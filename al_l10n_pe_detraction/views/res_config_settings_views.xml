<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_detraction" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.al.detraction</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="al_account_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='pe_accounting_block']"
                   position="inside">
                <setting string="Separar detracción en el asiento"
                         help="Reparte la línea por cobrar/pagar de la factura dentro del mismo asiento: neto en la cuenta del tercero y detracción en las cuentas configuradas (no se crea un segundo asiento).">
                    <field name="l10n_pe_detraction_split"/>
                    <div class="content-group mt16"
                         invisible="not l10n_pe_detraction_split">
                        <div class="row">
                            <label for="l10n_pe_detraction_receivable_account_id"
                                   class="col-lg-5 o_light_label"/>
                            <field name="l10n_pe_detraction_receivable_account_id"
                                   required="l10n_pe_detraction_split"/>
                        </div>
                        <div class="row">
                            <label for="l10n_pe_detraction_payable_account_id"
                                   class="col-lg-5 o_light_label"/>
                            <field name="l10n_pe_detraction_payable_account_id"
                                   required="l10n_pe_detraction_split"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
