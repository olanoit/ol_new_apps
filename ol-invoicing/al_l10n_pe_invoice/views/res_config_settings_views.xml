<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_invoice_report" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.al.invoice.report</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="65"/>
        <field name="inherit_id" ref="al_account_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='al_account_base']" position="inside">
                <block title="Comprobantes electrónicos" name="pe_invoice_report_block">
                    <setting string="Firma y eslogan en el reporte"
                             help="Bloque de firma / recibido conforme y eslogan de la compañía en el reporte A4 de comprobantes.">
                        <field name="active_fep_signatures"/>
                        <div class="content-group mt16">
                            <div class="row">
                                <label for="represent_id" class="col-lg-5 o_light_label"/>
                                <field name="represent_id"/>
                            </div>
                            <div class="row">
                                <label for="company_eslogan_pdf" class="col-lg-5 o_light_label"/>
                                <field name="company_eslogan_pdf"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
