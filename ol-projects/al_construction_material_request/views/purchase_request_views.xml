<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_request_form_construction" model="ir.ui.view">
        <field name="name">purchase.request.form.construction.request</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='assigned_to']" position="after">
                <field name="construction_request_id" invisible="not construction_request_id"/>
            </xpath>
        </field>
    </record>

</odoo>
