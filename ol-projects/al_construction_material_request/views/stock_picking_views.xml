<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_construction" model="ir.ui.view">
        <field name="name">stock.picking.form.construction.request</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="construction_request_id" invisible="not construction_request_id"/>
            </xpath>
        </field>
    </record>

</odoo>
