<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Encabezado común de los documentos impresos de la suite (el del
         comprobante A4): logo | compañía con domicilio fiscal, teléfono y
         correo | recuadro R.U.C., tipo y número. Parámetros: company,
         doc_title y, opcionales, doc_number, doc_extra (otra línea del
         recuadro, p. ej. el periodo) y doc_address (si no, se arma con la
         dirección de la compañía). El cuerpo del t-call añade líneas bajo los
         datos de la compañía. -->
    <template id="report_pe_document_header">
        <t t-set="partner" t-value="company.partner_id"/>
        <t t-set="district" t-value="'l10n_pe_district' in partner._fields and partner.l10n_pe_district.name"/>
        <t t-set="company_address" t-value="doc_address or ', '.join(p for p in (company.street, district, company.city, company.state_id.name) if p)"/>
        <table class="table table-sm table-borderless pe-doc-plain pe-doc-header">
            <tr>
                <td style="width: 15%;" class="align-middle">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                         class="pe-doc-logo" alt="Logo"/>
                </td>
                <td style="width: 50%;">
                    <ul class="pe-doc-company">
                        <li class="pe-doc-fs-20"><strong t-out="company.name"/></li>
                        <li t-if="company_address"><strong>Domicilio fiscal:</strong> <span t-out="company_address"/></li>
                        <li t-if="company.phone"><strong>Teléfono:</strong> <span t-out="company.phone"/></li>
                        <li t-if="company.email"><strong>Correo:</strong> <span t-out="company.email"/></li>
                        <li t-if="company.website"><strong>Web:</strong> <span t-out="company.website"/></li>
                        <t t-out="0"/>
                    </ul>
                </td>
                <td style="width: 35%;">
                    <ul class="pe-doc-box pe-doc-fs-14">
                        <li>R.U.C. <span t-out="company.vat"/></li>
                        <li style="text-transform: uppercase;"><strong t-out="doc_title"/></li>
                        <li t-if="doc_number"><strong>N.º <span t-out="doc_number"/></strong></li>
                        <li t-if="doc_extra"><span t-out="doc_extra"/></li>
                    </ul>
                </td>
            </tr>
        </table>
    </template>

    <!-- Pie común (se repite en cada página): datos de la compañía, fecha de
         la impresión y «Página X de Y». Va como hermano del div.article del
         documento (Odoo empareja cada .footer con su .article). Parámetro:
         company. -->
    <template id="report_pe_document_footer">
        <t t-set="partner" t-value="company.partner_id"/>
        <t t-set="district" t-value="'l10n_pe_district' in partner._fields and partner.l10n_pe_district.name"/>
        <t t-set="company_address" t-value="', '.join(p for p in (company.street, district, company.city, company.state_id.name) if p)"/>
        <div class="footer pe-doc-footer">
            <div class="pe-doc-footer-company">
                <strong t-out="company.name"/>
                <t t-if="company.vat"> · R.U.C. <span t-out="company.vat"/></t>
                <t t-if="company_address"> · <span t-out="company_address"/></t>
            </div>
            <div class="pe-doc-footer-contact">
                <t t-if="company.phone"><span t-out="company.phone"/></t>
                <t t-if="company.email"> · <span t-out="company.email"/></t>
                <t t-if="company.website"> · <span t-out="company.website"/></t>
            </div>
            <div class="pe-doc-footer-meta">
                <span>Impreso el <span t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/></span>
                <span class="pe-doc-footer-page">Página <span class="page"/> de <span class="topage"/></span>
            </div>
        </div>
    </template>

    <!-- Página completa de un documento: div.article (con los datos para la
         edición en línea), encabezado, el cuerpo del t-call y el pie.
         Parámetros: o (registro), company, doc_title y los opcionales del
         encabezado; page_class añade clases a la página (p. ej. pe-doc-text). -->
    <template id="report_pe_page">
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <div t-attf-class="page pe-doc-page #{page_class or ''}">
                <t t-call="al_report_base.report_pe_document_header"/>
                <t t-out="0"/>
            </div>
        </div>
        <t t-call="al_report_base.report_pe_document_footer"/>
    </template>

    <!-- Casillas de firma: un rectángulo por paso del documento (elaboró,
         cada nivel de aprobación, conformidad) con el rol, el nombre, el cargo
         y la fecha y hora, y espacio para firmar. Un paso que aún no ocurre
         deja la casilla con el rol y sin nombre. Parámetro: sign_boxes, lista
         de diccionarios con role, name, job y date (texto). Cuatro casillas
         por fila. -->
    <template id="report_pe_sign_boxes">
        <t t-set="box_rows" t-value="[sign_boxes[i:i + 4] for i in range(0, len(sign_boxes or []), 4)]"/>
        <table class="pe-doc-plain pe-doc-sign-boxes pe-doc-keep" t-foreach="box_rows" t-as="box_row">
            <tr>
                <td t-foreach="box_row" t-as="box">
                    <div class="pe-doc-sign-box">
                        <div class="pe-doc-sign-role" t-out="box.get('role')"/>
                        <div class="pe-doc-sign-space"/>
                        <div class="pe-doc-sign-name"><t t-out="box.get('name') or ' '"/></div>
                        <div class="pe-doc-sign-job" t-if="box.get('job')" t-out="box.get('job')"/>
                        <div class="pe-doc-sign-date" t-if="box.get('date')" t-out="box.get('date')"/>
                    </div>
                </td>
                <t t-foreach="range(4 - len(box_row))" t-as="_empty"><td/></t>
            </tr>
        </table>
    </template>
</odoo>
