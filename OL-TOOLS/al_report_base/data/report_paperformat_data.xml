<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formatos de los documentos de la suite: sin el encabezado de Odoo (el
         documento pinta el suyo), margen corto arriba y lugar para el pie. -->
    <record id="paperformat_pe_a4" model="report.paperformat">
        <field name="name">Documentos PE: A4 vertical</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">22</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="paperformat_pe_a4_landscape" model="report.paperformat">
        <field name="name">Documentos PE: A4 horizontal</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
</odoo>
