<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_al_user_role_from_groups_wizard_form" model="ir.ui.view">
        <field name="name">al.user.role.from.groups.wizard.form</field>
        <field name="model">al.user.role.from.groups.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear rol desde grupos">
                <group>
                    <field name="name" placeholder="p. ej. Químico farmacéutico"/>
                </group>
                <p class="text-muted">
                    Grupos que otorgará el rol. Use <em>Agregar una línea</em> para sumar más.
                </p>
                <field name="group_ids" nolabel="1" options="{'no_create': True}">
                    <list>
                        <field name="privilege_id" string="Privilegio"/>
                        <field name="name" string="Grupo"/>
                        <field name="comment" string="Descripción" optional="show"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_role" string="Crear rol" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- En Acción de la lista de grupos (con los grupos seleccionados). -->
    <record id="action_al_user_role_from_groups_wizard" model="ir.actions.act_window">
        <field name="name">Crear rol con estos grupos</field>
        <field name="res_model">al.user.role.from.groups.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_groups"/>
        <field name="group_ids" eval="[(4, ref('base.group_erp_manager'))]"/>
    </record>
</odoo>
