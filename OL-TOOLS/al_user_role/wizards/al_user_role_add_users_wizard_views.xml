<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_al_user_role_add_users_wizard_form" model="ir.ui.view">
        <field name="name">al.user.role.add.users.wizard.form</field>
        <field name="model">al.user.role.add.users.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar usuarios al rol">
                <group>
                    <field name="role_id" readonly="1"/>
                    <field name="user_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="company_id" groups="base.group_multi_company"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_add_users" string="Agregar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_al_user_role_add_users_wizard" model="ir.actions.act_window">
        <field name="name">Agregar usuarios</field>
        <field name="res_model">al.user.role.add.users.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_role_id': active_id}</field>
    </record>
</odoo>
