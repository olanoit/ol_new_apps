<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multicompañía: cada compañía ve solo sus series CPE. -->
    <record id="edi_invoice_series_comp_rule" model="ir.rule">
        <field name="name">Series CPE: multicompañía</field>
        <field name="model_id" ref="model_edi_invoice_series"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
