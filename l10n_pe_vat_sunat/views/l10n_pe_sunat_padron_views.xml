<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_pe_sunat_padron_list" model="ir.ui.view">
        <field name="name">l10n.pe.sunat.padron.list</field>
        <field name="model">l10n_pe.sunat.padron</field>
        <field name="arch" type="xml">
            <list string="Padrón SUNAT">
                <field name="kind"/>
                <field name="vat"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_pe_sunat_padron_search" model="ir.ui.view">
        <field name="name">l10n.pe.sunat.padron.search</field>
        <field name="model">l10n_pe.sunat.padron</field>
        <field name="arch" type="xml">
            <search>
                <field name="vat"/>
                <filter string="Buenos contribuyentes"
                        name="good"
                        domain="[('kind', '=', 'good_taxpayer')]"/>
                <filter string="Agentes de retención"
                        name="retention"
                        domain="[('kind', '=', 'retention_agent')]"/>
                <separator/>
                <group>
                    <filter string="Tipo de padrón"
                            name="grp_kind"
                            context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_pe_sunat_padron" model="ir.actions.act_window">
        <field name="name">Padrón SUNAT</field>
        <field name="res_model">l10n_pe.sunat.padron</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_l10n_pe_sunat_padron_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no se ha sincronizado el padrón SUNAT.
            </p>
            <p>
                El cron diario "SUNAT: Sincronizar padrón" se encarga
                de descargar los ZIPs oficiales de buenos
                contribuyentes y agentes de retención.
                Para correr una sincronización ahora, vaya a Ajustes →
                Técnico → Acciones Planificadas y pulse "Run Manually".
            </p>
        </field>
    </record>

    <menuitem id="menu_l10n_pe_sunat_padron"
              name="Padrón SUNAT"
              parent="contacts.res_partner_menu_config"
              action="action_l10n_pe_sunat_padron"
              groups="base.group_system"
              sequence="20"/>

    <!-- Espejo en la app "Perú": el padrón es la fuente de «buen
         contribuyente» y «agente de retención», que se usan al facturar. -->
    <menuitem id="pe_menu_l10n_pe_sunat_padron"
              name="Padrón SUNAT"
              parent="al_account_base.al_l10n_pe_config"
              action="action_l10n_pe_sunat_padron"
              groups="base.group_system"
              sequence="50"/>

</odoo>
