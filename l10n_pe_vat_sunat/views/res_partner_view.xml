<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.l10n.pe.vat</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Header con botón Update + estado SUNAT como statusbar -->
            <sheet position="before">
                <header>
                    <button string="Actualizar desde API"
                            type="object" name="btn_update_document"
                            class="oe_highlight"
                            invisible="country_code != 'PE'"
                            context="{'force_update': True}"/>
                    <field name="state" widget="statusbar" nolabel="1"
                           statusbar_visible="ACTIVO,BAJA DE OFICIO"
                           invisible="not is_company"
                           statusbar_colors="{'ACTIVO':'green','BAJA DE OFICIO':'red','BAJA PROVISIONAL':'red','SUSPENSION TEMPORAL':'red'}"/>
                </header>
            </sheet>

            <!-- Ribbons HABIDO / NO HABIDO -->
            <xpath expr="//div[@name='button_box']" position="after">
                <widget name="web_ribbon"
                        text="Habido"
                        invisible="not is_company or sunat_condition != 'HABIDO' or not state"/>
                <widget name="web_ribbon"
                        text="No Habido"
                        bg_color="bg-danger"
                        invisible="not is_company or sunat_condition == 'HABIDO' or not sunat_condition or not state"/>
            </xpath>

            <!-- Campos auxiliares (ocultos pero presentes para los attrs) -->
            <xpath expr="//field[@name='category_id']" position="before">
                <field name="sunat_condition" invisible="1"/>
                <field name="alert_warning_vat" invisible="1"/>
            </xpath>

            <!-- Nombre comercial debajo del título -->
            <xpath expr="//h1[1]" position="after">
                <div class="o_row" invisible="not is_company">
                    <field name="commercial_name" placeholder="Nombre comercial"/>
                </div>
            </xpath>

            <!-- Alerta cuando la API falló -->
            <xpath expr="//field[@name='vat']" position="after">
                <!-- Editables: el padrón los mantiene al día, pero
                     puede ir por detrás de la designación de SUNAT y son
                     las dos excepciones al régimen de retenciones. -->
                <field name="is_good_taxpayer" invisible="not is_company"/>
                <field name="is_retention_agent" invisible="not is_company"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert"
                     invisible="not alert_warning_vat">
                    <strong>No hay conexión con SUNAT/API o los datos
                    no existen.</strong> Complete los datos
                    manualmente; el servicio externo no respondió en
                    la última consulta.
                </div>
            </xpath>

        </field>
    </record>

</odoo>
