<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!--
        Cron diario que sincroniza los padrones SUNAT (buenos
        contribuyentes y agentes de retención).

        Se ejecuta cada 24h a las 03:00 (horario del servidor); la
        primera ejecución corre al cargar el módulo si está activo.
    -->
    <record id="ir_cron_sync_sunat_padron" model="ir.cron">
        <field name="name">SUNAT: Sincronizar padrón (Buen contribuyente / Agente de retención)</field>
        <field name="model_id" ref="model_l10n_pe_sunat_padron"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_padron()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0, second=0) + relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

</odoo>
