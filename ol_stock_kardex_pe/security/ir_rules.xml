<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multicompañía: los kardex generados (con su archivo) y las líneas de la
         vista SQL solo se ven en las compañías activas del usuario. -->
    <record id="rule_l10n_pe_kardex_report_company" model="ir.rule">
        <field name="name">Kardex SUNAT generado: multicompañía</field>
        <field name="model_id" ref="model_l10n_pe_kardex_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_l10n_pe_kardex_line_company" model="ir.rule">
        <field name="name">Kardex SUNAT (línea): multicompañía</field>
        <field name="model_id" ref="model_l10n_pe_kardex_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
