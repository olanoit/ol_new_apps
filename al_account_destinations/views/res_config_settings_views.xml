<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sección "Destinos" dentro de la app Perú de Ajustes (del base) -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.al.destinations</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="al_account_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='al_account_base']//block[@name='pe_accounting_block']"
                   position="inside">
                <setting string="Cuentas destino (dinámica 6↔9)" name="pe_destinations_setting"
                         help="Sentido del asiento de destino automático: de gasto por naturaleza (6) a función (9), o viceversa.">
                    <field name="l10n_pe_dest_type"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
