<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multicompañía de los modelos propios. La visibilidad de proyectos y
             tareas NO se redefine aquí a propósito: se apoya en las reglas
             nativas de `project` (privacidad, portal, compañías), que el
             servicio de datos respeta al leer sin sudo(). -->
        <record id="gantt_state_color_company_rule" model="ir.rule">
            <field name="name">Gantt: colores por compañía</field>
            <field name="model_id" ref="model_al_gantt_state_color"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Las líneas base siguen la visibilidad de su proyecto: no se
             redefine aquí quién ve qué proyecto, se delega en `project`. -->
        <record id="gantt_baseline_company_rule" model="ir.rule">
            <field name="name">Gantt: líneas base por compañía</field>
            <field name="model_id" ref="model_al_gantt_baseline"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
