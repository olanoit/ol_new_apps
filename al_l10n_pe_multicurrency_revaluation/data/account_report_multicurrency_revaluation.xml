<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Columna con el T.C. aplicado en cada línea (genérico, compra o venta).
         Es texto: el valor ya viene formateado a 3 decimales con el símbolo
         de la moneda; el formato numérico lo redondearía. -->
    <record id="multicurrency_revaluation_report_rate_used" model="account.report.column">
        <field name="report_id" ref="account_reports.multicurrency_revaluation_report"/>
        <field name="name">T.C.</field>
        <field name="expression_label">rate_used</field>
        <field name="sequence">50</field>
        <field name="figure_type">string</field>
    </record>

    <record id="multicurrency_revaluation_to_adjust_rate_used" model="account.report.expression">
        <field name="report_line_id" ref="account_reports.multicurrency_revaluation_to_adjust"/>
        <field name="label">rate_used</field>
        <field name="engine">custom</field>
        <field name="formula">_report_custom_engine_multi_currency_revaluation_to_adjust</field>
        <field name="subformula">rate_used</field>
        <field name="auditable" eval="False"/>
    </record>

    <record id="multicurrency_revaluation_excluded_rate_used" model="account.report.expression">
        <field name="report_line_id" ref="account_reports.multicurrency_revaluation_excluded"/>
        <field name="label">rate_used</field>
        <field name="engine">custom</field>
        <field name="formula">_report_custom_engine_multi_currency_revaluation_excluded</field>
        <field name="subformula">rate_used</field>
        <field name="auditable" eval="False"/>
    </record>
</odoo>
