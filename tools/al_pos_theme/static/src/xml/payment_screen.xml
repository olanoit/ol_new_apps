<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Pantalla de pago.
        - Se quitan las utilidades de fondo `bg-100` (con !important) para
          que el fondo lo den los tokens (clase propia `alpt-payment-main`).
    -->
    <t t-name="al_pos_theme.PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('main-content')]" position="attributes">
            <attribute name="class" remove="bg-100" add="alpt-payment-main" separator=" "/>
        </xpath>
    </t>

    <!--
        Monto adeudado: el core le pone `font-size: 125px` inline en
        escritorio (domina la pantalla). Se elimina el
        atributo (un <attribute> vacío lo borra) y el tamaño lo controla payment_screen.scss.
        Se agrega una etiqueta para que el número tenga contexto.
    -->
    <t t-name="al_pos_theme.PaymentScreenDue" t-inherit="point_of_sale.PaymentScreenDue" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('total')]" position="attributes">
            <attribute name="t-att-style"></attribute>
        </xpath>
        <xpath expr="//div[hasclass('total')]" position="before">
            <div class="alpt-due-label text-center">Total a pagar</div>
        </xpath>
    </t>

</templates>
