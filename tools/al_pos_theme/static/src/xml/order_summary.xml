<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Panel de orden vacío: el core deja la columna en blanco. Se usa el
        slot `emptyCart` que OrderDisplay ya expone (sólo se renderiza cuando
        la orden no tiene líneas), así que no se toca su estructura.
    -->
    <t t-name="al_pos_theme.OrderSummary" t-inherit="point_of_sale.OrderSummary" t-inherit-mode="extension">
        <xpath expr="//OrderDisplay" position="inside">
            <t t-set-slot="emptyCart">
                <div class="alpt-empty-cart d-flex flex-column align-items-center justify-content-center flex-grow-1 text-center gap-2 p-4">
                    <span class="alpt-empty-cart__icon d-flex align-items-center justify-content-center rounded-circle">
                        <i class="fa fa-shopping-basket" aria-hidden="true"/>
                    </span>
                    <span class="alpt-empty-cart__title">La orden está vacía</span>
                    <span class="alpt-empty-cart__hint">Toque un producto o escanee un código de barras para comenzar.</span>
                </div>
            </t>
        </xpath>
    </t>

</templates>
