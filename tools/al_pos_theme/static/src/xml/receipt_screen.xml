<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Pantalla de recibo: se quitan las utilidades de fondo (`bg-100`,
        `bg-200`, con !important) y se agregan clases propias. El recibo en
        sí (OrderReceipt) no se toca: sigue en blanco y negro para imprimir.
    -->
    <t t-name="al_pos_theme.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-screen')]" position="attributes">
            <attribute name="class" remove="bg-100" add="alpt-receipt-screen" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-container')]" position="attributes">
            <attribute name="class" remove="bg-200" add="alpt-receipt-preview" separator=" "/>
        </xpath>
    </t>

</templates>
