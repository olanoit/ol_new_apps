<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mcp_oauth_client_view_list" model="ir.ui.view">
        <field name="name">mcp.oauth.client.list</field>
        <field name="model">mcp.oauth.client</field>
        <field name="arch" type="xml">
            <list string="Clientes OAuth">
                <field name="client_name"/>
                <field name="client_id"/>
                <field name="redirect_uris"/>
                <field name="create_date" string="Registrado el"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="mcp_oauth_client_view_form" model="ir.ui.view">
        <field name="name">mcp.oauth.client.form</field>
        <field name="model">mcp.oauth.client</field>
        <field name="arch" type="xml">
            <form string="Cliente OAuth">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="client_name"/>
                        <field name="client_id"/>
                        <field name="redirect_uris" placeholder="https://claude.ai/api/mcp/auth_callback&#10;http://localhost:33418/callback"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mcp_oauth_client_action" model="ir.actions.act_window">
        <field name="name">Clientes OAuth</field>
        <field name="res_model">mcp.oauth.client</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay clientes OAuth registrados</p>
            <p>Los clientes MCP se registran solos (registro dinámico). Solo se aceptan
               las URIs de redirección registradas aquí.</p>
        </field>
    </record>

</odoo>
