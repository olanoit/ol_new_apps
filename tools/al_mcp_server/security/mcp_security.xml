            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            Reglas de registro de mcp.session.log
            ─────────────────────────────────────
            group_user  → solo lee sus propias llamadas (los payloads pueden llevar PII)
            group_system → ve todo
        -->
        <record id="rule_mcp_session_log_user_own" model="ir.rule">
            <field name="name">Registro MCP: los usuarios solo ven sus propias llamadas</field>
            <field name="model_id" ref="model_mcp_session_log"/>
