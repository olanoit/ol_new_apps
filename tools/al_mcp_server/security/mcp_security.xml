<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Reglas de registro de mcp.token
            ───────────────────────────────
            group_user  → ve SOLO sus propios tokens (user_id = uid)
            group_system → ve TODOS los tokens (se combina con OR con la regla de group_user: prevalece el administrador)
        -->
        <record id="rule_mcp_token_user_own" model="ir.rule">
            <field name="name">Token MCP: los usuarios solo ven sus propios tokens</field>
            <field name="model_id" ref="model_mcp_token"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_mcp_token_admin_all" model="ir.rule">
            <field name="name">Token MCP: el administrador ve todos</field>
            <field name="model_id" ref="model_mcp_token"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            Reglas de registro de mcp.session
            ─────────────────────────────────
            group_user  → ve SOLO sus propias sesiones (solo lectura)
            group_system → ve TODAS las sesiones (acceso completo)
        -->
        <record id="rule_mcp_session_user_own" model="ir.rule">
            <field name="name">Sesión MCP: los usuarios solo ven sus propias sesiones</field>
            <field name="model_id" ref="model_mcp_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_mcp_session_admin_all" model="ir.rule">
            <field name="name">Sesión MCP: el administrador ve todas</field>
            <field name="model_id" ref="model_mcp_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            Reglas de registro de mcp.job
            ─────────────────────────────
            group_user  → ve SOLO sus propios trabajos (user_id = uid)
            group_system → ve TODOS los trabajos (se combina con OR con la regla de group_user: prevalece el administrador)
        -->
        <record id="rule_mcp_job_user_own" model="ir.rule">
