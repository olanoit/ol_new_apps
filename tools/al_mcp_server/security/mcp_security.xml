            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_mcp_job_admin_all" model="ir.rule">
            <field name="name">Trabajo MCP: el administrador ve todos</field>
            <field name="model_id" ref="model_mcp_job"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            Reglas de registro de mcp.portal.page
            ─────────────────────────────────────
            group_user  → ve SOLO sus propias páginas (created_by = uid)
            group_system → ve TODAS las páginas (se combina con OR con la regla de group_user: prevalece el administrador)
        -->
        <record id="rule_mcp_portal_page_user_own" model="ir.rule">
            <field name="name">Página de portal MCP: los usuarios solo ven sus propias páginas</field>
