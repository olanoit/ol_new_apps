<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_vacuum_auth_codes" model="ir.cron">
            <field name="name">MCP: Limpieza de Códigos de Autorización Caducados</field>
            <field name="model_id" ref="model_mcp_auth_code"/>
            <field name="state">code</field>
            <field name="code">model._vacuum_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_vacuum_sessions" model="ir.cron">
            <field name="name">MCP: Limpieza de Sesiones Antiguas</field>
            <field name="model_id" ref="model_mcp_session"/>
            <field name="state">code</field>
            <field name="code">model._vacuum_old_sessions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_process_mcp_jobs" model="ir.cron">
            <field name="name">MCP: Procesar Trabajos Pendientes</field>
            <field name="model_id" ref="model_mcp_job"/>
            <field name="state">code</field>
            <field name="code">model._process_pending_jobs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="sequence">20</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
