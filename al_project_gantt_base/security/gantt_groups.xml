<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Odoo 19 agrupa los grupos por res.groups.privilege (ya no por
             category_id directo en res.groups). -->
        <record id="res_groups_privilege_gantt" model="res.groups.privilege">
            <field name="name">Gantt de Proyectos</field>
            <field name="sequence">35</field>
            <field name="category_id" ref="base.module_category_services"/>
        </record>

        <!-- Solo usuarios internos: ambos grupos implican project.group_project_user,
             que a su vez implica base.group_user. -->
        <record id="group_gantt_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_gantt"/>
            <field name="implied_ids" eval="[Command.link(ref('project.group_project_user'))]"/>
            <field name="comment">Puede consultar el diagrama de Gantt de los proyectos que ya tiene permitido ver.</field>
        </record>

        <record id="group_gantt_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_gantt"/>
            <field name="implied_ids" eval="[Command.link(ref('group_gantt_user')), Command.link(ref('project.group_project_manager'))]"/>
            <field name="comment">Además, configura los colores por estado y los parámetros del Gantt.</field>
        </record>

        <!-- Los administradores de proyecto obtienen acceso al Gantt al instalar. -->
        <record id="project.group_project_manager" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('al_project_gantt_base.group_gantt_user'))]"/>
        </record>

    </data>
</odoo>
