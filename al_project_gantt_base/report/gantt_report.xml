<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A3 apaisado: un diagrama de Gantt no cabe en vertical. -->
    <record id="paperformat_gantt" model="report.paperformat">
        <field name="name">Gantt A3 apaisado</field>
        <field name="default" eval="False"/>
        <field name="format">A3</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_gantt" model="ir.actions.report">
        <field name="name">Diagrama de Gantt</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_project_gantt_base.report_gantt</field>
        <field name="report_file">al_project_gantt_base.report_gantt</field>
        <field name="paperformat_id" ref="paperformat_gantt"/>
        <field name="print_report_name">'Gantt - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
