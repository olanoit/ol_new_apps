<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Correlativo del resumen diario de reversiones (RR-AAAAMMDD-N) cuando no
         está instalado al_l10n_pe_retention; con él, se usa el suyo para que
         la reversión de un CRE y la de una liquidación no repitan número. -->
    <record id="reversal_sequence" model="ir.sequence">
        <field name="name">Resumen de reversiones de la liquidación de compra (Perú)</field>
        <field name="code">al_l10n_pe_edi_purchase_settlement.reversal_sequence</field>
        <field name="prefix">RR-%(year)s%(month)s%(day)s-</field>
        <field name="padding">0</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
