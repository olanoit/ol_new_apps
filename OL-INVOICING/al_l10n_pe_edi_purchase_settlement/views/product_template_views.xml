<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tasa de la retención de renta en la liquidación de compra: el oro
         retiene el 4 %, el resto el 1,5 %. En la pestaña «Contabilidad». -->
    <record id="product_template_form_view_purchase_settlement" model="ir.ui.view">
        <field name="name">product.template.form.purchase.settlement.pe</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']/group[@name='accounting']" position="after">
                <group name="l10n_pe_lce" string="Liquidación de compra"
                       invisible="'PE' not in fiscal_country_codes or not purchase_ok">
                    <group name="l10n_pe_lce_left">
                        <field name="l10n_pe_lce_gold"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
