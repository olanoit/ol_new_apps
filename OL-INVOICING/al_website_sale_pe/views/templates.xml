<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dirección de facturación (portal y checkout): boleta o factura antes
         del documento, y consulta del RUC o DNI. Odoo 20: el RUC va en «vat»
         y el DNI en el identificador adicional PE_DNI. -->
    <template id="address_form_fields" inherit_id="portal.address_form_fields">
        <xpath expr="//div[@id='div_vat']" position="before">
            <div t-if="l10n_pe_receipt and is_commercial_address and can_edit_vat"
                 id="div_l10n_pe_receipt" class="col-12 mb-2">
                <label class="col-form-label d-block">Comprobante</label>
                <div class="btn-group" role="group" aria-label="Comprobante">
                    <input type="radio" class="btn-check" name="l10n_pe_receipt" id="l10n_pe_receipt_boleta"
                           value="boleta" autocomplete="off" data-sunat-code="1"
                           t-att-checked="l10n_pe_receipt == 'boleta'"/>
                    <label class="btn btn-outline-primary" for="l10n_pe_receipt_boleta">Boleta</label>
                    <input type="radio" class="btn-check" name="l10n_pe_receipt" id="l10n_pe_receipt_factura"
                           value="factura" autocomplete="off" data-sunat-code="6"
                           t-att-checked="l10n_pe_receipt == 'factura'"/>
                    <label class="btn btn-outline-primary" for="l10n_pe_receipt_factura">Factura</label>
                </div>
                <small class="form-text text-muted d-block">
                    La factura se emite a un RUC; la boleta, a su DNI u otro documento.
                </small>
                <button type="button" class="btn btn-link px-0 o_l10n_pe_document_lookup">
                    <i class="oi me-1" data-icon="search"/>Consultar en SUNAT
                </button>
                <small class="o_l10n_pe_document_lookup_message form-text text-muted d-block"/>
            </div>
        </xpath>
    </template>

</odoo>
