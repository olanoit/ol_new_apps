<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <!-- Patrón estándar Odoo: template contenedor + template _document
             por registro (mismo esquema que account.report_invoice). Todo el
             estilo vive en static/src/css/report_cpe.css (bundles
             web.report_assets_common / _pdf). -->
        <template id="report_cpe_invoice_a4_main">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-call="al_l10n_pe_invoice.report_cpe_invoice_a4_document" t-lang="lang"/>
                </t>
            </t>
        </template>

        <template id="report_cpe_invoice_a4_document">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <!-- QR oficial SUNAT: el core lo extrae del XML firmado (incluye
                 el hash de la firma); vacío si aún no se generó el XML. -->
            <t t-set="extra_edi_vals" t-value="o._l10n_pe_edi_get_extra_report_values()"/>
            <div class="article cpe-a4"
                 t-att-data-oe-model="o and o._name"
                 t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">

                <!-- ENCABEZADO: logo | compañía | recuadro RUC/documento
                     (estilo común de los comprobantes PE, al_account_base) -->
                <t t-call="al_account_base.report_pe_document_header">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="doc_title" t-value="o.l10n_latam_document_type_id.report_name"/>
                    <t t-set="doc_number" t-value="o.l10n_latam_document_number or o.name"/>
                    <t t-set="doc_address" t-value="o._l10n_pe_report_company_address()"/>
                    <li t-if="o.company_id.active_fep_signatures and o.company_id.company_eslogan_pdf">
                        <em><span t-field="o.company_id.company_eslogan_pdf"/></em>
                    </li>
                </t>

                <!-- CLIENTE Y FECHAS: el adquirente es la entidad comercial, como
                     en el XML y el QR (no el contacto de la empresa) -->
                <t t-set="buyer" t-value="o.commercial_partner_id"/>
                <t t-set="payment_means" t-value="o._l10n_pe_report_payment_means()"/>
                <t t-set="report_rate" t-value="o._l10n_pe_report_exchange_rate()"/>
                <table class="pe-doc-table mb-2">
                    <tr>
                        <td class="pe-doc-label" style="width: 15%;">Señor(es)</td>
                        <td style="width: 43%;"><span t-field="buyer.name"/></td>
                        <td class="pe-doc-label" style="width: 19%;">Fecha de emisión</td>
                        <td style="width: 23%;"><span t-field="o.invoice_date"
                                  t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/></td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label"><span t-out="buyer.l10n_latam_identification_type_id.name or 'Doc.'"/></td>
                        <td><span t-field="buyer.vat"/></td>
                        <td class="pe-doc-label">Fecha de vencimiento</td>
                        <td><span t-if="o.invoice_date_due" t-field="o.invoice_date_due"
                                  t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/></td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label">Dirección</td>
                        <td><span t-out="o._l10n_pe_report_partner_address()"/></td>
                        <td class="pe-doc-label">Moneda</td>
                        <td><span t-out="o._l10n_pe_report_currency_label()"/></td>
                    </tr>
                    <tr t-if="payment_means or o.invoice_payment_term_id">
                        <td class="pe-doc-label">Forma de pago</td>
                        <td><span t-out="payment_means"/></td>
                        <td class="pe-doc-label">Condición</td>
                        <td><span t-if="o.invoice_payment_term_id" t-field="o.invoice_payment_term_id.name"/></td>
                    </tr>
                    <tr t-if="o.invoice_user_id or report_rate">
                        <td class="pe-doc-label">Vendedor</td>
                        <td><span t-if="o.invoice_user_id" t-field="o.invoice_user_id.name"/></td>
                        <td class="pe-doc-label">Tipo de cambio</td>
                        <td>
                            <t t-if="report_rate">
                                <span t-out="o.company_currency_id.symbol"/>
                                <span t-out="'%.3f' % report_rate"/>
                            </t>
                        </td>
                    </tr>
                    <tr t-if="o.sale_id or o.external_purchase or o.sale_id.external_purchase">
                        <td class="pe-doc-label">Pedido de venta</td>
                        <td><span t-if="o.sale_id" t-field="o.sale_id.name"/></td>
                        <td class="pe-doc-label">O/C externa</td>
                        <td><span t-out="o.external_purchase or o.sale_id.external_purchase"/></td>
                    </tr>
                </table>

                <!-- NOTA DE CRÉDITO / DÉBITO: documento que modifica y motivo
                     (obligatorios en la representación impresa) -->
                <t t-set="origin_move" t-value="o._l10n_pe_report_origin_move()"/>
                <table class="pe-doc-table mb-2" t-if="o.l10n_latam_document_type_id.code in ('07', '08')">
                    <tr>
                        <td class="pe-doc-label" style="width: 22%;">Documento que modifica</td>
                        <td>
                            <t t-if="origin_move">
                                <span t-out="origin_move.l10n_latam_document_type_id.report_name"/>
                                <span t-out="origin_move.l10n_latam_document_number or origin_move.name"/>
                                <t t-if="origin_move.invoice_date">
                                    del <span t-field="origin_move.invoice_date"
                                              t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                </t>
                            </t>
                            <t t-else=""><span t-out="o.ref"/></t>
                        </td>
                    </tr>
                    <tr t-if="o.l10n_latam_document_type_id.code == '07' and o.l10n_pe_edi_refund_reason">
                        <td class="pe-doc-label">Motivo</td>
                        <td><span t-field="o.l10n_pe_edi_refund_reason"/></td>
                    </tr>
                    <tr t-if="o.l10n_latam_document_type_id.code == '08' and o.l10n_pe_edi_charge_reason">
                        <td class="pe-doc-label">Motivo</td>
                        <td><span t-field="o.l10n_pe_edi_charge_reason"/></td>
                    </tr>
                </table>

                <!-- DETALLE, TOTALES, IMPORTE EN LETRAS E INFORMACIÓN ADICIONAL:
                     una sola tabla, como el comprobante de retención -->
                <t t-set="lines"
                   t-value="o.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))"/>
                <t t-set="has_discount" t-value="any(l.discount for l in lines)"/>
                <t t-set="ncols" t-value="8 if has_discount else 7"/>
                <!-- Descuento en base imponible: % por línea + líneas negativas -->
                <t t-set="discount_amount" t-value="o.get_amount_discount()"/>
                <t t-set="qr_str" t-value="extra_edi_vals.get('qr_str')"/>
                <table class="pe-doc-table pe-doc-lines mb-2">
                    <thead>
                        <tr class="pe-doc-thead">
                            <td class="text-center" style="width: 5%;">Ítem</td>
                            <td style="width: 10%;">Código</td>
                            <td>Descripción</td>
                            <td class="text-end" style="width: 8%;">Cant.</td>
                            <td class="text-center" style="width: 8%;">Unidad</td>
                            <td class="text-end" style="width: 12%;">P. Unit</td>
                            <td class="text-end" style="width: 7%;" t-if="has_discount">Desc. %</td>
                            <td class="text-end" style="width: 13%;">Importe</td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="lines" t-as="line">
                            <td class="text-center"><span t-out="line_index + 1"/></td>
                            <td><span t-field="line.product_id.default_code"/></td>
                            <td><span t-field="line.name"/></td>
                            <td class="text-end"><span t-field="line.quantity"/></td>
                            <td class="text-center"><span t-field="line.product_uom_id.name"/></td>
                            <td class="text-end"><span t-out="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            <td class="text-end" t-if="has_discount"><span t-out="line.discount"/></td>
                            <td class="text-end"><span t-out="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="pe-doc-subtotal pe-doc-first" t-if="o.l10n_pe_edi_amount_base">
                            <td t-att-colspan="ncols - 1" class="text-end pe-doc-label">Op. gravadas</td>
                            <td class="text-end"><span t-out="o.l10n_pe_edi_amount_base" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr class="pe-doc-subtotal" t-if="o.l10n_pe_edi_amount_exonerated">
                            <td t-att-colspan="ncols - 1" class="text-end pe-doc-label">Op. exoneradas</td>
                            <td class="text-end"><span t-out="o.l10n_pe_edi_amount_exonerated" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr class="pe-doc-subtotal" t-if="o.l10n_pe_edi_amount_unaffected">
                            <td t-att-colspan="ncols - 1" class="text-end pe-doc-label">Op. inafectas</td>
                            <td class="text-end"><span t-out="o.l10n_pe_edi_amount_unaffected" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr class="pe-doc-subtotal" t-if="o.l10n_pe_edi_amount_export">
                            <td t-att-colspan="ncols - 1" class="text-end pe-doc-label">Op. exportación</td>
                            <td class="text-end"><span t-out="o.l10n_pe_edi_amount_export" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr class="pe-doc-subtotal" t-if="o.l10n_pe_edi_amount_free">
                            <td t-att-colspan="ncols - 1" class="text-end pe-doc-label">Op. gratuitas</td>
                            <td class="text-end"><span t-out="o.l10n_pe_edi_amount_free" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr class="pe-doc-subtotal" t-if="discount_amount">
                            <td t-att-colspan="ncols - 1" class="text-end pe-doc-label">Descuento</td>
                            <td class="text-end"><span t-out="discount_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr class="pe-doc-subtotal" t-if="o.l10n_pe_edi_amount_isc">
                            <td t-att-colspan="ncols - 1" class="text-end pe-doc-label">ISC</td>
                            <td class="text-end"><span t-out="o.l10n_pe_edi_amount_isc" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr class="pe-doc-subtotal">
                            <td t-att-colspan="ncols - 1" class="text-end pe-doc-label"><span t-out="o._l10n_pe_report_igv_label()"/></td>
                            <td class="text-end"><span t-out="o.l10n_pe_edi_amount_igv" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr class="pe-doc-subtotal" t-if="o.l10n_pe_edi_amount_icbper">
                            <td t-att-colspan="ncols - 1" class="text-end pe-doc-label">ICBPER</td>
                            <td class="text-end"><span t-out="o.l10n_pe_edi_amount_icbper" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr class="pe-doc-subtotal" t-if="o.l10n_pe_edi_amount_others">
                            <td t-att-colspan="ncols - 1" class="text-end pe-doc-label">Otros tributos</td>
                            <td class="text-end"><span t-out="o.l10n_pe_edi_amount_others" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr class="pe-doc-total">
                            <td t-att-colspan="ncols - 1" class="text-end pe-doc-label">IMPORTE TOTAL</td>
                            <td class="text-end"><span t-out="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr class="pe-doc-note">
                            <td t-att-colspan="ncols">
                                <strong>SON:</strong>
                                <span class="text-uppercase" t-out="o._l10n_pe_edi_amount_to_text()"/>
                                <div t-if="o.l10n_pe_gloss"><strong>Glosa:</strong> <span t-field="o.l10n_pe_gloss"/></div>
                                <div t-if="o.l10n_pe_edi_legend_value"><span t-field="o.l10n_pe_edi_legend_value"/></div>
                            </td>
                        </tr>
                        <!-- DETRACCIÓN (al_l10n_pe_detraction) -->
                        <tr class="pe-doc-note" t-if="o.l10n_pe_detraction_applies">
                            <t t-set="national_bank_account" t-value="o._l10n_pe_get_national_bank_account_number()"/>
                            <td t-att-colspan="ncols">
                                <strong>Operación sujeta al Sistema de Pago de Obligaciones Tributarias (detracción):</strong>
                                <span t-field="o.l10n_pe_detraction_type_id.display_name"/>,
                                <span t-out="o.l10n_pe_detraction_percent"/> %, monto
                                <span t-field="o.l10n_pe_detraction_amount"
                                      t-options="{'widget': 'monetary', 'display_currency': o.company_currency_id}"/>
                                <t t-if="national_bank_account">· Cta. Banco de la Nación: <span t-out="national_bank_account"/></t>
                            </td>
                        </tr>
                        <!-- REPRESENTACIÓN IMPRESA + QR OFICIAL (el QR solo existe cuando
                             el XML firmado ya fue generado) -->
                        <tr class="pe-doc-note">
                            <td t-att-colspan="ncols" class="pe-doc-fs-11">
                                <table class="pe-doc-plain">
                                    <tr>
                                        <td>
                                            <strong>Información adicional:</strong><br/>
                                            • Representación impresa de la
                                            <span t-out="o.l10n_latam_document_type_id.report_name"/>.<br/>
                                            • Este documento ha sido generado electrónicamente y tiene validez legal.<br/>
                                            • Consulte el estado del documento en www.sunat.gob.pe.
                                        </td>
                                        <td t-if="qr_str" class="text-center" style="width: 120px;">
                                            <img alt="QR SUNAT"
                                                 t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('QR', quote_plus(qr_str), 100, 100, 0)"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </tfoot>
                </table>

                <!-- CRÉDITO / CUOTAS -->
                <table class="pe-doc-table pe-doc-lines mb-2" style="width: 60%;" t-if="payment_means == 'CRÉDITO'">
                    <thead>
                        <tr class="pe-doc-thead">
                            <td colspan="3">
                                Información del crédito · Monto neto pendiente de pago:
                                <span t-out="o._l10n_pe_report_net_pending()"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="pe-doc-subheader">
                            <td class="text-center">N.º cuota</td>
                            <td class="text-center">Fecha de vencimiento</td>
                            <td class="text-end">Monto</td>
                        </tr>
                        <t t-set="dues" t-value="o.get_data_dues()"/>
                        <tr t-foreach="dues" t-as="due">
                            <td class="text-center"><span t-out="due.get('nro')"/></td>
                            <td class="text-center"><span t-out="due.get('date')"/></td>
                            <td class="text-end">
                                <span t-out="due.get('amount')"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- FIRMAS (opcional por compañía) -->
                <table class="cpe-signatures" t-if="o.company_id.active_fep_signatures">
                    <tr>
                        <td>
                            <div class="cpe-muted" style="margin-bottom: 26px;">
                                <t t-if="o.state == 'posted' and o.payment_state in ('paid', 'in_payment')">
                                    CANCELADO / CANJEADO
                                </t>
                                <t t-else="">PENDIENTE DE PAGO</t>
                            </div>
                            <div class="cpe-signature-line"/>
                            <strong>Firma y sello del responsable</strong>
                            <div class="cpe-muted">
                                <span t-field="o.company_id.city"/>,
                                <span t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                            </div>
                        </td>
                        <td>
                            <div style="margin-bottom: 26px;">&#160;</div>
                            <div class="cpe-signature-line"/>
                            <strong>Recibido conforme</strong>
                            <div class="cpe-muted">Nombre: ______________________</div>
                            <div class="cpe-muted">DNI/RUC: ______________________</div>
                        </td>
                    </tr>
                </table>

                <!-- CUENTAS BANCARIAS -->
                <table class="pe-doc-table pe-doc-lines mb-2" t-if="o.company_id.partner_id.bank_ids">
                    <thead>
                        <tr class="pe-doc-thead">
                            <td class="text-center" style="width: 6%;">Ítem</td>
                            <td style="width: 40%;">Banco</td>
                            <td class="text-center" style="width: 14%;">Moneda</td>
                            <td style="width: 40%;">N.º de cuenta</td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.company_id.partner_id.bank_ids" t-as="bank">
                            <td class="text-center"><span t-out="bank_index + 1"/></td>
                            <td><span t-field="bank.bank_id.name"/></td>
                            <td class="text-center"><span t-field="bank.currency_id.name"/></td>
                            <td><span t-field="bank.acc_number"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <t t-call="al_account_base.report_pe_document_footer">
                <t t-set="company" t-value="o.company_id"/>
            </t>
        </template>

        <record id="report_cpe_invoice_a4" model="ir.actions.report">
            <field name="name">CPE A4</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">al_l10n_pe_invoice.report_cpe_invoice_a4_main</field>
            <field name="report_file">al_l10n_pe_invoice.report_cpe_invoice_a4_main</field>
            <field name="print_report_name">(object._get_report_base_filename_custom())</field>
            <field name="paperformat_id" ref="al_l10n_pe_invoice.paperformat_cpe_a4"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>
