<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hoja de reclamación (Anexo I del D.S. 011-2011-PCM, modificado por el
         D.S. 101-2022-PCM) con el formato común de los documentos de la suite
         (al_report_base): encabezado con el recuadro R.U.C./hoja/número,
         secciones 1 a 4 en tablas con borde redondeado y pie con la
         numeración. Los textos y secciones legales no cambian. -->
    <template id="report_complaint_document">
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="local_dt" t-value="o._local_datetime()"/>
        <!-- Casilla de marca: recuadro con una X si está marcada. -->
        <t t-set="check_style" t-value="'display: inline-block; width: 11px; height: 11px; border: 1px solid #000; text-align: center; line-height: 10px; font-size: 10px; margin-right: 4px;'"/>
        <t t-call="al_report_base.report_pe_page"
            doc_title.f="HOJA DE RECLAMACIÓN"
            doc_number="o.name"
            doc_extra="'Libro %s' % o.book_id.code">

            <div class="pe-doc-title">LIBRO DE RECLAMACIONES</div>

            <table class="pe-doc-table mb-2">
                <tr>
                    <td class="pe-doc-label" style="width: 18%;">Fecha</td>
                    <td class="pe-doc-value" style="width: 32%;">
                        <t t-out="local_dt.strftime('%d/%m/%Y')"/> · Hora <t t-out="local_dt.strftime('%H:%M')"/>
                    </td>
                    <td class="pe-doc-label" style="width: 22%;">Código de identificación</td>
                    <td class="pe-doc-value" style="width: 28%;"><t t-out="o.book_id.code"/></td>
                </tr>
                <tr>
                    <td class="pe-doc-label">Establecimiento</td>
                    <td class="pe-doc-value" t-att-colspan="1 if o.channel == 'backup' and o.backup_sheet_number else 3"><t t-out="o.book_id.address or ''"/></td>
                    <t t-if="o.channel == 'backup' and o.backup_sheet_number">
                        <td class="pe-doc-label">Hoja de respaldo N.º</td>
                        <td class="pe-doc-value"><t t-out="o.backup_sheet_number"/></td>
                    </t>
                </tr>
            </table>

            <div class="pe-doc-section">1. IDENTIFICACIÓN DEL CONSUMIDOR RECLAMANTE</div>
            <table class="pe-doc-table pe-doc-keep">
                <tr><td class="pe-doc-label" style="width: 18%;">NOMBRE:</td><td colspan="3" t-out="o.consumer_name"/></tr>
                <tr><td class="pe-doc-label">DOMICILIO:</td><td colspan="3" t-out="o.consumer_address or ''"/></tr>
                <tr>
                    <td class="pe-doc-label">DNI / CE:</td>
                    <td style="width: 32%;"><t t-out="dict(o._fields['consumer_doc_type'].selection).get(o.consumer_doc_type)"/>
                        <t t-out="o.consumer_doc_number"/></td>
                    <td class="pe-doc-label" style="width: 22%;">TELÉFONO / E-MAIL:</td>
                    <td><t t-out="o.consumer_phone or ''"/><t t-if="o.consumer_phone and o.consumer_email"> / </t>
                        <t t-out="o.consumer_email or ''"/></td>
                </tr>
                <tr>
                    <td class="pe-doc-label">PADRE O MADRE:</td>
                    <td colspan="3">
                        <t t-if="o.is_minor">
                            <t t-out="o.guardian_name"/>
                            <t t-if="o.guardian_doc_number"> · Doc. <t t-out="o.guardian_doc_number"/></t>
                            <t t-if="o.guardian_address"> · <t t-out="o.guardian_address"/></t>
                            <t t-if="o.guardian_phone"> · <t t-out="o.guardian_phone"/></t>
                            <t t-if="o.guardian_email"> · <t t-out="o.guardian_email"/></t>
                        </t>
                        <t t-else="">[Para el caso de menores de edad]</t>
                    </td>
                </tr>
            </table>

            <div class="pe-doc-section">2. IDENTIFICACIÓN DEL BIEN CONTRATADO</div>
            <table class="pe-doc-table pe-doc-keep">
                <tr>
                    <td style="width: 18%;">
                        <span t-att-style="check_style"><t t-if="o.good_type in ('product', 'both')">X</t></span>PRODUCTO<br/>
                        <span t-att-style="check_style"><t t-if="o.good_type in ('service', 'both')">X</t></span>SERVICIO
                    </td>
                    <td>
                        <strong>MONTO RECLAMADO:</strong>
                        <t t-if="o.amount_claimed" t-out="o.amount_claimed"
                           t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                        <br/><strong>DESCRIPCIÓN:</strong> <t t-out="o.good_description or ''"/>
                        <t t-if="o.order_reference"><br/><strong>Comprobante o pedido:</strong>
                            <t t-out="o.order_reference"/></t>
                    </td>
                </tr>
            </table>

            <div class="pe-doc-section">3. DETALLE DE LA RECLAMACIÓN Y PEDIDO DEL CONSUMIDOR
                <span style="float: right;">
                    <span t-att-style="check_style + ' background-color: #fff; color: #000;'"><t t-if="o.claim_type == 'claim'">X</t></span>RECLAMO¹
                      <span t-att-style="check_style + ' background-color: #fff; color: #000;'"><t t-if="o.claim_type == 'complaint'">X</t></span>QUEJA²
                </span>
            </div>
            <table class="pe-doc-table pe-doc-lines pe-doc-keep">
                <tr><td class="pe-doc-label" style="width: 18%;">DETALLE:</td><td style="white-space: pre-wrap;" t-out="o.detail"/></tr>
                <tr><td class="pe-doc-label">PEDIDO:</td><td style="white-space: pre-wrap;" t-out="o.consumer_request or ''"/></tr>
                <tr>
                    <td colspan="2" class="text-center" style="padding-top: 22px;">
                        <t t-if="o.consumer_confirmed">Enviado y confirmado por el consumidor en el libro virtual el
                            <t t-out="local_dt.strftime('%d/%m/%Y %H:%M')"/></t>
                        <t t-else="">______________________________</t>
                        <br/><strong>FIRMA DEL CONSUMIDOR</strong>
                    </td>
                </tr>
            </table>

            <div class="pe-doc-section">4. OBSERVACIONES Y ACCIONES ADOPTADAS POR EL PROVEEDOR</div>
            <table class="pe-doc-table pe-doc-lines pe-doc-keep">
                <tr><td colspan="2" style="white-space: pre-wrap; height: 40px;">
                    <t t-if="o.settlement_offer"><strong>Oferta de solución:</strong>
                        <t t-out="o.settlement_offer"/>
                        <t t-if="o.state in ('settled', 'closed') and o.settlement_acceptance_date">
                            <br/><strong>ACUERDO ACEPTADO PARA SOLUCIONAR EL RECLAMO</strong>
                            (<t t-out="o.settlement_acceptance_date.strftime('%d/%m/%Y')"/>)</t>
                        <br/></t>
                    <t t-out="o.provider_observations or ''"/>
                </td></tr>
                <tr>
                    <td style="width: 60%;"><strong>FECHA DE COMUNICACIÓN DE LA RESPUESTA:</strong>
                        <t t-if="o.response_date" t-out="o.response_date.strftime('%d/%m/%Y')"/></td>
                    <td class="text-center" style="padding-top: 22px;">______________________________<br/><strong>FIRMA DEL PROVEEDOR</strong></td>
                </tr>
            </table>

            <div class="pe-doc-fs-11 mt-2">
                <p class="mb-1">¹ RECLAMO: Disconformidad relacionada a los productos o servicios.</p>
                <p class="mb-1">² QUEJA: Disconformidad no relacionada a los productos o servicios; o, malestar o descontento respecto a la atención al público.</p>
                <p class="mb-1">*La formulación del reclamo no impide acudir a otras vías de solución de controversias ni es requisito previo para interponer una denuncia ante el INDECOPI.</p>
                <p class="mb-1">* El proveedor debe dar respuesta al reclamo o queja en un plazo no mayor a quince (15) días hábiles, el cual es improrrogable.</p>
            </div>
            <div class="text-end mt-2"><strong>Destinatario: <t t-out="destination or 'CONSUMIDOR'"/></strong></div>
        </t>
    </template>

    <template id="report_complaint">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="al_l10n_pe_complaints_book.report_complaint_document"/>
            </t>
        </t>
    </template>

    <!-- Aviso del Anexo II (D.S. 006-2014-PCM): A4, «Libro de Reclamaciones» con
         letras de al menos 1 × 1 cm y el resto de al menos 0,5 × 0,5 cm. Con el
         encabezado y el pie comunes de la suite (al_report_base); el aviso
         conserva su recuadro y sus tamaños de letra. -->
    <template id="report_book_notice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <t t-call="al_report_base.report_pe_page"
                    doc_title.f="Aviso del libro de reclamaciones"
                    doc_number="o.code"
                    doc_extra="'Libro %s' % ('virtual' if o.book_type == 'virtual' else 'físico')">
                    <div class="text-center" style="border: 3px solid #000; border-radius: 5px; padding: 36px 30px; margin-top: 10px;">
                        <div style="font-size: 54px; font-weight: bold; line-height: 1.15;">Libro de Reclamaciones</div>
                        <div style="font-size: 26px; line-height: 1.45; margin-top: 36px;">
                            Conforme a lo establecido en el Código de Protección y Defensa del Consumidor este
                            establecimiento cuenta con un Libro de Reclamaciones
                            (<t t-out="'virtual' if o.book_type == 'virtual' else 'físico'"/>) a tu disposición.
                            Solicítalo para registrar una queja o reclamo
                        </div>
                        <div style="font-size: 22px; margin-top: 36px;">
                            En caso de negativa de entrega del libro escribe a libroreclamaciones@indecopi.gob.pe
                        </div>
                        <div style="font-size: 18px; margin-top: 36px;">
                            <t t-out="o.company_id.name"/> · RUC <t t-out="o.company_id.vat or ''"/> · Libro <t t-out="o.code"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
