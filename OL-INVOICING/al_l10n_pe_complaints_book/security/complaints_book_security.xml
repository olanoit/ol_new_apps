<odoo>

    <record id="res_groups_privilege_complaints_book" model="res.groups.privilege">
        <field name="name">Libro de reclamaciones</field>
        <field name="sequence">60</field>
    </record>

    <!-- Las hojas llevan datos personales (DNI, domicilio, correo): solo las ve
         el equipo de atenci&#243;n de reclamos. -->
    <record id="group_complaint_user" model="res.groups">
        <field name="name">Atenci&#243;n de reclamos</field>
        <field name="comment">Atiende y responde las hojas de reclamaci&#243;n.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_complaints_book"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_complaint_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="comment">Configura los libros, exporta al SIREC y elimina hojas cuyo plazo de conservaci&#243;n termin&#243;.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_complaints_book"/>
        <field name="implied_ids" eval="[(4, ref('group_complaint_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
