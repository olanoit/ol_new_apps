<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_complaint_sirec_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pe.complaint.sirec.wizard.form</field>
        <field name="model">l10n_pe.complaint.sirec.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group invisible="file">
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="book_ids" widget="many2many_tags"/>
                        <field name="only_pending"/>
                        <field name="mark_reported"/>
                    </group>
                </group>
                <group invisible="not file">
                    <field name="count"/>
                    <field name="filename" invisible="1"/>
                    <field name="file" filename="filename"/>
                </group>
                <p class="text-muted" invisible="file">
                    Archivo de carga masiva del SIREC: un registro por línea separado por «|». Cada
                    reclamo y su respuesta se reportan en un máximo de 30 días calendario.
                </p>
                <footer>
                    <button name="action_export" type="object" string="Generar archivo"
                            class="btn-primary" invisible="file"/>
                    <button special="cancel" string="Cerrar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_complaint_sirec_wizard" model="ir.actions.act_window">
        <field name="name">Exportar al SIREC</field>
        <field name="res_model">l10n_pe.complaint.sirec.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
