<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="paperformat_guia_remision" model="report.paperformat">
            <field name="name">Guía de remisión: A4 SUNAT</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">22</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- Patrón estándar Odoo: template contenedor + template _document
             por registro (mismo esquema que account.report_invoice). Todo el
             estilo vive en static/src/css/report_guia.css (bundles
             web.report_assets_common / _pdf), con el mismo lenguaje visual
             que los comprobantes de al_l10n_pe_invoice. -->
        <template id="report_guia_remision_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-call="al_l10n_pe_delivery_guide_report.report_guia_remision_page" t-lang="lang"/>
                </t>
            </t>
        </template>

        <template id="report_guia_remision_page">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <!-- La clase "article" es obligatoria: _prepare_html() solo envuelve
                 en web.minimal_layout (charset UTF-8 + CSS) los divs .article. -->
            <div class="article gre-a4"
                 t-att-data-oe-model="o and o._name"
                 t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">

                <!-- ENCABEZADO: logo | compañía | recuadro RUC/documento
                     (estilo común de los comprobantes PE, al_account_base) -->
                <t t-call="al_account_base.report_pe_document_header">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="doc_title" t-value="'Guía de remisión electrónica remitente'"/>
                    <t t-set="doc_number" t-value="o.l10n_latam_document_number"/>
                </t>

                <!-- INFORMACIÓN DEL TRASLADO -->
                <table class="pe-doc-table mb-2">
                    <tr class="pe-doc-subheader"><td colspan="4">Información del traslado</td></tr>
                    <tr>
                        <td class="pe-doc-label" style="width: 22%;">Fecha de emisión</td>
                        <td style="width: 28%;">
                            <t t-set="issue_date" t-value="o._l10n_pe_report_issue_date()"/>
                            <span t-if="issue_date" t-out="issue_date.strftime('%d/%m/%Y')"/>
                            <span t-elif="o.date_done" t-field="o.date_done"
                                  t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm:ss'}"/>
                            <span t-else="" t-field="o.scheduled_date"
                                  t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm:ss'}"/>
                        </td>
                        <td class="pe-doc-label" style="width: 22%;">Modalidad de traslado</td>
                        <td style="width: 28%;">
                            <t t-if="o.l10n_pe_edi_transport_type == '01'">Transporte público</t>
                            <t t-else="">Transporte privado</t>
                        </td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label">
                            <t t-if="o.l10n_pe_edi_transport_type == '01'">Fecha de entrega al transportista</t>
                            <t t-else="">Fecha de inicio de traslado</t>
                        </td>
                        <td>
                            <span t-field="o.l10n_pe_edi_departure_start_date"
                                  t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                        </td>
                        <td class="pe-doc-label">Peso bruto total (<t t-out="o.weight_uom_name"/>)</td>
                        <td><span t-field="o.weight"/></td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label">Motivo de traslado</td>
                        <td><span t-field="o.l10n_pe_edi_reason_for_transfer"/></td>
                        <td class="pe-doc-label">Observaciones</td>
                        <td><span t-field="o.l10n_pe_edi_observation"/></td>
                    </tr>
                </table>

                <!-- REMITENTE Y DESTINATARIO: el remitente es la compañía, como
                     declara el XML (DespatchSupplierParty); la dirección del
                     almacén va en «Punto de partida». -->
                <t t-set="receiver" t-value="o.partner_id.commercial_partner_id"/>
                <table class="pe-doc-table mb-2">
                    <tr class="pe-doc-subheader">
                        <td colspan="2">Datos del remitente</td>
                        <td colspan="2">Datos del destinatario</td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label" style="width: 14%;">Razón social</td>
                        <td style="width: 36%;"><span t-field="o.company_id.name"/></td>
                        <td class="pe-doc-label" style="width: 14%;">Razón social</td>
                        <td style="width: 36%;"><span t-field="receiver.name"/></td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label">R.U.C.</td>
                        <td><span t-field="o.company_id.vat"/></td>
                        <td class="pe-doc-label">
                            <span t-out="receiver.l10n_latam_identification_type_id.name or 'Doc.'"/>
                        </td>
                        <td><span t-field="receiver.vat"/></td>
                    </tr>
                    <tr>
                        <td/>
                        <td/>
                        <td class="pe-doc-label">Dirección</td>
                        <td>
                            <span t-field="o.partner_id.street"/>
                            <t t-if="o.partner_id.l10n_pe_district">
                                - <span t-field="o.partner_id.l10n_pe_district.name"/>
                                - <span t-field="o.partner_id.l10n_pe_district.city_id.state_id.name"/>
                                - <span t-field="o.partner_id.l10n_pe_district.city_id.country_id.name"/>
                            </t>
                        </td>
                    </tr>
                </table>

                <!-- PUNTOS DE PARTIDA Y LLEGADA, con ubigeo (como en el XML) -->
                <t t-set="departure" t-value="o._l10n_pe_report_departure_partner()"/>
                <table class="pe-doc-table mb-2">
                    <tr class="pe-doc-subheader">
                        <td colspan="2">Punto de partida</td>
                        <td colspan="2">Punto de llegada</td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label" style="width: 14%;">Dirección</td>
                        <td style="width: 36%;"><span t-out="o._l10n_pe_report_address_line(departure)"/></td>
                        <td class="pe-doc-label" style="width: 14%;">Dirección</td>
                        <td style="width: 36%;"><span t-out="o._l10n_pe_report_address_line(o.partner_id)"/></td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label">Ubigeo</td>
                        <td><span t-out="departure.l10n_pe_district.code"/></td>
                        <td class="pe-doc-label">Ubigeo</td>
                        <td><span t-out="o.partner_id.l10n_pe_district.code"/></td>
                    </tr>
                </table>

                <!-- DATOS DEL TRANSPORTE -->
                <table class="pe-doc-table mb-2" t-if="o.l10n_pe_edi_transport_type == '01'">
                    <tr class="pe-doc-subheader"><td colspan="4">Datos del transportista</td></tr>
                    <tr>
                        <td class="pe-doc-label" style="width: 14%;">Razón social</td>
                        <td style="width: 36%;"><span t-field="o.l10n_pe_edi_operator_id.name"/></td>
                        <td class="pe-doc-label" style="width: 14%;">R.U.C.</td>
                        <td style="width: 36%;"><span t-field="o.l10n_pe_edi_operator_id.vat"/></td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label">N.º registro MTC</td>
                        <td colspan="3">
                            <span t-field="o.l10n_pe_edi_operator_id.l10n_pe_edi_mtc_number"/>
                        </td>
                    </tr>
                </table>

                <table class="pe-doc-table mb-2" t-if="o.l10n_pe_edi_transport_type == '02'">
                    <tr class="pe-doc-subheader">
                        <td colspan="2">Datos del conductor</td>
                        <td colspan="2">Datos del vehículo</td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label" style="width: 14%;">Conductor</td>
                        <td style="width: 36%;"><span t-field="o.l10n_pe_edi_operator_id.name"/></td>
                        <td class="pe-doc-label" style="width: 18%;">Placa</td>
                        <td style="width: 32%;"><span t-field="o.l10n_pe_edi_vehicle_id.license_plate"/></td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label">
                            <span t-out="o.l10n_pe_edi_operator_id.l10n_latam_identification_type_id.name or 'Doc.'"/>
                        </td>
                        <td><span t-field="o.l10n_pe_edi_operator_id.vat"/></td>
                        <td class="pe-doc-label">Marca/Modelo</td>
                        <td><span t-field="o.l10n_pe_edi_vehicle_id.name"/></td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label">Licencia</td>
                        <td><span t-field="o.l10n_pe_edi_operator_id.l10n_pe_edi_operator_license"/></td>
                        <td class="pe-doc-label">Categoría M1 o L</td>
                        <td>
                            <t t-if="o.l10n_pe_edi_vehicle_id.is_m1l">Sí</t>
                            <t t-else="">No</t>
                        </td>
                    </tr>
                </table>

                <!-- DETALLE DE LOS BIENES E INFORMACIÓN ADICIONAL: una sola tabla.
                     El QR solo existe cuando el documento ya fue enviado a SUNAT. -->
                <t t-set="grouped_lines" t-value="o._get_grouped_move_lines()"/>
                <t t-set="qr_url" t-value="o._l10n_pe_edi_get_qr()"/>
                <t t-set="qr_url" t-value="qr_url and qr_url.strip()"/>
                <table class="pe-doc-table pe-doc-lines mb-2">
                    <thead>
                        <tr class="pe-doc-thead">
                            <td class="text-center" style="width: 5%;">N.º</td>
                            <td style="width: 11%;">Código</td>
                            <td style="width: 31%;">Descripción</td>
                            <td style="width: 16%;">Series/Lotes</td>
                            <td class="text-center" style="width: 10%;">Unidad</td>
                            <td class="text-end" style="width: 10%;">Cantidad</td>
                            <td class="text-center" style="width: 13%;">Bien normalizado</td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="grouped_lines" t-as="line">
                            <td class="text-center"><span t-out="line_index + 1"/></td>
                            <td><span t-out="line['product'].barcode or line['product'].default_code"/></td>
                            <td><span t-field="line['product'].name"/></td>
                            <td>
                                <t t-if="line['lots']">
                                    <div t-foreach="line['lots']" t-as="lot_name" t-out="lot_name"/>
                                </t>
                                <t t-else="">-</t>
                            </td>
                            <td class="text-center"><span t-field="line['uom'].name"/></td>
                            <td class="text-end"><span t-out="o._l10n_pe_report_quantity(line['quantity'])"/></td>
                            <td class="text-center">No</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="pe-doc-note">
                            <td colspan="7" class="pe-doc-fs-11">
                                <table class="pe-doc-plain">
                                    <tr>
                                        <td>
                                            <strong>Información adicional:</strong><br/>
                                            • Representación impresa de la Guía de Remisión Electrónica Remitente.<br/>
                                            • Este documento ha sido generado electrónicamente y tiene validez legal.<br/>
                                            • Consulte el estado del documento en www.sunat.gob.pe.
                                        </td>
                                        <td t-if="qr_url" class="text-center" style="width: 120px;">
                                            <img alt="QR SUNAT"
                                                 t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=100&amp;height=100' % quote_plus(qr_url)"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <t t-call="al_account_base.report_pe_document_footer">
                <t t-set="company" t-value="o.company_id"/>
            </t>
        </template>

        <record id="action_report_guia_remision" model="ir.actions.report">
            <field name="name">Guía de remisión</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">al_l10n_pe_delivery_guide_report.report_guia_remision_document</field>
            <field name="report_file">al_l10n_pe_delivery_guide_report.report_guia_remision_document</field>
            <field name="print_report_name">'GUIA_REMISION - %s - %s' % (
                object.partner_id.name or '', object.name)</field>
            <field name="paperformat_id" ref="al_l10n_pe_delivery_guide_report.paperformat_guia_remision"/>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>
