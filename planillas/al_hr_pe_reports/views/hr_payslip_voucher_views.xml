<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <!-- Boleta individual: el form nativo SÍ tiene header.
             NO se añade un botón de impresión: el «Imprimir» nativo ya
             saca la boleta PE (ver `_get_pdf_reports`). Aquí solo va el
             envío por correo, que es otra acción. -->
        <record id="view_hr_payslip_form_inherit_voucher" model="ir.ui.view">
            <field name="name">hr.payslip.form.inherit.boleta.pe</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_send_voucher_by_email" type="object"
                            string="Enviar boleta"
                            invisible="state not in ('validated', 'paid')"/>
                </xpath>
            </field>
        </record>

        <!-- Seguimiento del envío en la lista de boletas (port v18). -->
        <record id="view_hr_payslip_tree_inherit_voucher" model="ir.ui.view">
            <field name="name">hr.payslip.list.inherit.boleta.pe</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
            <field name="arch" type="xml">
                <field name="net_wage" position="after">
                    <field name="date_send" optional="hide"/>
                    <field name="is_verified" widget="boolean_toggle"
                           readonly="1" force_save="1" optional="hide"/>
                    <field name="date_confirmation" optional="hide"/>
                </field>
            </field>
        </record>

        <!-- Lote: el form nativo de hr.payslip.run NO tiene header; las
             acciones del lote van al menú del kanban nativo. -->
        <record id="hr_payslip_run_view_kanban_inherit_voucher" model="ir.ui.view">
            <field name="name">hr.payslip.run.kanban.inherit.boleta.pe</field>
            <field name="model">hr.payslip.run</field>
            <field name="inherit_id" ref="hr_payroll.hr_payslip_run_view_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//t[@t-name='menu']" position="inside">
                    <button name="action_print_vouchers" type="object"
                            class="btn btn-secondary"
                            string="Imprimir boletas"
                            invisible="state not in ('02_close', '03_paid')"/>
                    <button name="action_send_vouchers_by_email" type="object"
                            class="btn btn-secondary"
                            string="Enviar boletas por correo"
                            invisible="state not in ('02_close', '03_paid')"/>
                </xpath>
            </field>
        </record>

        <!-- Envío masivo también desde la lista de boletas (menú Acción),
             port del ir.actions.server de v18. -->
        <record id="action_server_send_vouchers" model="ir.actions.server">
            <field name="name">Enviar boletas PE por correo</field>
            <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = records.action_send_voucher_by_email()</field>
        </record>

    </data>
</odoo>
