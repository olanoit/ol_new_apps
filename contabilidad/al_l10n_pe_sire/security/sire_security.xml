<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multicompañía: cada periodo SIRE (y sus líneas) solo es visible
             desde su compañía; con él se lanzan llamadas a SUNAT con las
             credenciales de esa compañía. -->
        <record id="sire_rce_company_rule" model="ir.rule">
            <field name="name">SIRE RCE: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_sire_rce"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="sire_rce_line_company_rule" model="ir.rule">
            <field name="name">SIRE RCE línea: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_sire_rce_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="sire_rvie_company_rule" model="ir.rule">
            <field name="name">SIRE RVIE: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_sire_rvie"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="sire_rvie_line_company_rule" model="ir.rule">
            <field name="name">SIRE RVIE línea: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_sire_rvie_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
