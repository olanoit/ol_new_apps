<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_sire" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sire</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='other_tab_group']" position="inside">
                <group string="SIRE (PE)" name="l10n_pe_sire_group"
                       invisible="move_type not in ('in_invoice', 'in_refund')">
                    <field name="l10n_pe_sire_goods_class"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
