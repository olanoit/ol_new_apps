<odoo>
    <data>
        <!-- Vista de formulario Refinanciamiento -->
        <record model="ir.ui.view" id="_account_refinance_form">
            <field name="name">l10n_pe.letter.refinance.wizard.view.form</field>
            <field name="model">l10n_pe.letter.refinance.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="letter_id" readonly="1"/>
                            <field name="refinance_date"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="create_refinance" string="Confirmar" type="object" class="oe_highlight"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <!-- Acción de ventana Refinanciamiento-->
        <record model="ir.actions.act_window" id="account_refinance_invoice_action">
            <field name="name">Refinanciamiento</field>
            <field name="res_model">l10n_pe.letter.refinance.wizard</field>
            <field name="view_mode">form</field>
            <field name="context">{'default_letter_id': active_id}</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
