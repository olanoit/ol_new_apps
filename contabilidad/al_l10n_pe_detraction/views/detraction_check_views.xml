<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_detraction_check_list" model="ir.ui.view">
        <field name="name">l10n_pe.detraction.check.list</field>
        <field name="model">l10n_pe.detraction.check</field>
        <field name="arch" type="xml">
            <list string="Contrastes con SUNAT" create="false"
                  decoration-warning="pending_count">
                <field name="date"/>
                <field name="name"/>
                <field name="difference_count"/>
                <field name="pending_count"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_detraction_check_form" model="ir.ui.view">
        <field name="name">l10n_pe.detraction.check.form</field>
        <field name="model">l10n_pe.detraction.check</field>
        <field name="arch" type="xml">
            <form string="Contraste con SUNAT" create="false">
                <header>
                    <button name="action_apply" type="object" string="Aplicar marcadas"
                            class="btn-primary" invisible="not pending_count"
                            confirm="¿Aplicar al catálogo los porcentajes y códigos marcados? Los productos vinculados tomarán el porcentaje nuevo."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="source_url" widget="url" readonly="1"/>
                        </group>
                        <group>
                            <field name="difference_count"/>
                            <field name="pending_count"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        SUNAT no publica el porcentaje por código: se obtiene
                        cruzando por nombre sus tablas de modificaciones y
                        tomando la más reciente. Revise cada diferencia en la
                        fuente antes de aplicarla. «Sin porcentaje en SUNAT» y
                        «No figura en SUNAT» son informativos (p. ej. el 027,
                        transporte de bienes, tiene norma propia).
                    </div>
                    <field name="line_ids">
                        <list editable="bottom" create="false" delete="false"
                              decoration-warning="actionable"
                              decoration-muted="status in ('match', 'missing', 'no_rate')"
                              decoration-success="applied">
                            <field name="actionable" column_invisible="1"/>
                            <field name="to_apply" readonly="not actionable" widget="boolean_toggle"/>
                            <field name="code" readonly="1"/>
                            <field name="sunat_name" readonly="1"/>
                            <field name="type_id" readonly="1" optional="show"/>
                            <field name="odoo_percentage" readonly="1"/>
                            <field name="sunat_percentage" readonly="1"/>
                            <field name="sunat_since" readonly="1" optional="show"/>
                            <field name="annex1" readonly="1" optional="hide"/>
                            <field name="status" readonly="1" widget="badge"
                                   decoration-warning="status in ('rate_diff', 'new')"
                                   decoration-success="status == 'match'"/>
                            <field name="applied" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_detraction_check_search" model="ir.ui.view">
        <field name="name">l10n_pe.detraction.check.search</field>
        <field name="model">l10n_pe.detraction.check</field>
        <field name="arch" type="xml">
            <search string="Contrastes con SUNAT">
                <field name="name"/>
                <filter name="pending" string="Con diferencias por aplicar"
                        domain="[('pending_count', '>', 0)]"/>
            </search>
        </field>
    </record>

    <record id="action_detraction_check" model="ir.actions.act_window">
        <field name="name">Contrastes con SUNAT</field>
        <field name="res_model">l10n_pe.detraction.check</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay contrastes</p>
            <p>
                Use «Contrastar con SUNAT» en el catálogo de detracciones. La
                acción planificada lo hace cada mes y avisa si cambian las
                diferencias.
            </p>
        </field>
    </record>

    <!-- Lo llama el botón de la lista del catálogo. -->
    <record id="action_detraction_check_now" model="ir.actions.server">
        <field name="name">Contrastar con SUNAT</field>
        <field name="model_id" ref="model_l10n_pe_detraction_check"/>
        <field name="state">code</field>
        <field name="code">action = model.action_check_now()</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>
</odoo>
