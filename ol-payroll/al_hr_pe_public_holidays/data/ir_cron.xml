<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_apply_yearly_holidays" model="ir.cron">
            <field name="name">Peru Holidays: Yearly Auto Apply</field>
            <field name="model_id" ref="model_pe_public_holiday"/>
            <field name="state">code</field>
            <field name="code">model.cron_apply_yearly_holidays()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">12</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(years=1)).strftime('%Y-01-02 02:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
