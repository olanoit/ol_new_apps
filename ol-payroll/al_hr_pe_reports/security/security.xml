<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Catálogo global-or-own -->
        <record id="l10n_pe_hr_contract_template_company_rule" model="ir.rule">
            <field name="name">Plantillas de contrato: global o de la compañía</field>
            <field name="model_id" ref="model_l10n_pe_hr_contract_template"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Transaccionales: aislamiento estricto -->
        <record id="hr_automate_multipayment_company_rule" model="ir.rule">
            <field name="name">Pago masivo bancario: multicompañía</field>
            <field name="model_id" ref="model_hr_automate_multipayment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="hr_automate_multipayment_line_company_rule" model="ir.rule">
            <field name="name">Línea de pago masivo: multicompañía</field>
            <field name="model_id" ref="model_hr_automate_multipayment_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
