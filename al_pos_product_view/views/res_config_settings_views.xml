<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ajustes fusionados de ambas funcionalidades: vista por defecto
         cuadrícula/lista y el interruptor del filtro por etiquetas, ambos
         añadidos al bloque existente de "Mostrar imágenes de producto". -->
    <record id="res_config_settings_view_form_al_pos_product_view" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.al.pos.product.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='pos_show_product_images']/.." position="after">
                <!-- Conmutador cuadrícula/lista: vista de productos por defecto. -->
                <div class="mt-2">
                    <label for="pos_default_product_view" string="Vista de productos por defecto" class="fw-normal me-1"/>
                    <field name="pos_default_product_view"
                           class="o_light_label"
                           widget="radio"
                           options="{'horizontal': true}"/>
                </div>
                <!-- Interruptor del filtro por etiquetas. -->
                <div class="mt-2">
                    <field name="pos_iface_filter_products_by_tag" class="o_light_label me-1"/>
                    <label for="pos_iface_filter_products_by_tag" string="Filtrar productos por etiqueta" class="fw-normal"/>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
