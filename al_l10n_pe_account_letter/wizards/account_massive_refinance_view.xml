<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_massive_refinance_wizard_form" model="ir.ui.view">
            <field name="name">l10n_pe.letter.refinance.massive.wizard.form</field>
            <field name="model">l10n_pe.letter.refinance.massive.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="journal_id"/>
                                <field name="currency_id"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="refinance_date"/>
                                <field name="total_amount" widget="monetary"/>
                            </group>
                        </group>
                        <field name="letter_ids">
                            <list create="false" delete="false" edit="false">
                                <field name="name"/>
                                <field name="invoice_date"/>
                                <field name="partner_id"/>
                                <field name="rest_amount_currency"
                                       string="Importe pendiente"
                                       widget="monetary"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </sheet>
                    <footer>
                        <button name="action_confirm"
                                string="Refinanciar"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancelar"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="account_massive_refinance_wizard_action" model="ir.actions.act_window">
            <field name="name">Refinanciación masiva de canjes</field>
            <field name="res_model">l10n_pe.letter.refinance.massive.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_l10n_pe_letter"/>
            <field name="binding_view_types">list</field>
        </record>
    </data>
</odoo>
