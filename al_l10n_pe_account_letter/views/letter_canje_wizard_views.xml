<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_letter_canje_wizard_form" model="ir.ui.view">
            <field name="name">l10n_pe.letter.canje.wizard.form</field>
            <field name="model">l10n_pe.letter.canje.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="canje_type"
                               invisible="show_canje_type == False"
                               widget="selection_badge"/>
                        <field name="letter_line_id"
                               domain="[('id','in',letter_line_ids)]"
                               invisible="canje_type != 'one'"
                               required="canje_type == 'one'"
                               options="{'no_create': True,'no_quick_create': True, 'no_open':True, 'no_create_edit': True}"/>
                        <field name="letter_type" widget="selection_badge"/>
                        <field name="min_date"/>
                        <field name="date_canje"/>
                        <field name="bank_id" options="{'no_create': True,'no_quick_create': True, 'no_open':True, 'no_create_edit': True}"/>
                        <field name="code"/>
                        <field name="letter_id" invisible="1"/>
                        <field name="show_canje_type" invisible="1"/>
                        <field name="letter_line_ids" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_canje" string="Confirmar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
