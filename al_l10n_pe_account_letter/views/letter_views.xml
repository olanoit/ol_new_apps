<odoo>
    <data>

        <record id="view_account_letter_search" model="ir.ui.view">
            <field name="name">l10n_pe.letter.search</field>
            <field name="model">l10n_pe.letter</field>
            <field name="arch" type="xml">
                <search string="Buscar letras">
                    <field name="name" string="Nro. canje"/>
                    <field name="partner_id" string="Socio"/>
                    <field name="journal_id" string="Diario"/>
                    <field name="invoice_date" string="Fecha canje"/>
                    <field name="letter_end_date" string="Fec. venc. letra"/>
                    <field name="payment_reference" string="Referencia"/>
                    <field name="state" string="Estado"/>
                    <field name="type_payment" string="Tipo de pago"/>
                    <field name="type" string="Tipo"/>

                    <separator/>

                    <filter name="filter_borrador" string="Borrador" domain="[('state','=','draft')]"/>
                    <filter name="filter_canjeado" string="Canjeado" domain="[('state','=','redeemed')]"/>
                    <filter name="filter_vencidas" string="Vencidas (fec. venc. &lt; hoy)"
                            domain="[('letter_end_date','&lt;',context_today())]"/>
                    <filter name="filter_por_vencer" string="Por vencer (fec. venc. ≥ hoy)"
                            domain="[('letter_end_date','&gt;=',context_today())]"/>

                    <separator/>

                    <filter name="filter_today" string="Canje hoy"
                            domain="[('invoice_date', '=', context_today())]"/>
                    <filter name="filter_old" string="Canjes anteriores (fec. canje &lt; hoy)"
                            domain="[('invoice_date','&lt;',context_today())]"/>
                    <filter name="filter_future" string="Canjes futuros (fec. canje &gt; hoy)"
                            domain="[('invoice_date','&gt;',context_today())]"/>

                    <separator/>

                    <filter name="group_by_socio" string="Socio" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_estado" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_by_tipo" string="Tipo" context="{'group_by': 'type'}"/>
                    <filter name="group_by_fecha_canje" string="Fecha canje"
                            context="{'group_by': 'invoice_date'}"/>
                    <filter name="group_by_fecha_venc" string="Fec. venc. letra"
                            context="{'group_by': 'letter_end_date'}"/>
                </search>
            </field>
        </record>

        <!-- Vista Lista Clientes-->
        <record model="ir.ui.view" id="_account_letter_tree_clientes">
            <field name="name">l10n_pe.letter.view.list.clientes</field>
            <field name="model">l10n_pe.letter</field>
            <field name="arch" type="xml">
                <list>
                    <header>
                        <button name="%(action_account_letter_type_form)d" type="action" string="Método"
                                class="oe_highlight"/>
                        <button name="action_link_account_move_by_ref"
                                type="object"
                                string="Vincular asientos"
                                class="btn btn-primary"
                                icon="fa-link"
                                help="Vincula los asientos contables por referencia para los canjes seleccionados."/>
                    </header>
                    <field name="name"/>
                    <field name="partner_id" string="Socio"/>
                    <field name="glosa"/>
                    <field name="invoice_date"/>
                    <field name="payment_reference"/>
                    <field name="journal_id"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state in ('checked','redeemed')"
                           decoration-success="state == 'banked'"/>
                    <field name="invoice_line_ids" widget="many2many_tags" string="Facturas"/>
                    <field name="related_invoice_names" optional="hide"/>
                    <field name="is_refinance_children" string="Canje refinanciado" optional="hide"/>
                    <field name="refinance_origin_display" string="Canjes de origen" optional="hide"/>
                </list>
            </field>
        </record>
        <!-- Vista Lista Proveedores-->
        <record model="ir.ui.view" id="_account_letter_tree_proveedores">
            <field name="name">l10n_pe.letter.view.list.proveedores</field>
            <field name="model">l10n_pe.letter</field>
            <field name="arch" type="xml">
                <list>
                    <header>
                        <button name="%(action_account_letter_type_form)d" type="action" string="Método"
                                class="oe_highlight"/>
                        <button name="action_link_account_move_by_ref"
                                type="object"
                                string="Vincular asientos"
                                class="btn btn-primary"
                                icon="fa-link"
                                help="Vincula los asientos contables por referencia para los canjes seleccionados."/>
                    </header>
                    <field name="name"/>
                    <field name="partner_id" string="Socio"/>
                    <field name="glosa"/>
                    <field name="invoice_date"/>
                    <field name="payment_reference"/>
                    <field name="journal_id"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state in ('checked','redeemed')"
                           decoration-success="state == 'banked'"/>
                    <field name="invoice_line_ids" widget="many2many_tags" string="Facturas"/>
                    <field name="related_invoice_names" optional="hide"/>
                    <field name="is_refinance_children" string="Canje refinanciado" optional="hide"/>
                    <field name="refinance_origin_display" string="Canjes de origen" optional="hide"/>
                </list>
            </field>
        </record>
        <!-- Vista Formulario-->
        <record model="ir.ui.view" id="_account_letter_form_clientes">
            <field name="name">l10n_pe.letter.view.form</field>
            <field name="model">l10n_pe.letter</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_checked" string="Confirmar" class="oe_highlight" type="object"
                                invisible="state != 'draft'"/>
                        <button name="action_cancel" string="Cancelar" class="oe_highlight" type="object"
                                invisible="state != 'draft'"/>
                        <button name="action_redeemed" string="Canjear" class="oe_highlight" type="object"
                                invisible="state != 'checked'"/>
                        <button name="action_canje" string="Canje" class="oe_highlight" type="object"
                                invisible="is_all_paid == True or state != 'redeemed' or canje_move_id != False"/>
                        <button name="action_link_account_move_by_ref" string="Vincular asiento" type="object"
                                class="btn btn-primary oe_highlight"
                                icon="fa-link"
                                invisible="state != 'redeemed' or account_id != False"/>

                        <button name="action_draft" string="Restablecer a borrador" type="object"
                                invisible="state == 'draft'"/>
                        <button name="%(account_refinance_invoice_action)d" type="action" string="Refinanciar"
                                class="oe_highlight"
                                invisible="is_all_paid == True"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_related_invoices"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-pencil-square-o"
                                    invisible="related_invoice_count == 0">
                                <field name="related_invoice_count" widget="statinfo" string="Facturas"/>
                            </button>
                            <button name="action_open_related_payments"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-pencil-square-o"
                                    invisible="related_payment_count == 0">
                                <field name="related_payment_count" widget="statinfo" string="Pagos"/>
                            </button>
                            <button name="action_link_account_move_by_ref"
                                    type="object"
                                    class="oe_stat_button bg-primary text-white"
                                    icon="fa-link"
                                    invisible="state != 'redeemed' or account_id != False">
                                <div class="o_form_field o_stat_info">
                                    <span class="o_stat_text">Vincular asiento</span>
                                    <span class="o_stat_value">Por referencia</span>
                                </div>
                            </button>
                            <button name="action_open_account_move"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-book"
                                    invisible="not account_id">
                                <div class="o_form_field o_stat_info">
                                    <span class="o_stat_text">Asiento</span>
                                    <field name="account_id" nolabel="1" readonly="1"/>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <span class="o_form_label">Nro.canje</span>
                            <h1>
                                <field name="name" placeholder="Draft"/>
                            </h1>
                        </div>
                        <group>
                            <group id="header_left_group">
                                <label for="partner_id" string="Cliente" style="font-weight:bold;"
                                       invisible="type != 'out_invoice'"/>
                                <label for="partner_id" string="Proveedor" style="font-weight:bold;"
                                       invisible="type != 'in_invoice'"/>
                                <field name="partner_id" nolabel="1" readonly="state != 'draft'"/>
                                <field name="domain_letter_ids" invisible="1"/>
                                <field name="journal_id" domain="[('id','in', domain_letter_ids)]"
                                       options="{'no_create': True, 'no_open': True , 'no_create_edit': True}"
                                       readonly="state != 'draft'"/>
                                <field name="exchange_rate"/>
                                <field name="refinance_id" invisible="is_refinance_parent != True"
                                       readonly="1"/>
                                <field name="inverse_id"
                                       invisible="is_refinance_children != True or refinance_origin_ids != False"
                                       readonly="1"/>
                                <field name="refinance_origin_ids" widget="many2many_tags"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': False}"
                                       invisible="is_refinance_children != True or refinance_origin_ids == False"
                                       readonly="1"/>
                                <field name="is_refinance_parent" invisible="1"/>
                                <field name="is_refinance_children" invisible="1"/>
                            </group>
                            <group id="header_right_group">
                                <label for="invoice_date" string="Fecha canje" style="font-weight:bold;"/>
                                <field name="invoice_date" nolabel="1"/>
                                <field name="payment_reference" readonly="state != 'draft'"/>
                                <field name="glosa" readonly="state != 'draft'"/>
                                <field name="currency_id"/>
                                <field name="canje_move_id"
                                       invisible="state != 'redeemed' or canje_move_id == False"/>
                                <field name="canje_move_ids" widget="many2many_tags"
                                       invisible="state != 'redeemed' or canje_move_ids == []"/>
                                <field name="is_all_paid" invisible="1"/>
                                <field name="payment_ids" widget="many2many_tags" string="Pagos" invisible="1"/>
                                <field name="type" invisible="1"/>
                                <field name="is_massive_letter" invisible="1"/>
                                <field name="confirmed_reference" invisible="1"/>
                                <field name="account_id" invisible="1"/>
                                <field name="company_currency_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page id="invoice_tab" name="invoice_tab" string="Facturas">
                                <field name="invoice_line_ids"
                                       readonly="state in ('redeemed','banked')">
                                    <list editable="bottom">
                                        <field name="domain_move_line_id" invisible="1"/>
                                        <field name="document_type_id"/>
                                        <field name="date_em"/>
                                        <field name="move_line_id"
                                               options="{'no_create': True, 'no_open': True , 'no_create_edit': True}"
                                               domain="[('id','in', domain_move_line_id)]"/>
                                        <field name="partner_id" optional="hide"/>
                                        <field name="move_id" optional="hide"/>
                                        <field name="move_invoice_type" column_invisible="1"/>
                                        <field name="invoice_name"/>
                                        <field name="account_id"/>
                                        <field name="currency_id"/>
                                        <field name="balance"/>
                                        <field name="amount_currency"/>
                                        <field name="imp_div" sum="Importe total"/>
                                        <field name="debit" sum="Débito total"/>
                                        <field name="credit" sum="Crédito total"/>
                                        <field name="letter_id" string="Nro. canje" optional="hide" readonly="1"/>
                                        <field name="company_currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page id="letter_tab" name="letter_tab" string="Letras">
                                <group>
                                    <group id="header_left_group">
                                        <field name="number_letter"
                                               readonly="state in ('redeemed','banked')"/>
                                        <field name="letter_end_date"
                                               readonly="state in ('redeemed','banked')"/>
                                        <field name="range_date"
                                               readonly="state in ('redeemed','banked')"/>
                                    </group>
                                    <group id="header_right_group">
                                        <field name="type_payment"
                                               readonly="state in ('redeemed','banked')"/>
                                        <field name="partial_amount"
                                               invisible="type_payment != 'partial'"/>
                                        <field name="rest_amount"/>
                                        <field name="rest_amount_currency" readonly="1"/>
                                    </group>
                                </group>
                                <button name="create_letters"
                                        invisible="state in ('redeemed','banked')"
                                        string="Crear letras" type="object" class="oe_highlight"/>
                                <field name="letter_line_ids"
                                       readonly="state in ('redeemed','banked')"
                                       create="state not in ('redeemed','banked')"
                                       delete="state not in ('redeemed','banked')">
                                    <list editable="bottom">
                                        <field name="letter_user_id"/>
                                        <field name="nro_letter"/>
                                        <field name="currency_id"/>
                                        <field name="company_currency_id" column_invisible="1"/>
                                        <field name="bank_id"
                                               options="{'no_create': True, 'no_open': True , 'no_create_edit': True}"
                                               readonly="state == 'draft' or state == 'checked'"/>
                                        <field name="code"
                                               readonly="state == 'draft' or state == 'checked'"/>
                                        <field name="letter_type"
                                               readonly="state == 'draft' or state == 'checked'"/>
                                        <field name="account_id" readonly="state in ('redeemed','banked')"/>
                                        <field name="expiration_date" readonly="state in ('redeemed','banked')"/>
                                        <field name="imp_div" sum="Importe total" readonly="state in ('redeemed','banked')"/>
                                        <field name="adeudado" sum="Adeudado total" optional="show"
                                               readonly="state in ('redeemed','banked')"/>
                                        <field name="debit" sum="Débito total" readonly="state in ('redeemed','banked')"/>
                                        <field name="credit" sum="Crédito total" readonly="state in ('redeemed','banked')"/>
                                        <field name="payment_state" widget="badge"
                                               decoration-danger="payment_state == 'pending'"
                                               decoration-warning="payment_state =='partial'"
                                               decoration-success="payment_state == 'paid'"/>
                                        <field name="letter_id" optional="hide" readonly="1"/>
                                        <field name="state" column_invisible="1"/>
                                        <field name="exchange_rate" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                            <page id="letter_residual" name="letter_residual" string="Redondeos"
                                  invisible="not letter_residual_ids">
                                <field name="letter_residual_ids" readonly="1">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="account_id"/>
                                        <field name="amount" optional="show"/>
                                        <field name="amount_currency" optional="hide"/>
                                        <field name="debit"/>
                                        <field name="credit"/>
                                        <field name="company_currency_id" column_invisible="1"/>
                                        <field name="currency_id" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                            <page id="move_line" name="move_line" string="Apuntes contables"
                                  invisible="not account_id">
                                <field name="account_move_line_ids" readonly="1">
                                    <list editable="bottom">
                                        <field name="account_id"/>
                                        <field name="l10n_pe_letter_line_id"/>
                                        <field name="name"/>
                                        <field name="analytic_distribution"/>
                                        <field name="date"/>
                                        <field name="amount_currency"/>
                                        <field name="debit" sum="Débito total" string="Debe"/>
                                        <field name="credit" sum="Crédito total" string="Haber"/>
                                        <field name="currency_id" optional="hide"/>
                                        <field name="company_id" column_invisible="1"/>
                                        <field name="company_currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <!-- Acción de ventana Cliente-->
        <record model="ir.actions.act_window" id="account_letter_action_clientes">
            <field name="name">Canje de letras</field>
            <field name="res_model">l10n_pe.letter</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="_account_letter_tree_clientes"/>
            <field name="domain">[('type', '=', 'out_invoice'), ('is_massive_letter', '=', False)]</field>
            <field name="context">{'default_type': 'out_invoice'}</field>
        </record>
        <!-- Acción de ventana Proveedores-->
        <record model="ir.actions.act_window" id="account_letter_action_proveedores">
            <field name="name">Canje de letras</field>
            <field name="res_model">l10n_pe.letter</field>
            <field name="view_id" ref="_account_letter_tree_proveedores"/>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type', '=', 'in_invoice'), ('is_massive_letter', '=', False)]</field>
            <field name="context">{'default_type': 'in_invoice'}</field>
        </record>
        <!-- Acción de ventana Historial de canje Masivo Cliente-->
        <record model="ir.actions.act_window" id="account_letter_action_historial_clientes">
            <field name="name">Historia de canje</field>
            <field name="res_model">l10n_pe.letter</field>
            <field name="view_id" ref="_account_letter_tree_clientes"/>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type', '=', 'out_invoice'), ('is_massive_letter', '=', True)]</field>
            <field name="context">{'default_type': 'out_invoice'}</field>
        </record>
        <!-- Acción de ventana Historial de canje Masivo Proveedor-->
        <record model="ir.actions.act_window" id="account_letter_action_massive_proveedores">
            <field name="name">Historia de canje</field>
            <field name="res_model">l10n_pe.letter</field>
            <field name="view_id" ref="_account_letter_tree_proveedores"/>
            <field name="view_mode">list</field>
            <field name="domain">[('type', '=', 'in_invoice'), ('is_massive_letter', '=', True)]</field>
            <field name="context">{'default_type': 'in_invoice'}</field>
        </record>

        <record id="account_letter_rule_company" model="ir.rule">
            <field name="name">Letra de cambio multi-company</field>
            <field name="model_id" ref="model_l10n_pe_letter"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="view_account_letter_link_summary" model="ir.ui.view">
            <field name="name">l10n_pe.letter.link.summary.form</field>
            <field name="model">l10n_pe.letter.link.summary</field>
            <field name="arch" type="xml">
                <form string="Resumen de vinculación">
                    <sheet>
                        <group>
                            <field name="summary" nolabel="1" readonly="1" widget="text"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_close" type="object" string="Cerrar y recargar" class="btn-primary"/>
                        <button string="Cerrar" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
