<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================================================
         Plantillas de contrato de trabajo (l10n_pe.hr.contract.template)
         + extensión del form de empleado (pestaña Nómina) para elegir
         plantilla, régimen de prueba e imprimir el contrato.
         ============================================================= -->

    <record id="l10n_pe_hr_contract_template_view_form" model="ir.ui.view">
        <field name="name">l10n_pe.hr.contract.template.form</field>
        <field name="model">l10n_pe.hr.contract.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de contrato">
                <sheet>
                    <widget name="web_ribbon" title="Archivado"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Placeholders disponibles (se escriben
                        <code>{{nombre}}</code>):
                        <strong>empresa</strong> — nombre_empleador,
                        ruc_empleador, direccion_empleador, distrito,
                        provincia, departamento, cargo_RL, apoderado,
                        dni_apoderado;
                        <strong>trabajador</strong> — nombre_trabajador,
                        estado_civil_trabajador, sexo_trabajador,
                        td_trabajador, dni_trabajador,
                        nacionalidad_trabajador, direccion_trabajador;
                        <strong>puesto</strong> — titulo_trabajo, area,
                        funciones_empleado;
                        <strong>remuneración</strong> — salario,
                        salario_letras, moneda;
                        <strong>duración</strong> — meses, fecha_inicio,
                        fecha_fin, fecha_prueba_fin;
                        <strong>otros</strong> — horas_jornada,
                        lugar_contrato, fecha_firma.
                    </div>
                    <field name="body" widget="html" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_pe_hr_contract_template_view_list" model="ir.ui.view">
        <field name="name">l10n_pe.hr.contract.template.list</field>
        <field name="model">l10n_pe.hr.contract.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas de contrato">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="show"/>
            </list>
        </field>
    </record>

    <record id="l10n_pe_hr_contract_template_view_search" model="ir.ui.view">
        <field name="name">l10n_pe.hr.contract.template.search</field>
        <field name="model">l10n_pe.hr.contract.template</field>
        <field name="arch" type="xml">
            <search string="Plantillas de contrato">
                <field name="name"/>
                <field name="company_id"/>
                <filter string="Archivadas" name="inactive"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="l10n_pe_hr_contract_template_action"
            model="ir.actions.act_window">
        <field name="name">Plantillas de contrato</field>
        <field name="res_model">l10n_pe.hr.contract.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea aquí tu primera plantilla de contrato de trabajo
            </p>
            <p>
                El texto admite placeholders {{nombre_trabajador}},
                {{salario_letras}}, {{fecha_inicio}}… que se rellenan con
                los datos del empleado al imprimir.
            </p>
        </field>
    </record>

    <!-- Configuración Perú: Nómina → Configuración → Perú -->
    <menuitem id="menu_l10n_pe_hr_contract_template"
        name="Plantillas de contrato"
        parent="al_hr_pe.menu_hr_pe_cfg_documents"
        action="l10n_pe_hr_contract_template_action"
        sequence="10"/>

    <!-- Empleado → pestaña Nómina: plantilla, período de prueba PE e
         impresión del contrato de la versión vigente. -->
    <record id="hr_employee_view_form_inherit_pe_contract" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.al.hr.pe.reports</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <page name="payroll_information" position="inside">
                <group string="Perú — Contrato de trabajo"
                       name="l10n_pe_contract">
                    <group>
                        <field name="l10n_pe_contract_template_id"/>
                        <field name="l10n_pe_trial_period_regime"/>
                        <field name="trial_date_end"/>
                    </group>
                    <group>
                        <button name="action_print_pe_contract" type="object"
                                string="Imprimir contrato"
                                icon="fa-print" class="btn-secondary"
                                colspan="2"/>
                    </group>
                </group>
            </page>
        </field>
    </record>

</odoo>
