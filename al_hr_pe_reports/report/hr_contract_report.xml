<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================================================
         Contrato de trabajo desde plantilla (docs = hr.version).
         El cuerpo lo renderiza l10n_pe.hr.contract.template._render_body
         (sustitución por diccionario controlado, sin eval); t-out con
         Markup lo inserta sin re-escapar. Div raíz .article obligatorio
         + reset anti-bordes fantasma (gotchas QWeb-PDF v19).
         ============================================================= -->

    <template id="report_contract">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="article pe-contract"
                     t-att-data-oe-model="doc and doc._name"
                     t-att-data-oe-id="doc and doc.id"
                     t-att-data-oe-lang="doc and doc.env.context.get('lang')"
                     t-att-style="'page-break-after: always;' if not doc_last else ''">
                    <style>
                        .pe-contract { font-size: 12px; color: #000; }
                        .pe-contract table, .pe-contract td,
                        .pe-contract th { border: none; }
                        .pe-contract .pe-header { width: 100%;
                            border-collapse: collapse; margin-bottom: 6px; }
                        .pe-contract .pe-header td { padding: 0 4px;
                            vertical-align: middle; }
                        .pe-contract .pe-header img { max-height: 80px;
                            max-width: 160px; }
                        .pe-contract .pe-header-rule { border-bottom: 2px solid #000;
                            margin-bottom: 18px; }
                        .pe-contract .pe-company-name { font-weight: bold;
                            font-size: 14px; }
                        .pe-contract .pe-company-info { font-size: 11px; }
                        .pe-contract .pe-body p { text-align: justify; }
                    </style>

                    <table class="pe-header">
                        <tr>
                            <td style="width: 25%;">
                                <img t-if="doc.company_id.logo"
                                     t-att-src="image_data_uri(doc.company_id.logo)"
                                     alt="Logo"/>
                            </td>
                            <td style="width: 75%;">
                                <div class="pe-company-name">
                                    <span t-field="doc.company_id.name"/>
                                </div>
                                <div class="pe-company-info">
                                    <span t-field="doc.company_id.street"/><br/>
                                    RUC: <span t-field="doc.company_id.vat"/>
                                </div>
                            </td>
                        </tr>
                    </table>
                    <div class="pe-header-rule"/>

                    <div class="pe-body"
                         t-out="doc.l10n_pe_contract_template_id._render_body(doc)"/>
                </div>
            </t>
        </t>
    </template>

    <record id="paperformat_contract" model="report.paperformat">
        <field name="name">Contrato de trabajo (A4)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">18</field>
        <field name="margin_right">18</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_contract" model="ir.actions.report">
        <field name="name">Contrato de trabajo</field>
        <field name="model">hr.version</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_hr_pe_reports.report_contract</field>
        <field name="report_file">al_hr_pe_reports.report_contract</field>
        <field name="print_report_name">'Contrato - %s' % (object.employee_id.name)</field>
        <field name="paperformat_id" ref="paperformat_contract"/>
        <field name="binding_model_id" ref="hr.model_hr_version"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
