<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="paperformat_boleta_pago" model="report.paperformat">
            <field name="name">Boleta de pago: A4 vertical</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">8</field>
            <field name="margin_bottom">8</field>
            <field name="margin_left">8</field>
            <field name="margin_right">8</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- Patrón estándar: template contenedor + template _page por
             registro (mismo esquema que la guía de remisión del proyecto).
             El estilo va inline en <style> (B/N, tipografía compacta) con
             prefijo .bpe- propio; incluye el reset anti-bordes fantasma de
             wkhtmltopdf+BS5 y tablas en rejilla clásica collapse/1px.

             El nombre lleva «l10n_pe» a propósito: el dominio nativo de
             `hr.payroll.structure.report_id` solo ofrece plantillas cuyo
             report_name contiene l10n_<código de país>, y `_get_pdf_reports`
             usa el mismo criterio para no pisar otra plantilla peruana. -->
        <template id="report_l10n_pe_boleta_pago_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="al_hr_pe_reports.report_l10n_pe_boleta_pago_page"/>
                </t>
            </t>
        </template>

        <template id="report_l10n_pe_boleta_pago_page">
            <!-- La clase "article" es obligatoria: _prepare_html() solo
                 envuelve en web.minimal_layout (charset UTF-8 + CSS) los
                 divs .article; sin ella el PDF sale sin estilos y con
                 mojibake.
                 El salto de página va por estilo condicional y no en la
                 clase: `page-break-after: always` en el último documento
                 deja una página en blanco al final del PDF. -->
            <div class="article bpe-a4"
                 t-att-style="'page-break-after: always;' if not o_last else ''"
                 t-att-data-oe-model="o and o._name"
                 t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <style>
                    .bpe-a4 {
                        font-family: 'Arial', 'Helvetica', sans-serif;
                        font-size: 10px;
                        line-height: 1.5;
                        color: #000;
                        max-width: 21cm;
                        margin: 0 auto;
                    }
                    .bpe-a4 table {
                        border-collapse: collapse;
                        width: 100%;
                    }
                    /* Reset anti-bordes fantasma: BS5 deja tr/td/th con
                       border-style solid y width 0 y el WebKit de
                       wkhtmltopdf pinta hairlines con eso. Cada bloque
                       redeclara sus bordes debajo. */
                    .bpe-a4 table, .bpe-a4 thead, .bpe-a4 tbody,
                    .bpe-a4 tfoot, .bpe-a4 tr, .bpe-a4 td, .bpe-a4 th {
                        border: none;
                    }
                    .bpe-a4 td, .bpe-a4 th { padding: 3.5px 6px; }

                    /* --- Encabezado --- */
                    .bpe-header td { vertical-align: top; }
                    .bpe-header-logo { width: 18%; }
                    .bpe-header-logo img { max-width: 120px; max-height: 55px; }
                    .bpe-header-company { width: 54%; }
                    .bpe-company-name { font-weight: bold; font-size: 11px; }
                    .bpe-doc-box {
                        width: 28%;
                        border: 1px solid #000;
                        text-align: center;
                        vertical-align: middle;
                        padding: 4px;
                    }
                    .bpe-doc-box .bpe-doc-ruc { font-weight: bold; font-size: 10.5px; }
                    .bpe-doc-box .bpe-doc-periodo { font-size: 9.5px; }
                    .bpe-title {
                        text-align: center;
                        font-size: 12.5px;
                        font-weight: bold;
                        letter-spacing: 1px;
                        margin: 4px 0 1px 0;
                    }
                    .bpe-subtitle {
                        text-align: center;
                        font-size: 8.5px;
                        margin-bottom: 4px;
                    }

                    /* --- Bloques numerados --- */
                    .bpe-block { margin-top: 9px; }
                    .bpe-block-title {
                        background-color: #e8e8e8;
                        border: 1px solid #000;
                        border-bottom: none;
                        font-weight: bold;
                        text-transform: uppercase;
                        font-size: 9px;
                        letter-spacing: 0.5px;
                        padding: 3.5px 6px;
                    }

                    /* Rejilla clásica: collapse + 1px negro, sin radius
                       (wkhtmltopdf pinta contornos difusos con radius). */
                    .bpe-grid td, .bpe-grid th { border: 1px solid #000; }
                    .bpe-grid th, .bpe-th {
                        background-color: #f5f5f5;
                        font-weight: bold;
                        text-align: center;
                        text-transform: uppercase;
                        font-size: 9px;
                    }
                    .bpe-label {
                        font-weight: bold;
                        white-space: nowrap;
                        background-color: #fafafa;
                        width: 12%;
                    }
                    .bpe-num { text-align: right; white-space: nowrap; }
                    .bpe-center { text-align: center; }

                    /* --- Conceptos: tres bloques independientes --- */
                    .bpe-concepts { table-layout: fixed; }
                    .bpe-concepts > tbody > tr > td {
                        vertical-align: top;
                        padding: 0;
                        width: 33.33%;
                    }
                    .bpe-concepts > tbody > tr > td + td { padding-left: 4px; }
                    /* fixed: sin él cada bloque autoajusta sus columnas al
                       texto que le tocó y los tres cuadros salen con
                       anchos distintos. */
                    /* Sin fila de relleno: rellenar hasta una altura común
                       dibujaba un renglón vacío de más. Los totales ya
                       quedan alineados porque van en otra fila de la tabla
                       exterior, así que los cuadros pueden cerrar cada uno
                       donde termina su último concepto. */
                    .bpe-concepts table { table-layout: fixed; }
                    .bpe-concepts td { word-wrap: break-word; }
                    /* Separación fija entre el cuadro de conceptos y su
                       total: sin ella, en la columna cuyo cuadro llega
                       justo hasta el total, el borde inferior del uno y
                       el superior del otro se tocan y se ven como una
                       línea doble (no colapsan: son tablas distintas). */
                    .bpe-concepts > tbody > tr + tr > td { padding-top: 4px; }
                    .bpe-total-row td {
                        font-weight: bold;
                        background-color: #f5f5f5;
                    }
                    .bpe-empty-row td { color: #fff; }

                    /* --- Neto --- */
                    .bpe-net td {
                        border: 1px solid #000;
                        font-weight: bold;
                        padding: 4px 6px;
                    }
                    .bpe-net .bpe-net-amount {
                        width: 32%;
                        text-align: right;
                        font-size: 11.5px;
                        background-color: #f5f5f5;
                    }

                    /* --- Firmas --- */
                    .bpe-firmas { margin-top: 34px; }
                    .bpe-firmas td {
                        width: 50%;
                        text-align: center;
                        /* top + hueco de firma de altura fija: con
                           `bottom` las dos rayas quedaban a distinta altura
                           porque los bloques no tienen el mismo número de
                           líneas debajo. */
                        vertical-align: top;
                        padding: 0 26px;
                    }
                    .bpe-firma-img {
                        height: 58px;
                        line-height: 58px;
                    }
                    .bpe-firma-img img { max-height: 56px; vertical-align: bottom; }
                    .bpe-firma-line {
                        border-top: 1px solid #000;
                        padding-top: 4px;
                        font-size: 9px;
                    }
                    .bpe-firma-line .bpe-firma-name { font-weight: bold; }
                    .bpe-footer-note {
                        margin-top: 14px;
                        font-size: 8px;
                    }
                </style>

                <t t-set="d" t-value="o._get_voucher_report_data()"/>
                <t t-set="v" t-value="o.version_id"/>
                <t t-set="emp" t-value="o.employee_id"/>

                <!-- ============ ENCABEZADO ============ -->
                <table class="bpe-header">
                    <tr>
                        <td class="bpe-header-logo">
                            <img t-if="o.company_id.logo"
                                 t-att-src="image_data_uri(o.company_id.logo)"
                                 alt="Logo"/>
                        </td>
                        <td class="bpe-header-company">
                            <div class="bpe-company-name">
                                <span t-field="o.company_id.name"/>
                            </div>
                            <div t-if="o.company_id.street">
                                <span t-field="o.company_id.street"/>
                                <t t-if="o.company_id.city">
                                    - <span t-field="o.company_id.city"/>
                                </t>
                            </div>
                            <div t-if="o.company_id.phone or o.company_id.email">
                                <span t-if="o.company_id.phone" t-field="o.company_id.phone"/>
                                <span t-if="o.company_id.phone and o.company_id.email"> · </span>
                                <span t-if="o.company_id.email" t-field="o.company_id.email"/>
                            </div>
                        </td>
                        <td class="bpe-doc-box">
                            <div class="bpe-doc-ruc">RUC: <span t-field="o.company_id.vat"/></div>
                            <div>BOLETA DE PAGO</div>
                            <div class="bpe-doc-periodo">
                                <span t-field="o.date_from" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                al
                                <span t-field="o.date_to" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                            </div>
                        </td>
                    </tr>
                </table>

                <div class="bpe-title">BOLETA DE PAGO DE REMUNERACIONES</div>
                <div class="bpe-subtitle">
                    D.S. N° 001-98-TR
                    <t t-if="o.payslip_run_id"> · Planilla: <span t-esc="o.payslip_run_id.name"/></t>
                </div>

                <!-- ============ 1. TRABAJADOR ============ -->
                <div class="bpe-block">
                    <div class="bpe-block-title">1. Datos del trabajador</div>
                    <table class="bpe-grid">
                        <tr>
                            <td class="bpe-label">Trabajador</td>
                            <td colspan="3"><span t-esc="emp.name"/></td>
                            <td class="bpe-label">
                                <span t-esc="emp.l10n_latam_identification_type_id.name or 'Documento'"/>
                            </td>
                            <td><span t-esc="emp.identification_id"/></td>
                        </tr>
                        <tr>
                            <td class="bpe-label">Fecha de ingreso</td>
                            <td>
                                <span t-if="d['fecha_ingreso']" t-esc="d['fecha_ingreso'].strftime('%d/%m/%Y')"/>
                            </td>
                            <td class="bpe-label">Fecha de cese</td>
                            <td>
                                <span t-if="d['fecha_cese']" t-esc="d['fecha_cese'].strftime('%d/%m/%Y')"/>
                            </td>
                            <td class="bpe-label">Situación</td>
                            <td><span t-esc="d['situacion']"/></td>
                        </tr>
                        <tr>
                            <td class="bpe-label">Cargo</td>
                            <td><span t-esc="v.job_id.name or ''"/></td>
                            <td class="bpe-label">Área</td>
                            <td><span t-esc="v.department_id.name or ''"/></td>
                            <td class="bpe-label">Tipo de trabajador</td>
                            <td><span t-esc="v.worker_type_id.name or ''"/></td>
                        </tr>
                        <tr>
                            <td class="bpe-label">Régimen laboral</td>
                            <td><span t-esc="d['regimen_laboral']"/></td>
                            <td class="bpe-label">Régimen de salud</td>
                            <td><span t-esc="d['regimen_salud']"/></td>
                            <td class="bpe-label">Condición</td>
                            <td><span t-esc="d['condicion']"/></td>
                        </tr>
                        <tr>
                            <td class="bpe-label">Régimen pensionario</td>
                            <td><span t-esc="o.membership_id.name or v.membership_id.name or ''"/></td>
                            <td class="bpe-label">CUSPP</td>
                            <td><span t-esc="v.l10n_pe_cuspp or ''"/></td>
                            <td class="bpe-label">Otros empleadores 5ta</td>
                            <td><t t-if="v.l10n_pe_other_employers">Sí</t><t t-else="">No</t></td>
                        </tr>
                        <tr>
                            <td class="bpe-label">Remuneración básica</td>
                            <td class="bpe-num">
                                <!-- v19: wage vive en hr.version (el payslip
                                     ya no tiene campo wage propio) -->
                                <span t-esc="'{:,.2f}'.format(v.wage or 0.0)"/>
                            </td>
                            <td class="bpe-label">Cuenta de abono</td>
                            <td colspan="3"><span t-esc="d['cuenta_abono']"/></td>
                        </tr>
                    </table>
                </div>

                <!-- ============ 2. JORNADA ============ -->
                <div class="bpe-block">
                    <div class="bpe-block-title">2. Días y horas del periodo</div>
                    <table class="bpe-grid">
                        <tr>
                            <th>Días laborados</th>
                            <th>Días no laborados</th>
                            <th>Días subsidiados</th>
                            <th>Días de vacaciones</th>
                            <th>Horas ordinarias</th>
                            <th>Horas sobretiempo</th>
                        </tr>
                        <tr>
                            <td class="bpe-center"><span t-esc="'%g' % d['dias_laborados']"/></td>
                            <td class="bpe-center"><span t-esc="'%g' % d['dias_no_laborados']"/></td>
                            <td class="bpe-center"><span t-esc="'%g' % d['dias_subsidiados']"/></td>
                            <td class="bpe-center"><span t-esc="'%g' % d['dias_vacaciones']"/></td>
                            <td class="bpe-center"><span t-esc="d['horas_ordinarias']"/></td>
                            <td class="bpe-center"><span t-esc="d['horas_sobretiempo']"/></td>
                        </tr>
                    </table>
                    <!-- Sobretiempo por sobretasa (D.S. 007-2002-TR art. 10) -->
                    <table t-if="d['horas_extras']" class="bpe-grid">
                        <tr>
                            <th t-foreach="d['horas_extras']" t-as="he">
                                <span t-esc="he['nombre']"/>
                            </th>
                        </tr>
                        <tr>
                            <td t-foreach="d['horas_extras']" t-as="he"
                                class="bpe-center">
                                <span t-esc="he['horas']"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- ============ 2b. SUSPENSIONES (T21) ============ -->
                <div t-if="d['suspensiones']" class="bpe-block">
                    <div class="bpe-block-title">
                        2.1 Suspensión de labores
                    </div>
                    <table class="bpe-grid">
                        <tr>
                            <th style="width: 12%;">Tipo</th>
                            <th>Motivo</th>
                            <th style="width: 12%;">N° días</th>
                        </tr>
                        <tr t-foreach="d['suspensiones']" t-as="susp">
                            <td class="bpe-center"><span t-esc="susp['codigo']"/></td>
                            <td><span t-esc="susp['motivo']"/></td>
                            <td class="bpe-center"><span t-esc="susp['dias']"/></td>
                        </tr>
                    </table>
                </div>

                <!-- ============ 3. CONCEPTOS ============
                     Tres bloques independientes lado a lado, cada uno con
                     su cabecera propia. Los totales van en una segunda
                     fila de la tabla exterior: así quedan alineados entre
                     columnas sin depender de alturas iguales, que es lo
                     que hacía frágil la rejilla única con zip_longest. -->
                <div class="bpe-block">
                    <div class="bpe-block-title">
                        3. Conceptos remunerativos (código Tabla 22 SUNAT)
                    </div>
                    <table class="bpe-concepts">
                        <tr>
                            <t t-set="columnas" t-value="[
                                ('Ingresos', d['ingresos']),
                                ('Descuentos', d['descuentos']),
                                ('Aportes del empleador', d['aportes_empleador'])]"/>
                            <td t-foreach="columnas" t-as="columna">
                                <table class="bpe-grid">
                                    <!-- Los anchos van en el colgroup: con
                                         `table-layout: fixed` las columnas se
                                         miden por la PRIMERA fila, que aquí es
                                         la cabecera con colspan=3, así que los
                                         anchos puestos en los th se ignoraban y
                                         salían tres columnas iguales. -->
                                    <colgroup>
                                        <col style="width: 15%;"/>
                                        <col style="width: 57%;"/>
                                        <col style="width: 28%;"/>
                                    </colgroup>
                                    <tr>
                                        <th colspan="3"><span t-esc="columna[0]"/></th>
                                    </tr>
                                    <tr>
                                        <th>Cód.</th>
                                        <th>Concepto</th>
                                        <th>S/</th>
                                    </tr>
                                    <tr t-foreach="columna[1]" t-as="linea">
                                        <td class="bpe-center">
                                            <span t-esc="linea['codigo']"/>
                                        </td>
                                        <td><span t-esc="linea['nombre']"/></td>
                                        <td class="bpe-num">
                                            <span t-esc="'{:,.2f}'.format(linea['importe'])"/>
                                        </td>
                                    </tr>
                                    <!-- Sin conceptos la columna quedaría sin
                                         cuerpo y el borde se descuadraría. -->
                                    <tr t-if="not columna[1]" class="bpe-empty-row">
                                        <td colspan="3">—</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <t t-set="totales" t-value="[
                                ('Total ingresos', d['total_ingresos']),
                                ('Total descuentos', d['total_descuentos']),
                                ('Total aportes', d['total_aportes'])]"/>
                            <td t-foreach="totales" t-as="total">
                                <table class="bpe-grid">
                                    <!-- 72/28 = las dos primeras columnas de
                                         arriba más la del importe, para que el
                                         total caiga justo bajo la columna S/. -->
                                    <colgroup>
                                        <col style="width: 72%;"/>
                                        <col style="width: 28%;"/>
                                    </colgroup>
                                    <tr class="bpe-total-row">
                                        <td><span t-esc="total[0]"/> S/</td>
                                        <td class="bpe-num">
                                            <span t-esc="'{:,.2f}'.format(total[1])"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- ============ 4. NETO ============ -->
                <div class="bpe-block">
                    <table class="bpe-net">
                        <tr>
                            <td><span t-esc="d['neto_letras']"/></td>
                            <td class="bpe-net-amount">
                                NETO A PAGAR S/
                                <span t-esc="'{:,.2f}'.format(d['neto'])"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- ============ 5. FIRMAS ============ -->
                <table class="bpe-firmas">
                    <tr>
                        <td>
                            <div class="bpe-firma-img">
                                <img t-if="d['param'].signature"
                                     t-att-src="image_data_uri(d['param'].signature)"
                                     alt="Firma del empleador"/>
                            </div>
                            <div class="bpe-firma-line">
                                <div class="bpe-firma-name"
                                     t-esc="d['param'].reprentante_legal_id.name or o.company_id.name"/>
                                <div t-if="d['param'].reprentante_legal_id.vat">
                                    <span t-esc="d['param'].reprentante_legal_id.l10n_latam_identification_type_id.name or 'Doc.'"/>
                                    N° <span t-esc="d['param'].reprentante_legal_id.vat"/>
                                </div>
                                <div>EMPLEADOR</div>
                            </div>
                        </td>
                        <td>
                            <!-- Mismo hueco de firma que el empleador para
                                 que las dos líneas queden a la misma altura. -->
                            <div class="bpe-firma-img"/>
                            <div class="bpe-firma-line">
                                <div class="bpe-firma-name" t-esc="emp.name"/>
                                <div t-if="emp.identification_id">
                                    <span t-esc="emp.l10n_latam_identification_type_id.name or 'Doc.'"/>
                                    N° <span t-esc="emp.identification_id"/>
                                </div>
                                <div>RECIBÍ CONFORME — TRABAJADOR</div>
                            </div>
                        </td>
                    </tr>
                </table>

                <div class="bpe-footer-note">
                    Boleta de pago emitida conforme al D.S. N° 001-98-TR.
                    El duplicado quedará en poder del trabajador y el
                    original firmado en poder del empleador.
                </div>
            </div>
        </template>

        <!-- Sin `binding_model_id`: la boleta no debe aparecer también en
             el menú «Imprimir». El único camino es el botón nativo
             «Imprimir», que resuelve el reporte por `_get_pdf_reports`. -->
        <record id="action_report_boleta_pago" model="ir.actions.report">
            <field name="name">Boleta de pago (PE)</field>
            <field name="model">hr.payslip</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">al_hr_pe_reports.report_l10n_pe_boleta_pago_document</field>
            <field name="report_file">al_hr_pe_reports.report_l10n_pe_boleta_pago_document</field>
            <field name="print_report_name">'Boleta de pago - %s - %s' % (
                object.employee_id.name or '', object.date_from)</field>
            <field name="paperformat_id" ref="al_hr_pe_reports.paperformat_boleta_pago"/>
            <field name="binding_model_id" eval="False"/>
        </record>

    </data>
</odoo>
