<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_piece_costing" model="ir.ui.view">
        <field name="name">stock.picking.type.form.piece.costing</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='stock_picking_type_lot']" position="after">
                <group string="Costeo por medida" invisible="code != 'mrp_operation'">
                    <field name="piece_costing_default"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
