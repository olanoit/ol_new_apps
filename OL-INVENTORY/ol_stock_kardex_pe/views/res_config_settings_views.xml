<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ol_stock_kardex_pe</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock_account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="valuation_setting_container" position="inside">
                <setting id="l10n_pe_wh_cost_setting"
                         help="Cada almacén lleva su propio costo promedio en el kardex; el cierre de almacén ajusta la contabilidad.">
                    <field name="l10n_pe_wh_cost"/>
                    <div class="content-group" invisible="not l10n_pe_stock_lock_date">
                        <div class="mt8">
                            <label for="l10n_pe_stock_lock_date" class="o_light_label"/>
                            <field name="l10n_pe_stock_lock_date" class="ms-2"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
