<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_kardex">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="header" t-value="o._get_report_header()"/>
                <t t-set="valued" t-value="header['valued']"/>
                <!-- Formato común de los documentos de la suite (al_report_base):
                     el div.article lo pone report_pe_page, con el encabezado
                     (recuadro R.U.C./formato/periodo) y el pie con la numeración. -->
                <t t-set="company" t-value="o.company_id"/>
                <t t-call="al_report_base.report_pe_page"
                    doc_title.f="Inventario permanente"
                    doc_number="'Formato %s' % ('13.1' if valued else '12.1')"
                    doc_extra="'Período %s' % header['period']">
                    <t t-foreach="o._get_report_data()" t-as="scope">
                        <t t-foreach="scope['products']" t-as="block">
                            <div t-attf-class="pe-doc-keep pe-doc-fs-11"
                                 t-attf-style="margin-bottom: 16px;#{' page-break-before: always;' if scope['warehouse'] and block_first and not scope_first else ''}">
                                <div class="text-center mb-1"><strong t-out="header['title']"/></div>
                                <table class="pe-doc-table mb-1">
                                    <tr>
                                        <td class="pe-doc-label" style="width: 11%;">PERÍODO:</td>
                                        <td class="pe-doc-value" style="width: 20%;">
                                            <span t-out="header['date_from']" t-options='{"widget": "date"}'/> -
                                            <span t-out="header['date_to']" t-options='{"widget": "date"}'/>
                                        </td>
                                        <td class="pe-doc-label" style="width: 15%;">CÓDIGO DE LA EXISTENCIA:</td>
                                        <td class="pe-doc-value" style="width: 14%;" t-out="block['code']"/>
                                        <td class="pe-doc-label" style="width: 17%;">TIPO (TABLA 5):</td>
                                        <td class="pe-doc-value" t-out="block['existence_type']"/>
                                    </tr>
                                    <tr>
                                        <td class="pe-doc-label">RUC:</td>
                                        <td class="pe-doc-value" t-out="header['ruc']"/>
                                        <td class="pe-doc-label">DESCRIPCIÓN:</td>
                                        <td class="pe-doc-value" t-out="block['description']"/>
                                        <td class="pe-doc-label">UNIDAD DE MEDIDA (TABLA 6):</td>
                                        <td class="pe-doc-value"><t t-out="block['uom_code']"/> - <t t-out="block['uom_name']"/></td>
                                    </tr>
                                    <tr>
                                        <td class="pe-doc-label">RAZÓN SOCIAL:</td>
                                        <td class="pe-doc-value" t-out="header['company_name']"/>
                                        <td class="pe-doc-label">ESTABLECIMIENTO:</td>
                                        <td class="pe-doc-value" t-att-colspan="1 if valued else 3" t-out="scope['establishment']"/>
                                        <t t-if="valued">
                                            <td class="pe-doc-label">MÉTODO DE VALUACIÓN:</td>
                                            <td class="pe-doc-value" t-out="block['valuation_method']"/>
                                        </t>
                                    </tr>
                                </table>

                                <table class="pe-doc-table pe-doc-lines" style="table-layout: fixed;">
                                    <colgroup>
                                        <col style="width: 7%;"/>
                                        <col style="width: 5%;"/>
                                        <col style="width: 5%;"/>
                                        <col style="width: 9%;"/>
                                        <col style="width: 7%;"/>
                                        <t t-if="valued">
                                            <col t-foreach="9" t-as="c" style="width: 7.44%;"/>
                                        </t>
                                        <t t-else="">
                                            <col style="width: 22.3%;"/>
                                            <col style="width: 22.3%;"/>
                                            <col style="width: 22.4%;"/>
                                        </t>
                                    </colgroup>
                                    <thead>
                                        <tr class="pe-doc-thead text-center">
                                            <td colspan="4">DOCUMENTO DE TRASLADO, COMPROBANTE DE PAGO, DOCUMENTO INTERNO O SIMILAR</td>
                                            <td rowspan="2" class="align-middle">TIPO DE OPERACIÓN (TABLA 12)</td>
                                            <t t-if="valued">
                                                <td colspan="3">ENTRADAS</td>
                                                <td colspan="3">SALIDAS</td>
                                                <td colspan="3">SALDO FINAL</td>
                                            </t>
                                            <t t-else="">
                                                <td>ENTRADAS</td>
                                                <td>SALIDAS</td>
                                                <td>SALDO FINAL</td>
                                            </t>
                                        </tr>
                                        <tr class="pe-doc-thead text-center">
                                            <td>FECHA</td>
                                            <td>TIPO (TABLA 10)</td>
                                            <td>SERIE</td>
                                            <td>NÚMERO</td>
                                            <t t-if="valued">
                                                <t t-foreach="3" t-as="g">
                                                    <td>CANTIDAD</td>
                                                    <td>COSTO UNITARIO</td>
                                                    <td>COSTO TOTAL</td>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <td>CANTIDAD</td>
                                                <td>CANTIDAD</td>
                                                <td>CANTIDAD</td>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="block['lines']" t-as="line">
                                            <td class="text-center">
                                                <span t-out="line.date" t-options='{"widget": "date"}'/>
                                            </td>
                                            <td class="text-center" t-out="line.document_type_code"/>
                                            <td class="text-center"
                                                t-out="line.line_type == 'opening' and '-' or line.serie"/>
                                            <td class="text-center"
                                                t-out="line.line_type == 'opening' and 'SALDO INICIAL' or line.folio"/>
                                            <td class="text-center" t-out="line.operation_type"/>
                                            <t t-if="valued">
                                                <td class="text-end" t-out="'%.2f' % line.qty_in"/>
                                                <td class="text-end" t-out="'%.4f' % line.cost_unit_in"/>
                                                <td class="text-end" t-out="'%.2f' % line.cost_total_in"/>
                                                <td class="text-end" t-out="'%.2f' % line.qty_out"/>
                                                <td class="text-end" t-out="'%.4f' % line.cost_unit_out"/>
                                                <td class="text-end" t-out="'%.2f' % line.cost_total_out"/>
                                                <td class="text-end" t-out="'%.2f' % line.balance_qty"/>
                                                <td class="text-end" t-out="'%.4f' % line.balance_unit_cost"/>
                                                <td class="text-end" t-out="'%.2f' % line.balance_value"/>
                                            </t>
                                            <t t-else="">
                                                <td class="text-end" t-out="'%.2f' % line.qty_in"/>
                                                <td class="text-end" t-out="'%.2f' % line.qty_out"/>
                                                <td class="text-end" t-out="'%.2f' % line.balance_qty"/>
                                            </t>
                                        </tr>
                                    </tbody>
                                    <tfoot t-if="block['total_line']">
                                        <t t-set="total" t-value="block['total_line']"/>
                                        <tr class="pe-doc-total">
                                            <td colspan="5" class="text-center">TOTALES</td>
                                            <t t-if="valued">
                                                <td class="text-end" t-out="'%.2f' % total.qty_in"/>
                                                <td/>
                                                <td class="text-end" t-out="'%.2f' % total.cost_total_in"/>
                                                <td class="text-end" t-out="'%.2f' % total.qty_out"/>
                                                <td/>
                                                <td class="text-end" t-out="'%.2f' % total.cost_total_out"/>
                                                <td class="text-end" t-out="'%.2f' % total.balance_qty"/>
                                                <td class="text-end" t-out="'%.4f' % total.balance_unit_cost"/>
                                                <td class="text-end" t-out="'%.2f' % total.balance_value"/>
                                            </t>
                                            <t t-else="">
                                                <td class="text-end" t-out="'%.2f' % total.qty_in"/>
                                                <td class="text-end" t-out="'%.2f' % total.qty_out"/>
                                                <td class="text-end" t-out="'%.2f' % total.balance_qty"/>
                                            </t>
                                        </tr>
                                    </tfoot>
                                </table>
                                <div class="mt-1" style="color: #595959;">
                                    (1) Dirección del establecimiento o código según el Registro Único de Contribuyentes.
                                    <t t-if="scope['warehouse']"> — Almacén: <t t-out="scope['name']"/></t>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
