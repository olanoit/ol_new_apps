<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_kardex_generate" model="ir.cron">
        <field name="name">Kardex SUNAT: generar reportes pendientes</field>
        <field name="model_id" ref="model_l10n_pe_kardex_report"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_kardex_wh_cost" model="ir.cron">
        <field name="name">Kardex SUNAT: poner al día el costo por almacén</field>
        <field name="model_id" ref="model_l10n_pe_kardex_wh_cost"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
