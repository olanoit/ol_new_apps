<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_consumption_list" model="ir.ui.view">
        <field name="name">stock.move.list.l10n.pe.consumption</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list string="Consumos a costo" create="0" edit="0" delete="0">
                <field name="date" string="Fecha"/>
                <field name="reference" string="Referencia"/>
                <field name="product_id" string="Producto"/>
                <field name="quantity" string="Cantidad"/>
                <field name="uom_id" groups="uom.group_uom"/>
                <field name="location_id" string="Origen" groups="stock.group_stock_multi_locations"/>
                <field name="location_dest_id" string="Destino" groups="stock.group_stock_multi_locations"/>
                <field name="analytic_distribution" widget="analytic_distribution" string="Centro de costo"
                       groups="analytic.group_analytic_accounting"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="value" string="Valor" sum="Total"/>
                <field name="account_move_id" optional="show" string="Asiento"/>
            </list>
        </field>
    </record>

    <record id="action_stock_move_consumption" model="ir.actions.act_window">
        <field name="name">Consumos a costo</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_stock_move_consumption_list"/>
        <field name="domain">[('state', '=', 'done'), '|',
            ('location_dest_id.l10n_pe_is_consumption', '=', True),
            ('location_id.l10n_pe_is_consumption', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay consumos</p>
            <p>Marque una ubicación virtual como «Ubicación de consumo» y traslade productos a ella.</p>
        </field>
    </record>

    <menuitem id="menu_stock_move_consumption" action="action_stock_move_consumption"
              parent="stock.menu_warehouse_report" sequence="60"/>
</odoo>
