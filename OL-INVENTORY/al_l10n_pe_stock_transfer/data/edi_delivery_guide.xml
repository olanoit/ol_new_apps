<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Destinatario y puntos de partida y llegada según el motivo:
         * 04 (entre establecimientos) y los ingresos 02/07/08: el destinatario
           es el propio remitente;
         * en un ingreso la partida es el proveedor (o el puerto) y la llegada
           el almacén de la empresa;
         * cada punto lleva su código de establecimiento (cbc:AddressTypeCode):
           los propios con el RUC de la empresa y su código anexo, los de un
           tercero con RUC con su RUC y 0 (como el estándar). -->
    <template id="sunat_guiaremision_internal" inherit_id="l10n_pe_edi_stock.sunat_guiaremision">
        <xpath expr="//*[local-name()='DeliveryCustomerParty']" position="replace">
            <cac:DeliveryCustomerParty xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
                                       xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
                <cac:Party>
                    <cac:PartyIdentification>
                        <cbc:ID t-att-schemeID="l10n_pe_delivery_customer.l10n_latam_identification_type_id.l10n_pe_vat_code"
                            schemeName="Documento de Identidad"
                            schemeAgencyName="PE:SUNAT"
                            schemeURI="urn:pe:gob:sunat:cpe:see:gem:catalogos:catalogo06"><t t-out='l10n_pe_delivery_customer.vat'/></cbc:ID>
                    </cac:PartyIdentification>
                    <cac:PartyLegalEntity>
                        <cbc:RegistrationName><t t-out='l10n_pe_delivery_customer.commercial_partner_id.name'/></cbc:RegistrationName>
                    </cac:PartyLegalEntity>
                </cac:Party>
            </cac:DeliveryCustomerParty>
        </xpath>
        <xpath expr="//*[local-name()='DeliveryAddress']" position="replace">
            <cac:DeliveryAddress xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
                                 xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
                <cbc:ID schemeName="Ubigeos"
                    schemeAgencyName="PE:INEI"><t t-out="l10n_pe_arrival_address.l10n_pe_district.code"/></cbc:ID>
                <cbc:AddressTypeCode t-if="l10n_pe_arrival_ruc"
                    t-att-listID="l10n_pe_arrival_ruc"
                    listAgencyName="PE:SUNAT"
                    listName="Establecimientos anexos"><t t-out="l10n_pe_arrival_annex"/></cbc:AddressTypeCode>
                <cac:AddressLine>
                    <cbc:Line><t t-out="'%s %s %s %s' % (l10n_pe_arrival_address.street or '', l10n_pe_arrival_address.l10n_pe_district.name or '', l10n_pe_arrival_address.city or '', l10n_pe_arrival_address.state_id.name or '')"/></cbc:Line>
                </cac:AddressLine>
            </cac:DeliveryAddress>
        </xpath>
        <xpath expr="//*[local-name()='DespatchAddress']" position="replace">
            <cac:DespatchAddress xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
                                 xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
                <cbc:ID schemeName="Ubigeos"
                    schemeAgencyName="PE:INEI"><t t-out="warehouse_address.l10n_pe_district.code"/></cbc:ID>
                <cbc:AddressTypeCode t-if="l10n_pe_origin_ruc"
                    t-att-listID="l10n_pe_origin_ruc"
                    listAgencyName="PE:SUNAT"
                    listName="Establecimientos anexos"><t t-out="l10n_pe_origin_annex"/></cbc:AddressTypeCode>
                <cac:AddressLine>
                    <cbc:Line><t t-out="'%s %s %s %s' % (warehouse_address.street or '', warehouse_address.l10n_pe_district.name or '', warehouse_address.city or '', warehouse_address.state_id.name or '')"/></cbc:Line>
                </cac:AddressLine>
            </cac:DespatchAddress>
        </xpath>
    </template>
</odoo>
