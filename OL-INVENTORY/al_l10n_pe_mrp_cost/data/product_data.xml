<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Servicio con que el cierre de costos carga sus importes a las
         órdenes (línea del costo en destino). -->
    <record id="product_production_cost_adjustment" model="product.product">
        <field name="name">Costo de producción (cierre)</field>
        <field name="type">service</field>
        <field name="landed_cost_ok" eval="True"/>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="False"/>
        <field name="list_price">0</field>
    </record>
</odoo>
