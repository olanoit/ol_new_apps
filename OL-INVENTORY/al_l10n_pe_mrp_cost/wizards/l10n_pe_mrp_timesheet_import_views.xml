<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_pe_mrp_timesheet_import_view_form" model="ir.ui.view">
        <field name="name">l10n_pe.mrp.timesheet.import.form</field>
        <field name="model">l10n_pe.mrp.timesheet.import</field>
        <field name="arch" type="xml">
            <form string="Importar tareo">
                <div class="alert alert-info" role="alert">
                    Excel con una fila de títulos y las columnas <b>Orden</b>, <b>Operación</b>,
                    <b>Empleado</b> (DNI, código o nombre), <b>Fecha</b> (dd/mm/aaaa), <b>Inicio</b>
                    (hh:mm, opcional) y <b>Horas</b>. Si una fila tiene un error no se importa ninguna.
                </div>
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_pe_mrp_timesheet_import" model="ir.actions.act_window">
        <field name="name">Importar tareo</field>
        <field name="res_model">l10n_pe.mrp.timesheet.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
