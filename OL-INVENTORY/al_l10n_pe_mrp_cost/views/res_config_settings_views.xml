<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.al_l10n_pe_mrp_cost</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="process_operations_setting_container" position="after">
                <block title="Costeo (Perú)" name="l10n_pe_mrp_cost_setting_container">
                    <setting id="l10n_pe_mrp_labor_account"
                             help="Cuenta que se abona al cargar a las órdenes el ajuste de la mano de obra al costo hora real (71 en el PCGE).">
                        <field name="l10n_pe_mrp_labor_account_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
