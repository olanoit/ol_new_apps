<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_pe_mrp_cost_close_view_list" model="ir.ui.view">
        <field name="name">l10n_pe.mrp.cost.close.list</field>
        <field name="model">l10n_pe.mrp.cost.close</field>
        <field name="arch" type="xml">
            <list string="Cierres de costos">
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="amount_total"/>
                <field name="landed_cost_id"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="l10n_pe_mrp_cost_close_view_form" model="ir.ui.view">
        <field name="name">l10n_pe.mrp.cost.close.form</field>
        <field name="model">l10n_pe.mrp.cost.close</field>
        <field name="arch" type="xml">
            <form string="Cierre de costos">
                <header>
                    <button name="action_compute" string="Calcular" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_validate" string="Validar" type="object"
                            invisible="state != 'draft' or not line_ids"
                            confirm="Se cargarán los importes a las órdenes con un costo en destino y su asiento. ¿Continuar?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not warning">
                        <field name="warning"/>
                    </div>
                    <group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="landed_cost_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="production_id"/>
                            <field name="product_id"/>
                            <field name="element"/>
                            <field name="pool_id"/>
                            <field name="basis"/>
                            <field name="amount" sum="Total"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_l10n_pe_mrp_cost_close" model="ir.actions.act_window">
        <field name="name">Cierres de costos</field>
        <field name="res_model">l10n_pe.mrp.cost.close</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cierre el costo del primer mes</p>
            <p>Ajusta la mano de obra al costo hora real del mes y reparte los CIF entre las
               órdenes terminadas.</p>
        </field>
    </record>
</odoo>
