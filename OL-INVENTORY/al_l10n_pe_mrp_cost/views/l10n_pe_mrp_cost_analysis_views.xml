<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_pe_mrp_cost_analysis_view_pivot" model="ir.ui.view">
        <field name="name">l10n_pe.mrp.cost.analysis.pivot</field>
        <field name="model">l10n_pe.mrp.cost.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Costo por elemento" sample="1">
                <field name="production_id" type="row"/>
                <field name="element" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="l10n_pe_mrp_cost_analysis_view_graph" model="ir.ui.view">
        <field name="name">l10n_pe.mrp.cost.analysis.graph</field>
        <field name="model">l10n_pe.mrp.cost.analysis</field>
        <field name="arch" type="xml">
            <graph string="Costo por elemento" type="bar" stacked="1" sample="1">
                <field name="date" interval="month"/>
                <field name="element"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="l10n_pe_mrp_cost_analysis_view_list" model="ir.ui.view">
        <field name="name">l10n_pe.mrp.cost.analysis.list</field>
        <field name="model">l10n_pe.mrp.cost.analysis</field>
        <field name="arch" type="xml">
            <list string="Costo por elemento">
                <field name="date"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="element"/>
                <field name="workcenter_id"/>
                <field name="pool_id" optional="hide"/>
                <field name="hours" sum="Total"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="l10n_pe_mrp_cost_analysis_view_search" model="ir.ui.view">
        <field name="name">l10n_pe.mrp.cost.analysis.search</field>
        <field name="model">l10n_pe.mrp.cost.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="workcenter_id"/>
                <filter name="date" string="Terminada" date="date"/>
                <group>
                    <filter name="group_element" string="Elemento" context="{'group_by': 'element'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_workcenter" string="Centro de producción" context="{'group_by': 'workcenter_id'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_pe_mrp_cost_analysis" model="ir.actions.act_window">
        <field name="name">Costo por elemento</field>
        <field name="res_model">l10n_pe.mrp.cost.analysis</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>
</odoo>
