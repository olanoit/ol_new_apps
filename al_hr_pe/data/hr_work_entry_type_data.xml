<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Work entry types PE (port de hr_fields v18).
             Campos v18 omitidos por no existir en v19:
             * rate (recargo de horas extra): el % se incorporó como
               literal en las fórmulas HE25/HE35/HE100.
             * struct_ids (filtro por estructura): sin equivalente en
               hr.work.entry.type v19.
             A diferencia de v18 (que pisaba el código del tipo nativo de
             asistencia — no aplica bajo noupdate y afecta a otros países),
             DLAB es un tipo PE propio; la boleta remapea la línea de
             asistencia nativa a DLAB (hr_payslip._get_worked_day_lines). -->
        <record id="wd_DLAB" model="hr.work.entry.type">
            <field name="code">DLAB</field>
            <field name="name">DIAS LABORADOS</field>
            <field name="sequence">1</field>
            <field name="is_leave" eval="False"/>
            <field name="country_id" ref="base.pe"/>
        </record>
        <record id="wd_DOM" model="hr.work.entry.type">
            <field name="code">DOM</field>
            <field name="name">DIAS DE DESCANSO</field>
            <field name="sequence">5</field>
            <field name="color">3</field>
            <field name="is_leave" eval="False"/>
            <field name="round_days">NO</field>
            <field name="country_id" ref="base.pe"/>
        </record>
        <record id="wd_FER" model="hr.work.entry.type">
            <field name="code">FER</field>
            <field name="name">DIAS FERIADO/DESCANSO LABORADO</field>
