<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================================================================
         Organización de «Configuración ▸ Perú»

         Aquí viven **solo los grupos**. Cada menú se cuelga de su grupo
         en el archivo donde está declarado: redefinirlo aquí obligaría a
         repetir su `name` —Odoo reescribe el nombre con el xmlid si se
         omite— y tener el mismo texto en dos sitios acaba divergiendo.

         Se carga antes que el resto para que los grupos existan cuando
         los menús los referencian.

         El problema que resuelve: «Perú» tenía veintitrés entradas
         planas —trece de ellas catálogos T** del T-Registro— y había que
         recorrerlas a ojo para encontrar cualquiera.
         ================================================================== -->
    <data>

        <!-- Menú Perú bajo Nómina ▸ Configuración -->
        <menuitem id="menu_hr_pe_root" name="Perú"
                  parent="hr_work_entry_enterprise.menu_hr_payroll_configuration"
                  sequence="60"/>

        <!-- ===================== GRUPOS ===================== -->

        <menuitem id="menu_hr_pe_cfg_parameters"
                  name="Parámetros"
                  parent="menu_hr_pe_root"
                  sequence="10"/>
        <menuitem id="menu_hr_pe_cfg_periods"
                  name="Periodos y suspensiones"
                  parent="menu_hr_pe_root"
                  sequence="20"/>
        <menuitem id="menu_hr_pe_cfg_social"
                  name="Seguridad social"
                  parent="menu_hr_pe_root"
                  sequence="30"/>
        <menuitem id="menu_hr_pe_cfg_dependents"
                  name="Derechohabientes"
                  parent="menu_hr_pe_root"
                  sequence="40"/>
        <!-- Las trece tablas del T-Registro juntas: se consultan poco y
             siempre por su número. -->
        <menuitem id="menu_hr_pe_cfg_catalogs"
                  name="Catálogos SUNAT"
                  parent="menu_hr_pe_root"
                  sequence="50"/>
        <!-- 60 queda para «Construcción civil», que ya era un grupo y se
             coloca desde su propio módulo. -->
        <menuitem id="menu_hr_pe_cfg_documents"
                  name="Documentos"
                  parent="menu_hr_pe_root"
                  sequence="70"/>

    </data>
</odoo>
