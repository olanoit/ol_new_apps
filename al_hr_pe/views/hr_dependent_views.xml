<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_pe_dependent_list" model="ir.ui.view">
        <field name="name">l10n_pe.hr.dependent.list</field>
        <field name="model">l10n_pe.hr.dependent</field>
        <field name="arch" type="xml">
            <list string="Derechohabientes"
                  decoration-muted="state == 'ended'"
                  decoration-info="state == 'draft'">
                <header>
                    <button name="action_export_tregistro_xlsx" type="object"
                            string="Exportar para el T-Registro"
                            class="btn-primary"/>
                </header>
                <field name="employee_id"/>
                <field name="type_id"/>
                <field name="name"/>
                <field name="identification_id"/>
                <field name="birthday" optional="show"/>
                <field name="age" optional="show"/>
                <field name="is_studying" optional="hide"
                       widget="boolean_toggle"/>
                <field name="gives_family_allowance" widget="boolean_toggle"
                       optional="show"/>
                <field name="date_start"/>
                <field name="date_end" optional="show"/>
                <field name="is_declared" widget="boolean_toggle"
                       optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'current'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_pe_dependent_form" model="ir.ui.view">
        <field name="name">l10n_pe.hr.dependent.form</field>
        <field name="model">l10n_pe.hr.dependent</field>
        <field name="arch" type="xml">
            <form string="Derechohabiente">
                <header>
                    <button name="action_set_end" type="object"
                            string="Dar de baja"
                            invisible="date_end"
                            confirm="Se marcará el fin del vínculo con la fecha de hoy. ¿Continuar?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,current,ended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"
                                   placeholder="Se arma con los apellidos y nombres"/></h1>
                    </div>
                    <group>
                        <group name="link" string="Vínculo">
                            <field name="employee_id"
                                   options="{'no_create': True}"/>
                            <field name="company_id" invisible="1"/>
                            <field name="type_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="is_child" invisible="1"/>
                            <field name="is_unborn" invisible="1"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="end_reason_id"
                                   invisible="not date_end"
                                   required="date_end"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group name="identity" string="Identificación">
                            <field name="last_name"/>
                            <field name="m_last_name"/>
                            <field name="names"/>
                            <field name="l10n_latam_identification_type_id"
                                   options="{'no_create': True}"
                                   required="not is_unborn"/>
                            <field name="identification_id"
                                   required="not is_unborn"/>
                            <field name="country_id"
                                   options="{'no_create': True}"/>
                            <field name="birthday" required="not is_unborn"/>
                            <field name="age" invisible="not birthday"/>
                            <field name="gender"/>
                        </group>
                    </group>
                    <group>
                        <group name="proof" string="Acreditación">
                            <field name="proof_type_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="proof_document"
                                   placeholder="N° 0012345"/>
                            <field name="disability_resolution"
                                   invisible="not type_id"
                                   placeholder="Resolución de EsSalud N° ..."/>
                            <field name="gestation_due_date"
                                   invisible="not is_unborn"
                                   required="is_unborn"/>
                        </group>
                        <group name="allowance" string="Asignación familiar">
                            <field name="is_studying" invisible="not is_child"/>
                            <field name="gives_family_allowance" readonly="1"/>
                            <field name="is_declared" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_pe_dependent_search" model="ir.ui.view">
        <field name="name">l10n_pe.hr.dependent.search</field>
        <field name="model">l10n_pe.hr.dependent</field>
        <field name="arch" type="xml">
            <search string="Derechohabientes">
                <field name="name"/>
                <field name="identification_id"/>
                <field name="employee_id"/>
                <filter name="filter_current" string="Vigentes"
                        domain="['|', ('date_end', '=', False),
                                 ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_pending" string="Por declarar"
                        domain="[('is_declared', '=', False),
                                 ('date_end', '=', False)]"/>
                <separator/>
                <filter name="filter_allowance" string="Dan asignación familiar"
                        domain="[('gives_family_allowance', '=', True)]"/>
                <group>
                    <filter name="group_employee" string="Trabajador" domain="[]"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Tipo" domain="[]"
                            context="{'group_by': 'type_id'}"/>
                    <filter name="group_state" string="Situación" domain="[]"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_pe_dependent" model="ir.actions.act_window">
        <field name="name">Derechohabientes</field>
        <field name="res_model">l10n_pe.hr.dependent</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_current': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registre el primer derechohabiente
            </p>
            <p>
                Cónyuge, concubino, hijos menores, hijos mayores
                incapacitados y madre gestante. El T-Registro los exige
                para la acreditación en EsSalud, y de los hijos sale la
                asignación familiar (Ley 25129).
            </p>
        </field>
    </record>

    <!-- Catálogos -->
    <record id="view_l10n_pe_dependent_type_list" model="ir.ui.view">
        <field name="name">l10n_pe.hr.dependent.type.list</field>
        <field name="model">l10n_pe.hr.dependent.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de derechohabiente" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <field name="is_child" widget="boolean_toggle"/>
                <field name="is_partner" widget="boolean_toggle"/>
                <field name="is_unborn" widget="boolean_toggle"/>
                <field name="requires_disability" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_l10n_pe_dependent_type" model="ir.actions.act_window">
        <field name="name">Tipos de derechohabiente</field>
        <field name="res_model">l10n_pe.hr.dependent.type</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_l10n_pe_dependent_end_reason_list" model="ir.ui.view">
        <field name="name">l10n_pe.hr.dependent.end.reason.list</field>
        <field name="model">l10n_pe.hr.dependent.end.reason</field>
        <field name="arch" type="xml">
            <list string="Motivos de baja" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_l10n_pe_dependent_end_reason" model="ir.actions.act_window">
        <field name="name">Motivos de baja de derechohabientes</field>
        <field name="res_model">l10n_pe.hr.dependent.end.reason</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menús: el maestro cuelga de Empleados (es dato del trabajador) y
         los catálogos de la configuración Perú, como el resto de tablas. -->
    <menuitem id="menu_l10n_pe_dependent" name="Derechohabientes"
              parent="hr.menu_hr_employee_payroll"
              action="action_l10n_pe_dependent"
              groups="hr_payroll.group_hr_payroll_user"
              sequence="40"/>

    <menuitem id="menu_l10n_pe_dependent_type" name="Tipos de derechohabiente"
              parent="al_hr_pe.menu_hr_pe_root"
              action="action_l10n_pe_dependent_type"
              sequence="34"/>

    <menuitem id="menu_l10n_pe_dependent_end_reason"
              name="Motivos de baja de derechohabientes"
              parent="al_hr_pe.menu_hr_pe_root"
              action="action_l10n_pe_dependent_end_reason"
              sequence="35"/>

    <!-- Botón en la ficha del trabajador -->
    <record id="view_employee_form_dependents" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.pe.dependents</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_l10n_pe_dependents" type="object"
                        class="oe_stat_button" icon="fa-users"
                        groups="hr.group_hr_user">
                    <field name="l10n_pe_dependent_count" widget="statinfo"
                           string="Derechohab."/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
