<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Catálogos globales con override: ver globales + los propios -->
        <record id="hr_worker_type_company_rule" model="ir.rule">
            <field name="name">Tipo de trabajador: global o de la compañía</field>
            <field name="model_id" ref="model_hr_worker_type"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
