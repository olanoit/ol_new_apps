<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <!-- Variante de la boleta legal para construcción civil.

             `mode="primary"` crea una copia del template con los cambios
             aplicados, sin tocar el original: la boleta del régimen
             general sigue igual. Lo único que cambia es cómo se describe
             la remuneración —jornal, categoría y obra en vez de sueldo
             mensual— porque en este régimen no hay «remuneración básica»
             que mostrar.

             El nombre lleva `l10n_pe` a propósito: es lo que mira
             `hr.payslip._get_pdf_reports` para no pisar una plantilla
             peruana ya elegida. -->
        <template id="report_l10n_pe_boleta_construccion_page"
                  inherit_id="al_hr_pe_reports.report_l10n_pe_boleta_pago_page"
                  primary="True">

            <!-- Bloque 1: el sueldo mensual no aplica; manda el jornal. -->
            <xpath expr="//td[hasclass('bpe-label')][text()='Remuneración básica']"
                   position="replace">
                <td class="bpe-label">Jornal básico</td>
            </xpath>
            <xpath expr="//span[@t-esc=&quot;'{:,.2f}'.format(v.wage or 0.0)&quot;]"
                   position="replace">
                <span t-esc="'{:,.2f}'.format(o.l10n_pe_daily_wage or 0.0)"/>
            </xpath>

            <!-- Categoría y obra: son los datos que identifican el puesto
                 en este régimen, y la obra determina qué bonificaciones
                 por condiciones de trabajo se pagan. -->
            <xpath expr="(//div[hasclass('bpe-block')])[1]//table[hasclass('bpe-grid')]"
                   position="inside">
                <tr>
                    <td class="bpe-label">Categoría</td>
                    <td><span t-esc="v.l10n_pe_construction_category_id.name or ''"/></td>
                    <td class="bpe-label">Obra</td>
                    <td colspan="3">
                        <span t-esc="v.l10n_pe_construction_site_id.name or ''"/>
                    </td>
                </tr>
                <tr t-if="v.l10n_pe_construction_bae_id">
                    <td class="bpe-label">Especialidad</td>
                    <td colspan="5">
                        <span t-esc="v.l10n_pe_construction_bae_id.name"/>
                    </td>
                </tr>
            </xpath>
        </template>

        <template id="report_l10n_pe_boleta_construccion_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="al_hr_pe_construction.report_l10n_pe_boleta_construccion_page"/>
                </t>
            </t>
        </template>

        <!-- Sin binding_model_id: el único camino de impresión es el botón
             nativo, que resuelve el reporte por `_get_pdf_reports`. -->
        <record id="action_report_boleta_construccion" model="ir.actions.report">
            <field name="name">Boleta de pago - Construcción civil (PE)</field>
            <field name="model">hr.payslip</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">al_hr_pe_construction.report_l10n_pe_boleta_construccion_document</field>
            <field name="report_file">al_hr_pe_construction.report_l10n_pe_boleta_construccion_document</field>
            <field name="print_report_name">'Boleta construcción - %s - %s' % (
                object.employee_id.name or '', object.date_from)</field>
            <field name="paperformat_id"
                   ref="al_hr_pe_reports.paperformat_boleta_pago"/>
            <field name="binding_model_id" eval="False"/>
        </record>

        <!-- La estructura del régimen imprime su propia variante. -->
        <record id="construction_structure" model="hr.payroll.structure">
            <field name="report_id" ref="action_report_boleta_construccion"/>
        </record>

    </data>
</odoo>
