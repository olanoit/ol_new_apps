<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_multi_company_rule" model="ir.rule">
        <field name="name">Pago múltiple: multicompañía</field>
        <field name="model_id" ref="model_l10n_pe_payment_multi"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="payment_multi_line_company_rule" model="ir.rule">
        <field name="name">Línea de pago múltiple: multicompañía</field>
        <field name="model_id" ref="model_l10n_pe_payment_multi_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
