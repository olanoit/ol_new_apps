<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_multi" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.pe.multi</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group2']/field[@name='journal_id']" position="before">
                <field name="l10n_pe_payment_multi_id" invisible="not l10n_pe_payment_multi_id"/>
            </xpath>
        </field>
    </record>

    <!-- Acción en la lista de facturas: pagar varias de distintos socios a la vez. -->
    <record id="action_move_payment_multi" model="ir.actions.server">
        <field name="name">Pago múltiple</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[Command.link(ref('account.group_account_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['l10n_pe.payment.multi']._l10n_pe_open_from_moves(records)</field>
    </record>
</odoo>
