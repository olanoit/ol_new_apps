<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collection_action_form" model="ir.ui.view">
        <field name="name">l10n_pe.collection.action.form</field>
        <field name="model">l10n_pe.collection.action</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="id"/>
                            <field name="is_consumer" invisible="1"/>
                            <field name="contact_id" options="{'no_create': True}"/>
                            <field name="channel"/>
                            <field name="result_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="promise_id" invisible="not promise_id"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not is_consumer">
                        Consumidor: el art. 62 del Código de Protección al Consumidor prohíbe llamarlo, visitarlo o
                        escribirle fuera del horario permitido, en fines de semana o feriados, y comunicar la deuda a
                        terceros.
                    </div>
                    <group string="Reclamo" invisible="not is_dispute">
                        <group>
                            <field name="is_dispute" invisible="1"/>
                            <field name="dispute_reason_id" required="is_dispute" readonly="dispute_id"
                                   options="{'no_create': True}"/>
                            <field name="dispute_id" invisible="not dispute_id"/>
                        </group>
                    </group>
                    <group string="Compromiso de pago" invisible="not is_promise">
                        <group>
                            <field name="is_promise" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="promise_date" required="is_promise" readonly="promise_id"/>
                            <field name="promise_amount" required="is_promise" readonly="promise_id"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="id" options="{'no_create': True}">
                        <list>
                            <field name="move_id"/>
                            <field name="date_maturity"/>
                            <field name="company_currency_id" column_invisible="True"/>
                            <field name="amount_residual" string="Saldo"/>
                        </list>
                    </field>
                    <group>
                        <group>
                            <field name="next_action_date"/>
                            <field name="next_action_summary" invisible="not next_action_date"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Qué se habló, con quién, qué se acordó…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_collection_action_list" model="ir.ui.view">
        <field name="name">l10n_pe.collection.action.list</field>
        <field name="model">l10n_pe.collection.action</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="channel"/>
                <field name="result_id"/>
                <field name="promise_id" optional="show"/>
                <field name="next_action_date" optional="show"/>
                <field name="note" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_collection_action_search" model="ir.ui.view">
        <field name="name">l10n_pe.collection.action.search</field>
        <field name="model">l10n_pe.collection.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="result_id"/>
                <filter name="mine" string="Mis gestiones" domain="[('user_id', '=', uid)]"/>
                <filter name="promises" string="Con compromiso" domain="[('promise_id', '!=', False)]"/>
                <filter name="date" string="Fecha" date="date"/>
                <group>
                    <filter name="group_user" string="Gestor" context="{'group_by': 'user_id'}"/>
                    <filter name="group_channel" string="Canal" context="{'group_by': 'channel'}"/>
                    <filter name="group_result" string="Resultado" context="{'group_by': 'result_id'}"/>
                    <filter name="group_date" string="Día" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_collection_action_pivot" model="ir.ui.view">
        <field name="name">l10n_pe.collection.action.pivot</field>
        <field name="model">l10n_pe.collection.action</field>
        <field name="arch" type="xml">
            <pivot string="Gestiones">
                <field name="user_id" type="row"/>
                <field name="result_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_collection_action" model="ir.actions.act_window">
        <field name="name">Gestiones</field>
        <field name="res_model">l10n_pe.collection.action</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="context">{'search_default_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre cada contacto con un cliente</p>
            <p>Llamadas, visitas o correos con su resultado: queda en el historial del cliente y se
               programa la siguiente acción.</p>
        </field>
    </record>
</odoo>
