<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collection_zone_list" model="ir.ui.view">
        <field name="name">l10n_pe.collection.zone.list</field>
        <field name="model">l10n_pe.collection.zone</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_collection_zone" model="ir.actions.act_window">
        <field name="name">Zonas</field>
        <field name="res_model">l10n_pe.collection.zone</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_collection_bucket_list" model="ir.ui.view">
        <field name="name">l10n_pe.collection.bucket.list</field>
        <field name="model">l10n_pe.collection.bucket</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="days_from"/>
                <field name="days_to"/>
                <field name="probability"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>
    <record id="action_collection_bucket" model="ir.actions.act_window">
        <field name="name">Tramos de antigüedad</field>
        <field name="res_model">l10n_pe.collection.bucket</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>Los tramos agrupan la cartera por días de atraso. La probabilidad de cobro de cada
               tramo es la que usa la proyección: ajústela con la experiencia de la empresa.</p>
        </field>
    </record>

    <record id="view_collection_result_list" model="ir.ui.view">
        <field name="name">l10n_pe.collection.result.list</field>
        <field name="model">l10n_pe.collection.result</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_promise"/>
                <field name="is_contact"/>
                <field name="next_action_days"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_collection_result" model="ir.actions.act_window">
        <field name="name">Resultados de gestión</field>
        <field name="res_model">l10n_pe.collection.result</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
