<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collection_lawsuit_form" model="ir.ui.view">
        <field name="name">l10n_pe.collection.lawsuit.form</field>
        <field name="model">l10n_pe.collection.lawsuit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_conciliation" type="object" string="Conciliación"
                            invisible="state != 'draft'"/>
                    <button name="action_file" type="object" string="Demanda presentada" class="btn-primary"
                            invisible="state not in ('draft', 'conciliation')"/>
                    <button name="action_admit" type="object" string="Admitida" class="btn-primary"
                            invisible="state != 'filed'"/>
                    <button name="action_judgment" type="object" string="Sentencia"
                            invisible="state not in ('filed', 'admitted')"/>
                    <button name="action_enforce" type="object" string="Ejecución forzada"
                            invisible="state not in ('admitted', 'judgment')"/>
                    <button name="action_close" type="object" string="Concluir" invisible="state == 'closed'"/>
                    <button name="action_reopen" type="object" string="Reabrir" invisible="state != 'closed'"
                            groups="al_l10n_pe_collection.group_collection_manager"/>
                    <button name="action_print_file" type="object" string="Expediente"
                            groups="al_l10n_pe_collection.group_collection_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,filed,admitted,judgment,enforcement,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Cobrado" bg_color="text-bg-success" invisible="result not in ('paid', 'settled')"/>
                    <widget name="web_ribbon" title="Incobrable" bg_color="text-bg-danger" invisible="result != 'uncollectible'"/>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="process_type"/>
                            <field name="court"/>
                            <field name="file_number"/>
                            <field name="agency_id" options="{'no_create': True}"/>
                            <field name="lawyer"/>
                            <field name="user_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="date_conciliation" invisible="not date_conciliation and state != 'conciliation'"/>
                            <field name="date_filed" invisible="not date_filed"/>
                            <field name="amount_claimed" invisible="not date_filed"/>
                            <field name="amount_residual"/>
                            <field name="amount_recovered" invisible="not date_filed"/>
                            <field name="amount_costs"/>
                            <field name="next_deadline" invisible="not next_deadline"/>
                            <field name="result" invisible="not result"/>
                            <field name="date_closed" invisible="not date_closed"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="state not in ('draft', 'conciliation')">
                        Al presentar la demanda, los documentos salen del seguimiento automático y sustentan la
                        provisión de cobranza dudosa aunque no tengan 12 meses de vencidos (art. 21 f del Reglamento
                        de la LIR). Si el proceso concluye incobrable, quedan con las acciones judiciales agotadas que
                        exige el castigo de deudas de más de 3 UIT.
                    </div>
                    <notebook>
                        <page string="Actuaciones" name="events">
                            <field name="event_ids">
                                <list editable="top" decoration-muted="done"
                                      decoration-danger="date_deadline and not done and date_deadline &lt; current_date">
                                    <field name="date"/>
                                    <field name="event_type"/>
                                    <field name="name"/>
                                    <field name="date_deadline"/>
                                    <field name="done"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documentos" name="documents">
                            <field name="line_ids" readonly="state not in ('draft', 'conciliation')"
                                   options="{'no_create': True}">
                                <list>
                                    <field name="move_id" string="Documento"/>
                                    <field name="date_maturity" string="Vencimiento"/>
                                    <field name="balance" string="Importe" sum="Total"/>
                                    <field name="amount_residual" string="Saldo" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Gastos y costas" name="costs">
                            <field name="cost_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="move_id" optional="show" options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="note" placeholder="Estrategia, bienes del deudor, acuerdos…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_collection_lawsuit_list" model="ir.ui.view">
        <field name="name">l10n_pe.collection.lawsuit.list</field>
        <field name="model">l10n_pe.collection.lawsuit</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'closed'"
                  decoration-danger="next_deadline and next_deadline &lt; current_date and state != 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="process_type" optional="show"/>
                <field name="file_number" optional="show"/>
                <field name="agency_id" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="date_filed" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_claimed" sum="Total"/>
                <field name="amount_residual"/>
                <field name="next_deadline"/>
                <field name="state" widget="badge" decoration-info="state in ('draft', 'conciliation')"
                       decoration-warning="state in ('filed', 'admitted', 'judgment', 'enforcement')"/>
                <field name="result" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_collection_lawsuit_search" model="ir.ui.view">
        <field name="name">l10n_pe.collection.lawsuit.search</field>
        <field name="model">l10n_pe.collection.lawsuit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="file_number"/>
                <field name="agency_id"/>
                <filter name="open" string="En curso" domain="[('state', '!=', 'closed')]"/>
                <filter name="closed" string="Concluidos" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="overdue_deadline" string="Plazos vencidos"
                        domain="[('next_deadline', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', '!=', 'closed')]"/>
                <filter name="mine" string="Mis procesos" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_state" string="Etapa" context="{'group_by': 'state'}"/>
                    <filter name="group_agency" string="Estudio" context="{'group_by': 'agency_id'}"/>
                    <filter name="group_type" string="Vía" context="{'group_by': 'process_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_collection_lawsuit" model="ir.actions.act_window">
        <field name="name">Cobranza judicial</field>
        <field name="res_model">l10n_pe.collection.lawsuit</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre un proceso judicial de cobranza</p>
            <p>Demanda, juzgado, expediente, actuaciones con sus plazos y gastos. Sustenta la provisión y el castigo
                de la cobranza dudosa ante SUNAT.</p>
        </field>
    </record>

    <record id="view_collection_lawsuit_close_form" model="ir.ui.view">
        <field name="name">l10n_pe.collection.lawsuit.close.form</field>
        <field name="model">l10n_pe.collection.lawsuit.close</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="lawsuit_id" invisible="1"/>
                    <field name="result" widget="radio"/>
                    <field name="note" required="result == 'uncollectible'"
                           placeholder="Resolución, acta de transacción o constancia de que el deudor no tiene bienes"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="result != 'uncollectible'">
                    Los documentos del proceso quedan con las acciones judiciales agotadas: se pueden castigar aunque el
                    deudor deba más de 3 UIT (art. 21 g del Reglamento de la LIR).
                </div>
                <footer>
                    <button name="action_close" type="object" string="Concluir" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
