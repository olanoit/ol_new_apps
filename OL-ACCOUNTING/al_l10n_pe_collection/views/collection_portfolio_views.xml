<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collection_portfolio_list" model="ir.ui.view">
        <field name="name">l10n_pe.collection.portfolio.list</field>
        <field name="model">l10n_pe.collection.portfolio</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="days_overdue &gt; 60"
                  decoration-warning="is_overdue and days_overdue &lt;= 60">
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="user_id"/>
                <field name="zone_id" optional="show"/>
                <field name="date" optional="hide"/>
                <field name="date_maturity"/>
                <field name="days_overdue"/>
                <field name="bucket_id" optional="show"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="promise_date" optional="show"/>
                <field name="rating" optional="show"/>
                <field name="in_dispute" optional="show"/>
                <field name="hold" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="amount_residual_currency" optional="hide"/>
                <field name="amount_residual" sum="Total"/>
                <field name="account_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_collection_portfolio_pivot" model="ir.ui.view">
        <field name="name">l10n_pe.collection.portfolio.pivot</field>
        <field name="model">l10n_pe.collection.portfolio</field>
        <field name="arch" type="xml">
            <pivot string="Cartera" sample="1">
                <field name="user_id" type="row"/>
                <field name="bucket_id" type="col"/>
                <field name="amount_residual" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_collection_portfolio_graph" model="ir.ui.view">
        <field name="name">l10n_pe.collection.portfolio.graph</field>
        <field name="model">l10n_pe.collection.portfolio</field>
        <field name="arch" type="xml">
            <graph string="Cartera" type="bar" stacked="1">
                <field name="user_id"/>
                <field name="bucket_id"/>
                <field name="amount_residual" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_collection_portfolio_search" model="ir.ui.view">
        <field name="name">l10n_pe.collection.portfolio.search</field>
        <field name="model">l10n_pe.collection.portfolio</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="user_id"/>
                <field name="zone_id"/>
                <filter name="mine" string="Mi cartera" domain="[('user_id', '=', uid)]"/>
                <filter name="no_user" string="Sin gestor" domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter name="overdue" string="Vencido" domain="[('is_overdue', '=', True)]"/>
                <filter name="not_overdue" string="Por vencer" domain="[('is_overdue', '=', False)]"/>
                <filter name="over_90" string="Más de 90 días" domain="[('days_overdue', '&gt;', 90)]"/>
                <filter name="with_promise" string="Con compromiso" domain="[('promise_date', '!=', False)]"/>
                <filter name="in_dispute" string="En disputa" domain="[('in_dispute', '=', True)]"/>
                <filter name="enforceable" string="Exigible" domain="[('in_dispute', '=', False)]"/>
                <filter name="on_hold" string="Clientes bloqueados" domain="[('hold', 'in', ('auto', 'manual'))]"/>
                <group>
                    <filter name="group_user" string="Gestor" context="{'group_by': 'user_id'}"/>
                    <filter name="group_zone" string="Zona" context="{'group_by': 'zone_id'}"/>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_bucket" string="Tramo" context="{'group_by': 'bucket_id'}"/>
                    <filter name="group_rating" string="Calificación" context="{'group_by': 'rating'}"/>
                    <filter name="group_due" string="Mes de vencimiento" context="{'group_by': 'date_maturity:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_collection_portfolio" model="ir.actions.act_window">
        <field name="name">Cartera</field>
        <field name="res_model">l10n_pe.collection.portfolio</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{'search_default_group_partner': 1}</field>
    </record>

    <record id="action_collection_portfolio_server" model="ir.actions.server">
        <field name="name">Cartera</field>
        <field name="model_id" ref="model_l10n_pe_collection_portfolio"/>
        <!-- Con grupo: sin él, Odoo exige escritura sobre el modelo (la cartera es de solo lectura). -->
        <field name="group_ids" eval="[(4, ref('al_l10n_pe_collection.group_collection_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>
    <record id="action_collection_portfolio_overdue_server" model="ir.actions.server">
        <field name="name">Antigüedad de la cartera</field>
        <field name="model_id" ref="model_l10n_pe_collection_portfolio"/>
        <!-- Con grupo: sin él, Odoo exige escritura sobre el modelo (la cartera es de solo lectura). -->
        <field name="group_ids" eval="[(4, ref('al_l10n_pe_collection.group_collection_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()
action['name'] = 'Antigüedad de la cartera'
action['views'] = [(False, 'pivot'), (False, 'graph'), (False, 'list')]
action['context'] = {}</field>
    </record>
</odoo>
