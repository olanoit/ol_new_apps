<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ficha del cliente: zona y accesos de cobranza junto al seguimiento nativo. -->
    <record id="view_partner_property_form_collection" model="ir.ui.view">
        <field name="name">res.partner.property.form.collection</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account_followup.view_partner_property_form_followup"/>
        <field name="arch" type="xml">
            <field name="followup_responsible_id" position="attributes">
                <attribute name="string">Gestor de cobranza</attribute>
            </field>
            <field name="followup_responsible_id" position="after">
                <field name="l10n_pe_collection_zone_id" options="{'no_create': True}"/>
                <div colspan="2" class="d-flex flex-wrap gap-2 mt-2"
                     groups="al_l10n_pe_collection.group_collection_user">
                    <button name="action_l10n_pe_collection_new_action" type="object" string="Registrar gestión"
                            class="btn-secondary btn-sm"/>
                    <button name="action_l10n_pe_collection_statement" type="object" string="Estado de cuenta"
                            class="btn-secondary btn-sm"/>
                    <button name="action_l10n_pe_collection_send_statement" type="object" string="Enviar estado de cuenta"
                            class="btn-secondary btn-sm"/>
                </div>
            </field>
        </field>
    </record>

    <record id="view_partner_form_collection_buttons" model="ir.ui.view">
        <field name="name">res.partner.form.collection.buttons</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_l10n_pe_collection_actions" type="object" class="oe_stat_button" icon="fa-phone"
                        groups="al_l10n_pe_collection.group_collection_user"
                        invisible="not l10n_pe_collection_action_count">
                    <field name="l10n_pe_collection_action_count" widget="statinfo" string="Gestiones"/>
                </button>
                <button name="action_l10n_pe_collection_promises" type="object" class="oe_stat_button" icon="fa-handshake-o"
                        groups="al_l10n_pe_collection.group_collection_user"
                        invisible="not l10n_pe_collection_promise_count">
                    <field name="l10n_pe_collection_promise_count" widget="statinfo" string="Compromisos"/>
                </button>
            </div>
        </field>
    </record>

    <!-- Asignación de gestor y zona en lote desde la lista de clientes. -->
    <record id="view_partner_list_collection" model="ir.ui.view">
        <field name="name">res.partner.list.collection</field>
        <field name="model">res.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="name" readonly="1"/>
                <field name="vat" readonly="1" optional="show"/>
                <field name="followup_responsible_id" string="Gestor de cobranza"/>
                <field name="l10n_pe_collection_zone_id"/>
                <field name="email" readonly="1" optional="show"/>
                <field name="phone" readonly="1" optional="show"/>
                <field name="city" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_collection_partner_assignment" model="ir.actions.act_window">
        <field name="name">Clientes y gestores</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_partner_list_collection"/>
        <field name="context">{'search_default_customer': 1}</field>
        <field name="domain">[('customer_rank', '&gt;', 0)]</field>
        <field name="help" type="html">
            <p>Seleccione clientes y edite en lote el gestor de cobranza o la zona.</p>
        </field>
    </record>
</odoo>
