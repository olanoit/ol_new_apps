<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collection_dashboard_form" model="ir.ui.view">
        <field name="name">l10n_pe.collection.dashboard.form</field>
        <field name="model">l10n_pe.collection.dashboard</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_refresh" type="object" string="Actualizar" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1>Indicadores del gestor</h1></div>
                    <group>
                        <group>
                            <field name="user_id" options="{'no_create': True}" placeholder="Toda la cartera"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cartera">
                            <field name="portfolio_amount"/>
                            <field name="overdue_amount" decoration-danger="overdue_amount &gt; 0"/>
                            <field name="overdue_percent"/>
                            <field name="overdue_90_amount"/>
                            <field name="due_soon_amount"/>
                            <field name="partner_overdue_count"/>
                            <field name="dso"/>
                        </group>
                        <group string="Compromisos y metas">
                            <field name="promises_today_count"/>
                            <field name="promises_pending_amount"/>
                            <field name="promises_broken_count" decoration-danger="promises_broken_count &gt; 0"/>
                            <field name="promises_kept_rate"/>
                            <field name="collected_month_amount"/>
                            <field name="target_month_amount"/>
                            <field name="target_progress" widget="progressbar"/>
                        </group>
                    </group>
                    <div class="d-flex flex-wrap gap-2">
                        <button name="action_open_portfolio" type="object" string="Ver cartera" class="btn-secondary"/>
                        <button name="action_open_overdue" type="object" string="Ver vencido" class="btn-secondary"/>
                        <button name="action_open_due_soon" type="object" string="Vence en 7 días" class="btn-secondary"/>
                        <button name="action_open_promises" type="object" string="Ver compromisos" class="btn-secondary"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_collection_dashboard" model="ir.actions.server">
        <field name="name">Indicadores del gestor</field>
        <field name="model_id" ref="model_l10n_pe_collection_dashboard"/>
        <field name="group_ids" eval="[(4, ref('al_l10n_pe_collection.group_collection_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>
</odoo>
