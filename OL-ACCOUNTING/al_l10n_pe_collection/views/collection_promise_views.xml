<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collection_promise_form" model="ir.ui.view">
        <field name="name">l10n_pe.collection.promise.form</field>
        <field name="model">l10n_pe.collection.promise</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_evaluate" type="object" string="Evaluar ahora" invisible="state != 'pending'"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state != 'pending'"/>
                    <button name="action_reset" type="object" string="Reabrir" invisible="state in ('pending',)"
                            groups="al_l10n_pe_collection.group_collection_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,kept,broken"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'pending'"/>
                            <field name="user_id" readonly="state != 'pending'"/>
                            <field name="date" readonly="state != 'pending'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" readonly="state != 'pending'"/>
                        </group>
                        <group>
                            <field name="date_agreed"/>
                            <field name="collected_amount"/>
                            <field name="collected_percent" widget="progressbar"/>
                            <field name="evaluated_on" invisible="not evaluated_on"/>
                            <field name="reminder_sent"/>
                            <field name="action_id" invisible="not action_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'pending' or id" options="{'no_create': True}">
                        <list>
                            <field name="move_id"/>
                            <field name="date_maturity"/>
                            <field name="company_currency_id" column_invisible="True"/>
                            <field name="amount_residual" string="Saldo"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Notas"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_collection_promise_list" model="ir.ui.view">
        <field name="name">l10n_pe.collection.promise.list</field>
        <field name="model">l10n_pe.collection.promise</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'broken'" decoration-warning="state == 'partial'"
                  decoration-success="state == 'kept'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="collected_amount" sum="Total"/>
                <field name="collected_percent" widget="progressbar" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'kept'"
                       decoration-danger="state == 'broken'" decoration-warning="state == 'partial'"/>
            </list>
        </field>
    </record>

    <record id="view_collection_promise_calendar" model="ir.ui.view">
        <field name="name">l10n_pe.collection.promise.calendar</field>
        <field name="model">l10n_pe.collection.promise</field>
        <field name="arch" type="xml">
            <calendar string="Compromisos" date_start="date" color="user_id" mode="month">
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_collection_promise_search" model="ir.ui.view">
        <field name="name">l10n_pe.collection.promise.search</field>
        <field name="model">l10n_pe.collection.promise</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="mine" string="Mis compromisos" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                <filter name="today" string="Para hoy" domain="[('state', '=', 'pending'), ('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="broken" string="Incumplidos" domain="[('state', 'in', ('broken', 'partial'))]"/>
                <filter name="kept" string="Cumplidos" domain="[('state', '=', 'kept')]"/>
                <filter name="date" string="Fecha" date="date"/>
                <group>
                    <filter name="group_user" string="Gestor" context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_collection_promise" model="ir.actions.act_window">
        <field name="name">Compromisos de pago</field>
        <field name="res_model">l10n_pe.collection.promise</field>
        <field name="view_mode">list,calendar,form,pivot,graph</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre los compromisos de pago de los clientes</p>
            <p>Se evalúan solos al llegar la fecha: cumplido, parcial o incumplido.</p>
        </field>
    </record>
</odoo>
