<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_statement_send_form" model="ir.ui.view">
        <field name="name">l10n_pe.collection.statement.send.form</field>
        <field name="model">l10n_pe.collection.statement.send</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="partner_ids" widget="many2many_tags"/>
                    <field name="template_id" options="{'no_create': True}"/>
                    <field name="without_email" invisible="not without_email" class="text-danger"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Enviar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_statement_send" model="ir.actions.act_window">
        <field name="name">Enviar estado de cuenta</field>
        <field name="res_model">l10n_pe.collection.statement.send</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="context">{'default_partner_ids': active_ids}</field>
    </record>
</odoo>
