<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_collection_promise" model="ir.sequence">
        <field name="name">Compromiso de pago</field>
        <field name="code">l10n_pe.collection.promise</field>
        <field name="prefix">CP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_collection_dispute" model="ir.sequence">
        <field name="name">Reclamo de cobranza</field>
        <field name="code">l10n_pe.collection.dispute</field>
        <field name="prefix">RC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_collection_provision" model="ir.sequence">
        <field name="name">Provisión de cobranza dudosa</field>
        <field name="code">l10n_pe.collection.provision</field>
        <field name="prefix">PCD/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_collection_bureau" model="ir.sequence">
        <field name="name">Reporte a central de riesgo</field>
        <field name="code">l10n_pe.collection.bureau</field>
        <field name="prefix">CR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
