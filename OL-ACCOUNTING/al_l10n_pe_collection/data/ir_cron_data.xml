<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_collection_promises" model="ir.cron">
        <field name="name">Cobranza: evaluar compromisos y enviar recordatorios</field>
        <field name="model_id" ref="model_l10n_pe_collection_promise"/>
        <field name="state">code</field>
        <field name="code">model._cron_collection_promises()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 11:00:00')"/>
    </record>
    <record id="ir_cron_collection_digest" model="ir.cron">
        <field name="name">Cobranza: resumen diario a los gestores</field>
        <field name="model_id" ref="model_l10n_pe_collection_dashboard"/>
        <field name="state">code</field>
        <field name="code">model._cron_collection_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:30:00')"/>
    </record>
    <record id="ir_cron_collection_rating" model="ir.cron">
        <field name="name">Cobranza: calificar clientes y aplicar bloqueos por mora</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_l10n_pe_collection_rating()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 10:30:00')"/>
    </record>
    <record id="ir_cron_collection_bureau" model="ir.cron">
        <field name="name">Cobranza: reportes a centrales de riesgo por retirar</field>
        <field name="model_id" ref="model_l10n_pe_collection_bureau"/>
        <field name="state">code</field>
        <field name="code">model._cron_collection_bureau()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 11:30:00')"/>
    </record>
    <record id="ir_cron_collection_agency_assignments" model="ir.cron">
        <field name="name">Cobranza: terminar asignaciones a agencias vencidas</field>
        <field name="model_id" ref="model_l10n_pe_collection_agency_assignment"/>
        <field name="state">code</field>
        <field name="code">model._cron_end_assignments()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 06:00:00')"/>
    </record>
    <record id="ir_cron_collection_prediction" model="ir.cron">
        <field name="name">Cobranza: predecir fechas de pago</field>
        <field name="model_id" ref="model_l10n_pe_collection_predictor"/>
        <field name="state">code</field>
        <field name="code">model._cron_predict()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 07:00:00')"/>
    </record>
</odoo>
