<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_collection_promises" model="ir.cron">
        <field name="name">Cobranza: evaluar compromisos y enviar recordatorios</field>
        <field name="model_id" ref="model_l10n_pe_collection_promise"/>
        <field name="state">code</field>
        <field name="code">model._cron_collection_promises()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 11:00:00')"/>
    </record>
    <record id="ir_cron_collection_digest" model="ir.cron">
        <field name="name">Cobranza: resumen diario a los gestores</field>
        <field name="model_id" ref="model_l10n_pe_collection_dashboard"/>
        <field name="state">code</field>
        <field name="code">model._cron_collection_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:30:00')"/>
    </record>
</odoo>
