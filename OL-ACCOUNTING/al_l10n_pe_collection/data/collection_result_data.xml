<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="result_promise" model="l10n_pe.collection.result">
        <field name="name">Promete pagar</field>
        <field name="sequence">10</field>
        <field name="is_promise" eval="True"/>
        <field name="is_contact" eval="True"/>
        <field name="next_action_days">0</field>
    </record>
    <record id="result_paid" model="l10n_pe.collection.result">
        <field name="name">Dice que ya pagó (verificar)</field>
        <field name="sequence">20</field>
        <field name="is_promise" eval="False"/>
        <field name="is_contact" eval="True"/>
        <field name="next_action_days">2</field>
    </record>
    <record id="result_statement" model="l10n_pe.collection.result">
        <field name="name">Pide estado de cuenta</field>
        <field name="sequence">30</field>
        <field name="is_promise" eval="False"/>
        <field name="is_contact" eval="True"/>
        <field name="next_action_days">2</field>
    </record>
    <record id="result_claim" model="l10n_pe.collection.result">
        <field name="name">Reclamo o disconformidad</field>
        <field name="sequence">40</field>
        <field name="is_promise" eval="False"/>
        <field name="is_dispute" eval="True"/>
        <field name="is_contact" eval="True"/>
        <field name="next_action_days">3</field>
    </record>
    <record id="result_refuse" model="l10n_pe.collection.result">
        <field name="name">Se niega a pagar</field>
        <field name="sequence">50</field>
        <field name="is_promise" eval="False"/>
        <field name="is_contact" eval="True"/>
        <field name="next_action_days">7</field>
    </record>
    <record id="result_no_answer" model="l10n_pe.collection.result">
        <field name="name">No contesta</field>
        <field name="sequence">60</field>
        <field name="is_promise" eval="False"/>
        <field name="is_contact" eval="False"/>
        <field name="next_action_days">1</field>
    </record>
    <record id="result_message" model="l10n_pe.collection.result">
        <field name="name">Dejó mensaje</field>
        <field name="sequence">70</field>
        <field name="is_promise" eval="False"/>
        <field name="is_contact" eval="False"/>
        <field name="next_action_days">2</field>
    </record>
    <record id="result_wrong" model="l10n_pe.collection.result">
        <field name="name">Número o dirección equivocados</field>
        <field name="sequence">80</field>
        <field name="is_promise" eval="False"/>
        <field name="is_contact" eval="False"/>
        <field name="next_action_days">0</field>
    </record>

    <!-- Motivos de reclamo -->
    <record id="dispute_reason_price" model="l10n_pe.collection.dispute.reason">
        <field name="name">Precio o descuento</field>
        <field name="sequence">10</field>
    </record>
    <record id="dispute_reason_quantity" model="l10n_pe.collection.dispute.reason">
        <field name="name">Cantidad o producto no recibido</field>
        <field name="sequence">20</field>
    </record>
    <record id="dispute_reason_quality" model="l10n_pe.collection.dispute.reason">
        <field name="name">Calidad o producto defectuoso</field>
        <field name="sequence">30</field>
    </record>
    <record id="dispute_reason_document" model="l10n_pe.collection.dispute.reason">
        <field name="name">Comprobante no recibido o con errores</field>
        <field name="sequence">40</field>
    </record>
    <record id="dispute_reason_paid" model="l10n_pe.collection.dispute.reason">
        <field name="name">El cliente dice que ya pagó</field>
        <field name="sequence">50</field>
    </record>
    <record id="dispute_reason_other" model="l10n_pe.collection.dispute.reason">
        <field name="name">Otro</field>
        <field name="sequence">90</field>
    </record>
</odoo>
