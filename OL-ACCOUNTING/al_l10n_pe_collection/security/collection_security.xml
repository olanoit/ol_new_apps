        <record id="collection_commission_line_agency_rule" model="ir.rule">
            <field name="name">Cobro de la liquidación: los de la agencia</field>
            <field name="model_id" ref="model_l10n_pe_collection_commission_line"/>
            <field name="domain_force">[('commission_id.agency_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_collection_agency'))]"/>
        </record>
        <record id="collection_portfolio_agency_rule" model="ir.rule">
            <field name="name">Cartera: la asignada a la agencia</field>
            <field name="model_id" ref="model_l10n_pe_collection_portfolio"/>
            <field name="domain_force">[('partner_id.l10n_pe_collection_agency_id.user_ids', 'in', [user.id])]</field>
