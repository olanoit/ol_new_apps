<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_account_destiny_view_search" model="ir.ui.view">
        <field name="name">l10n_pe.account.destiny.search</field>
        <field name="model">l10n_pe.account.destiny</field>
        <field name="arch" type="xml">
            <search>
                <field name="dest_account_id"/>
                <field name="parent_account_id"/>
                <filter string="Cuenta principal" name="gby_parent"
                        context="{'group_by': 'parent_account_id'}"/>
                <filter string="Cuenta destino" name="gby_dest"
                        context="{'group_by': 'dest_account_id'}"/>
            </search>
        </field>
    </record>

    <record id="account_account_destiny_view_list" model="ir.ui.view">
        <field name="name">l10n_pe.account.destiny.list</field>
        <field name="model">l10n_pe.account.destiny</field>
        <field name="arch" type="xml">
            <list editable="top" import="1">
                <field name="allowed_dest_ids" column_invisible="1"/>
                <field name="parent_account_id"/>
                <field name="dest_account_id" force_save="1"
                       domain="[('id', 'in', allowed_dest_ids)]"
                       options="{'no_create': True}"/>
                <field name="percentage" force_save="1" widget="percentage"/>
            </list>
        </field>
    </record>

    <record id="account_account_destiny_view_form" model="ir.ui.view">
        <field name="name">l10n_pe.account.destiny.form</field>
        <field name="model">l10n_pe.account.destiny</field>
        <field name="arch" type="xml">
            <form string="Destino de cuenta">
                <sheet>
                    <group>
                        <field name="allowed_dest_ids" invisible="1"/>
                        <field name="parent_account_id"/>
                        <field name="dest_account_id"
                               domain="[('id', 'in', allowed_dest_ids)]"
                               options="{'no_create': True}"/>
                        <field name="percentage" widget="percentage"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_account_destiny_action" model="ir.actions.act_window">
        <field name="name">Destinos de cuentas contables</field>
        <field name="res_model">l10n_pe.account.destiny</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_gby_parent': 1}</field>
    </record>
</odoo>
