<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_bank_collection_batch" model="ir.sequence">
        <field name="name">Archivo de deudores</field>
        <field name="code">l10n_pe.bank.collection.batch</field>
        <field name="prefix">REC/ENV/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bank_collection_response" model="ir.sequence">
        <field name="name">Respuesta de recaudación</field>
        <field name="code">l10n_pe.bank.collection.response</field>
        <field name="prefix">REC/RSP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
