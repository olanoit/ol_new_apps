<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_collection_layout_form" model="ir.ui.view">
        <field name="name">l10n_pe.bank.collection.layout.form</field>
        <field name="model">l10n_pe.bank.collection.layout</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="bank_id"/>
                            <field name="file_type"/>
                            <field name="filename" invisible="file_type != 'debtors'"/>
                            <field name="currency_map"/>
                            <field name="replace_code" invisible="file_type != 'debtors'"/>
                            <field name="update_code" invisible="file_type != 'debtors'"/>
                        </group>
                        <group>
                            <field name="record_length"/>
                            <field name="line_separator"/>
                            <field name="final_newline"/>
                            <field name="encoding"/>
                            <field name="blank_chars"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="field_ids">
                        <list editable="bottom">
                            <field name="record_type"/>
                            <field name="start"/>
                            <field name="length"/>
                            <field name="end"/>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="key" invisible="kind in ('constant', 'filler')"/>
                            <field name="value" invisible="kind not in ('constant', 'filler')"/>
                            <field name="decimals" invisible="kind != 'amount'" optional="show"/>
                            <field name="date_format" invisible="kind != 'date'" optional="hide"/>
                            <field name="mapping" invisible="kind in ('constant', 'filler')" optional="show"/>
                            <field name="align" optional="hide"/>
                            <field name="pad" optional="hide"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Notas: versión de la ficha técnica, fecha de validación con el banco…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bank_collection_layout_list" model="ir.ui.view">
        <field name="name">l10n_pe.bank.collection.layout.list</field>
        <field name="model">l10n_pe.bank.collection.layout</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="bank_id"/>
                <field name="file_type"/>
                <field name="record_length"/>
            </list>
        </field>
    </record>

    <record id="action_bank_collection_layout" model="ir.actions.act_window">
        <field name="name">Formatos de recaudación</field>
        <field name="res_model">l10n_pe.bank.collection.layout</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
