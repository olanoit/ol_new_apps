<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_collection_agreement_form" model="ir.ui.view">
        <field name="name">l10n_pe.bank.collection.agreement.form</field>
        <field name="model">l10n_pe.bank.collection.agreement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="BCP soles"/></h1></div>
                    <group>
                        <group string="Cuenta recaudadora">
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="bank_id"/>
                            <field name="currency_id" options="{'no_create': True}"/>
                            <field name="account_branch"/>
                            <field name="account_number"/>
                            <field name="service_code"/>
                            <field name="company_name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Archivos y cobro">
                            <field name="debtors_layout_id"/>
                            <field name="response_layout_id"/>
                            <field name="code_source"/>
                            <field name="validation"/>
                            <field name="days_ahead"/>
                            <field name="block_days"/>
                            <field name="include_disputed"/>
                            <field name="payment_memo"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bank_collection_agreement_list" model="ir.ui.view">
        <field name="name">l10n_pe.bank.collection.agreement.list</field>
        <field name="model">l10n_pe.bank.collection.agreement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="currency_id"/>
                <field name="code_source"/>
                <field name="validation"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_bank_collection_agreement" model="ir.actions.act_window">
        <field name="name">Convenios de recaudación</field>
        <field name="res_model">l10n_pe.bank.collection.agreement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure el convenio de recaudación con su banco</p>
            <p>Cuenta recaudadora, moneda, formatos de los archivos y el código con el que pagan los clientes.</p>
        </field>
    </record>
</odoo>
