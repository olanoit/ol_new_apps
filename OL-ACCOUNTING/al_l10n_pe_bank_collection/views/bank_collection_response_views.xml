<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_collection_response_form" model="ir.ui.view">
        <field name="name">l10n_pe.bank.collection.response.form</field>
        <field name="model">l10n_pe.bank.collection.response</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_process" type="object" string="Crear pagos y conciliar"
                            class="btn-primary" invisible="state != 'imported' or not payable_count"/>
                    <button name="action_rematch" type="object" string="Volver a identificar"
                            invisible="state != 'imported'"/>
                    <button name="action_import" type="object" string="Reimportar"
                            invisible="state != 'imported'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_payments" type="object" class="oe_stat_button" icon="fa-money"
                                invisible="not payment_ids">
                            <span class="o_stat_text">Pagos</span>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="agreement_id" readonly="state == 'done'" options="{'no_create': True}"/>
                            <field name="date" readonly="state == 'done'"/>
                            <field name="file" filename="filename" readonly="state == 'done'"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_ids" invisible="1"/>
                            <field name="amount_total"/>
                            <field name="amount_done"/>
                            <field name="pending_count"/>
                            <field name="payable_count" invisible="1"/>
                            <field name="header_count" invisible="not header_count"/>
                            <field name="header_amount" invisible="not header_amount"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0"
                              decoration-success="state == 'done'" decoration-danger="state == 'unmatched'"
                              decoration-warning="state == 'partner'" decoration-muted="state in ('duplicate', 'skipped')">
                            <field name="line_number" optional="hide"/>
                            <field name="payment_date"/>
                            <field name="depositor_code"/>
                            <field name="return_info" optional="show"/>
                            <field name="operation_number" optional="show"/>
                            <field name="state" widget="badge" decoration-success="state == 'done'"
                                   decoration-info="state == 'matched'" decoration-warning="state == 'partner'"
                                   decoration-danger="state == 'unmatched'"/>
                            <field name="channel" optional="hide"/>
                            <field name="branch" optional="hide"/>
                            <field name="reference" optional="hide"/>
                            <field name="payment_type" optional="hide"/>
                            <field name="partner_id" readonly="state in ('done', 'duplicate')" options="{'no_create': True}"/>
                            <field name="move_line_ids" widget="many2many_tags" readonly="state in ('done', 'duplicate')"
                                   options="{'no_create': True}"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="amount" sum="Total"/>
                            <field name="late_amount" optional="hide"/>
                            <field name="payment_id" optional="show"/>
                            <button name="action_rematch" type="object" icon="fa-refresh" title="Identificar"
                                    invisible="state not in ('unmatched', 'partner')"/>
                            <button name="action_skip" type="object" icon="fa-ban" title="Descartar"
                                    invisible="state in ('done', 'skipped')"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bank_collection_response_list" model="ir.ui.view">
        <field name="name">l10n_pe.bank.collection.response.list</field>
        <field name="model">l10n_pe.bank.collection.response</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="agreement_id"/>
                <field name="filename"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total"/>
                <field name="amount_done"/>
                <field name="pending_count"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-info="state == 'imported'"/>
            </list>
        </field>
    </record>

    <record id="action_bank_collection_response" model="ir.actions.act_window">
        <field name="name">Respuestas del banco</field>
        <field name="res_model">l10n_pe.bank.collection.response</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Importe el archivo de cobros del banco</p>
            <p>Identifica a cada cliente y documento, crea los pagos y los concilia.</p>
        </field>
    </record>
</odoo>
