<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_collection_batch_form" model="ir.ui.view">
        <field name="name">l10n_pe.bank.collection.batch.form</field>
        <field name="model">l10n_pe.bank.collection.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load" type="object" string="Cargar cuotas" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_generate" type="object" string="Generar archivo"
                            class="btn-primary" invisible="state != 'draft' or not line_ids"/>
                    <button name="action_download" type="object" string="Descargar" class="btn-primary"
                            invisible="not file"/>
                    <button name="action_mark_sent" type="object" string="Marcar enviado"
                            invisible="state != 'generated'"/>
                    <button name="action_draft" type="object" string="Volver a borrador"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="agreement_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="mode" readonly="state != 'draft'"/>
                            <field name="partner_ids" widget="many2many_tags" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="line_count"/>
                            <field name="amount_total"/>
                            <field name="file" filename="filename" invisible="not file"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not warning">
                        <field name="warning"/>
                    </div>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom" create="0">
                            <field name="partner_id"/>
                            <field name="depositor_code"/>
                            <field name="move_id"/>
                            <field name="date_maturity"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="amount" sum="Total"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bank_collection_batch_list" model="ir.ui.view">
        <field name="name">l10n_pe.bank.collection.batch.list</field>
        <field name="model">l10n_pe.bank.collection.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="agreement_id"/>
                <field name="mode"/>
                <field name="line_count"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'"
                       decoration-info="state == 'generated'"/>
            </list>
        </field>
    </record>

    <record id="action_bank_collection_batch" model="ir.actions.act_window">
        <field name="name">Archivos de deudores</field>
        <field name="res_model">l10n_pe.bank.collection.batch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Genere el archivo de deudores para el banco</p>
            <p>Las cuotas abiertas con el código con que cada cliente paga en ventanilla, agentes o banca por internet.</p>
        </field>
    </record>
</odoo>
