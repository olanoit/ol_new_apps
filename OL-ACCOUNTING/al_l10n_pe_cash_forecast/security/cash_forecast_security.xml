<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cash_forecast_company_rule" model="ir.rule">
        <field name="name">Flujo de caja: multicompañía</field>
        <field name="model_id" ref="model_l10n_pe_cash_forecast"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="cash_forecast_period_company_rule" model="ir.rule">
        <field name="name">Periodo del flujo de caja: multicompañía</field>
        <field name="model_id" ref="model_l10n_pe_cash_forecast_period"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="cash_forecast_line_company_rule" model="ir.rule">
        <field name="name">Partida del flujo de caja: multicompañía</field>
        <field name="model_id" ref="model_l10n_pe_cash_forecast_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
