<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_forecast" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.pe.forecast</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']/group" position="inside">
                <group string="Flujo de caja" name="l10n_pe_forecast" invisible="type not in ('bank', 'cash')">
                    <field name="l10n_pe_forecast_exclude"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
