<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_receipt" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.pe.receipt</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']/group" position="inside">
                <group string="Comprobante de pago" name="l10n_pe_receipt"
                       invisible="type not in ('bank', 'cash', 'credit')">
                    <field name="l10n_pe_receipt_enabled"/>
                    <field name="l10n_pe_receipt_in_sequence_id" invisible="not l10n_pe_receipt_enabled"
                           groups="base.group_no_one"/>
                    <field name="l10n_pe_receipt_out_sequence_id" invisible="not l10n_pe_receipt_enabled"
                           groups="base.group_no_one"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
