<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Derechos de la DUA: costos en destino del producto importado. -->
    <record id="product_dua_ad_valorem" model="product.product">
        <field name="name">Ad valorem (DUA)</field>
        <field name="type">service</field>
        <field name="landed_cost_ok" eval="True"/>
        <field name="split_method_landed_cost">by_current_cost_price</field>
        <field name="purchase_ok" eval="True"/>
        <field name="sale_ok" eval="False"/>
        <field name="taxes_id" eval="[Command.clear()]"/>
        <field name="supplier_taxes_id" eval="[Command.clear()]"/>
    </record>
    <record id="product_dua_isc" model="product.product">
        <field name="name">ISC de importación (DUA)</field>
        <field name="type">service</field>
        <field name="landed_cost_ok" eval="True"/>
        <field name="split_method_landed_cost">by_current_cost_price</field>
        <field name="purchase_ok" eval="True"/>
        <field name="sale_ok" eval="False"/>
        <field name="taxes_id" eval="[Command.clear()]"/>
        <field name="supplier_taxes_id" eval="[Command.clear()]"/>
    </record>
    <record id="product_dua_other" model="product.product">
        <field name="name">Otros derechos aduaneros (DUA)</field>
        <field name="type">service</field>
        <field name="landed_cost_ok" eval="True"/>
        <field name="split_method_landed_cost">by_current_cost_price</field>
        <field name="purchase_ok" eval="True"/>
        <field name="sale_ok" eval="False"/>
        <field name="taxes_id" eval="[Command.clear()]"/>
        <field name="supplier_taxes_id" eval="[Command.clear()]"/>
    </record>
</odoo>
