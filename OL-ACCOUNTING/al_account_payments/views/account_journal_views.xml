<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_operation_number" model="ir.ui.view">
        <field name="name">account.journal.form.al.payments</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='bank_account_number']" position="inside">
                <field name="l10n_pe_require_operation_number" invisible="type != 'bank'"/>
            </xpath>
        </field>
    </record>
</odoo>
