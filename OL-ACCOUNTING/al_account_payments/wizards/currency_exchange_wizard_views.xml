<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="currency_exchange_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_pe.currency.exchange.wizard.form</field>
        <field name="model">l10n_pe.currency.exchange.wizard</field>
        <field name="arch" type="xml">
            <form string="Compra y venta de moneda">
                <group>
                    <group>
                        <field name="journal_from_id" options="{'no_create': True}"/>
                        <field name="currency_from_id" invisible="1"/>
                        <field name="amount_from"/>
                        <field name="bank_rate"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="journal_to_id" options="{'no_create': True}"/>
                        <field name="currency_to_id" invisible="1"/>
                        <field name="amount_to"/>
                        <field name="system_rate"/>
                        <field name="company_currency_id" invisible="1"/>
                        <field name="difference" decoration-danger="difference &lt; 0"
                               decoration-success="difference &gt; 0"/>
                    </group>
                    <group>
                        <field name="bank_operation_number"/>
                        <field name="memo"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Registrar" class="btn-primary"/>
                    <button special="cancel" string="Descartar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_currency_exchange_wizard" model="ir.actions.act_window">
        <field name="name">Compra y venta de moneda</field>
        <field name="res_model">l10n_pe.currency.exchange.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
