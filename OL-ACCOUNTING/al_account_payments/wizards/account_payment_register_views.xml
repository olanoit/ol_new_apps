<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Asistente de registro de pagos: medio de pago y nro. de operación -->
    <record id="view_account_payment_register_form" model="ir.ui.view">
        <field name="name">account.payment.register.form.al.payments</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <!-- Aviso (no bloqueo) de fecha de pago futura -->
            <xpath expr="//group[1]" position="before">
                <field name="l10n_pe_future_date" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert" invisible="not l10n_pe_future_date">
                    La fecha del pago es posterior a hoy. Revísela antes de crear el pago.
                </div>
            </xpath>
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="pe_payment_method_id"
                       options="{'no_create_edit': True, 'no_open': True, 'no_create': True}"/>
                <field name="bank_operation_number"/>
            </xpath>
        </field>
    </record>

</odoo>
