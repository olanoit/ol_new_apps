<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_fourth_category" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.al.fourth.category</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="66"/>
        <field name="inherit_id" ref="al_account_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='al_account_base']" position="inside">
                <block title="Renta de 4.ª categoría" name="pe_fourth_category_block">
                    <setting company_dependent="1" string="Agente de retención de 4.ª categoría"
                             help="Retiene el impuesto a la renta de los recibos por honorarios que superan el tope, salvo que el prestador entregue su constancia de suspensión (Formulario Virtual 1609).">
                        <field name="l10n_pe_fourth_category_agent"/>
                        <div class="content-group mt16" invisible="not l10n_pe_fourth_category_agent">
                            <div class="row">
                                <label for="l10n_pe_fourth_category_rate" class="col-lg-5 o_light_label"/>
                                <field name="l10n_pe_fourth_category_rate"/>
                            </div>
                            <div class="row">
                                <label for="l10n_pe_fourth_category_threshold" class="col-lg-5 o_light_label"/>
                                <field name="l10n_pe_fourth_category_threshold"/>
                            </div>
                            <div class="row">
                                <label for="l10n_pe_fourth_category_account_id" class="col-lg-5 o_light_label"/>
                                <field name="l10n_pe_fourth_category_account_id"
                                       placeholder="40172 del plan contable"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
