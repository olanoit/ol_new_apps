<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_fourth_category" model="ir.ui.view">
        <field name="name">account.move.form.fourth.category</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="al_account_base.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook[@name='l10n_pe_accounting_notebook']" position="inside">
                <page string="Renta de 4.ª categoría" name="l10n_pe_fourth_category"
                      invisible="not l10n_pe_fourth_category_receipt">
                    <field name="l10n_pe_fourth_category_receipt" invisible="1"/>
                    <group>
                        <group>
                            <field name="l10n_pe_fourth_category_status"/>
                            <field name="l10n_pe_fourth_category_amount"
                                   invisible="l10n_pe_fourth_category_status != 'withheld'"/>
                        </group>
                        <group>
                            <field name="l10n_pe_fourth_category_suspension_id"
                                   invisible="not l10n_pe_fourth_category_suspension_id"/>
                        </group>
                    </group>
                    <div class="text-muted small">
                        Se retiene el 8 % del importe total del recibo cuando supera S/ 1 500 y el
                        prestador no entregó la constancia de suspensión (Formulario Virtual
                        1609). La retención se declara en la PLAME del mes en que se paga el recibo.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_in_invoice_list_fourth_category" model="ir.ui.view">
        <field name="name">account.move.list.fourth.category</field>
        <field name="model">account.move</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <field name="amount_total_in_currency_signed" position="before">
                <field name="l10n_pe_fourth_category_status" optional="show"/>
                <field name="l10n_pe_fourth_category_amount" optional="show" sum="Total retenido"/>
            </field>
        </field>
    </record>

    <!-- Recibos por honorarios (documento 02) de proveedores. -->
    <record id="action_fourth_category_receipts" model="ir.actions.act_window">
        <field name="name">Recibos por honorarios</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('l10n_pe_fourth_category_receipt', '=', True)]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('view_in_invoice_list_fourth_category')}),
            Command.create({'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
    </record>
</odoo>
