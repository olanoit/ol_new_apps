        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fourth_category_certificate_company" model="ir.rule">
        <field name="name">Certificado de 4.ª: compañías permitidas</field>
        <field name="model_id" ref="model_l10n_pe_fourth_category_certificate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
