<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Consulta de tickets SIRE. Cada solicitud programa su propia
         ejecución (ir.cron.trigger) con espera creciente; el intervalo
         es solo una red de seguridad. -->
    <record id="ir_cron_sire_rvie_poll" model="ir.cron">
        <field name="name">SIRE: consultar tickets del RVIE</field>
        <field name="model_id" ref="model_l10n_pe_sire_rvie"/>
        <field name="state">code</field>
        <field name="code">model._cron_sire_poll_tickets()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_sire_rce_poll" model="ir.cron">
        <field name="name">SIRE: consultar tickets del RCE</field>
        <field name="model_id" ref="model_l10n_pe_sire_rce"/>
        <field name="state">code</field>
        <field name="code">model._cron_sire_poll_tickets()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
