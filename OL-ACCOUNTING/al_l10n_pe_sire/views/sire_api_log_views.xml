<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sire_api_log_list" model="ir.ui.view">
        <field name="name">l10n_pe.sire.api.log.list</field>
        <field name="model">l10n_pe.sire.api.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="is_error">
                <field name="date"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="status_code"/>
                <field name="duration" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="is_error" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_sire_api_log_form" model="ir.ui.view">
        <field name="name">l10n_pe.sire.api.log.form</field>
        <field name="model">l10n_pe.sire.api.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="method"/>
                            <field name="endpoint"/>
                            <field name="url"/>
                        </group>
                        <group>
                            <field name="status_code"/>
                            <field name="duration"/>
                            <field name="is_error"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" widget="many2one_reference" invisible="not res_model"/>
                        </group>
                    </group>
                    <field name="response" class="font-monospace"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sire_api_log_search" model="ir.ui.view">
        <field name="name">l10n_pe.sire.api.log.search</field>
        <field name="model">l10n_pe.sire.api.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="endpoint"/>
                <field name="user_id"/>
                <filter name="filter_error" string="Con error" domain="[('is_error', '=', True)]"/>
                <filter name="filter_date" string="Fecha" date="date"/>
                <group>
                    <filter name="group_endpoint" string="Servicio" context="{'group_by': 'endpoint'}"/>
                    <filter name="group_status" string="HTTP" context="{'group_by': 'status_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sire_api_log" model="ir.actions.act_window">
        <field name="name">Bitácora de la API SIRE</field>
        <field name="res_model">l10n_pe.sire.api.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay llamadas a la API del SIRE</p>
            <p>Cada llamada a SUNAT queda aquí con su respuesta durante 90 días.</p>
        </field>
    </record>

</odoo>
