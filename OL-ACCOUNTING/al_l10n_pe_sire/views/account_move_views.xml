<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_sire" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sire</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- «Contabilidad PE ▸ Registros electrónicos» (al_account_base). -->
            <xpath expr="//group[@name='l10n_pe_books_right']" position="inside">
                <group string="SIRE" name="l10n_pe_sire_group" colspan="2"
                       invisible="move_type not in ('in_invoice', 'in_refund')">
                    <field name="l10n_pe_sire_goods_class"/>
                    <field name="l10n_pe_sire_is_non_domiciled"/>
                </group>
            </xpath>
            <xpath expr="//notebook[@name='l10n_pe_accounting_notebook']" position="inside">
                <page string="No domiciliado (SIRE)" name="l10n_pe_sire_non_domiciled"
                      invisible="not l10n_pe_sire_is_non_domiciled">
                    <group>
                        <group string="Renta">
                            <field name="l10n_pe_sire_nd_income_type" required="l10n_pe_sire_is_non_domiciled"/>
                            <field name="l10n_pe_sire_nd_agreement" required="l10n_pe_sire_is_non_domiciled"/>
                            <field name="l10n_pe_sire_nd_service_modality"/>
                            <field name="l10n_pe_sire_nd_exemption"/>
                            <field name="l10n_pe_sire_nd_art76"/>
                            <field name="l10n_pe_sire_nd_gross_income"/>
                            <field name="l10n_pe_sire_nd_deduction"/>
                            <field name="l10n_pe_sire_nd_net_income"/>
                            <field name="l10n_pe_sire_nd_withholding_rate"/>
                            <field name="l10n_pe_sire_nd_withheld_tax"/>
                        </group>
                        <group string="Crédito fiscal y vinculación">
                            <field name="l10n_pe_sire_nd_credit_move_id"/>
                            <field name="l10n_pe_sire_nd_igv_withholding"/>
                            <field name="l10n_pe_sire_nd_link"/>
                            <field name="l10n_pe_sire_nd_beneficiary_vat"/>
                            <field name="l10n_pe_sire_nd_beneficiary_name"/>
                            <field name="l10n_pe_sire_nd_beneficiary_country_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
