<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sire_operation_list" model="ir.ui.view">
        <field name="name">l10n_pe.sire.operation.list</field>
        <field name="model">l10n_pe.sire.operation</field>
        <field name="arch" type="xml">
            <list create="0" delete="0"
                  decoration-danger="state == 'error'"
                  decoration-muted="state == 'done'">
                <field name="date"/>
                <field name="kind"/>
                <field name="ticket"/>
                <field name="ticket_state" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'sent'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"/>
                <field name="detail" optional="show"/>
                <field name="report_ids" widget="many2many_binary" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="poll_next_date" optional="hide"/>
                <button name="action_check" type="object" string="Consultar"
                        icon="fa-refresh" invisible="not ticket or state != 'sent'"
                        groups="account.group_account_user"/>
                <button name="action_download_file" type="object" string="Archivo"
                        icon="fa-download" invisible="not filename"/>
                <field name="filename" column_invisible="1"/>
                <field name="can_send_adjustment" column_invisible="1"/>
                <button name="action_send_adjustment" type="object" string="Enviar ajustes"
                        icon="fa-paper-plane" invisible="not can_send_adjustment"
                        groups="account.group_account_user"/>
            </list>
        </field>
    </record>

    <record id="view_sire_operation_form" model="ir.ui.view">
        <field name="name">l10n_pe.sire.operation.form</field>
        <field name="model">l10n_pe.sire.operation</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_check" type="object" string="Consultar ticket"
                            class="btn-primary" invisible="not ticket or state != 'sent'"
                            groups="account.group_account_user"/>
                    <field name="can_send_adjustment" invisible="1"/>
                    <button name="action_send_adjustment" type="object" string="Enviar ajustes a SUNAT"
                            class="btn-primary" invisible="not can_send_adjustment"
                            groups="account.group_account_user"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="ticket"/>
                            <field name="ticket_state"/>
                            <field name="poll_next_date" invisible="not poll_next_date"/>
                            <field name="filename" invisible="1"/>
                            <field name="file" filename="filename" invisible="not file"/>
                            <field name="adjustment_kind" invisible="not adjustment_kind"/>
                            <field name="adjustment_number" invisible="not adjustment_kind"
                                   readonly="adjustment_sent"/>
                            <field name="adjustment_sent" invisible="not adjustment_kind"/>
                        </group>
                    </group>
                    <field name="detail"/>
                    <field name="report_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>
