<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sire_rvie_line_list" model="ir.ui.view">
        <field name="name">l10n_pe.sire.rvie.line.list</field>
        <field name="model">l10n_pe.sire.rvie.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="check_detail"
                  decoration-info="compare_state == '1'">
                <field name="type_line"/>
                <field name="compare_state" widget="badge" optional="show"/>
                <field name="car_sunat" optional="show"/>
                <field name="fecha_emision"/>
                <field name="tipo_cp"/>
                <field name="serie_cp"/>
                <field name="nro_cp"/>
                <field name="nro_doc_identidad" optional="show"/>
                <field name="razon_social" optional="show"/>
                <field name="bi_gravada" sum="Total"/>
                <field name="igv_ipm" sum="Total"/>
                <field name="total_cp" sum="Total"/>
                <field name="moneda" optional="show"/>
                <field name="tipo_cambio" optional="hide"/>
                <field name="check_detail" optional="show"/>
                <field name="diff_detail" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sire_rvie_line_search" model="ir.ui.view">
        <field name="name">l10n_pe.sire.rvie.line.search</field>
        <field name="model">l10n_pe.sire.rvie.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="serie_cp"/>
                <field name="nro_cp"/>
                <field name="nro_doc_identidad"/>
                <field name="car_sunat"/>
                <filter name="filter_sire" string="Propuesta SUNAT" domain="[('type_line', '=', 'sire')]"/>
                <filter name="filter_system" string="Sistema" domain="[('type_line', '=', 'system')]"/>
                <separator/>
                <filter name="filter_diff" string="Con diferencias"
                        domain="[('compare_state', 'in', ('1', '2', '3'))]"/>
                <filter name="filter_invalid" string="Con observaciones"
                        domain="[('check_detail', '!=', False)]"/>
                <group>
                    <filter name="group_type_line" string="Origen" context="{'group_by': 'type_line'}"/>
                    <filter name="group_compare_state" string="Comparación"
                            context="{'group_by': 'compare_state'}"/>
                </group>
            </search>
        </field>
    </record>

