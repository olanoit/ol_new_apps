                <field name="bi_gravada_dg" sum="Total"/>
                <field name="igv_dg" sum="Total"/>
                <field name="bi_gravada_dgng" sum="Total" optional="hide"/>
                <field name="bi_gravada_dng" sum="Total" optional="hide"/>
                <field name="total_cp" sum="Total"/>
                <field name="moneda" optional="show"/>
                <field name="tipo_cambio" optional="hide"/>
                <field name="check_detail" optional="show"/>
                <field name="diff_detail" optional="hide"/>
            </list>
        </field>
    </record>

