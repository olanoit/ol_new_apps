<odoo>

    <record id="res_groups_privilege_sire" model="res.groups.privilege">
        <field name="name">SIRE</field>
        <field name="sequence">70</field>
    </record>

    <!-- Quien prepara el periodo no es quien lo declara: aceptar, reemplazar,
         registrar el preliminar, enviar ajustes y cerrar queda para el
         aprobador. Lo tienen los administradores de contabilidad. -->
    <record id="group_sire_approver" model="res.groups">
        <field name="name">Aprobador SIRE</field>
        <field name="comment">Env&#237;a a SUNAT (aceptaci&#243;n, reemplazo, preliminar, ajustes), cierra y reabre los periodos y ve la bit&#225;cora de la API.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_sire"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sire_approver'))]"/>
    </record>

    </odoo>
