<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sire_reopen_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pe.sire.reopen.wizard.form</field>
        <field name="model">l10n_pe.sire.reopen.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    El motivo queda en el historial del periodo. Lo enviado a SUNAT no
                    se deshace: las correcciones de un periodo ya generado van como
                    ajustes posteriores.
                </p>
                <field name="reason" placeholder="¿Por qué se reabre el periodo?"/>
                <footer>
                    <button name="action_apply" type="object" string="Reabrir" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
