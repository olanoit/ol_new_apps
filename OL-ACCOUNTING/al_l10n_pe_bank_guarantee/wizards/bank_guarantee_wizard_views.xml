<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_guarantee_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pe.bank.guarantee.wizard.form</field>
        <field name="model">l10n_pe.bank.guarantee.wizard</field>
        <field name="arch" type="xml">
            <form string="Carta fianza">
                <group>
                    <group>
                        <field name="guarantee_id" readonly="1"/>
                        <field name="operation" invisible="1"/>
                        <field name="direction" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="date"/>
                        <field name="date_end" invisible="operation != 'renew'" required="operation == 'renew'"/>
                    </group>
                    <group>
                        <field name="amount"/>
                        <field name="commission" invisible="operation != 'renew' or direction != 'issued'"/>
                        <field name="journal_id" options="{'no_create': True}"
                               invisible="operation != 'execute'" required="operation == 'execute'"/>
                        <field name="account_id" options="{'no_create': True}"
                               invisible="operation != 'execute'" required="operation == 'execute'"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
