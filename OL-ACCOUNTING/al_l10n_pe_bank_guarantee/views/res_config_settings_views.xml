<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bank_guarantee" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.al.bank.guarantee</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="61"/>
        <field name="inherit_id" ref="al_l10n_pe_treasury.res_config_settings_view_form_treasury"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='pe_treasury_block']" position="inside">
                <setting company_dependent="1" string="Cartas fianza en cuentas de orden"
                         help="Registra cada carta fianza vigente en cuentas de orden (elemento 0 del PCGE) y la extorna al liberarla o ejecutarla.">
                    <field name="l10n_pe_guarantee_memo"/>
                    <div class="content-group" invisible="not l10n_pe_guarantee_memo">
                        <div class="row mt8">
                            <label for="l10n_pe_guarantee_memo_journal_id" string="Diario" class="col-lg-5 o_light_label"/>
                            <field name="l10n_pe_guarantee_memo_journal_id" options="{'no_create': True}"/>
                        </div>
                        <div class="row">
                            <label for="l10n_pe_guarantee_issued_debit_id" string="Emitidas (debe)" class="col-lg-5 o_light_label"/>
                            <field name="l10n_pe_guarantee_issued_debit_id" options="{'no_create': True}" placeholder="0113"/>
                        </div>
                        <div class="row">
                            <label for="l10n_pe_guarantee_issued_credit_id" string="Emitidas (haber)" class="col-lg-5 o_light_label"/>
                            <field name="l10n_pe_guarantee_issued_credit_id" options="{'no_create': True}" placeholder="0114"/>
                        </div>
                        <div class="row">
                            <label for="l10n_pe_guarantee_received_debit_id" string="Recibidas (debe)" class="col-lg-5 o_light_label"/>
                            <field name="l10n_pe_guarantee_received_debit_id" options="{'no_create': True}" placeholder="0129"/>
                        </div>
                        <div class="row">
                            <label for="l10n_pe_guarantee_received_credit_id" string="Recibidas (haber)" class="col-lg-5 o_light_label"/>
                            <field name="l10n_pe_guarantee_received_credit_id" options="{'no_create': True}" placeholder="0126"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
