<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Diario: aviso antes del vencimiento (en las recibidas, con el plazo del
         art. 1898 del Código Civil) y paso a vencidas. -->
    <record id="ir_cron_bank_guarantees" model="ir.cron">
        <field name="name">Tesorería: vencimiento de cartas fianza</field>
        <field name="model_id" ref="model_l10n_pe_bank_guarantee"/>
        <field name="state">code</field>
        <field name="code">model._cron_l10n_pe_bank_guarantees()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
