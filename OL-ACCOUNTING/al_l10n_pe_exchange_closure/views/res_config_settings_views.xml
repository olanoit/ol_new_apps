<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_exchange_closure" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.al.exchange.closure</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="62"/>
        <field name="inherit_id"
               ref="al_account_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='al_account_base']" position="inside">
                <block title="Cierre de tipo de cambio"
                       name="pe_exchange_closure_block">
                    <setting string="Diario del cierre"
                             help="Diario general donde se registran los asientos mensuales de ajuste por diferencia de cambio. Conviene uno dedicado (p. ej. CTC) para aislarlos en los reportes. Las cuentas de resultado son las de diferencia de cambio de la compañía (676 / 776).">
                        <field name="l10n_pe_exchange_closing_journal_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
