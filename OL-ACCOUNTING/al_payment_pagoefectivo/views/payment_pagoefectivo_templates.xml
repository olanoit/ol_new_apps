<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="redirect_form">
        <!-- Página del CIP en PagoEfectivo; sus parámetros van como campos para no perderlos. -->
        <form t-att-action="api_url" method="get">
            <t t-foreach="url_params or {}" t-as="param">
                <input type="hidden" t-att-name="param" t-att-value="url_params[param]"/>
            </t>
        </form>
    </template>

</odoo>
