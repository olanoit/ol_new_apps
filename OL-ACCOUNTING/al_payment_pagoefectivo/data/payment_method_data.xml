<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Odoo 20: cada método de pago pertenece a una pasarela (provider_id). -->


    <!-- PagoEfectivo: código de pago (CIP) que el cliente paga en efectivo en
         agentes y bodegas, o desde la banca por internet y las billeteras. -->
    <record id="payment_method_pagoefectivo" model="payment.method">
        <field name="name">PagoEfectivo</field>
        <field name="code">pagoefectivo</field>
        <field name="provider_id" ref="payment_provider_pagoefectivo"/>
        <field name="sequence">30</field>
        <field name="active">False</field>
        <field name="image" type="bytes" file="al_payment_pagoefectivo/static/img/pagoefectivo.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">none</field>
        <field name="support_refund">none</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.pe')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.PEN'), ref('base.USD')])]"/>
    </record>
</odoo>
