<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_culqi" model="payment.provider">
        <field name="name">Culqi</field>
        <field name="code">culqi</field>
        <field name="image_128" type="base64" file="al_payment_culqi/static/description/icon.png"/>
        <field name="module_id" ref="base.module_al_payment_culqi"/>
        <field name="inline_form_view_id" ref="inline_form"/>
        <field name="available_country_ids" eval="[Command.set([ref('base.pe')])]"/>
        <field name="payment_method_ids"
               eval="[Command.set([ref('payment.payment_method_card'), ref('payment_method_yape')])]"/>
    </record>

</odoo>
