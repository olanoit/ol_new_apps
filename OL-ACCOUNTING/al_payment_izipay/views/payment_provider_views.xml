<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form.izipay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'izipay'" name="izipay_credentials">
                    <field name="izipay_shop_id" required="code == 'izipay' and active"
                           placeholder="89289758"/>
                    <field name="izipay_password" required="code == 'izipay' and active"
                           password="True" placeholder="testpassword_…" groups="base.group_system"/>
                    <field name="izipay_public_key" required="code == 'izipay' and active"
                           placeholder="89289758:testpublickey_…"/>
                    <field name="izipay_webhook_url" widget="CopyClipboardChar"/>
                    <div colspan="2" class="text-muted small">
                        Las claves están en el Back Office Vendedor de Izipay ▸ Configuración ▸
                        Tienda ▸ Claves de la API REST. En «Modo de prueba» use las de test
                        (testpassword_…/testpublickey_…); en «Activado», las de producción.
                        Odoo envía la URL de notificación (IPN) en cada pago.
                    </div>
                </group>
            </group>
        </field>
    </record>

</odoo>
