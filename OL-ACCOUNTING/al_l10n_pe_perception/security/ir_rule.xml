<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multicompañía: cada compañía ve solo sus percepciones. -->
        <record id="rule_perception_company" model="ir.rule">
            <field name="name">Comprobantes de percepción: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_perception"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_perception_line_company" model="ir.rule">
            <field name="name">Comprobantes de percepción (facturas): multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_perception_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_perception_received_company" model="ir.rule">
            <field name="name">Percepciones que nos cobran: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_perception_received"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_perception_received_line_company" model="ir.rule">
            <field name="name">Percepciones que nos cobran (comprobantes): multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_perception_received_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
