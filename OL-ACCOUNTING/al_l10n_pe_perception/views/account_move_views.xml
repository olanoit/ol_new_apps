<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_perception" model="ir.ui.view">
        <field name="name">account.move.form.perception.pe</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_l10n_pe_register_perception" type="object"
                        string="Registrar percepción"
                        invisible="move_type != 'in_invoice' or state != 'posted' or country_code != 'PE'"
                        groups="account.group_account_user"
                        help="La factura consigna la percepción que nos cobra el proveedor: registra el crédito para el F.V. 621."/>
            </xpath>
            <!-- Pestaña interna de «Facturación PE» (al_account_base). -->
            <xpath expr="//notebook[@name='l10n_pe_invoicing_notebook']" position="inside">
                <page string="Percepción IGV" name="l10n_pe_perception"
                      invisible="move_type != 'out_invoice' or (not l10n_pe_perception_code and not l10n_pe_perception_note)">
                    <group>
                        <group>
                            <field name="l10n_pe_perception_code"/>
                            <field name="l10n_pe_perception_rate" invisible="not l10n_pe_perception_code"/>
                            <field name="l10n_pe_perception_note" invisible="not l10n_pe_perception_note"/>
                        </group>
                        <group>
                            <field name="l10n_pe_perception_base"/>
                            <field name="l10n_pe_perception_base_pen"/>
                            <field name="l10n_pe_perception_amount"/>
                            <field name="l10n_pe_perception_collected"/>
                        </group>
                    </group>
                    <field name="l10n_pe_perception_line_ids" readonly="1">
                        <list>
                            <field name="perception_id" string="Comprobante de percepción"/>
                            <field name="paid_amount"/>
                            <field name="collected_pen" sum="Cobrado"/>
                            <field name="perception_pen" sum="Percibido"/>
                            <field name="invoice_currency_id" column_invisible="1"/>
                            <field name="company_currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
                <page string="Percepciones que nos cobraron" name="l10n_pe_perception_received"
                      invisible="move_type != 'in_invoice' or not l10n_pe_perception_received_line_ids">
                    <field name="l10n_pe_perception_received_line_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="received_id"/>
                            <field name="amount" sum="Percibido"/>
                            <field name="state" widget="badge" decoration-success="state == 'posted'"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_list_perception" model="ir.ui.view">
        <field name="name">account.move.list.perception.pe</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Facturas sujetas a percepción" create="false" sample="1">
                <field name="company_currency_id" column_invisible="1"/>
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="l10n_pe_perception_code" optional="show"/>
                <field name="l10n_pe_perception_base_pen" sum="Base" optional="show"/>
                <field name="l10n_pe_perception_amount" sum="Estimado"/>
                <field name="l10n_pe_perception_collected" optional="show"/>
                <field name="payment_state" widget="badge" optional="show"
                       decoration-success="payment_state in ('paid', 'in_payment')"
                       decoration-warning="payment_state == 'partial'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="action_perception_invoices" model="ir.actions.act_window">
        <field name="name">Facturas sujetas a percepción</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_out_invoice_list_perception')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('l10n_pe_perception_code', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin facturas sujetas a percepción</p>
            <p>Aparecen las facturas de venta con bienes del régimen cuando la compañía
               es agente de percepción. Elija las cobradas de un cliente y use
               «Acciones ▸ Emitir comprobante de percepción».</p>
        </field>
    </record>

    <record id="action_server_perception_from_invoices" model="ir.actions.server">
        <field name="name">Emitir comprobante de percepción</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['l10n_pe.perception'].with_context(active_ids=records.ids).action_create_from_invoices()</field>
    </record>

    <record id="view_account_payment_form_perception" model="ir.ui.view">
        <field name="name">account.payment.form.perception.pe</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_l10n_pe_create_perception" type="object"
                        string="Comprobante de percepción"
                        invisible="payment_type != 'inbound' or partner_type != 'customer' or state in ('draft', 'canceled', 'rejected') or l10n_pe_perception_count"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_l10n_pe_view_perceptions" type="object" class="oe_stat_button"
                        icon="article" invisible="not l10n_pe_perception_count">
                    <field name="l10n_pe_perception_count" string="Percepciones" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
