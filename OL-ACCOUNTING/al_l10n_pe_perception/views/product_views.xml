<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_perception" model="ir.ui.view">
        <field name="name">product.template.form.perception.pe</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']/group[@name='properties']" position="after">
                <group name="l10n_pe_perception" string="Percepción del IGV"
                       invisible="'PE' not in fiscal_country_codes">
                    <group>
                        <field name="l10n_pe_perception_type"/>
                    </group>
                    <group>
                        <div class="text-muted" colspan="2">
                            Bien sujeto al régimen de percepciones: la factura de venta
                            calcula la percepción cuando la compañía es agente.
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_perception" model="ir.ui.view">
        <field name="name">product.template.search.perception.pe</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="before">
                <filter string="Sujetos a percepción" name="l10n_pe_perception"
                        domain="[('l10n_pe_perception_type', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
