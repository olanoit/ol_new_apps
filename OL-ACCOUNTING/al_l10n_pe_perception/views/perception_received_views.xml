<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Percepciones que nos cobran (crédito para el F.V. 621) -->
    <record id="view_perception_received_list" model="ir.ui.view">
        <field name="name">l10n_pe.perception.received.list</field>
        <field name="model">l10n_pe.perception.received</field>
        <field name="arch" type="xml">
            <list sample="1" decoration-muted="state == 'cancel'">
                <field name="currency_id" column_invisible="1"/>
                <field name="date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="kind" optional="show"/>
                <field name="document_kind" optional="show"/>
                <field name="amount" sum="Percibido"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'" decoration-info="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_perception_received_form" model="ir.ui.view">
        <field name="name">l10n_pe.perception.received.form</field>
        <field name="model">l10n_pe.perception.received</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Registrar"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Anular"
                            invisible="state != 'posted'"/>
                    <button name="action_draft" type="object" string="Pasar a borrador"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button"
                                icon="fa-book" string="Asiento" invisible="not move_id"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="state != 'draft'" placeholder="P001-00000123"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="document_kind" readonly="state != 'draft'"/>
                            <field name="kind" readonly="state != 'draft'"/>
                            <field name="l10n_pe_series" readonly="state != 'draft'"/>
                            <field name="l10n_pe_number" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="journal_id" readonly="state != 'draft'"
                                   placeholder="El de los ajustes"/>
                            <field name="move_id" invisible="not move_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="company_id" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="bill_id"/>
                            <field name="reference" optional="show"/>
                            <field name="base_amount" sum="Cobrado"/>
                            <field name="amount" sum="Percibido"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_perception_received_search" model="ir.ui.view">
        <field name="name">l10n_pe.perception.received.search</field>
        <field name="model">l10n_pe.perception.received</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Registradas" name="posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter string="Importación" name="import" domain="[('kind', '=', 'import')]"/>
                <filter string="Fecha" name="date" date="date"/>
                <group>
                    <filter string="Agente de percepción" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Régimen" name="group_kind" context="{'group_by': 'kind'}"/>
                    <filter string="Periodo" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_perception_received_pivot" model="ir.ui.view">
        <field name="name">l10n_pe.perception.received.pivot</field>
        <field name="model">l10n_pe.perception.received</field>
        <field name="arch" type="xml">
            <pivot string="Percepciones por aplicar (F.V. 621)" sample="1">
                <field name="date" interval="month" type="row"/>
                <field name="kind" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_perception_received" model="ir.actions.act_window">
        <field name="name">Percepciones que nos cobran</field>
        <field name="res_model">l10n_pe.perception.received</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre una percepción que le cobraron</p>
            <p>Desde el comprobante de percepción del proveedor, la factura que la consigna
               («Registrar percepción» en la factura de proveedor) o la DUA de una
               importación. Lo registrado se aplica en el F.V. 621.</p>
        </field>
    </record>

    <record id="action_perception_received_fv621" model="ir.actions.act_window">
        <field name="name">Resumen F.V. 621</field>
        <field name="res_model">l10n_pe.perception.received</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="domain">[('state', '=', 'posted')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin percepciones registradas</p>
            <p>Percepciones que nos cobraron por periodo, para aplicarlas contra el IGV
               del F.V. 621; el saldo no aplicado se arrastra.</p>
        </field>
    </record>
</odoo>
