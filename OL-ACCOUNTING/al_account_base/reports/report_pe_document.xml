<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- El encabezado y el pie comunes viven en al_report_base (formato de
         todos los documentos de la suite). Estos alias conservan los
         identificadores que usan los comprobantes, la guía de remisión y el
         comprobante de retención. -->
    <template id="report_pe_document_header">
        <t t-call="al_report_base.report_pe_document_header"><t t-out="0"/></t>
    </template>

    <template id="report_pe_document_footer">
        <t t-call="al_report_base.report_pe_document_footer"/>
    </template>
</odoo>
