<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_advances" model="ir.ui.view">
        <field name="name">account.move.form.inherit.pe.advances</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_l10n_pe_apply_advances" type="object" class="oe_stat_button"
                        icon="payments" invisible="not l10n_pe_advance_count"
                        groups="account.group_account_user">
                    <field name="l10n_pe_advance_count" widget="statinfo" string="Anticipos"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
