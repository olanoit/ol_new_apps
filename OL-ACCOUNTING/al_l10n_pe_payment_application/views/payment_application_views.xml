<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_application_form" model="ir.ui.view">
        <field name="name">l10n_pe.payment.application.form</field>
        <field name="model">l10n_pe.payment.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_documents" type="object" string="Cargar documentos"
                            invisible="state != 'draft'"/>
                    <button name="action_distribute" type="object" string="Distribuir"
                            invisible="state != 'draft'"/>
                    <button name="action_clean" type="object" string="Quitar sin importe"
                            invisible="state != 'draft'"/>
                    <button name="action_post" type="object" string="Aplicar" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Revertir"
                            invisible="state != 'posted'" groups="account.group_account_manager"
                            confirm="Se crea el asiento inverso y se desconcilian los documentos. ¿Continuar?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_move" type="object" class="oe_stat_button"
                                icon="menu" invisible="not move_id" string="Asiento"/>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="application_type" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="move_id" invisible="not move_id"/>
                            <field name="reversal_move_id" invisible="not reversal_move_id"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom" decoration-muted="not amount">
                            <field name="move_line_id" column_invisible="True"/>
                            <field name="move_id"/>
                            <field name="account_id"/>
                            <field name="date" optional="hide"/>
                            <field name="date_maturity" optional="show"/>
                            <field name="side"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="company_currency_id" column_invisible="True"/>
                            <field name="residual"/>
                            <field name="amount"/>
                            <field name="amount_company" optional="show" sum="Total"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="company_currency_id" invisible="1"/>
                        <field name="amount_debit"/>
                        <field name="amount_credit"/>
                        <field name="amount_difference" decoration-danger="amount_difference"/>
                    </group>
                    <field name="note" placeholder="Notas"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_payment_application_list" model="ir.ui.view">
        <field name="name">l10n_pe.payment.application.list</field>
        <field name="model">l10n_pe.payment.application</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="application_type"/>
                <field name="amount_debit" sum="Total"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="view_payment_application_search" model="ir.ui.view">
        <field name="name">l10n_pe.payment.application.search</field>
        <field name="model">l10n_pe.payment.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="posted" string="Aplicado" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter name="type_advance" string="Anticipos" domain="[('application_type', '=', 'advance')]"/>
                <filter name="type_netting" string="Compensaciones" domain="[('application_type', '=', 'netting')]"/>
                <group>
                    <filter name="group_partner" string="Socio" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'application_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payment_application" model="ir.actions.act_window">
        <field name="name">Aplicación de documentos</field>
        <field name="res_model">l10n_pe.payment.application</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aplique anticipos y compense documentos</p>
            <p>Elija el socio, cargue sus documentos abiertos e indique cuánto aplicar de cada uno.</p>
        </field>
    </record>

    <!-- Anticipos pendientes: apuntes con saldo en las cuentas de anticipos. -->
    <record id="view_pending_advances_list" model="ir.ui.view">
        <field name="name">account.move.line.pending.advances.list</field>
        <field name="model">account.move.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="amount_residual_currency" string="Saldo (moneda)"/>
                <field name="amount_residual" string="Saldo (M.N.)" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_pending_advances" model="ir.actions.server">
        <field name="name">Anticipos pendientes</field>
        <field name="model_id" ref="model_l10n_pe_payment_application"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_pending_advances()</field>
    </record>
    <record id="action_pending_advances_customer" model="ir.actions.server">
        <field name="name">Anticipos de clientes pendientes</field>
        <field name="model_id" ref="model_l10n_pe_payment_application"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_pending_advances('customer')</field>
    </record>
    <record id="action_pending_advances_supplier" model="ir.actions.server">
        <field name="name">Anticipos a proveedores pendientes</field>
        <field name="model_id" ref="model_l10n_pe_payment_application"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_pending_advances('supplier')</field>
    </record>
</odoo>
