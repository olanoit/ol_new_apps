<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Clasificación de los bienes y servicios adquiridos (campo 33 del RCE 8.4) -->
    <record id="view_product_template_form_rce" model="ir.ui.view">
        <field name="name">product.template.form.rce.classification</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="property_account_expense_id" position="after">
                <!-- `fiscal_country_codes` es el campo que la vista de account
                     deja disponible para esconder lo específico de un país.
                     `parent` aquí no existe: el campo está en la página de
                     Contabilidad del producto, no dentro de una lista. -->
                <field name="l10n_pe_rce_classification"
                       invisible="'PE' not in fiscal_country_codes"/>
            </field>
        </field>
    </record>

    <!-- Datos del RCE en la factura de proveedor -->
    <record id="view_move_form_rce" model="ir.ui.view">
        <field name="name">account.move.form.rce</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- «Contabilidad PE ▸ Registros electrónicos» (al_account_base). -->
            <xpath expr="//group[@name='l10n_pe_books_left']" position="inside">
                <group string="Registro de compras (PLE)" name="l10n_pe_rce_group" colspan="2"
                       invisible="move_type not in ('in_invoice', 'in_refund')">
                    <field name="l10n_pe_rce_classification"/>
                    <field name="l10n_pe_rce_status"/>
                </group>
            </xpath>
            <!-- De l10n_pe_reports: importación / no domiciliado (8.2) y el tipo
                 de transacción de los asientos, debajo de las columnas. -->
            <xpath expr="//group[@name='l10n_pe_books_group']" position="after">
                <xpath expr="//group[@name='l10n_pe_group_foreign']" position="move"/>
                <xpath expr="//group[@name='l10n_pe_sunat_transaction_type']" position="move"/>
            </xpath>
            <xpath expr="//group[@name='l10n_pe_group_foreign']" position="attributes">
                <attribute name="string">Importación y no domiciliados (PLE)</attribute>
            </xpath>
            <!-- Solo en asientos, como en su sitio original (pestaña del asiento). -->
            <xpath expr="//group[@name='l10n_pe_sunat_transaction_type']" position="attributes">
                <attribute name="invisible">country_code != 'PE' or move_type != 'entry'</attribute>
            </xpath>
        </field>
    </record>

</odoo>
