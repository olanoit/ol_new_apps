    <record id="pe_action_worksheet_format_2" model="ir.actions.client">
        <field name="name">Hoja de trabajo (formato 2)</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('pe_worksheet_format_2')}"/>
    </record>
</odoo>
