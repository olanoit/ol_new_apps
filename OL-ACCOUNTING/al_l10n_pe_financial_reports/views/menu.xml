<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú nativo de Contabilidad ▸ Informes, como en el v18. -->
    <menuitem id="menu_statement_changes_equity"
              name="3.19 Estado de Cambios en el Patrimonio Neto"
              parent="account.account_reports_legal_statements_menu"
              action="pe_action_statement_changes_equity"
              groups="account.group_account_readonly,account.group_account_basic"
              sequence="100"/>

    <!-- App Perú: todos los estados financieros en un grupo. Balance y Estado
         de resultados son los de Enterprise (con su variante peruana). -->
    <menuitem id="menu_pe_financial_statements" name="Estados financieros"
              parent="al_account_base.al_l10n_pe_menu_reporting"
              groups="account.group_account_readonly,account.group_account_basic"
              sequence="10"/>

    <menuitem id="menu_pe_balance_sheet" name="Balance"
              parent="menu_pe_financial_statements"
              action="account_reports.action_account_report_bs"
              sequence="10"/>

    <menuitem id="menu_pe_profit_and_loss" name="Estado de resultados"
              parent="menu_pe_financial_statements"
              action="account_reports.action_account_report_pl"
              sequence="20"/>

    <menuitem id="menu_pe_statement_changes_equity"
              name="3.19 Estado de Cambios en el Patrimonio Neto"
              parent="menu_pe_financial_statements"
              action="pe_action_statement_changes_equity"
              sequence="30"/>

    <menuitem id="menu_pe_worksheet_format_1"
              name="Hoja de trabajo (formato 1)"
              parent="menu_pe_financial_statements"
              action="pe_action_worksheet_format_1"
              sequence="40"/>

    <menuitem id="menu_pe_worksheet_format_2"
              name="Hoja de trabajo (formato 2)"
              parent="menu_pe_financial_statements"
              action="pe_action_worksheet_format_2"
              sequence="50"/>

    <!-- Contabilidad ▸ Cierre del mes: el cierre del ejercicio va con los
         demás procesos de cierre. -->
    <menuitem id="menu_pe_year_closing"
              name="Cierre del ejercicio"
              parent="al_account_base.al_l10n_pe_accounting_closing"
              action="action_l10n_pe_year_closing_wizard"
              groups="account.group_account_manager"
              sequence="90"/>

    <menuitem id="menu_pe_closing_rules"
              name="Reglas del cierre del ejercicio"
              parent="al_account_base.al_l10n_pe_config_accounting"
              action="action_l10n_pe_closing_rule"
              groups="account.group_account_manager"
              sequence="90"/>
</odoo>
