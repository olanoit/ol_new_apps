<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_factoring_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pe.factoring.wizard.form</field>
        <field name="model">l10n_pe.factoring.wizard</field>
        <field name="arch" type="xml">
            <form string="Operación con el factor">
                <field name="factoring_id" invisible="1"/>
                <field name="operation" invisible="1"/>
                <field name="modality" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="available_line_ids" invisible="1"/>
                <field name="single_line" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="operation != 'disburse'">
                    El factor abona el adelanto menos intereses, comisión y gastos.
                    <span invisible="modality != 'with_recourse'">Con recurso, el adelanto queda como
                        obligación con el factor y los intereses se devengan durante el plazo.</span>
                </div>
                <div class="alert alert-info" role="alert" invisible="operation != 'settle'">
                    El cliente pagó al factor (todo o una parte). Lo cobrado cubre primero el adelanto y
                    después libera el retenido, que el factor abona.
                    <span invisible="modality != 'with_recourse'">Con recurso, la factura se cancela por lo
                        cobrado.</span>
                    Para un cobro parcial, deje una sola factura e indique el importe cobrado.
                </div>
                <div class="alert alert-warning" role="alert" invisible="operation != 'repurchase'">
                    El cliente no pagó: se devuelve al factor el adelanto que lo cobrado no cubrió. La
                    factura sigue pendiente de cobro a nombre del cliente.
                </div>
                <div class="alert alert-warning" role="alert" invisible="operation != 'write_off'">
                    Sin recurso el factor asume el impago, pero el retenido solo se libera si el cliente
                    paga: el retenido pendiente de estas facturas pasa a pérdida.
                </div>
                <group>
                    <group>
                        <field name="date"/>
                        <field name="bank_journal_id" invisible="operation == 'accrue'"
                               required="operation != 'accrue'" options="{'no_create': True}"/>
                        <field name="amount" invisible="operation != 'accrue'"/>
                        <field name="collect_amount" invisible="operation != 'settle' or not single_line"/>
                    </group>
                    <group invisible="operation in ('accrue', 'write_off')">
                        <field name="advance_amount" invisible="operation != 'disburse'"/>
                        <field name="interest_amount"/>
                        <field name="fee_bill_id" options="{'no_create': True}"/>
                        <field name="fee_amount"/>
                        <field name="expense_amount"/>
                        <field name="net_amount"/>
                    </group>
                </group>
                <field name="line_ids" invisible="operation not in ('settle', 'repurchase', 'write_off')"
                       options="{'no_create': True}">
                    <list>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="move_id"/>
                        <field name="partner_id"/>
                        <field name="due_date"/>
                        <field name="nominal_amount" sum="Nominal"/>
                        <field name="advance_amount" sum="Adelanto"/>
                        <field name="retained_amount" sum="Retenido"/>
                        <field name="collected_amount" sum="Cobrado"/>
                        <field name="pending_amount" sum="Por cobrar"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Registrar" class="btn-primary"/>
                    <button special="cancel" string="Descartar"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
