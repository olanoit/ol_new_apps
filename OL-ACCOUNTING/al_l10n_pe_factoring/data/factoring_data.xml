<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cuentas por defecto (PCGE) en las compañías peruanas; las que se creen
         después las reciben en su primera operación. -->
    <function model="l10n_pe.factoring.account.config" name="_l10n_pe_create_default_configs"/>
    <function model="l10n_pe.factoring.account.config" name="_l10n_pe_fill_loss_account"/>
    <function model="l10n_pe.factoring.account.config" name="_l10n_pe_fill_transfer_account"/>

    <!-- «Ceder a factoring» desde la lista de facturas de cliente. -->
    <record id="action_server_factoring_create" model="ir.actions.server">
        <field name="name">Ceder a factoring</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_l10n_pe_factoring_create()</field>
    </record>

    <!-- Factura negociable: acciones desde la lista de facturas de cliente. -->
    <record id="action_server_negotiable_event" model="ir.actions.server">
        <field name="name">Evento de factura negociable</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_l10n_pe_negotiable_event()</field>
    </record>
    <record id="action_server_factrack_package" model="ir.actions.server">
        <field name="name">Paquete para Factrack (CAVALI)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_l10n_pe_factrack_package()</field>
    </record>
    <record id="action_server_cavali_register" model="ir.actions.server">
        <field name="name">Registrar en CAVALI</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_l10n_pe_cavali_register()</field>
    </record>

    <!-- Conformidad presunta a los 8 días y consulta a CAVALI, cada día. -->
    <record id="ir_cron_presumed_conformity" model="ir.cron">
        <field name="name">Factura negociable: conformidad presunta</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_l10n_pe_presumed_conformity()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_cavali_status" model="ir.cron">
        <field name="name">CAVALI: consulta del estado de las facturas negociables</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_l10n_pe_cavali_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
