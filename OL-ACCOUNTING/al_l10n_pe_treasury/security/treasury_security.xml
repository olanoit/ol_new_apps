<odoo>
    <record id="treasury_privilege" model="res.groups.privilege">
        <field name="name">Tesorer&#237;a</field>
        <field name="sequence">26</field>
    </record>

    <!-- Usuario: prepara la posici&#243;n, las transferencias y las programaciones de pago. -->
    <record id="group_treasury_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="privilege_id" ref="treasury_privilege"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <!-- Aprobador: adem&#225;s aprueba las programaciones y las transferencias que lo requieren. -->
    <record id="group_treasury_approver" model="res.groups">
        <field name="name">Aprobador</field>
        <field name="privilege_id" ref="treasury_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_treasury_user'))]"/>
    </record>

    <!-- Administrador: segunda aprobaci&#243;n, l&#237;neas de cr&#233;dito y configuraci&#243;n. -->
    <record id="group_treasury_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="treasury_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_treasury_approver')), (4, ref('account.group_account_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
