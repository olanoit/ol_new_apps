<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_treasury" model="ir.ui.view">
        <field name="name">account.payment.form.l10n_pe.treasury</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-2" role="alert"
                     invisible="not l10n_pe_bancarization_warning or state != 'draft'">
                    <field name="l10n_pe_bancarization_warning" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='memo']" position="after">
                <field name="l10n_pe_treasury_transfer_id" invisible="not l10n_pe_treasury_transfer_id"/>
                <field name="l10n_pe_treasury_plan_id" invisible="not l10n_pe_treasury_plan_id"/>
            </xpath>
        </field>
    </record>
</odoo>
