<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treasury_payment_plan_line_list" model="ir.ui.view">
        <field name="name">l10n_pe.treasury.payment.plan.line.list</field>
        <field name="model">l10n_pe.treasury.payment.plan.line</field>
        <field name="arch" type="xml">
            <list string="Documentos" editable="bottom" decoration-danger="days_overdue &gt; 0"
                  decoration-muted="payment_id">
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
                <field name="move_line_id" options="{'no_create': True}"
                       readonly="parent.state != 'draft'" column_invisible="parent.state != 'draft'"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="date_maturity"/>
                <field name="days_overdue" optional="show"/>
                <field name="amount_residual"/>
                <field name="amount" sum="Total" readonly="parent.state != 'draft'"/>
                <field name="note" optional="hide"/>
                <field name="payment_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_treasury_payment_plan_list" model="ir.ui.view">
        <field name="name">l10n_pe.treasury.payment.plan.list</field>
        <field name="model">l10n_pe.treasury.payment.plan</field>
        <field name="arch" type="xml">
            <list string="Programaciones de pago" sample="1" decoration-muted="state == 'cancel'"
                  decoration-info="state == 'draft'" decoration-warning="state == 'to_approve'">
                <field name="currency_id" column_invisible="1"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="date"/>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="partner_count" optional="show"/>
                <field name="line_count" optional="show"/>
                <field name="amount_total"/>
                <field name="amount_company" sum="Total (S/)" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="first_approver_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state in ('approved', 'paid')"
                       decoration-info="state == 'draft'" decoration-warning="state == 'to_approve'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_treasury_payment_plan_form" model="ir.ui.view">
        <field name="name">l10n_pe.treasury.payment.plan.form</field>
        <field name="model">l10n_pe.treasury.payment.plan</field>
        <field name="arch" type="xml">
            <form string="Programación de pagos">
                <header>
                    <button name="action_propose" type="object" string="Proponer documentos"
                            invisible="state != 'draft'"/>
                    <button name="action_submit" type="object" string="Enviar a aprobar" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Aprobar" class="btn-primary"
                            invisible="state != 'to_approve'"
                            groups="al_l10n_pe_treasury.group_treasury_approver"/>
                    <button name="action_pay" type="object" string="Pagar" class="btn-primary"
                            invisible="state != 'approved'"
                            confirm="Se registran los pagos de los documentos con el banco y la fecha de la programación. ¿Continuar?"/>
                    <button name="action_reject" type="object" string="Devolver"
                            invisible="state not in ('to_approve', 'approved')"
                            groups="al_l10n_pe_treasury.group_treasury_approver"/>
                    <button name="action_cancel" type="object" string="Anular"
                            invisible="state not in ('draft', 'to_approve', 'approved')"/>
                    <button name="action_draft" type="object" string="Volver a borrador" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved,paid"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="not over_available">
                    El total a pagar supera el disponible del banco en la fecha
                    (<field name="journal_available" class="oe_inline"/>).
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_payments" type="object" class="oe_stat_button" icon="payments"
                                invisible="not payment_count">
                            <field name="payment_count" widget="statinfo" string="Pagos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state not in ('draft',)"/>
                            <field name="journal_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="payment_method_line_id" readonly="state not in ('draft', 'approved')"
                                   options="{'no_create': True}"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="journal_available" invisible="state in ('paid', 'cancel')"/>
                            <field name="over_available" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="amount_total"/>
                            <field name="amount_company" invisible="currency_id == company_currency_id"/>
                            <field name="partner_count"/>
                            <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documentos" name="lines">
                            <field name="line_ids" readonly="state not in ('draft',)"
                                   context="{'list_view_ref': 'al_l10n_pe_treasury.view_treasury_payment_plan_line_list'}"/>
                        </page>
                        <page string="Aprobación" name="approval">
                            <group>
                                <group>
                                    <field name="approval_level"/>
                                    <field name="user_id"/>
                                </group>
                                <group>
                                    <field name="first_approver_id"/>
                                    <field name="first_approval_date"/>
                                    <field name="second_approver_id" invisible="approval_level != 'double'"/>
                                    <field name="second_approval_date" invisible="approval_level != 'double'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notas" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_treasury_payment_plan_search" model="ir.ui.view">
        <field name="name">l10n_pe.treasury.payment.plan.search</field>
        <field name="model">l10n_pe.treasury.payment.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="line_ids" string="Proveedor" filter_domain="[('line_ids.partner_id', 'ilike', self)]"/>
                <filter name="to_approve" string="Por aprobar" domain="[('state', '=', 'to_approve')]"/>
                <filter name="approved" string="Aprobadas" domain="[('state', '=', 'approved')]"/>
                <filter name="paid" string="Pagadas" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="date" string="Fecha de pago" date="date"/>
                <group>
                    <filter name="group_journal" string="Banco" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_week" string="Semana" context="{'group_by': 'date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_treasury_payment_plan" model="ir.actions.act_window">
        <field name="name">Programación de pagos</field>
        <field name="res_model">l10n_pe.treasury.payment.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Programe los pagos a proveedores</p>
            <p>Proponga los documentos que vencen, ajuste el importe de cada uno, envíe la
               programación a aprobar y, aprobada, regístrela con un clic.</p>
        </field>
    </record>

    <!-- Documentos programados: qué se va a pagar, por proveedor y semana. -->
    <record id="view_treasury_payment_plan_line_report_list" model="ir.ui.view">
        <field name="name">l10n_pe.treasury.payment.plan.line.report.list</field>
        <field name="model">l10n_pe.treasury.payment.plan.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Documentos programados" create="0" edit="0">
                <field name="currency_id" column_invisible="1"/>
                <field name="plan_id"/>
                <field name="plan_state"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="date_maturity"/>
                <field name="amount" sum="Total"/>
                <field name="payment_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_treasury_payment_plan_line_search" model="ir.ui.view">
        <field name="name">l10n_pe.treasury.payment.plan.line.search</field>
        <field name="model">l10n_pe.treasury.payment.plan.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="plan_id"/>
                <filter name="pending" string="Por pagar" domain="[('plan_state', 'in', ('draft', 'to_approve', 'approved')), ('payment_id', '=', False)]"/>
                <filter name="paid" string="Pagados" domain="[('payment_id', '!=', False)]"/>
                <group>
                    <filter name="group_partner" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_plan" string="Programación" context="{'group_by': 'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_treasury_payment_plan_line" model="ir.actions.act_window">
        <field name="name">Documentos programados</field>
        <field name="res_model">l10n_pe.treasury.payment.plan.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_treasury_payment_plan_line_report_list"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
