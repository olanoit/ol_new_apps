<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_treasury_transfer" model="ir.sequence">
        <field name="name">Transferencias de tesorería</field>
        <field name="code">l10n_pe.treasury.transfer</field>
        <field name="prefix">TRF/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_treasury_payment_plan" model="ir.sequence">
        <field name="name">Programaciones de pago</field>
        <field name="code">l10n_pe.treasury.payment.plan</field>
        <field name="prefix">PRG/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
