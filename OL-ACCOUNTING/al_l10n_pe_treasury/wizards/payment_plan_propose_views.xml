<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treasury_payment_plan_propose_form" model="ir.ui.view">
        <field name="name">l10n_pe.treasury.payment.plan.propose.form</field>
        <field name="model">l10n_pe.treasury.payment.plan.propose</field>
        <field name="arch" type="xml">
            <form string="Proponer documentos">
                <group>
                    <group string="Vencimiento">
                        <field name="plan_id" invisible="1"/>
                        <field name="date_due"/>
                        <field name="date_from"/>
                        <field name="include_no_maturity"/>
                    </group>
                    <group string="Proveedores">
                        <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="exclude_partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="min_amount"/>
                    </group>
                </group>
                <p class="text-muted">
                    Se agregan los documentos por pagar publicados, con saldo y en la moneda del banco,
                    que no estén en otra programación abierta.
                </p>
                <footer>
                    <button name="action_propose" type="object" string="Agregar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
