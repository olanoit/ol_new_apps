<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_term_form_company_currency" model="ir.ui.view">
        <field name="name">account.payment.term.form.inherit.pe.currency</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='value']" position="after">
                <field name="l10n_pe_company_currency" string="En soles" optional="show"
                       invisible="value != 'fixed'"/>
            </xpath>
        </field>
    </record>
</odoo>
