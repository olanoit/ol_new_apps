<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multicompañía: fondos y rendiciones solo desde su compañía. -->
        <record id="cash_fund_company_rule" model="ir.rule">
            <field name="name">Entregas a rendir y caja chica: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_cash_fund"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="cash_settlement_company_rule" model="ir.rule">
            <field name="name">Rendiciones de fondos: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_cash_settlement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="cash_settlement_document_company_rule" model="ir.rule">
            <field name="name">Comprobantes rendidos: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_cash_settlement_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="cash_settlement_mobility_company_rule" model="ir.rule">
            <field name="name">Gastos de movilidad: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_cash_settlement_mobility"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
