<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_cash_fund_advance" model="ir.sequence">
        <field name="name">Entregas a rendir</field>
        <field name="code">l10n_pe.cash.fund.advance</field>
        <field name="prefix">ER/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_cash_fund_petty_cash" model="ir.sequence">
        <field name="name">Cajas chicas</field>
        <field name="code">l10n_pe.cash.fund.petty_cash</field>
        <field name="prefix">CCH/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_cash_settlement" model="ir.sequence">
        <field name="name">Rendiciones de fondos</field>
        <field name="code">l10n_pe.cash.settlement</field>
        <field name="prefix">REN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <!-- Planilla de gastos de movilidad: numeración correlativa (art. 21 v del
         Reglamento de la Ley del Impuesto a la Renta). -->
    <record id="seq_cash_mobility" model="ir.sequence">
        <field name="name">Planillas de movilidad</field>
        <field name="code">l10n_pe.cash.mobility</field>
        <field name="prefix">PM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
