<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_l10n_pe_monthly_tax_company" model="ir.rule">
        <field name="name">Declaración mensual 621: compañías permitidas</field>
        <field name="model_id" ref="model_l10n_pe_monthly_tax"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_pe_tax_regime_company" model="ir.rule">
        <field name="name">Régimen tributario: compañías permitidas</field>
        <field name="model_id" ref="model_l10n_pe_tax_regime"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
