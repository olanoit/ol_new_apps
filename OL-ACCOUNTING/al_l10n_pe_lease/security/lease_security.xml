<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multicompañía: cada contrato (y su tabla) solo se ve desde su compañía. -->
        <record id="lease_company_rule" model="ir.rule">
            <field name="name">Arrendamientos: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_lease"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="lease_line_company_rule" model="ir.rule">
            <field name="name">Arrendamientos, tabla: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_lease_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="lease_event_company_rule" model="ir.rule">
            <field name="name">Arrendamientos, historial: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_lease_event"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
