<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_latam_check_view_form_print" model="ir.ui.view">
        <field name="name">l10n_latam.check.form.inherit.pe.print</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.l10n_latam_check_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_void']" position="before">
                <button name="action_l10n_pe_print_check" type="object" string="Imprimir cheque"
                        invisible="payment_method_code != 'own_checks' or issue_state == 'voided'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_form_print_check" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.pe.print.check</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_l10n_pe_print_checks" type="object" string="Imprimir cheque"
                        invisible="payment_method_code != 'own_checks' or state in ('draft', 'canceled')"/>
            </xpath>
        </field>
    </record>

    <!-- Varios cheques propios a la vez desde la lista. -->
    <record id="action_print_checks" model="ir.actions.server">
        <field name="name">Imprimir cheques</field>
        <field name="model_id" ref="l10n_latam_check.model_l10n_latam_check"/>
        <field name="binding_model_id" ref="l10n_latam_check.model_l10n_latam_check"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_l10n_pe_print_check()</field>
    </record>
</odoo>
