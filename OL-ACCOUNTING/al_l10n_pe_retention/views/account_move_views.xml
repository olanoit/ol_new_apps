<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_retention" model="ir.ui.view">
        <field name="name">account.move.form.retention.pe</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Pestaña interna de «Facturación PE» (al_account_base). -->
            <xpath expr="//notebook[@name='l10n_pe_invoicing_notebook']" position="inside">
                <page string="Retenciones sufridas" name="l10n_pe_retention_received"
                      invisible="move_type != 'out_invoice' or not l10n_pe_retention_received_line_ids">
                    <field name="l10n_pe_retention_received_line_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="retention_id" string="Comprobante de retención"/>
                            <field name="amount" sum="Total retenido"/>
                            <field name="state" widget="badge" decoration-success="state == 'posted'"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
                <page string="Retención IGV" name="l10n_pe_retention"
                      invisible="not l10n_pe_retention_eligible">
                    <group>
                        <group>
                            <field name="l10n_pe_retention_eligible"/>
                            <field name="l10n_pe_retention_applies"/>
                            <field name="l10n_pe_retention_amount"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_perception_agent" model="ir.ui.view">
        <field name="name">res.partner.form.perception.agent.pe</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_pe_vat_sunat.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="is_retention_agent" position="after">
                <field name="l10n_pe_is_perception_agent" invisible="not is_company"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_retention" model="ir.ui.view">
        <field name="name">account.invoice.filter.retention.pe</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="late" position="after">
                <filter name="filter_retention" string="Con retención IGV"
                        domain="[('l10n_pe_retention_applies', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>
