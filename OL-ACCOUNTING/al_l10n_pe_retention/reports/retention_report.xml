<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Representación impresa del Comprobante de Retención Electrónico
         (tipo 20). Los importes por comprobante salen del mismo reparto que
         el XML (_l10n_pe_edi_get_retention_breakdown), para que digan lo mismo. -->
    <template id="report_retention_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-set="company_currency" t-value="o.company_id.currency_id"/>
            <t t-set="documents" t-value="o._l10n_pe_edi_get_retention_breakdown()"/>
            <t t-set="supplier" t-value="o.partner_id.commercial_partner_id"/>
            <div class="page">
                <div class="row">
                    <div class="col-7">
                        <strong>Proveedor</strong><br/>
                        <span t-out="supplier.name"/><br/>
                        <span t-out="supplier.l10n_latam_identification_type_id.name or 'RUC'"/>:
                        <span t-out="supplier.vat"/><br/>
                        <span t-out="supplier.contact_address_inline"/>
                    </div>
                    <div class="col-5 text-center border border-dark py-2">
                        <div>RUC <span t-out="o.company_id.vat"/></div>
                        <div><strong>COMPROBANTE DE RETENCIÓN ELECTRÓNICO</strong></div>
                        <div><strong t-out="o.l10n_pe_edi_retention_number"/></div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-4"><strong>Fecha de emisión:</strong>
                        <span t-field="o.date" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/></div>
                    <div class="col-8"><strong>Régimen:</strong> retención del IGV
                        (<span t-out="'%g' % o.company_id.l10n_pe_retention_rate"/> %)</div>
                </div>
                <table class="table table-sm mt-3">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Comprobante</th>
                            <th>Fecha</th>
                            <th class="text-end">Importe total</th>
                            <th class="text-end">Importe pagado</th>
                            <th class="text-end">T.C.</th>
                            <th class="text-end">Retención (S/)</th>
                            <th class="text-end">Neto pagado (S/)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="documents" t-as="doc">
                            <t t-set="invoice" t-value="doc['bill']"/>
                            <td><span t-out="invoice.l10n_latam_document_type_id.code or '01'"/></td>
                            <td><span t-out="o._l10n_pe_edi_retention_bill_number(invoice)"/></td>
                            <td><span t-field="invoice.invoice_date" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/></td>
                            <td class="text-end"><span t-out="invoice.amount_total"
                                t-options="{'widget': 'monetary', 'display_currency': invoice.currency_id}"/></td>
                            <td class="text-end"><span t-out="doc['bill_paid_currency']"
                                t-options="{'widget': 'monetary', 'display_currency': invoice.currency_id}"/></td>
                            <td class="text-end"><span t-if="invoice.currency_id != company_currency"
                                t-out="'%.3f' % doc['exchange_rate']"/></td>
                            <td class="text-end"><span t-out="doc['bill_retention_pen']"
                                t-options="{'widget': 'monetary', 'display_currency': company_currency}"/></td>
                            <td class="text-end"><span t-out="doc['net_total_paid_pen']"
                                t-options="{'widget': 'monetary', 'display_currency': company_currency}"/></td>
                        </tr>
                    </tbody>
                </table>
                <div class="row">
                    <div class="col-5 offset-7">
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Total retenido</strong></td>
                                <td class="text-end"><strong t-out="sum(d['bill_retention_pen'] for d in documents)"
                                    t-options="{'widget': 'monetary', 'display_currency': company_currency}"/></td>
                            </tr>
                            <tr>
                                <td>Total pagado (neto)</td>
                                <td class="text-end"><span t-out="sum(d['net_total_paid_pen'] for d in documents)"
                                    t-options="{'widget': 'monetary', 'display_currency': company_currency}"/></td>
                            </tr>
                        </table>
                    </div>
                </div>
                <p class="small mt-3">
                    Representación impresa del Comprobante de Retención Electrónico.
                    <t t-if="o.l10n_pe_edi_status == 'sent'">Aceptado por SUNAT.</t>
                    Consulte su validez en www.sunat.gob.pe.
                </p>
            </div>
        </t>
    </template>

    <template id="report_retention">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-call="al_l10n_pe_retention.report_retention_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <record id="action_report_retention" model="ir.actions.report">
        <field name="name">Comprobante de retención</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_l10n_pe_retention.report_retention</field>
        <field name="report_file">al_l10n_pe_retention.report_retention</field>
        <field name="print_report_name">'%s - Retención' % (object.l10n_pe_edi_retention_number or object.name)</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
        <field name="domain" eval="[('l10n_pe_edi_retention_number', '!=', False)]"/>
    </record>
</odoo>
