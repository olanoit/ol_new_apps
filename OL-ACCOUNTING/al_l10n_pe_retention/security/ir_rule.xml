<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multicompañía: cada compañía ve solo sus retenciones sufridas. -->
        <record id="rule_retention_received_company" model="ir.rule">
            <field name="name">Retenciones sufridas: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_retention_received"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_retention_received_line_company" model="ir.rule">
            <field name="name">Retenciones sufridas (facturas): multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_retention_received_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_retention_document_company" model="ir.rule">
            <field name="name">CRE sin pago: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_retention_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_retention_document_line_company" model="ir.rule">
            <field name="name">CRE sin pago (facturas): multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_retention_document_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_retention_credit_deduction_company" model="ir.rule">
            <field name="name">Notas de crédito descontadas en CRE: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_retention_credit_deduction"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
