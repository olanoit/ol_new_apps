<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Diario e idempotente: devengo al cierre del mes anterior, capitalización de
         las cuotas de gracia total y aviso antes de cada vencimiento. -->
    <record id="ir_cron_bank_loans" model="ir.cron">
        <field name="name">Tesorería: préstamos bancarios (intereses y vencimientos)</field>
        <field name="model_id" ref="model_l10n_pe_bank_loan"/>
        <field name="state">code</field>
        <field name="code">model._cron_l10n_pe_bank_loans()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
