        </record>
        <record id="bank_loan_account_config_company_rule" model="ir.rule">
            <field name="name">Cuentas de préstamos: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_bank_loan_account_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
