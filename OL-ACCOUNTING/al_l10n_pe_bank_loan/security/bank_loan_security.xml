        <record id="bank_loan_company_rule" model="ir.rule">
            <field name="name">Préstamo bancario: multicompañía</field>
            <field name="model_id" ref="model_l10n_pe_bank_loan"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="bank_loan_line_company_rule" model="ir.rule">
