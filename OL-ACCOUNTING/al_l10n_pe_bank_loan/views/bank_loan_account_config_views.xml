<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_loan_account_config_list" model="ir.ui.view">
        <field name="name">l10n_pe.bank.loan.account.config.list</field>
        <field name="model">l10n_pe.bank.loan.account.config</field>
        <field name="arch" type="xml">
            <list string="Cuentas de préstamos" editable="bottom">
                <field name="loan_type"/>
                <field name="currency_id" options="{'no_create': True}"/>
                <field name="principal_account_id" options="{'no_create': True}"/>
                <field name="interest_payable_account_id" options="{'no_create': True}"/>
                <field name="interest_expense_account_id" options="{'no_create': True}"/>
                <field name="insurance_account_id" options="{'no_create': True}"/>
                <field name="fee_account_id" options="{'no_create': True}"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="action_bank_loan_account_config" model="ir.actions.act_window">
        <field name="name">Préstamos bancarios</field>
        <field name="res_model">l10n_pe.bank.loan.account.config</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
