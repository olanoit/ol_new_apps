<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_loan_line_list" model="ir.ui.view">
        <field name="name">l10n_pe.bank.loan.line.list</field>
        <field name="model">l10n_pe.bank.loan.line</field>
        <field name="arch" type="xml">
            <list string="Cronograma" editable="bottom" decoration-muted="state == 'paid'"
                  decoration-danger="overdue" decoration-info="grace">
                <field name="currency_id" column_invisible="1"/>
                <field name="overdue" column_invisible="1"/>
                <field name="sequence"/>
                <field name="date_start" optional="hide" readonly="1"/>
                <field name="date_due" readonly="parent.state != 'draft'"/>
                <field name="days" optional="show"/>
                <field name="balance_start" readonly="parent.state != 'draft'"/>
                <field name="principal" sum="Amortización" readonly="parent.state != 'draft'"/>
                <field name="interest" sum="Intereses" readonly="parent.state != 'draft'"/>
                <field name="capitalized" sum="Capitalizado" optional="hide" readonly="parent.state != 'draft'"/>
                <field name="insurance" sum="Seguro" optional="show" readonly="parent.state != 'draft'"/>
                <field name="fee" sum="Comisión" optional="show" readonly="parent.state != 'draft'"/>
                <field name="amount_total" sum="Total"/>
                <field name="balance_end" readonly="parent.state != 'draft'"/>
                <field name="grace" optional="hide" readonly="parent.state != 'draft'"/>
                <field name="interest_accrued" optional="hide"/>
                <field name="paid_date" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_bank_loan_list" model="ir.ui.view">
        <field name="name">l10n_pe.bank.loan.list</field>
        <field name="model">l10n_pe.bank.loan</field>
        <field name="arch" type="xml">
            <list string="Préstamos bancarios" sample="1" decoration-muted="state in ('paid', 'cancel')"
                  decoration-info="state == 'draft'">
                <field name="currency_id" column_invisible="1"/>
                <field name="name"/>
                <field name="loan_type" optional="show"/>
                <field name="partner_id"/>
                <field name="reference" optional="show"/>
                <field name="date_disbursement"/>
                <field name="rate" optional="show"/>
                <field name="amount" sum="Capital"/>
                <field name="principal_balance" sum="Saldo"/>
                <field name="next_due_date" optional="show"/>
                <field name="next_amount" optional="show"/>
                <field name="paid_count" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'running'"
                       decoration-info="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_bank_loan_form" model="ir.ui.view">
        <field name="name">l10n_pe.bank.loan.form</field>
        <field name="model">l10n_pe.bank.loan</field>
        <field name="arch" type="xml">
            <form string="Préstamo bancario">
                <header>
                    <button name="action_compute_schedule" type="object" string="Calcular cronograma"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Desembolsar" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Se registra el ingreso del préstamo al banco y la deuda. ¿Continuar?"/>
                    <button name="action_pay_installment" type="object" string="Pagar cuota" class="btn-primary"
                            invisible="state != 'running'"/>
                    <button name="action_prepay" type="object" string="Prepagar" invisible="state != 'running'"/>
                    <button name="action_accrue" type="object" string="Devengar intereses"
                            invisible="state != 'running'"/>
                    <button name="action_cancel" type="object" string="Anular"
                            invisible="state not in ('draft', 'running')"
                            confirm="Se revierten los asientos del préstamo. ¿Continuar?"/>
                    <button name="action_draft" type="object" string="Volver a borrador" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,paid"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="not fx_warning">
                    <field name="fx_warning" readonly="1"/>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_moves" type="object" class="oe_stat_button" icon="fa-bars"
                                invisible="not move_count">
                            <field name="move_count" widget="statinfo" string="Asientos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Préstamo">
                            <field name="loan_type" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'" options="{'no_quick_create': True}"/>
                            <field name="reference"/>
                            <field name="credit_line_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="journal_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="currency_id" readonly="state != 'draft'" options="{'no_create': True}"
                                   groups="base.group_multi_currency"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="purpose"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group string="Condiciones">
                            <field name="rate" readonly="state != 'draft'"/>
                            <field name="day_basis" readonly="state != 'draft'"/>
                            <field name="method" readonly="state != 'draft'"/>
                            <field name="frequency" readonly="state != 'draft'"/>
                            <field name="installment_count" readonly="state != 'draft'"/>
                            <field name="grace_type" readonly="state != 'draft'"/>
                            <field name="grace_count" readonly="state != 'draft'" invisible="grace_type == 'none'"/>
                            <field name="date_disbursement" readonly="state != 'draft'"/>
                            <field name="date_first_due" readonly="state != 'draft'"/>
                            <field name="insurance_rate" readonly="state != 'draft'"/>
                            <field name="fee_amount" readonly="state != 'draft'"/>
                            <field name="disbursement_fee" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Saldos">
                            <field name="principal_balance"/>
                            <field name="current_portion"/>
                            <field name="non_current_portion"/>
                            <field name="prepaid_amount" invisible="not prepaid_amount"/>
                        </group>
                        <group string="Costo">
                            <field name="installment_amount"/>
                            <field name="interest_total"/>
                            <field name="tcea"/>
                            <field name="next_due_date"/>
                            <field name="next_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cronograma" name="schedule">
                            <field name="line_ids" readonly="state not in ('draft',)"
                                   context="{'list_view_ref': 'al_l10n_pe_bank_loan.view_bank_loan_line_list'}"/>
                        </page>
                        <page string="Contabilidad" name="accounting">
                            <group>
                                <group string="Cuentas">
                                    <field name="principal_account_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                    <field name="interest_payable_account_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                    <field name="interest_expense_account_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                    <field name="insurance_account_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                    <field name="fee_account_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                </group>
                                <group string="Diarios e ITF">
                                    <field name="misc_journal_id" options="{'no_create': True}"/>
                                    <field name="itf_applies" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes" placeholder="Garantías, covenants, contacto en el banco…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bank_loan_search" model="ir.ui.view">
        <field name="name">l10n_pe.bank.loan.search</field>
        <field name="model">l10n_pe.bank.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="reference"/>
                <filter name="running" string="Vigentes" domain="[('state', '=', 'running')]"/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="date_disbursement" string="Desembolso" date="date_disbursement"/>
                <group>
                    <filter name="group_partner" string="Banco" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'loan_type'}"/>
                    <filter name="group_currency" string="Moneda" context="{'group_by': 'currency_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bank_loan" model="ir.actions.act_window">
        <field name="name">Préstamos y pagarés</field>
        <field name="res_model">l10n_pe.bank.loan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_running': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre un préstamo o un pagaré bancario</p>
            <p>Calcule el cronograma con la TEA, desembólselo y lleve el pago de cada cuota,
               el devengo de intereses y los prepagos con sus asientos.</p>
        </field>
    </record>

    <!-- Calendario de cuotas: lo que vence, por banco y mes. -->
    <record id="view_bank_loan_line_report_list" model="ir.ui.view">
        <field name="name">l10n_pe.bank.loan.line.report.list</field>
        <field name="model">l10n_pe.bank.loan.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Cuotas" create="0" edit="0" decoration-danger="overdue">
                <field name="currency_id" column_invisible="1"/>
                <field name="overdue" column_invisible="1"/>
                <field name="date_due"/>
                <field name="loan_id"/>
                <field name="partner_id"/>
                <field name="sequence"/>
                <field name="principal" sum="Amortización"/>
                <field name="interest" sum="Intereses"/>
                <field name="insurance" sum="Seguro" optional="hide"/>
                <field name="fee" sum="Comisión" optional="hide"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_bank_loan_line_pivot" model="ir.ui.view">
        <field name="name">l10n_pe.bank.loan.line.pivot</field>
        <field name="model">l10n_pe.bank.loan.line</field>
        <field name="arch" type="xml">
            <pivot string="Vencimientos" sample="1">
                <field name="date_due" type="col" interval="month"/>
                <field name="partner_id" type="row"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_bank_loan_line_search" model="ir.ui.view">
        <field name="name">l10n_pe.bank.loan.line.search</field>
        <field name="model">l10n_pe.bank.loan.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="loan_id"/>
                <field name="partner_id"/>
                <filter name="pending" string="Pendientes"
                        domain="[('state', '=', 'pending'), ('loan_state', '=', 'running')]"/>
                <filter name="paid" string="Pagadas" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="date_due" string="Vencimiento" date="date_due"/>
                <group>
                    <filter name="group_partner" string="Banco" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'date_due:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bank_loan_line" model="ir.actions.act_window">
        <field name="name">Calendario de cuotas</field>
        <field name="res_model">l10n_pe.bank.loan.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="view_bank_loan_line_report_list"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
