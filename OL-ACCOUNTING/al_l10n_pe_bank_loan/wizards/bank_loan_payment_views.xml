<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_loan_payment_form" model="ir.ui.view">
        <field name="name">l10n_pe.bank.loan.payment.form</field>
        <field name="model">l10n_pe.bank.loan.payment</field>
        <field name="arch" type="xml">
            <form string="Pago del préstamo">
                <group>
                    <group>
                        <field name="loan_id" readonly="1"/>
                        <field name="operation" widget="radio"/>
                        <field name="line_id" readonly="1"/>
                        <field name="date"/>
                        <field name="prepay_mode" widget="radio" invisible="operation != 'prepay'"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="principal" readonly="operation == 'installment'"/>
                        <field name="interest" readonly="operation == 'prepay'"/>
                        <field name="insurance" invisible="operation == 'prepay'"/>
                        <field name="fee" invisible="operation == 'prepay'"/>
                        <field name="total" class="fw-bold"/>
                    </group>
                </group>
                <p class="text-muted" invisible="operation != 'prepay'">
                    El prepago paga el capital indicado más los intereses corridos de la cuota en curso
                    y rehace las cuotas pendientes desde la fecha del prepago.
                </p>
                <footer>
                    <button name="action_confirm" type="object" string="Registrar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
