<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cash_closing_company_rule" model="ir.rule">
        <field name="name">Cierre de caja: multicompañía</field>
        <field name="model_id" ref="model_l10n_pe_cash_closing"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="cash_closing_line_company_rule" model="ir.rule">
        <field name="name">Movimiento del cierre de caja: multicompañía</field>
        <field name="model_id" ref="model_l10n_pe_cash_closing_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="cash_closing_count_company_rule" model="ir.rule">
        <field name="name">Arqueo: multicompañía</field>
        <field name="model_id" ref="model_l10n_pe_cash_closing_count"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
