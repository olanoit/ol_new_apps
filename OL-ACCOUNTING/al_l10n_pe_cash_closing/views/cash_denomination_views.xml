<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_denomination_list" model="ir.ui.view">
        <field name="name">l10n_pe.cash.denomination.list</field>
        <field name="model">l10n_pe.cash.denomination</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="currency_id"/>
                <field name="kind"/>
                <field name="value"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_cash_denomination_search" model="ir.ui.view">
        <field name="name">l10n_pe.cash.denomination.search</field>
        <field name="model">l10n_pe.cash.denomination</field>
        <field name="arch" type="xml">
            <search>
                <field name="currency_id"/>
                <filter name="inactive" string="Archivadas" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_currency" string="Moneda" context="{'group_by': 'currency_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cash_denomination" model="ir.actions.act_window">
        <field name="name">Billetes y monedas</field>
        <field name="res_model">l10n_pe.cash.denomination</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_currency': 1}</field>
    </record>
</odoo>
