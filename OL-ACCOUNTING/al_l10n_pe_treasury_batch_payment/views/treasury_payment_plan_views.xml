<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treasury_payment_plan_form_batch" model="ir.ui.view">
        <field name="name">l10n_pe.treasury.payment.plan.form.batch</field>
        <field name="model">l10n_pe.treasury.payment.plan</field>
        <field name="inherit_id" ref="al_l10n_pe_treasury.view_treasury_payment_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="batch_payment_id" invisible="1"/>
                <button name="action_open_batch_payment" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        string="Lote bancario" invisible="not batch_payment_id"/>
            </xpath>
        </field>
    </record>
</odoo>
