<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_term_deposit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.al.term.deposit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="64"/>
        <field name="inherit_id" ref="al_account_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='al_account_base']" position="inside">
                <block title="Depósitos y garantías" name="pe_term_deposit_block">
                    <setting company_dependent="1" string="Aviso de vencimiento"
                             help="Días antes del vencimiento de un depósito o garantía en que su responsable recibe una actividad.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="l10n_pe_term_deposit_notice_days" string="Días de aviso"
                                       class="col-lg-5 o_light_label"/>
                                <field name="l10n_pe_term_deposit_notice_days"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
