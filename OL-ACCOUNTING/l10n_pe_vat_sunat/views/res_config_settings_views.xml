<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- La sección va DENTRO de la app "Perú" de los ajustes, como el resto
         de la localización. Antes declaraba su propia <app> anidada dentro
         de la de Contabilidad: una app dentro de otra solo se dibuja cuando
         la de fuera está seleccionada, así que la pestaña salía vacía. -->
    <record id="res_config_settings_view_form_l10n_pe_vat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_pe_vat</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="al_account_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='al_account_base']" position="inside">
                <block title="Validación RUC/DNI (PE)"
                       id="l10n_pe_vat_validation_block">
                    <setting company_dependent="1" id="enable_ruc" string="Validar RUC"
                             help="Consultar la API al ingresar/modificar un RUC.">
                        <field name="l10n_pe_ruc_validation"/>
                    </setting>
                    <setting company_dependent="1" id="enable_dni" string="Validar DNI"
                             help="Consultar la API al ingresar/modificar un DNI.">
                        <field name="l10n_pe_dni_validation"/>
                    </setting>
                    <setting company_dependent="1" id="api_fallback" string="Fallback en cascada"
                             help="Desactivado: usa solo la conexión activa de mayor prioridad. Activado: si falla, prueba la siguiente.">
                        <field name="l10n_pe_api_use_fallback"/>
                    </setting>
                    <setting company_dependent="1" id="api_connections" string="Conexiones de API"
                             help="Configura las APIs de consulta, su prioridad, su token y el mapeo de campos.">
                        <field name="l10n_pe_ruc_lookup_ready" invisible="1"/>
                        <field name="l10n_pe_dni_lookup_ready" invisible="1"/>
                        <field name="l10n_pe_lookup_missing_token" invisible="1"/>
                        <div class="alert alert-danger mt-2 mb-2" role="alert"
                             invisible="not l10n_pe_ruc_validation or l10n_pe_ruc_lookup_ready">
                            La consulta de <strong>RUC</strong> no funcionará: ninguna conexión
                            habilitada para RUC tiene su token.
                        </div>
                        <div class="alert alert-danger mt-2 mb-2" role="alert"
                             invisible="not l10n_pe_dni_validation or l10n_pe_dni_lookup_ready">
                            La consulta de <strong>DNI</strong> no funcionará: ninguna conexión
                            habilitada para DNI tiene su token. La consulta de DNI siempre
                            necesita una API con token (RENIEC no tiene consulta pública).
                        </div>
                        <div class="text-muted mt-2" invisible="not l10n_pe_lookup_missing_token">
                            Sin token, no se consultan: <field name="l10n_pe_lookup_missing_token"
                                class="fw-bold d-inline" readonly="1"/>
                        </div>
                        <div class="mt-2">
                            <strong>Cómo obtener el token</strong>
                            <ol class="mb-1">
                                <li>Cree una cuenta en la web del proveedor (enlace «Registro del
                                    token» de cada conexión). Por ejemplo,
                                    <a href="https://decolecta.com/profile/" target="_blank">Decolecta</a>
                                    da 1,000 consultas al mes gratis y su token sirve también para
                                    el tipo de cambio.</li>
                                <li>Copie el token de su panel o del correo de bienvenida.</li>
                                <li>Péguelo en «Token / clave» de la conexión y déjela
                                    habilitada.</li>
                            </ol>
                            <span class="text-muted">El RUC también se consulta sin token en el
                                portal de SUNAT (conexión «SUNAT (oficial)»), que solo responde a
                                servidores con dirección del Perú.</span>
                        </div>
                        <button name="action_open_pe_api_connections"
                                type="object" class="btn-link"
                                string="Configurar conexiones RUC/DNI"
                                icon="fa-arrow-right"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="l10n_pe_vat_sunat_config_settings_action" model="ir.actions.act_window">
        <field name="name">Ajustes RUC/DNI</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_l10n_pe_vat"/>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'al_account_base'}</field>
    </record>

    <menuitem name="Ajustes RUC/DNI"
              parent="contacts.res_partner_menu_config"
              groups="base.group_system"
              id="sunat_settings"
              sequence="0"
              action="l10n_pe_vat_sunat_config_settings_action"/>

    <menuitem name="Conexiones RUC/DNI"
              parent="contacts.res_partner_menu_config"
              groups="base.group_system"
              id="menu_l10n_pe_api_connection"
              sequence="1"
              action="action_l10n_pe_api_connection"/>

    <menuitem name="Conexiones RUC/DNI"
              parent="al_account_base.al_l10n_pe_config_sunat"
              groups="base.group_system"
              id="pe_menu_l10n_pe_api_connection"
              sequence="20"
              action="action_l10n_pe_api_connection"/>

</odoo>
