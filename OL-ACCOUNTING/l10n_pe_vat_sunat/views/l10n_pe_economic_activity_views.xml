<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_pe_economic_activity_view_list" model="ir.ui.view">
        <field name="name">l10n_pe.economic.activity.list</field>
        <field name="model">l10n_pe.economic.activity</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="l10n_pe_economic_activity_view_form" model="ir.ui.view">
        <field name="name">l10n_pe.economic.activity.form</field>
        <field name="model">l10n_pe.economic.activity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_pe_economic_activity_view_search" model="ir.ui.view">
        <field name="name">l10n_pe.economic.activity.search</field>
        <field name="model">l10n_pe.economic.activity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Actividad" filter_domain="['|', ('code', 'ilike', self), ('name', 'ilike', self)]"/>
                <filter name="archived" string="Archivadas" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_l10n_pe_economic_activity" model="ir.actions.act_window">
        <field name="name">Actividades económicas</field>
        <field name="res_model">l10n_pe.economic.activity</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin actividades económicas</p>
            <p>Catálogo CIIU Rev. 4 que usa SUNAT en la ficha RUC. Las actividades
               que lleguen en una consulta y no estén se agregan solas.</p>
        </field>
    </record>

    <menuitem id="menu_l10n_pe_economic_activity"
              name="Actividades económicas"
              parent="contacts.res_partner_menu_config"
              action="action_l10n_pe_economic_activity"
              sequence="25"/>

    <!-- Espejo en la app «Perú»: la actividad principal la piden los libros
         y la ficha del contribuyente. -->
    <menuitem id="pe_menu_l10n_pe_economic_activity"
              name="Actividades económicas"
              parent="al_account_base.al_l10n_pe_config_sunat"
              action="action_l10n_pe_economic_activity"
              sequence="30"/>
</odoo>
