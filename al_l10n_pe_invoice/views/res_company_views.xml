<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_invoice_report" model="ir.ui.view">
        <field name="name">res.company.form.invoice.report</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="represent_id"
                       options="{'no_create': False, 'no_create_edit': True, 'no_open': False}"/>
            </xpath>
            <xpath expr="//field[@name='represent_id']" position="after">
                <field name="company_eslogan_pdf"/>
            </xpath>
        </field>
    </record>
</odoo>
