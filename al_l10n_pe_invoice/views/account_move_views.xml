<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_invoice_report" model="ir.ui.view">
        <field name="name">account.move.form.invoice.report</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_date']" position="after">
                <field name="sale_id" invisible="not sale_id" readonly="1"/>
                <field name="external_purchase" invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
