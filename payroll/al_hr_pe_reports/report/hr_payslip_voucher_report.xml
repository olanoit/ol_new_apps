<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="paperformat_boleta_pago" model="report.paperformat">
            <field name="name">Boleta de pago: A4 vertical</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">11</field>
            <field name="margin_right">11</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">96</field>
        </record>

        <!-- Patrón estándar: template contenedor + template _page por
             registro (mismo esquema que la guía de remisión del proyecto).

             El nombre lleva «l10n_pe» a propósito: el dominio nativo de
             `hr.payroll.structure.report_id` solo ofrece plantillas cuyo
             report_name contiene l10n_<código de país>, y `_get_pdf_reports`
             usa el mismo criterio para no pisar otra plantilla peruana. -->
        <template id="report_l10n_pe_boleta_pago_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="al_hr_pe_reports.report_l10n_pe_boleta_pago_page"/>
                </t>
            </t>
        </template>

        <template id="report_l10n_pe_boleta_pago_page">
            <!-- La clase "article" es obligatoria: _prepare_html() solo
                 envuelve en web.minimal_layout (charset UTF-8 + CSS) los
                 divs .article; sin ella el PDF sale sin estilos y con
                 mojibake.
                 El salto de página va por estilo condicional y no en la
                 clase: `page-break-after: always` en el último documento
                 deja una página en blanco al final del PDF. -->
            <div class="article bpe"
                 t-att-style="'page-break-after: always;' if not o_last else ''"
                 t-att-data-oe-model="o and o._name"
                 t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <style>
                    /* ==========================================================
                       BOLETA DE PAGO — sistema visual

                       El documento es un formulario legal que el trabajador
                       revisa y firma. Manda una idea: de todo lo que hay en la
                       hoja, lo único que se busca primero es el neto. Por eso
                       hay un solo elemento invertido en todo el documento —la
                       banda del neto— y el resto se mantiene deliberadamente
                       quieto.

                       Restricciones del motor: wkhtmltopdf usa un WebKit
                       antiguo, así que nada de grid, flex ni variables CSS;
                       todo son tablas y bordes. Sin webfonts: el carácter sale
                       de la escala, el tracking y una monoespaciada para las
                       cifras.

                       Grises, cada uno con una única función:
                         #111  banda del neto (y solo eso)
                         #e9e9e9  cabecera de sección
                         #f7f7f7  fila alterna en las tablas de conceptos
                         #666  metadatos secundarios
                       ========================================================== */

                    .bpe {
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 9.5px;
                        line-height: 1.45;
                        color: #000;
                        max-width: 21cm;
                        margin: 0 auto;
                    }
                    .bpe table { border-collapse: collapse; width: 100%; }

                    /* Reset anti-bordes fantasma: BS5 deja tr/td/th con
                       border-style solid y width 0, y el WebKit de
                       wkhtmltopdf pinta hairlines con eso. Cada bloque
                       redeclara sus bordes debajo. */
                    .bpe table, .bpe thead, .bpe tbody, .bpe tfoot,
                    .bpe tr, .bpe td, .bpe th { border: none; }
                    .bpe td, .bpe th { padding: 3px 6px; vertical-align: top; }

                    /* Las cifras van en monoespaciada: en una boleta la
                       columna de importes es el contenido, y así los dígitos
                       caen unos sobre otros. */
                    .bpe-fig {
                        font-family: 'DejaVu Sans Mono', 'Courier New', monospace;
                        text-align: right;
                        white-space: nowrap;
                    }

                    /* ---------- Cabecera ---------- */
                    .bpe-head td { vertical-align: middle; padding: 0 0 7px 0; }
                    .bpe-head-logo { width: 74px; }
                    .bpe-head-logo img { max-width: 68px; max-height: 46px; }
                    .bpe-head-org { padding-left: 10px !important; }
                    .bpe-org-name {
                        font-size: 13px;
                        font-weight: bold;
                        letter-spacing: 0.2px;
                        line-height: 1.2;
                    }
                    .bpe-org-meta { color: #666; font-size: 8.5px; }
                    .bpe-head-doc { text-align: right; white-space: nowrap; }
                    .bpe-doc-kind {
                        font-size: 11px;
                        font-weight: bold;
                        letter-spacing: 2.2px;
                        text-transform: uppercase;
                    }
                    .bpe-doc-period { font-size: 9px; }
                    .bpe-doc-law { color: #666; font-size: 8px; }

                    /* Filete grueso bajo la cabecera: separa la identidad del
                       emisor del contenido del documento. */
                    .bpe-rule { border-top: 2px solid #000; height: 0; }

                    /* ---------- Secciones ---------- */
                    .bpe-sec { margin-top: 11px; }
                    .bpe-sec-title {
                        font-size: 8.5px;
                        font-weight: bold;
                        text-transform: uppercase;
                        letter-spacing: 1.4px;
                        background: #e9e9e9;
                        border: 1px solid #000;
                        border-bottom: none;
                        padding: 3px 6px;
                    }
                    .bpe-sec-note {
                        font-weight: normal;
                        letter-spacing: 0;
                        text-transform: none;
                        color: #444;
                        font-size: 8px;
                    }

                    /* ---------- Rejilla ---------- */
                    .bpe-grid td, .bpe-grid th { border: 1px solid #000; }
                    .bpe-grid th {
                        background: #e9e9e9;
                        font-weight: bold;
                        text-transform: uppercase;
                        letter-spacing: 0.6px;
                        font-size: 8px;
                        text-align: center;
                    }
                    .bpe-k {
                        color: #444;
                        font-size: 8.5px;
                        text-transform: uppercase;
                        letter-spacing: 0.4px;
                        white-space: nowrap;
                    }
                    .bpe-v { font-weight: bold; }
                    .bpe-c { text-align: center; }

                    /* ---------- Conceptos ---------- */
                    /* Dos columnas enfrentadas: lo que suma y lo que resta.
                       Los aportes del empleador van aparte, más abajo, porque
                       no entran en el neto. */
                    .bpe-cols { table-layout: fixed; }
                    .bpe-cols > tbody > tr > td { padding: 0; width: 50%; }
                    .bpe-cols > tbody > tr > td + td { padding-left: 9px; }
                    .bpe-lines td { font-size: 9px; }
                    .bpe-lines tr.bpe-alt td { background: #f7f7f7; }
                    /* Celda de aire a la derecha de los aportes: sin ella la
                       tabla parecía tener columnas vacías por rellenar. Va
                       después de la zebra para ganarle en especificidad. */
                    .bpe-grid tr td.bpe-void {
                        border: none;
                        background: none;
                    }
                    .bpe-code {
                        font-family: 'DejaVu Sans Mono', 'Courier New', monospace;
                        text-align: center;
                        color: #444;
                        font-size: 8.5px;
                    }
                    .bpe-sum td {
                        border: 1px solid #000;
                        border-top: 2px solid #000;
                        font-weight: bold;
                        text-transform: uppercase;
                        letter-spacing: 0.5px;
                        font-size: 8.5px;
                    }
                    .bpe-none td {
                        color: #666;
                        text-align: center;
                        font-style: italic;
                    }

                    /* ---------- Neto: el único bloque invertido ---------- */
                    .bpe-net { margin-top: 11px; }
                    .bpe-net td {
                        background: #111;
                        color: #fff;
                        border: 1px solid #111;
                        padding: 7px 10px;
                        vertical-align: middle;
                    }
                    .bpe-net-words {
                        font-size: 9px;
                        letter-spacing: 0.3px;
                        text-transform: uppercase;
                    }
                    .bpe-net-label {
                        font-size: 8px;
                        letter-spacing: 1.6px;
                        text-transform: uppercase;
                    }
                    .bpe-net-amount {
                        width: 33%;
                        text-align: right;
                        font-family: 'DejaVu Sans Mono', 'Courier New', monospace;
                        font-size: 19px;
                        font-weight: bold;
                        letter-spacing: -0.4px;
                        white-space: nowrap;
                    }

                    /* ---------- Firmas ---------- */
                    .bpe-sign { margin-top: 40px; }
                    .bpe-sign td {
                        width: 50%;
                        text-align: center;
                        vertical-align: top;
                        padding: 0 30px;
                    }
                    /* Hueco de firma de altura fija en ambas columnas: con
                       alineación al fondo las dos rayas quedaban a distinta
                       altura porque no tienen las mismas líneas debajo. */
                    .bpe-sign-space { height: 54px; line-height: 54px; }
                    .bpe-sign-space img { max-height: 52px; vertical-align: bottom; }
                    .bpe-sign-rule {
                        border-top: 1px solid #000;
                        padding-top: 4px;
                        font-size: 8.5px;
                    }
                    .bpe-sign-name { font-weight: bold; }
                    .bpe-sign-role {
                        color: #444;
                        font-size: 7.5px;
                        text-transform: uppercase;
                        letter-spacing: 1.2px;
                    }
                    .bpe-foot {
                        margin-top: 16px;
                        padding-top: 5px;
                        border-top: 1px solid #000;
                        color: #666;
                        font-size: 7.5px;
                    }
                </style>

                <t t-set="d" t-value="o._get_voucher_report_data()"/>
                <t t-set="v" t-value="o.version_id"/>
                <t t-set="emp" t-value="o.employee_id"/>

                <!-- ==================== CABECERA ==================== -->
                <table class="bpe-head">
                    <tr>
                        <td class="bpe-head-logo">
                            <img t-if="o.company_id.logo"
                                 t-att-src="image_data_uri(o.company_id.logo)"
                                 alt="Logo"/>
                        </td>
                        <td class="bpe-head-org">
                            <div class="bpe-org-name"><span t-field="o.company_id.name"/></div>
                            <div class="bpe-org-meta">
                                RUC <span t-field="o.company_id.vat"/>
                                <t t-if="o.company_id.street">
                                    · <span t-field="o.company_id.street"/><t
                                        t-if="o.company_id.city">, <span t-field="o.company_id.city"/></t>
                                </t>
                            </div>
                        </td>
                        <td class="bpe-head-doc">
                            <div class="bpe-doc-kind">Boleta de pago</div>
                            <div class="bpe-doc-period">
                                <span t-field="o.date_from" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                –
                                <span t-field="o.date_to" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                            </div>
                            <div class="bpe-doc-law">
                                D.S. 001-98-TR<t t-if="o.payslip_run_id"> ·
                                <span t-esc="o.payslip_run_id.name"/></t>
                            </div>
                        </td>
                    </tr>
                </table>
                <div class="bpe-rule"/>

                <!-- ==================== TRABAJADOR ====================
                     Dos columnas de pares etiqueta/valor agrupadas por
                     sentido: a la izquierda quién es y qué hace, a la
                     derecha bajo qué régimen y cómo cobra. -->
                <div class="bpe-sec">
                    <div class="bpe-sec-title">Trabajador</div>
                    <table class="bpe-grid">
                        <colgroup>
                            <col style="width: 15%;"/><col style="width: 35%;"/>
                            <col style="width: 16%;"/><col style="width: 34%;"/>
                        </colgroup>
                        <tr>
                            <td class="bpe-k">Apellidos y nombres</td>
                            <td class="bpe-v"><span t-esc="emp.name"/></td>
                            <td class="bpe-k">
                                <span t-esc="emp.l10n_latam_identification_type_id.name or 'Documento'"/>
                            </td>
                            <td class="bpe-v"><span t-esc="emp.identification_id"/></td>
                        </tr>
                        <tr>
                            <td class="bpe-k">Cargo</td>
                            <td><span t-esc="v.job_id.name or '—'"/></td>
                            <td class="bpe-k">Área</td>
                            <td><span t-esc="v.department_id.name or '—'"/></td>
                        </tr>
                        <tr>
                            <td class="bpe-k">Fecha de ingreso</td>
                            <td>
                                <span t-if="d['fecha_ingreso']"
                                      t-esc="d['fecha_ingreso'].strftime('%d/%m/%Y')"/>
                                <t t-if="d['fecha_cese']">
                                    · Cese <span t-esc="d['fecha_cese'].strftime('%d/%m/%Y')"/>
                                </t>
                            </td>
                            <td class="bpe-k">Situación</td>
                            <td><span t-esc="d['situacion']"/></td>
                        </tr>
                        <tr>
                            <td class="bpe-k">Tipo de trabajador</td>
                            <td><span t-esc="v.worker_type_id.name or '—'"/></td>
                            <td class="bpe-k">Régimen laboral</td>
                            <td><span t-esc="d['regimen_laboral']"/></td>
                        </tr>
                        <tr>
                            <td class="bpe-k">Régimen de salud</td>
                            <td>
                                <span t-esc="d['regimen_salud']"/>
                                <t t-if="d['condicion']"> · <span t-esc="d['condicion']"/></t>
                            </td>
                            <td class="bpe-k">Régimen pensionario</td>
                            <td>
                                <span t-esc="o.membership_id.name or v.membership_id.name or '—'"/>
                                <t t-if="v.l10n_pe_cuspp">
                                    · CUSPP <span t-esc="v.l10n_pe_cuspp"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td class="bpe-k">Remuneración básica</td>
                            <td class="bpe-fig bpe-v">
                                <!-- v19: wage vive en hr.version (el payslip
                                     ya no tiene campo wage propio) -->
                                S/ <span t-esc="'{:,.2f}'.format(v.wage or 0.0)"/>
                            </td>
                            <td class="bpe-k">Cuenta de abono</td>
                            <td>
                                <span t-esc="d['cuenta_abono'] or '—'"/>
                                <t t-if="v.l10n_pe_other_employers">
                                    · Otros empleadores 5ta: Sí
                                </t>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- ==================== JORNADA ==================== -->
                <div class="bpe-sec">
                    <div class="bpe-sec-title">Días y horas del periodo</div>
                    <table class="bpe-grid">
                        <tr>
                            <th>Días laborados</th>
                            <th>No laborados</th>
                            <th>Subsidiados</th>
                            <th>Vacaciones</th>
                            <th>Horas ordinarias</th>
                            <th>Sobretiempo</th>
                        </tr>
                        <tr>
                            <td class="bpe-c bpe-fig"><span t-esc="'%g' % d['dias_laborados']"/></td>
                            <td class="bpe-c bpe-fig"><span t-esc="'%g' % d['dias_no_laborados']"/></td>
                            <td class="bpe-c bpe-fig"><span t-esc="'%g' % d['dias_subsidiados']"/></td>
                            <td class="bpe-c bpe-fig"><span t-esc="'%g' % d['dias_vacaciones']"/></td>
                            <td class="bpe-c bpe-fig"><span t-esc="d['horas_ordinarias']"/></td>
                            <td class="bpe-c bpe-fig"><span t-esc="d['horas_sobretiempo']"/></td>
                        </tr>
                    </table>
                    <!-- Sobretiempo por sobretasa (D.S. 007-2002-TR art. 10) -->
                    <table t-if="d['horas_extras']" class="bpe-grid"
                           style="margin-top: 4px;">
                        <tr>
                            <th t-foreach="d['horas_extras']" t-as="he">
                                <span t-esc="he['nombre']"/>
                            </th>
                        </tr>
                        <tr>
                            <td t-foreach="d['horas_extras']" t-as="he"
                                class="bpe-c bpe-fig">
                                <span t-esc="he['horas']"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- ==================== SUSPENSIONES (T21) ==================== -->
                <div t-if="d['suspensiones']" class="bpe-sec">
                    <div class="bpe-sec-title">Suspensión de labores</div>
                    <table class="bpe-grid">
                        <tr>
                            <th style="width: 12%;">Tipo</th>
                            <th>Motivo</th>
                            <th style="width: 12%;">Días</th>
                        </tr>
                        <tr t-foreach="d['suspensiones']" t-as="susp">
                            <td class="bpe-c bpe-code"><span t-esc="susp['codigo']"/></td>
                            <td><span t-esc="susp['motivo']"/></td>
                            <td class="bpe-c bpe-fig"><span t-esc="susp['dias']"/></td>
                        </tr>
                    </table>
                </div>

                <!-- ==================== CONCEPTOS ====================
                     Ingresos y descuentos enfrentados a la misma altura:
                     son las dos mitades del cálculo del neto y se leen en
                     paralelo. -->
                <div class="bpe-sec">
                    <div class="bpe-sec-title">
                        Conceptos del periodo
                        <span class="bpe-sec-note">— código de la tabla 22 de SUNAT</span>
                    </div>
                    <t t-set="columnas" t-value="[
                        ('Ingresos', d['ingresos'], d['total_ingresos']),
                        ('Descuentos', d['descuentos'], d['total_descuentos'])]"/>
                    <table class="bpe-cols">
                        <tr>
                            <td t-foreach="columnas" t-as="col">
                                <table class="bpe-grid bpe-lines">
                                    <!-- Los anchos van en el colgroup: con
                                         `table-layout: fixed` las columnas se
                                         miden por la PRIMERA fila, así que los
                                         puestos en los th se ignorarían. -->
                                    <colgroup>
                                        <col style="width: 13%;"/>
                                        <col style="width: 58%;"/>
                                        <col style="width: 29%;"/>
                                    </colgroup>
                                    <tr>
                                        <th>Cód.</th>
                                        <th style="text-align: left;"><span t-esc="col[0]"/></th>
                                        <th>Importe S/</th>
                                    </tr>
                                    <tr t-foreach="col[1]" t-as="linea"
                                        t-att-class="'bpe-alt' if linea_index % 2 else ''">
                                        <td class="bpe-code"><span t-esc="linea['codigo']"/></td>
                                        <td><span t-esc="linea['nombre']"/></td>
                                        <td class="bpe-fig">
                                            <span t-esc="'{:,.2f}'.format(linea['importe'])"/>
                                        </td>
                                    </tr>
                                    <!-- Sin conceptos la columna quedaría sin
                                         cuerpo y el borde se descuadraría. -->
                                    <tr t-if="not col[1]" class="bpe-none">
                                        <td colspan="3">Sin conceptos</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <!-- Los totales van en una fila propia de la tabla
                             exterior: así quedan a la misma altura aunque una
                             columna tenga más conceptos que la otra, que es lo
                             que permite compararlos de un vistazo. -->
                        <tr>
                            <td t-foreach="columnas" t-as="col">
                                <table class="bpe-grid">
                                    <colgroup>
                                        <col style="width: 71%;"/>
                                        <col style="width: 29%;"/>
                                    </colgroup>
                                    <tr class="bpe-sum">
                                        <td>Total <span t-esc="col[0]"/></td>
                                        <td class="bpe-fig">
                                            <span t-esc="'{:,.2f}'.format(col[2])"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- ==================== NETO ====================
                     El único bloque invertido de la hoja: es el dato que se
                     busca primero y el que debe seguir leyéndose en una
                     fotocopia. -->
                <table class="bpe-net">
                    <tr>
                        <td>
                            <div class="bpe-net-label">Neto a pagar</div>
                            <div class="bpe-net-words"><span t-esc="d['neto_letras']"/></div>
                        </td>
                        <td class="bpe-net-amount">
                            S/ <span t-esc="'{:,.2f}'.format(d['neto'])"/>
                        </td>
                    </tr>
                </table>

                <!-- ==================== APORTES DEL EMPLEADOR ====================
                     Después del neto y a media caja: son cargas de la empresa,
                     no descuentos del trabajador, y ponerlos junto a los
                     descuentos hacía pensar que restan de lo que cobra. -->
                <div t-if="d['aportes_empleador'] or d['total_aportes']" class="bpe-sec">
                    <div class="bpe-sec-title">
                        Aportes del empleador
                        <span class="bpe-sec-note">— no se descuentan del trabajador</span>
                    </div>
                    <!-- A ancho completo y con las columnas partidas igual que
                         arriba: la de importes cae en la misma vertical que la
                         de descuentos, de modo que todas las cifras de la hoja
                         se leen en una sola columna. -->
                    <table class="bpe-grid bpe-lines">
                        <colgroup>
                            <col style="width: 6.5%;"/>
                            <col style="width: 29%;"/>
                            <col style="width: 14.5%;"/>
                            <col style="width: 50%;"/>
                        </colgroup>
                        <tr t-foreach="d['aportes_empleador']" t-as="ap"
                            t-att-class="'bpe-alt' if ap_index % 2 else ''">
                            <td class="bpe-code"><span t-esc="ap['codigo']"/></td>
                            <td><span t-esc="ap['nombre']"/></td>
                            <td class="bpe-fig">
                                <span t-esc="'{:,.2f}'.format(ap['importe'])"/>
                            </td>
                            <td class="bpe-void"/>
                        </tr>
                        <tr t-if="not d['aportes_empleador']" class="bpe-none">
                            <td colspan="4">Sin aportes</td>
                        </tr>
                        <tr class="bpe-sum">
                            <td colspan="2">Total aportes</td>
                            <td class="bpe-fig">
                                <span t-esc="'{:,.2f}'.format(d['total_aportes'])"/>
                            </td>
                            <td class="bpe-void"/>
                        </tr>
                    </table>
                </div>

                <!-- ==================== FIRMAS ==================== -->
                <table class="bpe-sign">
                    <tr>
                        <td>
                            <div class="bpe-sign-space">
                                <img t-if="d['param'].signature"
                                     t-att-src="image_data_uri(d['param'].signature)"
                                     alt="Firma del empleador"/>
                            </div>
                            <div class="bpe-sign-rule">
                                <div class="bpe-sign-name"
                                     t-esc="d['param'].reprentante_legal_id.name or o.company_id.name"/>
                                <div t-if="d['param'].reprentante_legal_id.vat">
                                    <span t-esc="d['param'].reprentante_legal_id.l10n_latam_identification_type_id.name or 'Doc.'"/>
                                    <span t-esc="d['param'].reprentante_legal_id.vat"/>
                                </div>
                                <div class="bpe-sign-role">Empleador</div>
                            </div>
                        </td>
                        <td>
                            <!-- Mismo hueco que el empleador para que las dos
                                 rayas queden a la misma altura. -->
                            <div class="bpe-sign-space"/>
                            <div class="bpe-sign-rule">
                                <div class="bpe-sign-name" t-esc="emp.name"/>
                                <div t-if="emp.identification_id">
                                    <span t-esc="emp.l10n_latam_identification_type_id.name or 'Doc.'"/>
                                    <span t-esc="emp.identification_id"/>
                                </div>
                                <div class="bpe-sign-role">Recibí conforme</div>
                            </div>
                        </td>
                    </tr>
                </table>

                <div class="bpe-foot">
                    Emitida conforme al D.S. N° 001-98-TR. El duplicado queda en
                    poder del trabajador y el original firmado en poder del
                    empleador.
                </div>
            </div>
        </template>

        <!-- Sin `binding_model_id`: la boleta no debe aparecer también en
             el menú «Imprimir». El único camino es el botón nativo
             «Imprimir», que resuelve el reporte por `_get_pdf_reports`. -->
        <record id="action_report_boleta_pago" model="ir.actions.report">
            <field name="name">Boleta de pago (PE)</field>
            <field name="model">hr.payslip</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">al_hr_pe_reports.report_l10n_pe_boleta_pago_document</field>
            <field name="report_file">al_hr_pe_reports.report_l10n_pe_boleta_pago_document</field>
            <field name="print_report_name">'Boleta de pago - %s - %s' % (
                object.employee_id.name or '', object.date_from)</field>
            <field name="paperformat_id" ref="al_hr_pe_reports.paperformat_boleta_pago"/>
            <field name="binding_model_id" eval="False"/>
        </record>

    </data>
</odoo>
