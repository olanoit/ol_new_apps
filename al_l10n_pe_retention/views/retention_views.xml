<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Retenciones sufridas -->
    <record id="view_retention_received_list" model="ir.ui.view">
        <field name="name">l10n_pe.retention.received.list</field>
        <field name="model">l10n_pe.retention.received</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="amount" sum="Total retenido"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_retention_received_form" model="ir.ui.view">
        <field name="name">l10n_pe.retention.received.form</field>
        <field name="model">l10n_pe.retention.received</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object"
                            string="Registrar" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" type="object"
                            string="Pasar a borrador"
                            invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"
                                   readonly="state != 'draft'"/>
                            <field name="move_id"
                                   readonly="state != 'draft'"/>
                            <field name="entry_id"/>
                        </group>
                        <group>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="amount"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_retention_received" model="ir.actions.act_window">
        <field name="name">Retenciones sufridas</field>
        <field name="res_model">l10n_pe.retention.received</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registre los comprobantes de retención de sus clientes
            </p>
            <p>Cada registro genera el asiento a la cuenta 40114 y lo
               concilia con la factura de venta.</p>
        </field>
    </record>

    <!-- Resumen 626 -->
    <record id="view_retention_summary_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pe.retention.summary.wizard.form</field>
        <field name="model">l10n_pe.retention.summary.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="year"/>
                    <field name="month"/>
                </group>
                <group invisible="not file_data" string="Archivo generado">
                    <field name="file_name" invisible="1"/>
                    <field name="file_data" filename="file_name"
                           readonly="1" widget="binary"/>
                </group>
                <footer>
                    <button name="action_export" string="Generar"
                            type="object" class="btn-primary"/>
                    <button string="Cerrar" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_retention_summary" model="ir.actions.act_window">
        <field name="name">Resumen de retenciones (626)</field>
        <field name="res_model">l10n_pe.retention.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Pagos con retención -->
    <record id="action_retention_payments" model="ir.actions.act_window">
        <field name="name">Retenciones efectuadas</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('l10n_pe_retention_number', '!=', False)]</field>
    </record>

    <record id="view_payment_form_retention" model="ir.ui.view">
        <field name="name">account.payment.form.retention.pe</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_l10n_pe_generate_cre_xml" type="object"
                        string="XML CRE"
                        invisible="not l10n_pe_retention_number"/>
            </xpath>
        </field>
    </record>

    <!-- Menú: Perú ▸ Retenciones IGV -->
    <menuitem id="menu_retention_root" name="Retenciones IGV"
              parent="al_account_base.al_l10n_pe_root"
              groups="account.group_account_user"
              sequence="52"/>
    <menuitem id="menu_retention_payments" name="Retenciones efectuadas"
              parent="menu_retention_root" action="action_retention_payments"
              sequence="10"/>
    <menuitem id="menu_retention_received" name="Retenciones sufridas"
              parent="menu_retention_root" action="action_retention_received"
              sequence="20"/>
    <menuitem id="menu_retention_summary" name="Resumen 626"
              parent="menu_retention_root" action="action_retention_summary"
              sequence="30"/>
</odoo>
