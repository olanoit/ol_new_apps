<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_retention" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.al.retention</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="al_account_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='pe_accounting_block']"
                   position="inside">
                <setting string="Agente de retención del IGV"
                         help="Retiene el 3% en los pagos a proveedores por operaciones gravadas mayores a S/ 700 (R.S. 037-2002/SUNAT).">
                    <field name="l10n_pe_retention_agent"/>
                    <div class="content-group mt16"
                         invisible="not l10n_pe_retention_agent">
                        <div class="row">
                            <label for="l10n_pe_retention_rate"
                                   class="col-lg-5 o_light_label"/>
                            <field name="l10n_pe_retention_rate"/>
                        </div>
                        <div class="row">
                            <label for="l10n_pe_retention_min_amount"
                                   class="col-lg-5 o_light_label"/>
                            <field name="l10n_pe_retention_min_amount"/>
                        </div>
                        <div class="row">
                            <label for="l10n_pe_retention_tax_id"
                                   class="col-lg-5 o_light_label"/>
                            <field name="l10n_pe_retention_tax_id"/>
                        </div>
                    </div>
                </setting>
                <setting string="Retenciones sufridas (clientes agentes)"
                         help="Cuenta 40114 y diario del asiento de las retenciones que nos efectúan los clientes agentes de retención.">
                    <div class="content-group">
                        <div class="row">
                            <label for="l10n_pe_retention_received_account_id"
                                   class="col-lg-5 o_light_label"/>
                            <field name="l10n_pe_retention_received_account_id"/>
                        </div>
                        <div class="row">
                            <label for="l10n_pe_retention_received_journal_id"
                                   class="col-lg-5 o_light_label"/>
                            <field name="l10n_pe_retention_received_journal_id"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
