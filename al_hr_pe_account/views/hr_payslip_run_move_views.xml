<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==============================================================
         Menú raíz contable PE (lo referencia también el resto de
         acciones contables del módulo: provisiones, BBSS, etc.)
         ============================================================== -->
    <menuitem id="menu_hr_pe_account_root"
        name="Contabilidad PE"
        parent="hr_work_entry_enterprise.menu_hr_payroll_root"
        sequence="90"
        groups="hr_payroll.group_hr_payroll_manager"/>

    <record id="hr_payslip_run_move_wizard_action" model="ir.actions.act_window">
        <field name="name">Asiento de planilla por lote</field>
        <field name="res_model">hr.payslip.run.move.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_payslip_run_move_wizard_view_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_hr_payslip_run_move_wizard"
        action="hr_payslip_run_move_wizard_action"
        parent="menu_hr_pe_account_root"
        sequence="10"
        groups="hr_payroll.group_hr_payroll_manager"/>

    <!-- ==============================================================
         Lote de nómina: botón de generación en el menú del kanban.
         El form nativo de hr.payslip.run es un diálogo sin <header>,
         así que los botones de lote van en //t[@t-name='menu'] (mismo
         patrón que hr_payroll_account para su stat button del asiento,
         que reutilizamos para abrir el move_id). Estados v19:
         01_ready / 02_close / 03_paid.
         ============================================================== -->
    <record id="hr_payslip_run_view_kanban_inherit_pe_move" model="ir.ui.view">
        <field name="name">hr.payslip.run.kanban.inherit.pe.move</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='menu']" position="inside">
                <button name="action_pe_open_batch_move_wizard"
                        type="object"
                        class="btn btn-secondary"
                        string="Asiento PE por lote"
                        groups="hr_payroll.group_hr_payroll_manager"
                        invisible="move_id"/>
            </xpath>
        </field>
    </record>

    <!-- ==============================================================
         Parámetros Principales: pestaña Contabilidad (diario, partner,
         flag analítico y reglas AFP del asiento de lote).
         ============================================================== -->
    <record id="hr_main_parameter_view_form_account" model="ir.ui.view">
        <field name="name">hr.main.parameter.form.account</field>
        <field name="model">hr.main.parameter</field>
        <field name="inherit_id" ref="al_hr_pe.hr_main_parameter_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Contabilidad" name="account">
                    <group>
                        <group string="Asiento de planilla por lote">
                            <field name="move_journal_id"/>
                            <field name="move_partner_id"/>
                            <field name="detail_analytic"/>
                        </group>
                        <group string="Aportes AFP (cuenta por afiliación)">
                            <field name="afp_rule_ids"
                                   widget="many2many_tags"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
