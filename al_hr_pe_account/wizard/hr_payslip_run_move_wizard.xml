<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulario del asistente: previsualización (ex «Analisis Asiento
         Planilla» v18) + generación (ex «Generar Asiento Contable»). -->
    <record id="hr_payslip_run_move_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.run.move.wizard.form</field>
        <field name="model">hr.payslip.run.move.wizard</field>
        <field name="arch" type="xml">
            <form string="Asiento de planilla por lote">
                <group>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="payslip_run_id"
                               options="{'no_create': True}"/>
                        <field name="with_analytic"/>
                    </group>
                    <group>
                        <field name="debit"/>
                        <field name="credit"/>
                        <field name="difference"/>
                        <field name="account_id"
                               invisible="difference == 0"
                               required="difference != 0"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list create="0" edit="0" delete="0">
                        <field name="sequence" optional="hide"/>
                        <field name="salary_rule_id" optional="hide"/>
                        <field name="name"/>
                        <field name="account_id"/>
                        <field name="analytic_distribution"
                               widget="analytic_distribution"
                               column_invisible="not parent.with_analytic"/>
                        <field name="partner_id" optional="hide"/>
                        <field name="debit" sum="Total debe"/>
                        <field name="credit" sum="Total haber"/>
                    </list>
                </field>
                <footer>
                    <button string="Generar asiento" name="generate_move"
                            type="object" class="btn-primary"
                            invisible="not payslip_run_id"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
