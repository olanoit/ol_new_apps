<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="al_pos_vendedor.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension" owl="1">
        <xpath expr="//button[hasclass('partner-button')]" position="after">
            <button class="button seller-button btn btn-secondary btn-lg w-100 w-md-50 lh-lg text-truncate"
                t-if="pos.config.authorized_seller"
                t-on-click="() => this.addVendedor()">
                <i class="fa fa-user-o me-2" role="img" aria-label="Vendedor" title="Vendedor"/>
                <span class="seller-name">
                    <t t-if="this.getVendedorName()">
                        <t t-esc="this.getVendedorName()"/>
                    </t>
                    <t t-else="">
                        Vendedor
                    </t>
                </span>
            </button>
        </xpath>
    </t>

</templates>
