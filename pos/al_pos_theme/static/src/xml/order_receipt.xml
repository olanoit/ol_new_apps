<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Recibo: se quita el pie "Powered by Odoo". El pie de texto propio ya
        existe en el core (pos.config.receipt_footer, Ajustes PdV > Recibos),
        así que no se duplica aquí. El recibo queda en monocromo a propósito:
        las impresoras térmicas lo rasterizan en blanco y negro (ESC/POS).
        Compatible con los recibos que reusan <OrderReceipt/> (p. ej. el CPE
        de al_l10n_pe_edi_pos).
    -->
    <t t-name="al_pos_theme.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('footer-powered-by')]" position="replace"/>
        <!-- "Cambio" sin signo menos (ver js/payment_status_patch.js): sólo
             presentación, el valor del modelo no cambia. -->
        <xpath expr="//div[hasclass('receipt-change')]/span[hasclass('pos-receipt-right-align')]" position="attributes">
            <attribute name="t-out">formatCurrency(Math.abs(order.change))</attribute>
        </xpath>
    </t>

</templates>
