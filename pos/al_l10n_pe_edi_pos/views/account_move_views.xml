<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_edi_hold" model="ir.ui.view">
        <field name="name">account.move.form.inherit.al.l10n.pe.edi.pos</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Pestaña Otra información: el usuario de backend desmarca la
                 retención para que el cron/botón de EDI envíe a SUNAT. -->
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="l10n_pe_edi_hold"
                       invisible="country_code != 'PE' or move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>

</odoo>
