<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="industry_ecommerce" model="al.industry">
        <field name="name">Tienda en línea</field>
        <field name="code">ecommerce</field>
        <field name="sequence">60</field>
        <field name="module_id" ref="base.module_al_industry_ecommerce"/>
        <field name="description">Comercios que venden por su propia web con pago en línea y despacho a domicilio.</field>
        <field name="ciiu_code">4791</field>
    </record>

    <!-- Solo al instalar: configura la compañía activa sin pisar lo que ya
         tiene. Las demás compañías, con «Aplicar a la compañía activa». -->
    <data noupdate="1">
        <function model="al.industry" name="_apply_on_install"
                  eval="['al_industry_ecommerce.industry_ecommerce']"/>
    </data>
</odoo>
