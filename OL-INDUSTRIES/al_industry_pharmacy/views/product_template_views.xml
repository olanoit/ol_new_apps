<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_pharmacy" model="ir.ui.view">
        <field name="name">product.template.form.pharmacy</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Farmacia" name="pharmacy" invisible="type != 'consu'">
                    <group>
                        <group string="Registro sanitario">
                            <field name="pharmacy_sanitary_registry"/>
                            <field name="pharmacy_sale_condition"/>
                        </group>
                        <group string="Composición">
                            <field name="pharmacy_active_ingredient"/>
                            <field name="pharmacy_concentration"/>
                            <field name="pharmacy_dosage_form"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_pharmacy" model="ir.ui.view">
        <field name="name">product.template.search.pharmacy</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="product_tag_ids" position="after">
                <field name="pharmacy_active_ingredient"/>
                <field name="pharmacy_sanitary_registry"/>
            </field>
            <filter name="services" position="after">
                <separator/>
                <filter string="Venta libre" name="pharmacy_otc"
                        domain="[('pharmacy_sale_condition', '=', 'otc')]"/>
                <filter string="Con receta" name="pharmacy_prescription"
                        domain="[('pharmacy_sale_condition', 'in', ('prescription', 'controlled'))]"/>
                <filter string="Sin registro sanitario" name="pharmacy_no_registry"
                        domain="[('pharmacy_sale_condition', '!=', False), ('pharmacy_sanitary_registry', '=', False)]"/>
            </filter>
        </field>
    </record>
</odoo>
