<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_al_import_hr_version_wizard_form" model="ir.ui.view">
        <field name="name">al.import.hr.version.wizard.form</field>
        <field name="model">al.import.hr.version.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Datos PE de la Versión">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="upload,configure,done"/>
                </header>
                <sheet>
                    <!-- Paso 1: cargar archivo -->
                    <group invisible="state != 'upload'">
                        <field name="file_data" filename="file_name"
                               required="state == 'upload'"
                               widget="binary"
                               options="{'accepted_file_extensions': '.xlsx,.xlsm'}"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'upload'">
                        Suba el Excel de datos laborales PE. Columnas:
                        <strong>Nro documento</strong>,
                        <strong>Régimen laboral</strong>, <strong>CUSPP</strong>,
                        <strong>Tipo de comisión AFP</strong>,
                        <strong>Afiliación</strong>, <strong>Seguro social</strong>,
                        <strong>Tipo de trabajador (T08)</strong>,
                        <strong>Situación (T15)</strong>,
                        <strong>Excepción de jornada</strong> y
                        <strong>Tipo de labor</strong>.
                    </div>

                    <!-- Paso 2: configurar y ejecutar -->
                    <group invisible="state != 'configure'">
                        <group string="Origen">
                            <field name="file_name" readonly="1"/>
                            <field name="wizard_model_name" invisible="1"/>
                            <field name="sheet_id"
                                   required="state == 'configure'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="sheet_names_csv" readonly="1" invisible="1"/>
                            <field name="header_row"/>
                            <field name="start_row"/>
                        </group>
                        <group string="Opciones">
                            <field name="company_id"
                                   options="{'no_create': True}"
                                   groups="base.group_multi_company"/>
                            <field name="use_batching"/>
                            <field name="batch_size"
                                   invisible="not use_batching"
                                   required="use_batching"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'configure'">
                        <strong>Importante:</strong> se actualiza la
                        <em>versión vigente</em> del empleado localizado por
                        documento. Las celdas vacías <em>no modifican</em> el
                        valor actual. Régimen, comisión, excepción y tipo de
                        labor aceptan la clave técnica o la etiqueta; los
                        catálogos T08/T15 aceptan código o nombre.
                    </div>

                </sheet>
                <footer>
                    <button name="action_load_file" type="object"
                            string="Analizar archivo" class="btn-primary"
                            invisible="state != 'upload'"/>
                    <button name="action_run_import" type="object"
                            string="Importar" class="btn-primary"
                            invisible="state != 'configure'"/>
                    <!-- Enlace HTTP (no un boton object): descargar la
                         plantilla no debe exigir guardar el asistente. -->
                    <a class="btn btn-secondary" role="button"
                       href="/al_hr_pe_import/template/al.import.hr.version.wizard"
                       target="_blank">
                        <i class="fa fa-download me-1"/>Descargar plantilla
                    </a>
                    <button string="Cerrar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_al_import_hr_version_wizard" model="ir.actions.act_window">
        <field name="name">Importar Datos PE de Versiones desde Excel</field>
        <field name="res_model">al.import.hr.version.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="group_ids" eval="[(4, ref('hr_payroll.group_hr_payroll_manager'))]"/>
    </record>

</odoo>
