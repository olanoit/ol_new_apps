<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.al.hr.pe.reports</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="al_hr_pe.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='l10n_pe_payroll_signatory']" position="after">
                <setting id="l10n_pe_payroll_voucher_delivery" company_dependent="1" string="Boletas y pagos"
                         help="Cifrado del PDF de la boleta enviada por correo y diarios bancarios del pago masivo de sueldos y CTS.">
                    <div class="content-group">
                        <div class="mt8">
                            <field name="l10n_pe_payroll_voucher_encrypt"/>
                            <label for="l10n_pe_payroll_voucher_encrypt" string="Cifrar la boleta con el n.º de documento" class="o_light_label"/>
                        </div>
                        <div class="row mt8">
                            <label for="l10n_pe_payroll_payment_journal_ids" string="Diarios de pago" class="col-lg-4 o_light_label"/>
                            <field name="l10n_pe_payroll_payment_journal_ids" widget="many2many_tags"
                                   domain="[('type', '=', 'bank'), ('company_id', 'parent_of', company_id)]"
                                   options="{'no_create': True}"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
