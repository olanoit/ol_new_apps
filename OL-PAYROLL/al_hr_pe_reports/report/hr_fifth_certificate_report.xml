<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================================================
         Certificado de rentas y retenciones de 5ta categoría
         (Art. 45 D.S. 122-94-EF; R.S. 010-2006/SUNAT), con el formato
         común de los documentos de la suite (al_report_base).
         docs = hr.fifth.certificate.wizard (uno); un certificado (una
         página con su encabezado y pie) por cada empleado seleccionado.
         Los importes salen de doc._get_certificate_values(emp).
         ============================================================= -->

    <template id="report_fifth_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-foreach="doc.employee_ids" t-as="emp">
                    <t t-set="vals" t-value="doc._get_certificate_values(emp)"/>
                    <t t-set="legal" t-value="doc.main_parameter_id.reprentante_legal_id"/>
                    <t t-call="al_report_base.report_pe_page"
                        o="doc"
                        company="doc.company_id"
                        doc_title.f="Certificado de rentas y retenciones"
                        doc_extra="'Ejercicio gravable %s' % doc.year"
                        page_class.f="pe-doc-text">

                        <div class="pe-doc-title" style="margin-bottom: 4px;">
                            Certificado de rentas y retenciones por rentas de quinta categoría
                        </div>
                        <p class="text-center pe-doc-fs-11">
                            (Art. 45 D.S. N° 122-94-EF del 21/09/1994)
                            (R.S. N° 010-2006/SUNAT del 13/01/2006)<br/>
                            <strong>Ejercicio gravable <t t-out="doc.year"/></strong>
                        </p>

                        <p>
                            <strong t-field="doc.company_id.name"/>, con RUC N°
                            <span t-field="doc.company_id.vat"/> y domicilio
                            fiscal en <span t-field="doc.company_id.street"/>,
                            debidamente representada por
                            <t t-out="legal.name"/><t t-if="legal.function">,
                                en calidad de <t t-out="legal.function"/></t>,
                            identificado con documento N° <t t-out="legal.vat"/>,
                        </p>

                        <p><strong>CERTIFICA:</strong></p>

                        <p>
                            Que a <strong t-out="emp.name"/>, identificado con
                            <t t-out="emp.l10n_latam_identification_type_id.name or 'documento'"/>
                            N° <t t-out="emp.identification_id or ''"/>, con
                            domicilio en <t t-out="emp.private_street or ''"/>,
                            se le ha retenido por Impuesto a la Renta de
                            Quinta Categoría por sus funciones en el cargo de
                            <t t-out="emp.job_title or ''"/>, correspondiente
                            al ejercicio <t t-out="doc.year"/>, los importes
                            siguientes:
                        </p>

                        <table class="pe-doc-table pe-doc-lines pe-doc-keep mb-3">
                            <thead>
                                <tr class="pe-doc-thead">
                                    <td>Concepto</td>
                                    <td class="text-end" style="width: 22%;">Importe</td>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="pe-doc-subheader">
                                    <td colspan="2">1. Renta bruta</td>
                                </tr>
                                <tr>
                                    <td style="padding-left: 24px;">1.1. Sueldos, asignaciones,
                                        gratificaciones, bonificaciones, comisiones, etc.</td>
                                    <td class="text-end text-nowrap">S/ <t t-out="'{:,.2f}'.format(vals['rem_bruta'])"/></td>
                                </tr>
                                <tr>
                                    <td style="padding-left: 24px;">1.2. Ingresos percibidos de
                                        otros empleadores</td>
                                    <td class="text-end text-nowrap">S/ <t t-out="'{:,.2f}'.format(vals['other_emp_rem'])"/></td>
                                </tr>
                                <tr class="pe-doc-subheader">
                                    <td style="padding-left: 24px;">Remuneración bruta total</td>
                                    <td class="text-end text-nowrap">S/ <t t-out="'{:,.2f}'.format(vals['rem_total'])"/></td>
                                </tr>
                                <tr class="pe-doc-subheader">
                                    <td colspan="2">2. Deducción sobre rentas de quinta categoría</td>
                                </tr>
                                <tr>
                                    <td style="padding-left: 24px;">Menos: 7 UIT</td>
                                    <td class="text-end text-nowrap">S/ <t t-out="'{:,.2f}'.format(vals['seven_uit'])"/></td>
                                </tr>
                                <tr class="pe-doc-subheader">
                                    <td style="padding-left: 24px;">Total renta imponible</td>
                                    <td class="text-end text-nowrap">S/ <t t-out="'{:,.2f}'.format(vals['renta_imponible'])"/></td>
                                </tr>
                                <tr class="pe-doc-subheader">
                                    <td>3. Impuesto a la renta</td>
                                    <td class="text-end text-nowrap">S/ <t t-out="'{:,.2f}'.format(vals['impuesto'])"/></td>
                                </tr>
                                <tr class="pe-doc-subheader">
                                    <td>4. Total retención efectuada</td>
                                    <td class="text-end text-nowrap">S/ <t t-out="'{:,.2f}'.format(vals['retencion'])"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="pe-doc-total">
                                    <td>Saldo por regularizar</td>
                                    <td class="text-end text-nowrap">S/ <t t-out="'{:,.2f}'.format(vals['saldo'])"/></td>
                                </tr>
                            </tfoot>
                        </table>

                        <p>
                            <t t-out="doc.company_id.city"/>,
                            <t t-out="doc.format_date_letters(doc.date)"/>
                        </p>

                        <table class="pe-doc-plain pe-doc-signatures pe-doc-keep">
                            <tr>
                                <td/>
                                <td>
                                    <img t-if="doc.main_parameter_id.signature" class="pe-doc-sign-img"
                                         t-att-src="image_data_uri(doc.main_parameter_id.signature)"
                                         alt="Firma"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="pe-doc-sign-line">
                                        <strong t-out="emp.name"/><br/>
                                        <t t-out="emp.l10n_latam_identification_type_id.name"/>
                                        N° <t t-out="emp.identification_id"/><br/>
                                        Trabajador(a)
                                    </div>
                                </td>
                                <td>
                                    <div class="pe-doc-sign-line">
                                        <strong t-out="legal.name"/><br/>
                                        <t t-out="legal.l10n_latam_identification_type_id.name"/>
                                        N° <t t-out="legal.vat"/><br/>
                                        Empleador
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_fifth_certificate" model="ir.actions.report">
        <field name="name">Certificado de renta de 5ta categoría</field>
        <field name="model">hr.fifth.certificate.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_hr_pe_reports.report_fifth_certificate</field>
        <field name="print_report_name">'Certificado 5ta %s' % (object.year)</field>
        <field name="paperformat_id" ref="al_report_base.paperformat_pe_a4"/>
    </record>

</odoo>
