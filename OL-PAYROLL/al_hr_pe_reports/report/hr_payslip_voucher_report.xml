<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <!-- Patrón estándar: template contenedor + template _page por
             registro (mismo esquema que la guía de remisión del proyecto).

             El nombre lleva «l10n_pe» a propósito: el dominio nativo de
             `hr.payroll.structure.report_id` solo ofrece plantillas cuyo
             report_name contiene l10n_<código de país>, y `_get_pdf_reports`
             usa el mismo criterio para no pisar otra plantilla peruana. -->
        <template id="report_l10n_pe_boleta_pago_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="al_hr_pe_reports.report_l10n_pe_boleta_pago_page"/>
                </t>
            </t>
        </template>

        <template id="report_l10n_pe_boleta_pago_page">
            <!-- Formato común de los documentos de la suite (al_report_base:
                 encabezado con el recuadro del documento, estilos pe-doc- y
                 pie con la numeración de páginas), como el comprobante A4.
                 Ganchos estables para la variante de construcción civil
                 (al_hr_pe_construction hereda por xpath): la tabla
                 «pe-boleta-worker» y las celdas pe-doc-label por su texto. -->
            <t t-set="d" t-value="o._get_voucher_report_data()"/>
            <t t-set="v" t-value="o.version_id"/>
            <t t-set="emp" t-value="o.employee_id"/>
            <t t-set="fmt" t-value="lambda amount: '{:,.2f}'.format(amount or 0.0)"/>
            <t t-call="al_report_base.report_pe_page"
                company="o.company_id"
                doc_title.f="Boleta de pago"
                doc_extra="'%s – %s' % (o.date_from.strftime('%d/%m/%Y'), o.date_to.strftime('%d/%m/%Y'))"
                page_class.f="pe-boleta">

                <div class="pe-doc-fs-11">

                <!-- ==================== TRABAJADOR ==================== -->
                <div class="pe-doc-section" style="margin-top: 0;">Trabajador</div>
                <table class="pe-doc-table pe-boleta-worker">
                    <colgroup>
                        <col style="width: 17%;"/><col style="width: 33%;"/>
                        <col style="width: 17%;"/><col style="width: 33%;"/>
                    </colgroup>
                    <tr>
                        <td class="pe-doc-label">Apellidos y nombres</td>
                        <td class="pe-doc-value"><strong t-out="emp.name"/></td>
                        <td class="pe-doc-label"><t t-out="emp.l10n_latam_identification_type_id.name or 'Documento'"/></td>
                        <td class="pe-doc-value"><strong t-out="emp.identification_id"/></td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label">Cargo</td>
                        <td class="pe-doc-value"><span t-out="v.job_id.name or '—'"/></td>
                        <td class="pe-doc-label">Área</td>
                        <td class="pe-doc-value"><span t-out="v.department_id.name or '—'"/></td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label">Fecha de ingreso</td>
                        <td class="pe-doc-value">
                            <span t-if="d['fecha_ingreso']" t-out="d['fecha_ingreso'].strftime('%d/%m/%Y')"/>
                            <t t-if="d['fecha_cese']">
                                · Cese <span t-out="d['fecha_cese'].strftime('%d/%m/%Y')"/>
                            </t>
                        </td>
                        <td class="pe-doc-label">Situación</td>
                        <td class="pe-doc-value"><span t-out="d['situacion']"/></td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label">Tipo de trabajador</td>
                        <td class="pe-doc-value"><span t-out="v.worker_type_id.name or '—'"/></td>
                        <td class="pe-doc-label">Régimen laboral</td>
                        <td class="pe-doc-value"><span t-out="d['regimen_laboral']"/></td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label">Régimen de salud</td>
                        <td class="pe-doc-value">
                            <span t-out="d['regimen_salud']"/>
                            <t t-if="d['condicion']"> · <span t-out="d['condicion']"/></t>
                        </td>
                        <td class="pe-doc-label">Régimen pensionario</td>
                        <td class="pe-doc-value">
                            <span t-out="o.membership_id.name or v.membership_id.name or '—'"/>
                            <t t-if="v.l10n_pe_cuspp"> · CUSPP <span t-out="v.l10n_pe_cuspp"/></t>
                        </td>
                    </tr>
                    <tr>
                        <td class="pe-doc-label">Remuneración básica</td>
                        <td class="pe-doc-value">
                            <!-- v19: wage vive en hr.version (el payslip ya no
                                 tiene campo wage propio) -->
                            S/ <span t-out="'{:,.2f}'.format(v.wage or 0.0)"/>
                        </td>
                        <td class="pe-doc-label">Cuenta de abono</td>
                        <td class="pe-doc-value">
                            <span t-out="d['cuenta_abono'] or '—'"/>
                            <t t-if="v.l10n_pe_other_employers"> · Otros empleadores 5ta: Sí</t>
                        </td>
                    </tr>
                </table>

                <!-- ==================== JORNADA ==================== -->
                <div class="pe-doc-section">Días y horas del periodo</div>
                <table class="pe-doc-table pe-doc-lines">
                    <thead>
                        <tr class="pe-doc-thead">
                            <td class="text-center">Días laborados</td>
                            <td class="text-center">No laborados</td>
                            <td class="text-center">Subsidiados</td>
                            <td class="text-center">Vacaciones</td>
                            <td class="text-center">Horas ordinarias</td>
                            <td class="text-center">Sobretiempo</td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-center"><span t-out="'%g' % d['dias_laborados']"/></td>
                            <td class="text-center"><span t-out="'%g' % d['dias_no_laborados']"/></td>
                            <td class="text-center"><span t-out="'%g' % d['dias_subsidiados']"/></td>
                            <td class="text-center"><span t-out="'%g' % d['dias_vacaciones']"/></td>
                            <td class="text-center"><span t-out="d['horas_ordinarias']"/></td>
                            <td class="text-center"><span t-out="d['horas_sobretiempo']"/></td>
                        </tr>
                    </tbody>
                </table>
                <!-- Sobretiempo por sobretasa (D.S. 007-2002-TR art. 10) -->
                <table t-if="d['horas_extras']" class="pe-doc-table pe-doc-lines" style="margin-top: 4px;">
                    <thead>
                        <tr class="pe-doc-thead">
                            <td t-foreach="d['horas_extras']" t-as="he" class="text-center">
                                <span t-out="he['nombre']"/>
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td t-foreach="d['horas_extras']" t-as="he" class="text-center">
                                <span t-out="he['horas']"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- ==================== SUSPENSIONES (T21) ==================== -->
                <t t-if="d['suspensiones']">
                    <div class="pe-doc-section">Suspensión de labores</div>
                    <table class="pe-doc-table pe-doc-lines">
                        <thead>
                            <tr class="pe-doc-thead">
                                <td class="text-center" style="width: 12%;">Tipo</td>
                                <td>Motivo</td>
                                <td class="text-center" style="width: 12%;">Días</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="d['suspensiones']" t-as="susp">
                                <td class="text-center"><span t-out="susp['codigo']"/></td>
                                <td><span t-out="susp['motivo']"/></td>
                                <td class="text-center"><span t-out="susp['dias']"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <!-- ==================== CONCEPTOS ====================
                     Ingresos y descuentos enfrentados: las dos mitades del
                     cálculo del neto. Los totales van en una fila propia de
                     la tabla exterior para quedar a la misma altura aunque
                     una columna tenga más conceptos que la otra. -->
                <div class="pe-doc-section">Conceptos del periodo
                    <span style="font-weight: normal;">— código de la tabla 22 de SUNAT</span></div>
                <t t-set="columnas" t-value="[
                    ('Ingresos', d['ingresos'], d['total_ingresos']),
                    ('Descuentos', d['descuentos'], d['total_descuentos'])]"/>
                <table class="pe-doc-plain" style="table-layout: fixed;">
                    <tr>
                        <td t-foreach="columnas" t-as="col"
                            class="pe-boleta-col" t-attf-style="width: 50%; padding: 0 0 0 #{'5px' if col_index else '0'};">
                            <table class="pe-doc-table pe-doc-lines">
                                <colgroup>
                                    <col style="width: 14%;"/>
                                    <col style="width: 58%;"/>
                                    <col style="width: 28%;"/>
                                </colgroup>
                                <thead>
                                    <tr class="pe-doc-thead">
                                        <td>Cód.</td>
                                        <td><span t-out="col[0]"/></td>
                                        <td class="text-end">Importe S/</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="col[1]" t-as="linea">
                                        <td><span t-out="linea['codigo']"/></td>
                                        <td><span t-out="linea['nombre']"/></td>
                                        <td class="text-end text-nowrap"><span t-out="fmt(linea['importe'])"/></td>
                                    </tr>
                                    <tr t-if="not col[1]">
                                        <td colspan="3" class="text-center"><em>Sin conceptos</em></td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td t-foreach="columnas" t-as="col"
                            t-attf-style="padding: 4px 0 0 #{'5px' if col_index else '0'};">
                            <table class="pe-doc-table">
                                <tr>
                                    <td class="pe-doc-label" style="width: 72%;">Total <span t-out="col[0].lower()"/></td>
                                    <td class="pe-doc-label text-end text-nowrap"><span t-out="fmt(col[2])"/></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- ==================== NETO ==================== -->
                <div class="pe-doc-highlight pe-boleta-net">
                    <table class="pe-doc-plain">
                        <tr>
                            <td class="align-middle">
                                NETO A PAGAR<br/>
                                <span class="pe-doc-fs-11" style="font-weight: normal;">
                                    <span t-out="d['neto_letras']"/>
                                </span>
                            </td>
                            <td class="text-end align-middle text-nowrap pe-doc-fs-20" style="width: 35%;">
                                S/ <span t-out="fmt(d['neto'])"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- ==================== APORTES DEL EMPLEADOR ====================
                     Después del neto: son cargas de la empresa, no descuentos
                     del trabajador. -->
                <t t-if="d['aportes_empleador'] or d['total_aportes']">
                    <div class="pe-doc-section">Aportes del empleador
                        <span style="font-weight: normal;">— no se descuentan del trabajador</span></div>
                    <table class="pe-doc-table pe-doc-lines" style="width: 50%;">
                        <colgroup>
                            <col style="width: 14%;"/>
                            <col style="width: 58%;"/>
                            <col style="width: 28%;"/>
                        </colgroup>
                        <thead>
                            <tr class="pe-doc-thead">
                                <td>Cód.</td>
                                <td>Aporte</td>
                                <td class="text-end">Importe S/</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="d['aportes_empleador']" t-as="ap">
                                <td><span t-out="ap['codigo']"/></td>
                                <td><span t-out="ap['nombre']"/></td>
                                <td class="text-end text-nowrap"><span t-out="fmt(ap['importe'])"/></td>
                            </tr>
                            <tr t-if="not d['aportes_empleador']">
                                <td colspan="3" class="text-center"><em>Sin aportes</em></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="pe-doc-total">
                                <td colspan="2">Total aportes</td>
                                <td class="text-end text-nowrap"><span t-out="fmt(d['total_aportes'])"/></td>
                            </tr>
                        </tfoot>
                    </table>
                </t>

                <!-- ==================== FIRMAS ==================== -->
                <!-- Alineadas arriba: con la alineación al fondo de la hoja común
                     las dos rayas quedaban a distinta altura (no tienen las
                     mismas líneas debajo). -->
                <table class="pe-doc-plain pe-doc-signatures pe-doc-keep" style="margin-top: 36px;">
                    <tr>
                        <td style="vertical-align: top;">
                            <div style="height: 56px;">
                                <img t-if="d['param'].signature" class="pe-doc-sign-img"
                                     style="max-height: 54px;"
                                     t-att-src="image_data_uri(d['param'].signature)"
                                     alt="Firma del empleador"/>
                            </div>
                            <div class="pe-doc-sign-line">
                                <strong t-out="d['param'].reprentante_legal_id.name or o.company_id.name"/>
                                <div t-if="d['param'].reprentante_legal_id.vat">
                                    <span t-out="d['param'].reprentante_legal_id.l10n_latam_identification_type_id.name or 'Doc.'"/>
                                    <span t-out="d['param'].reprentante_legal_id.vat"/>
                                </div>
                                <div>Empleador</div>
                            </div>
                        </td>
                        <td style="vertical-align: top;">
                            <!-- Mismo hueco que el empleador para que las dos
                                 rayas queden a la misma altura. -->
                            <div style="height: 56px;"/>
                            <div class="pe-doc-sign-line">
                                <strong t-out="emp.name"/>
                                <div t-if="emp.identification_id">
                                    <span t-out="emp.l10n_latam_identification_type_id.name or 'Doc.'"/>
                                    <span t-out="emp.identification_id"/>
                                </div>
                                <div>Recibí conforme</div>
                            </div>
                        </td>
                    </tr>
                </table>

                <table class="pe-doc-table" style="margin-top: 14px;">
                    <tr>
                        <td class="pe-doc-fs-11">
                            Emitida conforme al D.S. N° 001-98-TR<t t-if="o.payslip_run_id">
                            (<span t-out="o.payslip_run_id.name"/>)</t>. El duplicado queda en
                            poder del trabajador y el original firmado en poder del
                            empleador.
                        </td>
                    </tr>
                </table>
                </div>
            </t>
        </template>

        <!-- Sin `binding_model_id`: la boleta no debe aparecer también en
             el menú «Imprimir». El único camino es el botón nativo
             «Imprimir», que resuelve el reporte por `_get_pdf_reports`. -->
        <record id="action_report_boleta_pago" model="ir.actions.report">
            <field name="name">Boleta de pago (PE)</field>
            <field name="model">hr.payslip</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">al_hr_pe_reports.report_l10n_pe_boleta_pago_document</field>
            <field name="print_report_name">'Boleta de pago - %s - %s' % (
                object.employee_id.name or '', object.date_from)</field>
            <field name="paperformat_id" ref="al_report_base.paperformat_pe_a4"/>
            <field name="binding_model_id" eval="False"/>
        </record>

    </data>
</odoo>
