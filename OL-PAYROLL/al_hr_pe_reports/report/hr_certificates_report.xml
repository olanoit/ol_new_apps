<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================================================
         Certificado de trabajo (D.S. 001-96-TR Art. 42) y carta de
         retiro CTS (D.S. 001-97-TR), con el formato común de los
         documentos de la suite (al_report_base: encabezado, pie y
         estilos del comprobante A4).
         ============================================================= -->

    <!-- Firma del representante legal: imagen escaneada y raya con su
         nombre y documento. -->
    <template id="report_pe_legal_signature">
        <table class="pe-doc-plain pe-doc-signatures pe-doc-keep">
            <tr>
                <td style="width: 25%;"/>
                <td>
                    <img t-if="doc.main_parameter_id.signature" class="pe-doc-sign-img"
                         t-att-src="image_data_uri(doc.main_parameter_id.signature)"
                         alt="Firma"/>
                    <div class="pe-doc-sign-line">
                        <strong t-out="doc.main_parameter_id.reprentante_legal_id.name"/><br/>
                        <t t-out="doc.main_parameter_id.reprentante_legal_id.l10n_pe_document_label"/>
                        N° <t t-out="doc.main_parameter_id.reprentante_legal_id.l10n_pe_sunat_id_value"/><br/>
                        Representante legal
                    </div>
                </td>
                <td style="width: 25%;"/>
            </tr>
        </table>
    </template>

    <template id="report_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="al_report_base.report_pe_page"
                    o="doc"
                    company="doc.company_id"
                    doc_title.f="Certificado de trabajo"
                    doc_extra.f="D.S. N° 001-96-TR, art. 42"
                    page_class.f="pe-doc-text">

                    <div class="pe-doc-title">Certificado de trabajo</div>

                    <p>El que suscribe, en representación de
                        <strong t-field="doc.company_id.name"/>:</p>

                    <p><strong>CERTIFICA:</strong></p>

                    <p>
                        Que, <t t-out="doc.des_empl"/>
                        <strong t-field="doc.employee_id.name"/>, identificado con
                        <t t-out="doc.employee_id.l10n_pe_document_type_id.name or 'documento'"/>
                        N° <t t-out="doc.employee_id.identification_id or ''"/>,
                        laboró en esta empresa desde el
                        <t t-out="doc.format_date_letters(doc.date_ini)"/> hasta el
                        <t t-out="doc.format_date_letters(doc.date_fin)"/>,
                        ocupando el cargo de
                        <t t-out="doc.employee_id.job_id.name or doc.employee_id.job_title or ''"/>, demostrando
                        durante su permanencia responsabilidad, honestidad y
                        dedicación en las labores que le fueron encomendadas.
                    </p>

                    <p>
                        Se expide el presente documento de acuerdo a ley, para los
                        fines que el interesado crea conveniente.
                    </p>

                    <p style="margin-top: 24px;">
                        <t t-out="doc.city"/>,
                        <t t-out="doc.format_date_letters(doc.date_fin)"/>
                    </p>

                    <t t-call="al_hr_pe_reports.report_pe_legal_signature"/>
                </t>
            </t>
        </t>
    </template>

    <template id="report_letter">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="al_report_base.report_pe_page"
                    o="doc"
                    company="doc.company_id"
                    doc_title.f="Carta de retiro CTS"
                    doc_extra.f="D.S. N° 001-97-TR"
                    page_class.f="pe-doc-text">

                    <p class="text-end">
                        <t t-out="doc.city"/>,
                        <t t-out="doc.format_date_letters(doc.date_fin)"/>
                    </p>

                    <p style="margin: 18px 0;">
                        <strong>Señores<br/>
                        <t t-out="doc.employee_id.cts_bank_account_id.bank_id.name or ''"/><br/>
                        Presente.-</strong>
                    </p>

                    <p>De nuestra consideración:</p>

                    <p>
                        Por la presente comunicamos que <t t-out="doc.des_empl"/>
                        <strong t-field="doc.employee_id.name"/>, identificado con
                        <t t-out="doc.employee_id.l10n_pe_document_type_id.name or 'documento'"/>
                        N° <t t-out="doc.employee_id.identification_id or ''"/>,
                        ha dejado de laborar en nuestra empresa a partir del
                        <t t-out="doc.format_date_letters(doc.date_fin)"/>, por lo
                        que solicitamos se le haga entrega del total de la
                        Compensación por Tiempo de Servicios depositada en la
                        cuenta CTS N°
                        <t t-out="doc.employee_id.cts_bank_account_id.account_number or ''"/>
                        de vuestra entidad.
                    </p>

                    <p>Sin otro particular, quedamos de ustedes.</p>
                    <p>Atentamente,</p>

                    <t t-call="al_hr_pe_reports.report_pe_legal_signature"/>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_certificate" model="ir.actions.report">
        <field name="name">Certificado de trabajo</field>
        <field name="model">hr.certificate.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_hr_pe_reports.report_certificate</field>
        <field name="print_report_name">'Certificado de trabajo - %s' % (object.employee_id.name)</field>
        <field name="paperformat_id" ref="al_report_base.paperformat_pe_a4"/>
    </record>

    <record id="action_report_letter" model="ir.actions.report">
        <field name="name">Carta de retiro CTS</field>
        <field name="model">hr.letter.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_hr_pe_reports.report_letter</field>
        <field name="print_report_name">'Carta de retiro CTS - %s' % (object.employee_id.name)</field>
        <field name="paperformat_id" ref="al_report_base.paperformat_pe_a4"/>
    </record>

</odoo>
