<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================================================
         Contrato de trabajo desde plantilla (docs = hr.version), con el
         formato común de los documentos de la suite (al_report_base).
         El cuerpo lo renderiza l10n_pe.hr.contract.template._render_body
         (sustitución por diccionario controlado, sin eval); t-out con
         Markup lo inserta sin re-escapar.
         ============================================================= -->

    <template id="report_contract">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="al_report_base.report_pe_page"
                    o="doc"
                    company="doc.company_id"
                    doc_title.f="Contrato de trabajo"
                    doc_extra="doc.employee_id.name"
                    page_class.f="pe-doc-text">

                    <div class="pe-contract-body" t-out="doc.l10n_pe_contract_template_id._render_body(doc)"/>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_contract" model="ir.actions.report">
        <field name="name">Contrato de trabajo</field>
        <field name="model">hr.version</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_hr_pe_reports.report_contract</field>
        <field name="report_file">al_hr_pe_reports.report_contract</field>
        <field name="print_report_name">'Contrato - %s' % (object.employee_id.name)</field>
        <field name="paperformat_id" ref="al_report_base.paperformat_pe_a4"/>
        <!-- Sin binding en «Imprimir»: se imprime solo desde el botón de
             la ficha, que valida plantilla y datos mínimos antes. -->
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>
