<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="al_hr_pe.YearSelectionField">
        <span t-if="this.props.readonly" t-out="this.value or ''"/>
        <select t-else="" class="o_input o_field_year_selection pe-3"
                t-att-id="this.props.id" t-on-change="this.onChange">
            <option t-if="!this.isRequired or !this.value" value="" t-att-selected="!this.value"
                    t-out="this.props.placeholder or ''"/>
            <t t-foreach="this.years" t-as="year" t-key="year">
                <option t-att-value="year" t-att-selected="year === this.value" t-out="year"/>
            </t>
        </select>
    </t>
</templates>
