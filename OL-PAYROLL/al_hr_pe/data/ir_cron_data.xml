<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- La situación del derechohabiente y su derecho a asignación
             familiar dependen de la fecha (cumpleaños, fin del vínculo):
             se recalculan cada día. -->
        <record id="ir_cron_l10n_pe_dependent_refresh" model="ir.cron">
            <field name="name">Planillas PE: actualizar derechohabientes</field>
            <field name="model_id" ref="model_l10n_pe_hr_dependent"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_date_dependent()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 05:00:00')"/>
            <field name="active" eval="True"/>
        </record>
        <!-- Comisiones, prima y RMA del SPP desde la tabla de la SBS (no
             hay API oficial). Si la página no responde o no cuadra, no se
             toca nada. -->
        <record id="ir_cron_l10n_pe_sbs_rates" model="ir.cron">
            <field name="name">Planillas PE: tasas AFP desde la SBS</field>
            <field name="model_id" ref="model_hr_membership"/>
            <field name="state">code</field>
            <field name="code">model._cron_l10n_pe_update_sbs_rates()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 06:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
