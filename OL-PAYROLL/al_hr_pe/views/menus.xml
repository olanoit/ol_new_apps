<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================================================================
         Organización de la app Nómina (mismo patrón que la app Perú)

         Primer nivel: los menús nativos (Tablero, Empleados, Entradas de
         trabajo, Recibos de nómina, Reportes, Configuración) más
         «Beneficios sociales» (al_hr_pe_benefits). Segundo nivel:
         secciones (encabezados del desplegable). Tercer nivel: acciones.
         El desplegable de Odoo no muestra un cuarto nivel: no anidar más.

         Aquí viven **solo las secciones compartidas**. Cada menú se
         cuelga de su sección en el archivo donde está declarado:
         redefinirlo aquí obligaría a repetir su `name` —Odoo reescribe el
         nombre con el xmlid si se omite— y tener el mismo texto en dos
         sitios acaba divergiendo. Se carga antes que el resto.

         Configuración (secuencias junto a las secciones nativas: Ajustes 0,
         Entradas de trabajo 50, Salario 80, Tablero 100):
           60 Parámetros            62 Seguridad social
           64 Catálogos SUNAT       66 Construcción civil (su módulo)
           68 Asistencia (al_hr_pe_attendance)
           70 Tipos y plantillas    90 Importar desde Excel (su módulo)
         ================================================================== -->
    <data>

        <menuitem id="menu_hr_pe_cfg_parameters"
                  name="Parámetros"
                  parent="hr_payroll.menu_hr_payroll_configuration"
                  sequence="60"/>
        <menuitem id="menu_hr_pe_cfg_social"
                  name="Seguridad social"
                  parent="hr_payroll.menu_hr_payroll_configuration"
                  sequence="62"/>
        <!-- Las tablas del T-Registro juntas: se consultan poco y siempre
             por su número. -->
        <menuitem id="menu_hr_pe_cfg_catalogs"
                  name="Catálogos SUNAT"
                  parent="hr_payroll.menu_hr_payroll_configuration"
                  sequence="64"/>
        <menuitem id="menu_hr_pe_cfg_documents"
                  name="Tipos y plantillas"
                  parent="hr_payroll.menu_hr_payroll_configuration"
                  sequence="70"/>

        <!-- Recibos de nómina ▸ Pagos y contabilidad: el pago al banco
             (al_hr_pe_reports) y el asiento (al_hr_pe_account), que no
             dependen uno del otro. -->
        <menuitem id="menu_hr_pe_payments"
                  name="Pagos y contabilidad"
                  parent="hr_payroll.menu_hr_payroll_payslips"
                  sequence="90"/>

    </data>
</odoo>
