<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Línea de vacaciones truncas -->
    <record id="hr_liquidation_vacation_line_view_form" model="ir.ui.view">
        <field name="name">hr.liquidation.vacation.line.form</field>
        <field name="model">hr.liquidation.vacation.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" invisible="l10n_pe_locked" string="Calcular" type="object" context="{'line_form': True}"/>
                </header>
                <sheet>
                    <field name="l10n_pe_locked" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="employee_id" readonly="1"/></h1>
                        <div class="text-muted"><field name="identification_id" readonly="1"/></div>
                    </div>
                    <group>
                        <group string="Trabajador">
                            <field name="preserve_record" readonly="l10n_pe_locked"/>
                            <field name="version_id" readonly="1"/>
                            <field name="membership_id" readonly="1"/>
                            <field name="admission_date" readonly="1"/>
                            <field name="compute_date" readonly="1"/>
                            <field name="cessation_date" readonly="1"/>
                            <field name="distribution_id" readonly="1"/>
                        </group>
                        <group string="Periodo computable">
                            <field name="months" readonly="l10n_pe_locked"/>
                            <field name="days" readonly="l10n_pe_locked"/>
                            <field name="lacks" readonly="l10n_pe_locked"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Remuneración computable" name="remuneration">
                            <group>
                                <group string="Remuneración fija">
                                    <field name="wage" readonly="1"/>
                                    <field name="household_allowance" readonly="1"/>
                                </group>
                                <group string="Promedios">
                                    <field name="commission" readonly="l10n_pe_locked"/>
                                    <field name="bonus" readonly="l10n_pe_locked"/>
                                    <field name="extra_hours" readonly="l10n_pe_locked"/>
                                    <field name="computable_remuneration" readonly="1" class="fw-bold"/>
                                </group>
                            </group>
                        </page>
                        <page string="Cálculo" name="calculation">
                            <group>
                                <group string="Vacaciones truncas">
                                    <field name="amount_per_month" readonly="1"/>
                                    <field name="amount_per_day" readonly="1"/>
                                    <field name="vacation_per_month" readonly="1"/>
                                    <field name="vacation_per_day" readonly="1"/>
                                    <field name="amount_per_lack" readonly="1"/>
                                    <field name="truncated_vacation" readonly="1"/>
                                </group>
                                <group string="Vacaciones pendientes">
                                    <field name="accrued_vacation" readonly="l10n_pe_locked"/>
                                    <field name="advanced_vacation" readonly="l10n_pe_locked"/>
                                    <field name="total_vacation" readonly="1" class="fw-bold"/>
                                </group>
                            </group>
                        </page>
                        <page string="Aportes y neto" name="net">
                            <group>
                                <group string="Aportes al sistema de pensiones">
                                    <field name="onp" readonly="1"/>
                                    <field name="afp_jub" readonly="1"/>
                                    <field name="afp_si" readonly="1"/>
                                    <field name="afp_mixed_com" readonly="1"/>
                                    <field name="afp_fixed_com" readonly="1"/>
                                </group>
                                <group string="Neto a pagar">
                                    <field name="vacation_indemnity" readonly="l10n_pe_locked"/>
                                    <field name="total" readonly="1" class="fw-bold"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_liquidation_vacation_line_view_list" model="ir.ui.view">
        <field name="name">hr.liquidation.vacation.line.list</field>
        <field name="model">hr.liquidation.vacation.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="employee_id"/>
                <field name="identification_id" optional="show"/>
                <field name="preserve_record" optional="hide"/>
                <field name="admission_date" optional="show"/>
                <field name="compute_date" optional="hide"/>
                <field name="cessation_date" optional="hide"/>
                <field name="membership_id" optional="hide"/>
                <field name="distribution_id" optional="hide"/>
                <field name="months" optional="show"/>
                <field name="days" optional="show"/>
                <field name="lacks" optional="hide"/>
                <field name="wage" sum="Total" optional="show"/>
                <field name="household_allowance" sum="Total" optional="show"/>
                <field name="commission" sum="Total" optional="hide"/>
                <field name="bonus" sum="Total" optional="hide"/>
                <field name="extra_hours" sum="Total" optional="hide"/>
                <field name="computable_remuneration" sum="Total" optional="show"/>
                <field name="amount_per_month" sum="Total" optional="hide"/>
                <field name="amount_per_day" sum="Total" optional="hide"/>
                <field name="vacation_per_month" sum="Total" optional="hide"/>
                <field name="vacation_per_day" sum="Total" optional="hide"/>
                <field name="amount_per_lack" sum="Total" optional="hide"/>
                <field name="truncated_vacation" sum="Total" optional="hide"/>
                <field name="advanced_vacation" sum="Total" optional="hide"/>
                <field name="accrued_vacation" sum="Total" optional="hide"/>
                <field name="total_vacation" sum="Total" optional="show" force_save="1"/>
                <field name="onp" sum="Total" optional="show" force_save="1"/>
                <field name="afp_jub" sum="Total" optional="show" force_save="1"/>
                <field name="afp_si" sum="Total" optional="show" force_save="1"/>
                <field name="afp_mixed_com" sum="Total" optional="hide" force_save="1"/>
                <field name="afp_fixed_com" sum="Total" optional="hide" force_save="1"/>
                <field name="vacation_indemnity" sum="Total" optional="hide"/>
                <field name="total" sum="Total" optional="show" force_save="1"/>
            </list>
        </field>
    </record>

    <!-- Conceptos extra -->
    <record id="hr_liquidation_extra_concepts_view_list" model="ir.ui.view">
        <field name="name">hr.liquidation.extra_concepts.list</field>
        <field name="model">hr.liquidation.extra_concepts</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="l10n_pe_locked" column_invisible="1"/>
                <field name="conceptos_lines" column_invisible="1"/>
                <field name="employee_id"/>
                <field name="identification_id" readonly="1" optional="show"/>
                <field name="preserve_record" optional="hide"/>
                <field name="admission_date" readonly="1" optional="show"/>
                <field name="cessation_date" readonly="1" optional="show"/>
                <field name="income" sum="Total"/>
                <field name="expenses" sum="Total"/>
                <button name="action_add_concepts" invisible="l10n_pe_locked and not conceptos_lines" string="Agregar conceptos" type="object" class="oe_highlight"/>
            </list>
        </field>
    </record>

    <record id="hr_extra_concept_view_form" model="ir.ui.view">
        <field name="name">hr.liquidation.extra_concepts.form.popup</field>
        <field name="model">hr.liquidation.extra_concepts</field>
        <field name="arch" type="xml">
            <form string="Conceptos adicionales">
                <field name="l10n_pe_locked" invisible="1"/>
                <group>
                    <group string="Trabajador">
                        <field name="employee_id" readonly="1"/>
                    </group>
                    <group string="Totales">
                        <field name="income" readonly="1"/>
                        <field name="expenses" readonly="1"/>
                    </group>
                </group>
                <field name="conceptos_lines" readonly="l10n_pe_locked">
                    <list editable="bottom">
                        <field name="name_input_id" options="{'no_create': True}" required="1"/>
                        <field name="amount" sum="Total"/>
                        <field name="type"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

    <!-- Liquidación de cese -->
    <record id="hr_liquidation_view_form" model="ir.ui.view">
        <field name="name">hr.liquidation.form</field>
        <field name="model">hr.liquidation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process" string="Procesar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_recompute" string="Recalcular" type="object" invisible="state != 'draft'"/>
                    <button name="action_export_to_payslips" string="Exportar liquidación" type="object" class="oe_highlight" invisible="state != 'draft'" confirm="¿Está seguro de que desea exportar los montos de la liquidación a su respectivo lote de nóminas?"/>
                    <button name="action_draft" string="Volver a borrador" type="object" invisible="state != 'exported'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_add_employees" class="oe_stat_button" icon="fa-users" type="object" help="Trabajadores a liquidar" invisible="employee_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="employee_count"/></span>
                                <span class="o_stat_text">Cesados</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" force_save="1" placeholder="Se propone al elegir el lote"/></h1>
                    </div>
                    <div class="alert alert-info" role="status">
                        Liquidación de beneficios sociales al cese: para cada trabajador cesado en el
                        periodo del lote se calculan la gratificación trunca (Ley 27735), la CTS
                        trunca (D.Leg. 650) y las vacaciones truncas y pendientes (D.Leg. 713), más
                        los conceptos adicionales que se registren. Al exportar, todo pasa a la
                        boleta del trabajador en el lote.
                    </div>
                    <group>
                        <group string="Periodo">
                            <field name="payslip_run_id" readonly="state == 'exported'"/>
                            <field name="year" readonly="state == 'exported'" widget="year_selection"/>
                            <field name="gratification_type" readonly="1" force_save="1"/>
                            <field name="cts_type" readonly="1" force_save="1"/>
                        </group>
                        <group string="Parámetros">
                            <field name="with_bonus" readonly="state == 'exported'"/>
                            <field name="months_and_days" readonly="state == 'exported'"/>
                            <field name="exchange_type" readonly="state == 'exported'"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Gratificación trunca" name="gratification">
                            <field name="gratification_line_ids" readonly="state == 'exported'"
                                context="{'list_view_ref': 'al_hr_pe_benefits.hr_gratification_line_view_list',
                                          'form_view_ref': 'al_hr_pe_benefits.hr_gratification_line_view_form'}"/>
                        </page>
                        <page string="CTS trunca" name="cts">
                            <field name="cts_line_ids" readonly="state == 'exported'"
                                context="{'list_view_ref': 'al_hr_pe_benefits.hr_cts_line_view_list',
                                          'form_view_ref': 'al_hr_pe_benefits.hr_cts_line_view_form'}"/>
                        </page>
                        <page string="Vacaciones truncas" name="vacation">
                            <field name="vacation_line_ids" readonly="state == 'exported'"
                                context="{'list_view_ref': 'al_hr_pe_benefits.hr_liquidation_vacation_line_view_list',
                                          'form_view_ref': 'al_hr_pe_benefits.hr_liquidation_vacation_line_view_form'}"/>
                        </page>
                        <page string="Otros conceptos" name="extra_concepts">
                            <field name="liq_ext_concept_ids" readonly="state == 'exported'"
                                context="{'list_view_ref': 'al_hr_pe_benefits.hr_liquidation_extra_concepts_view_list'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_liquidation_view_list" model="ir.ui.view">
        <field name="name">hr.liquidation.list</field>
        <field name="model">hr.liquidation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="year" optional="show" options="{'enable_formatting': false}"/>
                <field name="payslip_run_id" optional="show"/>
                <field name="gratification_type" optional="show"/>
                <field name="cts_type" optional="show"/>
                <field name="with_bonus" optional="hide"/>
                <field name="months_and_days" optional="hide"/>
                <field name="exchange_type" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'verify'"
                       decoration-success="state in ('done', 'exported', 'close', 'paid out')" optional="show"/>
                <field name="company_id" readonly="1" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_hr_liquidation" model="ir.actions.act_window">
        <field name="name">Liquidación de cese</field>
        <field name="res_model">hr.liquidation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea aquí tu primera liquidación de cese
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_liquidation"
        action="action_hr_liquidation"
        parent="al_hr_pe_benefits.menu_hr_pe_benefits_root"
        sequence="3"/>

</odoo>
