<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Récord vacacional: hr.vacation.rest                          -->
    <!-- ============================================================ -->
    <record id="hr_vacation_rest_view_form" model="ir.ui.view">
        <field name="name">hr.vacation.rest.form.al.hr.pe.benefits</field>
        <field name="model">hr.vacation.rest</field>
        <field name="arch" type="xml">
            <form string="Saldo de vacaciones">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="employee_id" placeholder="Trabajador"/></h1>
                        <div class="text-muted"><field name="identification_id"/></div>
                    </div>
                    <div class="alert alert-info" role="status">
                        Récord vacacional (D.Leg. 713): por cada año completo de servicios el
                        trabajador gana 30 días calendario de descanso (15 en la pequeña y la
                        microempresa), si cumple el récord de días efectivos. Cada mes se devengan
                        2,5 días; los días gozados se restan del saldo.
                    </div>
                    <group>
                        <group string="Movimiento">
                            <field name="internal_motive"/>
                            <field name="motive"/>
                            <field name="date_aplication"/>
                            <field name="year"/>
                            <field name="date_from"/>
                            <field name="date_end"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="Días e importe">
                            <field name="days"/>
                            <field name="amount"/>
                            <field name="days_rest" class="fw-bold"/>
                            <field name="amount_rest" class="fw-bold"/>
                            <field name="is_saldo_final"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_vacation_rest_view_list" model="ir.ui.view">
        <field name="name">hr.vacation.rest.list.al.hr.pe.benefits</field>
        <field name="model">hr.vacation.rest</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="employee_id"/>
                <field name="identification_id" optional="show"/>
                <field name="year" optional="show"/>
                <field name="date_from" optional="hide"/>
                <field name="date_end" optional="hide"/>
                <field name="date_aplication" optional="show"/>
                <field name="internal_motive" optional="hide"/>
                <field name="motive" optional="show"/>
                <field name="days" sum="Total"/>
                <field name="amount" sum="Total" optional="show"/>
                <field name="days_rest"/>
                <field name="amount_rest" optional="show"/>
                <field name="is_saldo_final" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_vacation_rest_view_list_resumen" model="ir.ui.view">
        <field name="name">hr.vacation.rest.list.resumen.al.hr.pe.benefits</field>
        <field name="model">hr.vacation.rest</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="employee_id"/>
                <field name="identification_id" optional="show"/>
                <field name="year" optional="show"/>
                <field name="days_rest" sum="Total"/>
                <field name="amount_rest" sum="Total" optional="show"/>
                <field name="is_saldo_final" optional="hide"/>
                <field name="date_aplication" optional="hide"/>
                <field name="internal_motive" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1" optional="hide"/>
                <button name="action_show_details" icon="fa-list" string="Ver detalle" type="object"/>
            </list>
        </field>
    </record>

    <record id="hr_vacation_rest_view_search" model="ir.ui.view">
        <field name="name">hr.vacation.rest.search.al.hr.pe.benefits</field>
        <field name="model">hr.vacation.rest</field>
        <field name="arch" type="xml">
            <search string="Saldos de vacaciones">
                <field name="employee_id"/>
                <field name="identification_id"/>
                <field name="year"/>
                <separator/>
                <filter string="Saldo final" name="saldo_final" domain="[('is_saldo_final', '=', True)]"/>
                <filter string="Trabajador" name="group_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="Año vacacional" name="group_year" context="{'group_by': 'year'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_vacation_rest" model="ir.actions.act_window">
        <field name="name">Saldos de vacaciones</field>
        <field name="res_model">hr.vacation.rest</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_vacation_rest_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no hay saldos de vacaciones: calcúlalos desde el asistente de récord vacacional.
            </p>
        </field>
    </record>

    <!-- Asistente de recálculo del récord vacacional -->
    <record id="hr_vacation_rest_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.vacation.rest.wizard.form.al.hr.pe.benefits</field>
        <field name="model">hr.vacation.rest.wizard</field>
        <field name="arch" type="xml">
            <form string="Récord vacacional">
                <group>
                    <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                    <field name="show_all"/>
                    <field name="employee_ids" widget="many2many_tags" invisible="show_all"/>
                </group>
                <footer>
                    <button name="action_compute_balances" string="Calcular saldos" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_vacation_rest_wizard" model="ir.actions.act_window">
        <field name="name">Récord vacacional</field>
        <field name="res_model">hr.vacation.rest.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Devengue de vacaciones en la boleta -->
    <record id="hr_payslip_view_form_inherit_accrual_vacation" model="ir.ui.view">
        <field name="name">hr.payslip.form.accrual.vacation.al.hr.pe.benefits</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="al_hr_pe.hr_payslip_view_form_inherit_pe"/>
        <field name="arch" type="xml">
            <!-- Pestaña interna de «Planilla PE» (al_hr_pe). -->
            <xpath expr="//notebook[@name='l10n_pe_payslip_notebook']" position="inside">
                <page string="Devengue de vacaciones" name="accrued_vacations">
                    <field name="accrual_vacation_ids">
                        <list editable="bottom">
                            <field name="periodo_id" required="1"/>
                            <field name="motive" optional="show"/>
                            <field name="date_aplication" optional="show"/>
                            <field name="request_date_from" optional="show"/>
                            <field name="request_date_to" optional="show"/>
                            <field name="days" required="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Liquidación vacacional: hr.vacation                          -->
    <!-- ============================================================ -->
    <record id="hr_vacation_line_view_form" model="ir.ui.view">
        <field name="name">hr.vacation.line.form.al.hr.pe.benefits</field>
        <field name="model">hr.vacation.line</field>
        <field name="arch" type="xml">
            <form string="Línea de liquidación vacacional">
                <header>
                    <button name="action_compute" invisible="l10n_pe_locked" string="Calcular" context="{'line_form': True}" type="object" class="oe_edit_only"/>
                </header>
                <sheet>
                    <field name="l10n_pe_has_history" invisible="1"/>
                    <field name="l10n_pe_locked" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="employee_id" readonly="1"/></h1>
                        <div class="text-muted"><field name="identification_id" readonly="1"/></div>
                    </div>
                    <group>
                        <group string="Trabajador">
                            <field name="preserve_record" readonly="l10n_pe_locked"/>
                            <field name="version_id" readonly="1"/>
                            <field name="membership_id"/>
                            <field name="admission_date" readonly="1"/>
                        </group>
                        <group string="Vacaciones">
                            <field name="vacation_kind" readonly="l10n_pe_locked"/>
                            <field name="compute_date" readonly="1"/>
                            <field name="compute_date_ini" readonly="1"/>
                            <field name="compute_date_fin" readonly="1"/>
                            <field name="accrued_vacation" readonly="l10n_pe_locked" class="fw-bold"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Remuneración computable" name="remuneration">
                            <group>
                                <group string="Remuneración fija">
                                    <field name="wage" readonly="1"/>
                                    <field name="household_allowance" readonly="1"/>
                                </group>
                                <group string="Promedios de los últimos seis meses">
                                    <field name="commission" readonly="l10n_pe_locked"/>
                                    <field name="bonus" readonly="l10n_pe_locked"/>
                                    <field name="extra_hours" readonly="l10n_pe_locked"/>
                                    <field name="computable_remuneration" readonly="1" class="fw-bold"/>
                                </group>
                            </group>
                        </page>
                        <page string="Aportes y neto" name="net">
                            <group>
                                <group string="Aportes al sistema de pensiones">
                                    <field name="total_vacation" readonly="1"/>
                                    <field name="onp" readonly="1"/>
                                    <field name="afp_jub" readonly="1"/>
                                    <field name="afp_si" readonly="1"/>
                                    <field name="afp_mixed_com" readonly="1"/>
                                    <field name="afp_fixed_com" readonly="1"/>
                                </group>
                                <group string="Neto a pagar">
                                    <field name="neto_total" readonly="1"/>
                                    <field name="quinta" readonly="l10n_pe_locked"/>
                                    <field name="total" readonly="1" class="fw-bold"/>
                                </group>
                            </group>
                        </page>
                        <page string="Récord vacacional" name="record">
                            <group>
                                <group string="Días computables">
                                    <field name="months" readonly="l10n_pe_locked"/>
                                    <field name="days" readonly="l10n_pe_locked"/>
                                    <field name="lacks" readonly="l10n_pe_locked"/>
                                    <field name="total_days" readonly="1"/>
                                    <field name="record_days" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_vacation_line_view_list" model="ir.ui.view">
        <field name="name">hr.vacation.line.list.al.hr.pe.benefits</field>
        <field name="model">hr.vacation.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="l10n_pe_has_history" column_invisible="1"/>
                <field name="employee_id"/>
                <field name="identification_id" optional="show"/>
                <field name="preserve_record" optional="hide"/>
                <field name="vacation_kind" optional="show"/>
                <field name="admission_date" optional="hide"/>
                <field name="compute_date" optional="hide"/>
                <field name="compute_date_ini" optional="hide"/>
                <field name="compute_date_fin" optional="hide"/>
                <field name="membership_id" optional="hide"/>
                <field name="months" optional="hide"/>
                <field name="days" optional="hide"/>
                <field name="record_days" optional="hide"/>
                <field name="total_days" optional="hide"/>
                <field name="wage" sum="Total" optional="show"/>
                <field name="household_allowance" sum="Total" optional="show"/>
                <field name="commission" sum="Total" optional="hide"/>
                <field name="bonus" sum="Total" optional="hide"/>
                <field name="extra_hours" sum="Total" optional="hide"/>
                <field name="computable_remuneration" sum="Total" optional="show"/>
                <field name="accrued_vacation" sum="Total" optional="show"/>
                <field name="total_vacation" sum="Total" optional="show" force_save="1"/>
                <field name="onp" sum="Total" optional="show" force_save="1"/>
                <field name="afp_jub" sum="Total" optional="show" force_save="1"/>
                <field name="afp_si" sum="Total" optional="show" force_save="1"/>
                <field name="afp_mixed_com" sum="Total" optional="hide" force_save="1"/>
                <field name="afp_fixed_com" sum="Total" optional="hide" force_save="1"/>
                <field name="neto_total" sum="Total" optional="show" force_save="1"/>
                <field name="quinta" sum="Total" optional="show" force_save="1"/>
                <field name="total" sum="Total" optional="show" force_save="1"/>
                <button name="action_show_details" invisible="not l10n_pe_has_history" icon="fa-list" type="object" title="Ver detalle"/>
            </list>
        </field>
    </record>

    <record id="hr_leave_vacation_line_view_list" model="ir.ui.view">
        <field name="name">hr.leave.vacation.line.list.al.hr.pe.benefits</field>
        <field name="model">hr.leave.vacation.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="periodo_id" optional="show"/>
                <field name="wage" sum="Total" optional="show"/>
                <field name="household_allowance" sum="Total" optional="show"/>
                <field name="commission" sum="Total" optional="show"/>
                <field name="extra_hours" sum="Total" optional="show"/>
                <field name="others_income" sum="Total" optional="show"/>
                <field name="total" sum="Total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="hr_vacation_view_form" model="ir.ui.view">
        <field name="name">hr.vacation.form.al.hr.pe.benefits</field>
        <field name="model">hr.vacation</field>
        <field name="arch" type="xml">
            <form string="Liquidación vacacional">
                <header>
                    <button name="action_process" string="Procesar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_recompute" string="Recalcular" type="object" invisible="state != 'draft'"/>
                    <button name="action_import_fifth" string="Importar quinta" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_export_to_payslips" string="Exportar vacaciones" type="object" class="oe_highlight" invisible="state != 'draft'" confirm="¿Está seguro de que desea exportar los montos de vacaciones a su lote de nóminas?"/>
                    <button name="action_export_xlsx" string="Descargar Excel" type="object" class="oe_highlight"/>
                    <button name="action_draft" string="Volver a borrador" type="object" invisible="state != 'exported'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" force_save="1" placeholder="Se propone al elegir el lote"/></h1>
                    </div>
                    <div class="alert alert-info" role="status">
                        Liquidación vacacional del mes (D.Leg. 713): por cada trabajador que goza o
                        vende vacaciones en el periodo del lote, remuneración computable ÷ 30 × días
                        de vacaciones, menos los aportes a la ONP o a la AFP y la retención de quinta
                        proporcional. Al exportar, los importes pasan a las boletas del lote.
                    </div>
                    <group>
                        <group string="Periodo">
                            <field name="year" readonly="state == 'exported'" widget="year_selection"/>
                            <field name="payslip_run_id" readonly="state == 'exported'"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Trabajadores" name="employees">
                            <field name="line_ids" readonly="state == 'exported'"
                                   context="{'list_view_ref': 'al_hr_pe_benefits.hr_vacation_line_view_list',
                                             'form_view_ref': 'al_hr_pe_benefits.hr_vacation_line_view_form'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_vacation_view_list" model="ir.ui.view">
        <field name="name">hr.vacation.list.al.hr.pe.benefits</field>
        <field name="model">hr.vacation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="year" optional="show" options="{'enable_formatting': false}"/>
                <field name="payslip_run_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'verify'"
                       decoration-success="state in ('done', 'exported', 'close', 'paid out')" optional="show"/>
                <field name="company_id" readonly="1" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_hr_vacation" model="ir.actions.act_window">
        <field name="name">Liquidación vacacional</field>
        <field name="res_model">hr.vacation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera liquidación vacacional aquí.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Menús (cuelgan de la raíz de beneficios sociales)            -->
    <!-- ============================================================ -->
    <menuitem id="menu_hr_pe_benefits_vacation"
              name="Vacaciones"
              parent="al_hr_pe_benefits.menu_hr_pe_benefits_root"
              sequence="30"
              groups="hr_payroll.group_hr_payroll_user"/>
    <menuitem id="menu_hr_pe_benefits_vacation_liquidation"
              action="action_hr_vacation"
              parent="menu_hr_pe_benefits_vacation"
              sequence="1"/>
    <menuitem id="menu_hr_pe_benefits_vacation_rest_wizard"
              action="action_hr_vacation_rest_wizard"
              parent="menu_hr_pe_benefits_vacation"
              sequence="2"/>
    <menuitem id="menu_hr_pe_benefits_vacation_rest"
              action="action_hr_vacation_rest"
              parent="menu_hr_pe_benefits_vacation"
              sequence="3"/>

</odoo>
