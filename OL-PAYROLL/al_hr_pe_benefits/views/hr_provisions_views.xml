<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Popups de conceptos adicionales por línea -->
    <record id="hr_provisiones_cts_line_concepts_view_form" model="ir.ui.view">
        <field name="name">hr.provisiones.cts.line.concepts.form</field>
        <field name="model">hr.provisiones.cts.line</field>
        <field name="arch" type="xml">
            <form string="Conceptos adicionales">
                <field name="l10n_pe_locked" invisible="1"/>
                <group>
                    <group string="Trabajador">
                        <field name="employee_id" readonly="1"/>
                    </group>
                    <group string="Total">
                        <field name="total_cts" readonly="1"/>
                    </group>
                </group>
                <field name="concepto_ids" readonly="l10n_pe_locked">
                    <list editable="bottom">
                        <field name="concepto" required="1"/>
                        <field name="monto" required="1" sum="Total"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

    <record id="hr_provisiones_grati_line_concepts_view_form" model="ir.ui.view">
        <field name="name">hr.provisiones.grati.line.concepts.form</field>
        <field name="model">hr.provisiones.grati.line</field>
        <field name="arch" type="xml">
            <form string="Conceptos adicionales">
                <field name="l10n_pe_locked" invisible="1"/>
                <group>
                    <group string="Trabajador">
                        <field name="employee_id" readonly="1"/>
                    </group>
                    <group string="Total">
                        <field name="total_grati" readonly="1"/>
                    </group>
                </group>
                <field name="concepto_ids" readonly="l10n_pe_locked">
                    <list editable="bottom">
                        <field name="concepto" required="1"/>
                        <field name="monto" required="1" sum="Total"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

    <record id="hr_provisiones_vaca_line_concepts_view_form" model="ir.ui.view">
        <field name="name">hr.provisiones.vaca.line.concepts.form</field>
        <field name="model">hr.provisiones.vaca.line</field>
        <field name="arch" type="xml">
            <form string="Conceptos adicionales">
                <field name="l10n_pe_locked" invisible="1"/>
                <group>
                    <group string="Trabajador">
                        <field name="employee_id" readonly="1"/>
                    </group>
                    <group string="Total">
                        <field name="total_vaca" readonly="1"/>
                    </group>
                </group>
                <field name="concepto_ids" readonly="l10n_pe_locked">
                    <list editable="bottom">
                        <field name="concepto" required="1"/>
                        <field name="monto" required="1" sum="Total"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

    <!-- Provisión mensual -->
    <record id="hr_provisiones_view_form" model="ir.ui.view">
        <field name="name">hr.provisiones.form</field>
        <field name="model">hr.provisiones</field>
        <field name="arch" type="xml">
            <form string="Provisiones">
                <header>
                    <button name="action_process" string="Procesar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_compute_accumulated" string="Obtener acumulado" type="object" invisible="state != 'draft'"/>
                    <button name="action_close" string="Cerrar" type="object" invisible="state != 'draft'" groups="hr_payroll.group_hr_payroll_manager"/>
                    <button name="action_draft" string="Volver a borrador" type="object" invisible="state != 'done'" groups="hr_payroll.group_hr_payroll_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="payslip_run_id"/>
                        <h1><field name="payslip_run_id" readonly="state == 'done'" placeholder="Lote de nóminas"/></h1>
                    </div>
                    <div class="alert alert-info" role="status">
                        Provisión mensual de beneficios sociales: cada mes se reconoce como gasto la
                        parte devengada de la CTS (÷ 12, con el sexto de la gratificación), de la
                        gratificación (÷ 6, más la bonificación extraordinaria) y de las vacaciones
                        (÷ 12), aunque se paguen después. En la pequeña empresa la CTS y la
                        gratificación se provisionan a la mitad, y las vacaciones a la mitad en la
                        pequeña y la microempresa. «Cerrar» la deja como definitiva.
                    </div>
                    <group>
                        <group string="Datos para el cálculo">
                            <field name="gratificacion_id" readonly="state == 'done'"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Gratificación" name="gratifications">
                            <field name="grati_lines" readonly="state == 'done'">
                                <list editable="bottom" create="0">
                                    <field name="l10n_pe_locked" column_invisible="1"/>
                                    <field name="concepto_ids" column_invisible="1"/>
                                    <field name="employee_id"/>
                                    <field name="nro_doc" optional="show"/>
                                    <field name="version_id" optional="hide"/>
                                    <field name="fecha_ingreso" optional="show"/>
                                    <field name="distribution_id" optional="hide"/>
                                    <field name="basico" sum="Total"/>
                                    <field name="asignacion" sum="Total"/>
                                    <field name="commission" sum="Total" optional="hide"/>
                                    <field name="bonus" sum="Total" optional="hide"/>
                                    <field name="extra_hours" sum="Total" optional="hide"/>
                                    <field name="total_grati" sum="Total" optional="hide"/>
                                    <field name="provisiones_grati" sum="Total" optional="show"/>
                                    <field name="tasa" optional="hide"/>
                                    <field name="boni_grati" sum="Total" optional="show"/>
                                    <field name="total" sum="Total" class="fw-bold"/>
                                    <button name="action_open_concepts" invisible="l10n_pe_locked and not concepto_ids" type="object" icon="fa-file-text-o" title="Conceptos adicionales"/>
                                    <field name="prov_acumulado" sum="Total" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="CTS" name="cts">
                            <field name="cts_lines" readonly="state == 'done'">
                                <list editable="bottom" create="0">
                                    <field name="l10n_pe_locked" column_invisible="1"/>
                                    <field name="concepto_ids" column_invisible="1"/>
                                    <field name="employee_id"/>
                                    <field name="nro_doc" optional="show"/>
                                    <field name="version_id" optional="hide"/>
                                    <field name="fecha_ingreso" optional="show"/>
                                    <field name="distribution_id" optional="hide"/>
                                    <field name="basico" sum="Total"/>
                                    <field name="asignacion" sum="Total"/>
                                    <field name="commission" sum="Total" optional="hide"/>
                                    <field name="bonus" sum="Total" optional="hide"/>
                                    <field name="extra_hours" sum="Total" optional="hide"/>
                                    <field name="un_sexto_grati" sum="Total" optional="show"/>
                                    <field name="total_cts" sum="Total" optional="hide"/>
                                    <field name="provisiones_cts" sum="Total" class="fw-bold"/>
                                    <button name="action_open_concepts" invisible="l10n_pe_locked and not concepto_ids" type="object" icon="fa-file-text-o" title="Conceptos adicionales"/>
                                    <field name="prov_acumulado" sum="Total" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Vacaciones" name="vacations">
                            <field name="vaca_lines" readonly="state == 'done'">
                                <list editable="bottom" create="0">
                                    <field name="l10n_pe_locked" column_invisible="1"/>
                                    <field name="concepto_ids" column_invisible="1"/>
                                    <field name="employee_id"/>
                                    <field name="nro_doc" optional="show"/>
                                    <field name="version_id" optional="hide"/>
                                    <field name="fecha_ingreso" optional="show"/>
                                    <field name="distribution_id" optional="hide"/>
                                    <field name="basico" sum="Total"/>
                                    <field name="asignacion" sum="Total"/>
                                    <field name="commission" sum="Total" optional="hide"/>
                                    <field name="bonus" sum="Total" optional="hide"/>
                                    <field name="extra_hours" sum="Total" optional="hide"/>
                                    <field name="total_vaca" sum="Total" optional="hide"/>
                                    <field name="provisiones_vaca" sum="Total" class="fw-bold"/>
                                    <button name="action_open_concepts" invisible="l10n_pe_locked and not concepto_ids" type="object" icon="fa-file-text-o" title="Conceptos adicionales"/>
                                    <field name="prov_acumulado" sum="Total" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_provisiones_view_list" model="ir.ui.view">
        <field name="name">hr.provisiones.list</field>
        <field name="model">hr.provisiones</field>
        <field name="arch" type="xml">
            <list>
                <field name="payslip_run_id"/>
                <field name="gratificacion_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'verify'"
                       decoration-success="state in ('done', 'exported', 'close', 'paid out')"/>
                <field name="company_id" readonly="1" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_hr_provisiones" model="ir.actions.act_window">
        <field name="name">Provisiones</field>
        <field name="res_model">hr.provisiones</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea aquí tu primera provisión mensual de beneficios sociales
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_provisiones"
        action="action_hr_provisiones"
        parent="al_hr_pe_benefits.menu_hr_pe_benefits_root"
        sequence="40"/>

</odoo>
