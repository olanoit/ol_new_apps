<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_gratification_line_detalle_list" model="ir.ui.view">
        <field name="name">hr.gratification.line.detalle.list</field>
        <field name="model">hr.gratification.line.detalle</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="periodo_id" optional="show"/>
                <field name="wage" sum="Total" optional="show"/>
                <field name="household_allowance" sum="Total" optional="show"/>
                <field name="commission" sum="Total" optional="show"/>
                <field name="extra_hours" sum="Total" optional="show"/>
                <field name="others_income" sum="Total" optional="show"/>
                <field name="total" sum="Total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="hr_gratification_line_view_form" model="ir.ui.view">
        <field name="name">hr.gratification.line.form</field>
        <field name="model">hr.gratification.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" invisible="l10n_pe_locked" string="Calcular" type="object" context="{'line_form': True}"/>
                    <button name="action_show_details" invisible="not l10n_pe_has_history" string="Detalle histórico" type="object"/>
                </header>
                <sheet>
                    <field name="l10n_pe_has_history" invisible="1"/>
                    <field name="l10n_pe_locked" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="employee_id" readonly="1"/></h1>
                        <div class="text-muted"><field name="identification_id" readonly="1"/></div>
                    </div>
                    <group>
                        <group string="Trabajador">
                            <field name="preserve_record" readonly="l10n_pe_locked"/>
                            <field name="version_id" readonly="1"/>
                            <field name="labor_regime" readonly="1"/>
                            <field name="social_insurance_id" readonly="1"/>
                            <field name="admission_date" readonly="1"/>
                            <field name="compute_date" readonly="1" invisible="not cessation_date"/>
                            <field name="cessation_date" readonly="1" invisible="not cessation_date"/>
                            <field name="distribution_id" readonly="1"/>
                        </group>
                        <group string="Periodo computable">
                            <field name="months" readonly="l10n_pe_locked"/>
                            <field name="days" readonly="l10n_pe_locked"/>
                            <field name="lacks" readonly="l10n_pe_locked"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Remuneración computable" name="remuneration">
                            <group>
                                <group string="Remuneración fija">
                                    <field name="wage" readonly="1"/>
                                    <field name="household_allowance" readonly="1"/>
                                </group>
                                <group string="Promedios del semestre">
                                    <field name="commission" readonly="l10n_pe_locked"/>
                                    <field name="bonus" readonly="l10n_pe_locked"/>
                                    <field name="extra_hours" readonly="l10n_pe_locked"/>
                                    <field name="computable_remuneration" readonly="1" class="fw-bold"/>
                                </group>
                            </group>
                        </page>
                        <page string="Cálculo" name="calculation">
                            <group>
                                <group string="Gratificación del semestre">
                                    <field name="amount_per_month" readonly="1"/>
                                    <field name="amount_per_day" readonly="1"/>
                                    <field name="grat_per_month" readonly="1"/>
                                    <field name="grat_per_day" readonly="1"/>
                                    <field name="amount_per_lack" readonly="1"/>
                                </group>
                                <group string="Total a pagar">
                                    <field name="total_grat" readonly="1"/>
                                    <field name="bonus_essalud" readonly="1"/>
                                    <field name="total" readonly="1" class="fw-bold"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_gratification_line_view_list" model="ir.ui.view">
        <field name="name">hr.gratification.line.list</field>
        <field name="model">hr.gratification.line</field>
        <field name="arch" type="xml">
            <list edit="0" create="0" delete="0">
                <field name="l10n_pe_has_history" column_invisible="1"/>
                <field name="employee_id"/>
                <field name="identification_id" optional="show"/>
                <field name="preserve_record" optional="hide"/>
                <field name="admission_date" optional="show"/>
                <field name="compute_date" optional="hide"/>
                <field name="cessation_date" optional="hide"/>
                <field name="labor_regime" optional="hide"/>
                <field name="social_insurance_id" optional="hide"/>
                <field name="distribution_id" optional="hide"/>
                <field name="months" optional="show"/>
                <field name="days" optional="show"/>
                <field name="lacks" optional="hide"/>
                <field name="wage" sum="Total" optional="show"/>
                <field name="household_allowance" sum="Total" optional="show"/>
                <field name="commission" sum="Total" optional="hide"/>
                <field name="bonus" sum="Total" optional="hide"/>
                <field name="extra_hours" sum="Total" optional="hide"/>
                <field name="computable_remuneration" sum="Total" optional="show"/>
                <field name="amount_per_month" sum="Total" optional="hide"/>
                <field name="amount_per_day" sum="Total" optional="hide"/>
                <field name="grat_per_month" sum="Total" optional="hide"/>
                <field name="grat_per_day" sum="Total" optional="hide"/>
                <field name="amount_per_lack" sum="Total" optional="hide"/>
                <field name="total_grat" sum="Total" optional="show"/>
                <field name="bonus_essalud" sum="Total" optional="show"/>
                <field name="total" sum="Total" optional="show"/>
                <button name="action_show_details" invisible="not l10n_pe_has_history" icon="fa-list" type="object" title="Detalle histórico"/>
            </list>
        </field>
    </record>

    <record id="hr_gratification_view_form" model="ir.ui.view">
        <field name="name">hr.gratification.form</field>
        <field name="model">hr.gratification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process" string="Procesar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_recompute" string="Recalcular" type="object" invisible="state != 'draft'"/>
                    <button name="action_export_to_payslips" string="Exportar gratificación" type="object" class="oe_highlight" invisible="state != 'draft'" confirm="¿Está seguro de que desea exportar los montos de gratificación a su respectivo lote de nóminas?"/>
                    <button name="action_draft" string="Volver a borrador" type="object" invisible="state != 'exported'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lines" class="oe_stat_button" icon="fa-file-text-o" type="object" help="Boletas de gratificación" invisible="grati_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="grati_count"/></span>
                                <span class="o_stat_text">Boletas</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" force_save="1" placeholder="Se propone al elegir tipo y año"/></h1>
                    </div>
                    <div class="alert alert-info" role="status">
                        Gratificaciones de Fiestas Patrias (julio) y Navidad (diciembre), Ley 27735:
                        una remuneración computable por semestre (enero-junio y julio-diciembre),
                        proporcional a los meses y días laborados y menos las faltas. Además se paga
                        la bonificación extraordinaria de la Ley 30334: lo que el empleador
                        aportaría a EsSalud o a la EPS sobre la gratificación.
                    </div>
                    <group>
                        <group string="Periodo">
                            <field name="type" readonly="state == 'exported'"/>
                            <field name="year" readonly="state == 'exported'" widget="year_selection"/>
                            <field name="payslip_run_id" readonly="state == 'exported'"/>
                        </group>
                        <group string="Cálculo y pago">
                            <field name="with_bonus" readonly="state == 'exported'"/>
                            <field name="months_and_days" readonly="state == 'exported'"/>
                            <field name="deposit_date" readonly="state == 'exported'"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Trabajadores" name="employees">
                            <field name="line_ids" readonly="state == 'exported'"
                                context="{'list_view_ref': 'al_hr_pe_benefits.hr_gratification_line_view_list',
                                          'form_view_ref': 'al_hr_pe_benefits.hr_gratification_line_view_form'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_gratification_view_list" model="ir.ui.view">
        <field name="name">hr.gratification.list</field>
        <field name="model">hr.gratification</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="year" optional="show" options="{'enable_formatting': false}"/>
                <field name="type" optional="show"/>
                <field name="with_bonus" optional="show"/>
                <field name="deposit_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'verify'"
                       decoration-success="state in ('done', 'exported', 'close', 'paid out')" optional="show"/>
                <field name="company_id" readonly="1" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_hr_gratification" model="ir.actions.act_window">
        <field name="name">Gratificación</field>
        <field name="res_model">hr.gratification</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea aquí tu primera gratificación semestral
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_gratification"
        action="action_hr_gratification"
        parent="menu_hr_pe_benefits_root"
        sequence="1"/>

</odoo>
