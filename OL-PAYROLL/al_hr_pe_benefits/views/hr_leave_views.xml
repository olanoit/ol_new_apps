<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_type_form_inherit_pe" model="ir.ui.view">
        <field name="name">hr.work.entry.type.form.inherit.pe</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_holidays.hr_work_entry_type_view_form"/>
        <field name="arch" type="xml">
            <field name="request_unit" position="after">
                <field name="l10n_pe_suspension_type_id"
                       groups="hr_payroll.group_hr_payroll_user"/>
            </field>
        </field>
    </record>

    <!-- Accidente de trabajo: solo en las ausencias de incapacidad
         temporal (T21 «20»/«21»). -->
    <record id="hr_leave_view_form_inherit_pe" model="ir.ui.view">
        <field name="name">hr.leave.form.inherit.pe</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_entry_type_id']/.." position="after">
                <field name="l10n_pe_is_incapacity" invisible="1"/>
                <div invisible="not l10n_pe_is_incapacity">
                    <field name="l10n_pe_work_accident" nolabel="1"
                           readonly="state in ['cancel', 'refuse']"/>
                    <label for="l10n_pe_work_accident" class="ms-2"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="hr_work_suspension_view_list_inherit_pe" model="ir.ui.view">
        <field name="name">hr.work.suspension.list.inherit.pe</field>
        <field name="model">hr.work.suspension</field>
        <field name="inherit_id" ref="al_hr_pe.hr_work_suspension_view_list"/>
        <field name="arch" type="xml">
            <field name="days" position="after">
                <field name="l10n_pe_work_accident" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
