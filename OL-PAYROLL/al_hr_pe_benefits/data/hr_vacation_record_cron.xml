<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Récord vacacional (D.Leg. 713, art. 10): evalúa el año de
             servicios recién cumplido y reevalúa los «sin datos». -->
        <record id="ir_cron_l10n_pe_vacation_record" model="ir.cron">
            <field name="name">Planillas PE: evaluar récord vacacional</field>
            <field name="model_id" ref="model_hr_vacation_record"/>
            <field name="state">code</field>
            <field name="code">model._cron_evaluate_vacation_records()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 05:30:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
