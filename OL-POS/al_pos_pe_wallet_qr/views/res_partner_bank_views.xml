<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_bank_form" model="ir.ui.view">
        <field name="name">res.partner.bank.form.l10n_pe_wallet_qr</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <page name="internal_notes" position="before">
                <page string="QR de billetera" name="l10n_pe_wallet_qr">
                    <group>
                        <group>
                            <field name="l10n_pe_wallet_qr_image" widget="image" options="{'size': [220, 220]}"/>
                        </group>
                        <group>
                            <div colspan="2" class="text-muted">
                                Suba el QR de cobro de Yape, Plin u otra billetera que abona en esta
                                cuenta. Para cobrar con él en el TPV, cree un método de pago con
                                integración «QR» y formato «QR de billetera (Yape, Plin)» en un
                                diario de banco con esta cuenta.
                            </div>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

</odoo>
