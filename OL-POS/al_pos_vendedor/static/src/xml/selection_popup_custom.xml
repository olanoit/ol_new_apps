<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="al_pos_vendedor.SelectionPopupCustom" owl="1">
        <Dialog title="this.props.title" footer="false" size="'sm'">

            <div class="alv-popup">

                <!-- Buscador -->
                <div class="alv-search-wrap">
                    <i class="oi alv-search-icon" data-icon="search"/>
                    <input class="alv-search-input"
                           type="text"
                           placeholder="Buscar..."
                           autocomplete="off"
                           t-custom-model="this.state.inputValue"
                           t-ref="input"
                           t-on-input="this.searchLabel"/>
                    <button t-if="this.state.inputValue"
                            class="alv-search-clear"
                            t-on-click="() => { this.state.inputValue = ''; this.searchLabel(); }">
                        <i class="oi" data-icon="close"/>
                    </button>
                </div>

                <!-- Banner vendedor actual (solo si hay selección) -->
                <t t-if="this.currentSelection">
                    <div class="alv-current-banner">
                        <div class="alv-current-info">
                            <div class="alv-current-avatar"
                                 t-att-style="'background:' + this.getAvatarColor(this.currentSelection.label)">
                                <t t-out="this.getInitials(this.currentSelection.label)"/>
                            </div>
                            <div class="alv-current-text">
                                <span class="alv-current-label">Vendedor actual</span>
                                <span class="alv-current-name" t-out="this.currentSelection.label"/>
                            </div>
                        </div>
                        <button class="alv-deselect-btn" t-on-click="this.clearSelection">
                            <i class="oi me-1" data-icon="close"/>Quitar
                        </button>
                    </div>
                </t>

                <!-- Grid de vendedores -->
                <div class="alv-grid">

                    <t t-if="this.state.filteredList.length === 0">
                        <div class="alv-empty">
                            <i class="oi oi-filled alv-empty-icon" data-icon="person_remove"/>
                            <span>Sin resultados</span>
                        </div>
                    </t>

                    <t t-foreach="this.state.filteredList" t-as="item" t-key="item.id">
                        <button class="alv-card"
                                t-att-class="item.isSelected ? 'alv-card--selected' : ''"
                                t-on-click="() => this.selectItem(item)">

                            <!-- Marcar/quitar como vendedor predeterminado de la sesión -->
                            <span t-if="this.allowDefault"
                                  class="alv-star"
                                  t-att-class="this.state.defaultId === item.id ? 'alv-star--on' : ''"
                                  t-att-title="this.state.defaultId === item.id ? 'Vendedor predeterminado de la sesión' : 'Fijar como predeterminado de la sesión'"
                                  t-on-click="(ev) => this.toggleDefault(item, ev)">
                                <i t-att-data-icon="this.state.defaultId === item.id ? 'star' : 'star'"/>
                            </span>

                            <!-- Avatar -->
                            <div class="alv-avatar"
                                 t-att-style="'background:' + this.getAvatarColor(item.label)">
                                <t t-out="this.getInitials(item.label)"/>
                                <i t-if="item.isSelected" class="oi alv-avatar-check" data-icon="check"/>
                            </div>

                            <!-- Nombre -->
                            <span class="alv-card-name" t-out="item.label"/>

                        </button>
                    </t>

                </div>

                <!-- Ayuda: estrella = predeterminado de la sesión -->
                <div t-if="this.allowDefault" class="alv-default-hint">
                    <i class="oi oi-filled alv-default-hint-icon" data-icon="star"/>
                    <span>Toca la estrella para fijar el vendedor predeterminado de la sesión (se aplicará automáticamente a las ventas nuevas).</span>
                </div>

                <!-- Pie: cantidad + cancelar -->
                <div class="alv-footer">
                    <span class="alv-count">
                        <t t-out="this.state.filteredList.length"/>
                        <t t-if="this.state.filteredList.length === 1"> vendedor</t>
                        <t t-else=""> vendedores</t>
                    </span>
                    <button class="alv-cancel" t-on-click="this.cancel">
                        <i class="oi oi-filled me-1" data-icon="cancel"/>Cancelar
                    </button>
                </div>

            </div>
        </Dialog>
    </t>

</templates>
