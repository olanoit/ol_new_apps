<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Los vendedores cargados solo para asignarlos a la venta no aparecen
         en la lista de cajeros (no pueden iniciar sesión). -->
    <t t-name="al_pos_vendedor.CashierSelectionPopup"
       t-inherit="pos_hr.CashierSelectionPopup"
       t-inherit-mode="extension">
        <!-- Odoo 20: la lista sale de displayableOptions (con «ver todos»). -->
        <xpath expr="//button[@t-foreach='this.displayableOptions']" position="attributes">
            <attribute name="t-foreach">this.displayableOptions.filter((employee) => !employee._al_seller_only)</attribute>
        </xpath>
    </t>

</templates>
