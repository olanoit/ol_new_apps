<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mismo bloque que res_config_settings_views.xml (Ajustes > Punto de
         Venta), pero embebido directo en la ficha del PDV
         (Punto de Venta > Configuración > TPV) — pedido en vivo: que estas
         configuraciones también estén acá, no solo en Ajustes generales.
         Mismo criterio de orden: 1) método de impresión, 2) IP/puerto,
         3) datos del agente local (solo si el método es "Agente local"). -->
    <record id="pos_config_view_form_inherit_al_network_printer" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.al.network.printer</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <!-- Este bloque tiene ahora su propio toggle
                 (escpos_network_printer_enabled, ver models/pos_config.py) en vez
                 de depender del `other_devices` nativo (Epson) para mostrarse —
                 antes, activar/desactivar "ePos Printer" (de OTRO proveedor, sin
                 relación real con este módulo) decidía si se veía o no toda esta
                 sección. Se sigue ocultando este bloque si "ePos Printer" está
                 activo (`invisible="other_devices"` más abajo) — no tendría
                 sentido configurar los dos recibos a la vez, y de hecho no se
                 puede guardar (`_check_single_receipt_printer_backend`). En el
                 otro sentido, activar este módulo NO oculta el bloque nativo: se
                 decidió dejar los dos visibles en paralelo en vez de ocultar un
                 setting que no es de este módulo. -->
            <setting id="other_devices" position="after">
                <setting id="al_escpos_printer" string="Impresora ESC/POS de red"
                         help="Impresora térmica genérica de red (no Epson), sin IoT Box"
                         invisible="other_devices">
                    <field name="escpos_network_printer_enabled"/>
                    <!-- No se usa el atributo `documentation=` del widget nativo: ese mecanismo
                         concatena rutas relativas contra odoo.com/documentation (ver
                         DocumentationLink en web/static/src/views/widgets/documentation_link/),
                         pensado para docs oficiales de Odoo, no para la página de descripción de
                         un módulo propio. Un link relativo sí funciona en cualquier instancia: Odoo
                         sirve el `static/` de cada módulo instalado en su propia ruta, sin depender
                         del dominio de esa instancia. Misma clase (`o_doc_link`) y estructura que
                         usa el widget nativo, para que se vea igual. -->
                    <!--                    <a href="/al_pos_network_printer/static/description/index.html"-->
                    <!--                       title="Documentación" target="_blank" class="o_doc_link me-2">-->
                    <!--                        <i class="fa fa-external-link" aria-hidden="true"/>-->
                    <!--                        <span>Ver documentación completa</span>-->
                    <!--                    </a>-->
                    <div class="content-group" invisible="not escpos_network_printer_enabled">
                        <!-- 1. Método de impresión — primero, decide todo lo de abajo. -->
                        <div class="row mt-2">
                            <label for="escpos_printer_mode" string="Método de impresión"
                                   class="col-lg-4 o_light_label"/>
                            <div class="col-lg-8">
                                <field name="escpos_printer_mode" class="w-100"/>
                                <small class="text-muted d-block mt-1" invisible="escpos_printer_mode == 'agent'">
                                    Odoo le habla directo a la impresora (red local).
                                </small>
                                <small class="text-muted d-block mt-1" invisible="escpos_printer_mode != 'agent'">
                                    Usar solo si Odoo no llega a la impresora (ej. Odoo.sh) — requiere
                                    instalar un agente puente en la red del local.
                                </small>
                            </div>
                        </div>
                        <small class="text-muted d-block mb-2">
                            Recargar (F5) el POS después de cambiar esto.
                        </small>

                        <!-- 2. IP/puerto — hace falta en los 2 métodos. -->
                        <div class="row mt-2">
                            <div class="col-lg-6">
                                <field name="escpos_printer_ip"
                                       placeholder="ej. 192.168.0.252"
                                       class="w-100 pt-1"/>
                            </div>
                            <div class="col-lg-6">
                                <field name="escpos_printer_port"
                                       placeholder="Puerto (por defecto 9100)"
                                       class="w-100 pt-1"/>
                            </div>
                        </div>

                        <!-- Botón "Probar impresora": solo tiene sentido en modo
                             "backend" — en "agent" el backend no tiene ruta de
                             red hacia la impresora (ver action_test_escpos_printer). -->
                        <div class="row mt-2" invisible="escpos_printer_mode != 'backend' or not escpos_printer_ip">
                            <div class="col-lg-6 offset-lg-6">
                                <button name="action_test_escpos_printer"
                                        type="object"
                                        string="Probar impresora"
                                        class="btn-secondary w-100"
                                        icon="fa-print"/>
                            </div>
                        </div>

                        <!-- 1.5. Impresión automática — no depende del método
                             (backend/agente), aplica igual en los 2. -->
                        <div class="row mt-3 pt-2 border-top">
                            <div class="col-lg-8">
                                <label for="escpos_auto_print" string="Imprimir automáticamente al pagar"
                                       class="o_light_label"/>
                                <small class="text-muted d-block">
                                    Al guardar con esto marcado, el ticket sale solo apenas se confirma el
                                    pago (sin pantalla de recibo). Al desmarcar y guardar, vuelve el
                                    proceso normal (impresión manual).
                                </small>
                            </div>
                            <div class="col-lg-4 d-flex align-items-center">
                                <field name="escpos_auto_print"/>
                            </div>
                        </div>

                        <!-- 1.6. Cola de reintento en background — opt-in,
                             inactiva por defecto. Solo tiene sentido en modo
                             "backend": en "agent" el backend nunca ve el fallo
                             (ver escpos_retry_queue_enabled). -->
                        <div class="row mt-2" invisible="escpos_printer_mode != 'backend'">
                            <div class="col-lg-8">
                                <label for="escpos_retry_queue_enabled"
                                       string="Reintentar impresión fallida en segundo plano"
                                       class="o_light_label"/>
                                <small class="text-muted d-block">
                                    Si la impresión falla (impresora apagada, sin papel, red caída un
                                    momento), reintenta solo hasta que la impresora vuelva a responder, sin
                                    depender de que el cajero note el popup de reintento manual.
                                </small>
                            </div>
                            <div class="col-lg-4 d-flex align-items-center">
                                <field name="escpos_retry_queue_enabled"/>
                            </div>
                        </div>

                        <!-- 3. Agente local (Camino A/B) — SOLO si el método es "agent". -->
                        <div invisible="escpos_printer_mode != 'agent'">
                            <div class="row mt-2">
                                <div class="col-lg-8">
                                    <field name="escpos_agent_url"
                                           placeholder="URL del agente local, ej. http://192.168.0.50:8765"
                                           class="w-100"/>
                                </div>
                                <div class="col-lg-4">
                                    <widget name="al_test_escpos_agent"/>
                                </div>
                            </div>
                            <small class="text-muted d-block mb-2">
                                Debe usar <code>https://</code> si Odoo está en HTTPS.
                            </small>
                            <label for="escpos_agent_token" string="Token del agente"
                                   class="o_light_label d-block mt-2"/>
                            <field name="escpos_agent_token"
                                   placeholder="Opcional, pero recomendado"
                                   password="True"
                                   class="w-100"/>
                            <!-- Diálogo "Autorizar conexión con la impresora" antes
                                 de pagar (ver models/pos_config.py::
                                 escpos_require_agent_authorization y
                                 pos_store.js::pay()) — inactivo por defecto,
                                 opt-in una vez confirmado que el agente por HTTPS
                                 autoriza bien de punta a punta. -->
                            <div class="row mt-3">
                                <label for="escpos_require_agent_authorization"
                                       class="col-lg-8 o_light_label">
                                    Bloquear pago hasta autorizar el agente
                                </label>
                                <div class="col-lg-4">
                                    <field name="escpos_require_agent_authorization" class="oe_inline"/>
                                </div>
                            </div>
                            <small class="text-muted d-block mb-2">
                                Inactivo: el pago sigue igual que siempre, sin chequear antes al agente — el
                                ticket se intenta imprimir igual al final.
                            </small>
                            <label for="escpos_agent_channel" string="Canal del agente (bus)"
                                   class="o_light_label d-block mt-2"/>
                            <div class="row">
                                <div class="col-lg-8">
                                    <field name="escpos_agent_channel"
                                           class="w-100"
                                           widget="CopyClipboardChar"/>
                                </div>
                                <div class="col-lg-4">
                                    <button name="action_regenerate_escpos_agent_channel"
                                            type="object"
                                            string="Regenerar canal"
                                            class="btn-link"
                                            icon="fa-refresh"
                                            confirm="Cualquier agente conectado con el canal actual va a dejar de recibir los comprobantes del backend hasta que se reconfigure con el nuevo valor. ¿Continuar?"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
