<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hereda el formulario "Preparation Printers" del core
         (point_of_sale/views/pos_printer_view.xml). El widget="radio" del
         campo printer_type ya muestra automáticamente la opción nueva
         'escpos_network' agregada en models/pos_printer.py; acá solo se
         agregan los campos de IP/puerto que esa opción necesita. -->
    <record id="view_pos_printer_form_inherit_al_network_printer" model="ir.ui.view">
        <field name="name">pos.printer.form.inherit.al.network.printer</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_printer_form" />
        <field name="arch" type="xml">
            <field name="epson_printer_ip" position="after">
                <field name="escpos_printer_ip"
                       placeholder="192.168.1.87"
                       invisible="printer_type != 'escpos_network'" />
                <field name="escpos_printer_port"
                       placeholder="9100"
                       invisible="printer_type != 'escpos_network'" />
            </field>
        </field>
    </record>

    <record id="view_pos_printer_list_inherit_al_network_printer" model="ir.ui.view">
        <field name="name">pos.printer.list.inherit.al.network.printer</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_printer" />
        <field name="arch" type="xml">
            <field name="proxy_ip" position="after">
                <field name="escpos_printer_ip" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
