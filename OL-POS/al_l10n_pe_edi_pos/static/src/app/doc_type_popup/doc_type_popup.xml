<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="al_l10n_pe_edi_pos.DocTypePopup">
        <Dialog title="this.props.title" footer="false" size="'md'">
            <!-- Tipo: Recibo / Boleta / Factura -->
            <div class="alpe-doctype-grid alpe-doctype-grid--three">
                <t t-foreach="this.types" t-as="docType" t-key="docType.code">
                    <button class="alpe-doctype-card btn"
                            t-att-class="{ 'alpe-selected': this.state.type === docType.code }"
                            t-on-click="() => this.selectType(docType.code)">
                        <i t-att-class="'fa fa-2x mb-2 ' + docType.icon" role="img"/>
                        <div class="alpe-doctype-label" t-out="docType.label"/>
                        <div class="alpe-doctype-hint text-muted" t-out="docType.hint"/>
                        <i t-if="this.state.type === docType.code"
                           class="oi oi-filled alpe-check" data-icon="check_circle" role="img"/>
                    </button>
                </t>
            </div>

            <!-- Serie del tipo elegido, en el mismo modal -->
            <div t-if="this.state.type !== 'recibo' and this.seriesForType.length" class="mt-3">
                <div class="fw-bold mb-2">Serie del comprobante</div>
                <div class="d-flex flex-wrap gap-2">
                    <button t-foreach="this.seriesForType" t-as="serie" t-key="serie.id"
                            class="alpe-serie-chip btn btn-sm rounded-pill border d-flex align-items-center gap-2"
                            t-att-class="this.state.serieId === serie.id ? 'btn-primary' : 'btn-light'"
                            t-on-click="() => this.selectSerie(serie)">
                        <span t-out="serie.name"/>
                        <i t-att-class="'fa ' + (this.state.fixedIds[this.state.type] === serie.id ? 'fa-star text-warning' : 'fa-star-o')"
                           t-att-title="this.state.fixedIds[this.state.type] === serie.id ? 'Quitar serie fija' : 'Fijar como serie de esta caja'"
                           role="img"
                           t-on-click="(ev) => this.toggleFixed(serie, ev)"/>
                    </button>
                </div>
                <div class="text-muted mt-1" style="font-size: 85%;">
                    <i class="oi oi-filled text-warning me-1" data-icon="star"/>La serie fija se
                    aplica sola en cada venta de esta caja.
                </div>
            </div>

            <!-- Switch de emisión a SUNAT, debajo de la serie -->
            <div t-if="this.state.type !== 'recibo'" class="form-check form-switch mt-3">
                <input class="form-check-input" type="checkbox" role="switch"
                       id="alpe-send-switch" t-custom-model="this.state.send"/>
                <label class="form-check-label" for="alpe-send-switch">
                    Emitir a SUNAT
                    <span class="fw-bold" t-out="this.state.send ? 'Sí' : 'No'"/>
                </label>
                <div t-if="!this.state.send" class="text-muted" style="font-size: 85%;">
                    El comprobante se genera pero queda retenido: otro
                    usuario lo emite a SUNAT desde el backend.
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-3">
                <button class="btn btn-secondary" t-on-click="this.cancel">Cancelar</button>
                <button class="btn btn-primary" t-att-disabled="!this.canConfirm"
                        t-on-click="this.confirm">Confirmar</button>
            </div>
        </Dialog>
    </t>

</templates>
