<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- l10n_pe_edi_pos (EE) lee el tipo de documento de la factura sin
         comprobar que exista: con el pago en línea del TPV la orden se cierra
         en el servidor y el ticket se dibuja antes de que llegue la factura,
         y el TPV se queda en blanco (TypeError). Se lee con «?.». -->
    <t t-name="al_l10n_pe_edi_pos.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[@t-out='order.account_move.l10n_latam_document_type_id?.report_name']" position="attributes">
            <attribute name="t-out">order.account_move?.l10n_latam_document_type_id?.report_name</attribute>
        </xpath>
    </t>

</templates>
