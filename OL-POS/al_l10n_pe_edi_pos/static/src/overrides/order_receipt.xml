<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Recibo CPE del TPV. El recibo nativo NO se reemplaza (otros módulos
         —pos_loyalty, pos_restaurant, l10n_pe_edi_pos (EE), al_pos_vendedor—
         se anclan a sus nodos): se le añade un t-if y la versión CPE se
         inserta como hermano DESPUÉS, de modo que cualquier xpath
         //div[hasclass('pos-receipt')] de otro módulo siga encontrando
         primero el nativo. Mismo diseño que el ticket 80mm de
         al_l10n_pe_invoice (reglas continuas/discontinuas, sin rellenos
         grises — vernáculo de impresora térmica). -->
    <t t-name="al_l10n_pe_edi_pos.OrderReceipt"
       t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
            <attribute name="t-if">!peActive</attribute>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt')]" position="after">
            <div class="pos-receipt alpe-receipt p-2" t-if="this.peActive">
                    <t t-set="company" t-value="this.order.company"/>
                    <t t-set="amounts" t-value="this.peAmounts"/>

                    <!-- ENCABEZADO -->
                    <div class="alpe-center alpe-header">
                        <img t-if="this.order.config.receiptLogoUrl"
                             t-att-src="this.order.config.receiptLogoUrl" alt="Logo"/>
                        <div><strong t-out="company.name"/></div>
                        <div><strong>RUC: <t t-out="company.vat"/></strong></div>
                        <div t-if="company.street" t-out="company.street"/>
                        <div t-if="company.phone">Tel: <t t-out="company.phone"/></div>
                    </div>

                    <!-- TIPO Y NÚMERO DE DOCUMENTO -->
                    <div class="alpe-doc" t-if="this.peIssued">
                        <t t-out="this.order.peDocTypeLabel"/><br/>
                        <t t-out="this.peDocNumber"/>
                    </div>
                    <div class="alpe-doc" t-else="">
                        COMPROBANTE ELECTRÓNICO PENDIENTE<br/>
                        <small>Este ticket no es un comprobante de pago: solicite el
                        comprobante emitido.</small>
                    </div>

                    <!-- DATOS DEL CLIENTE -->
                    <ul class="alpe-info">
                        <li>
                            <strong>Señor(es):</strong>
                            <t t-out="this.order.partner_id?.name || 'CLIENTE VARIOS'"/>
                        </li>
                        <li t-if="this.order.partner_id?.vat">
                            <strong><t t-out="this.order.peVatLabel"/>:</strong>
                            <t t-out="this.order.partner_id.vat"/>
                        </li>
                        <li t-if="this.order.partner_id?.street">
                            <strong>Dirección:</strong>
                            <t t-out="this.order.partner_id.street"/>
                        </li>
                        <li>
                            <strong>Emisión:</strong>
                            <t t-out="this.order.formatDateOrTime('date_order')"/>
                        </li>
                        <li>
                            <strong>Moneda:</strong>
                            <t t-out="this.order.currency?.name === 'USD' ? 'DÓLARES AMERICANOS' : 'SOLES'"/>
                        </li>
                    </ul>

                    <!-- DETALLE DE LÍNEAS -->
                    <table class="alpe-lines">
                        <thead>
                            <tr>
                                <th class="alpe-ctr">Cant.</th>
                                <th>Descripción</th>
                                <th class="alpe-num">P.U.</th>
                                <th class="alpe-num">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="this.peReceiptLines" t-as="line" t-key="line.uuid">
                                <td class="alpe-ctr" t-out="line.qty"/>
                                <td>
                                    <t t-out="line.getFullProductName()"/>
                                    <div t-if="line.getDiscount()" class="alpe-discount">
                                        Desc. <t t-out="line.getDiscount()"/>%
                                    </div>
                                    <div t-if="line.customerNote" class="alpe-discount"
                                         t-out="line.customerNote"/>
                                </td>
                                <td class="alpe-num" t-out="this.formatCurrency(line.unitPrices.total_included)"/>
                                <td class="alpe-num" t-out="this.formatCurrency(line.priceIncl)"/>
                            </tr>
                        </tbody>
                    </table>

                    <!-- TOTALES SUNAT -->
                    <table class="alpe-totals">
                        <tr t-if="amounts.base">
                            <td class="alpe-label">Op. gravadas</td>
                            <td class="alpe-num" t-out="this.formatCurrency(amounts.base)"/>
                        </tr>
                        <tr t-if="amounts.exonerated">
                            <td class="alpe-label">Op. exoneradas</td>
                            <td class="alpe-num" t-out="this.formatCurrency(amounts.exonerated)"/>
                        </tr>
                        <tr t-if="amounts.unaffected">
                            <td class="alpe-label">Op. inafectas</td>
                            <td class="alpe-num" t-out="this.formatCurrency(amounts.unaffected)"/>
                        </tr>
                        <tr t-if="amounts.export">
                            <td class="alpe-label">Op. exportación</td>
                            <td class="alpe-num" t-out="this.formatCurrency(amounts.export)"/>
                        </tr>
                        <tr t-if="amounts.free">
                            <td class="alpe-label">Op. gratuitas</td>
                            <td class="alpe-num" t-out="this.formatCurrency(amounts.free)"/>
                        </tr>
                        <tr t-if="amounts.isc">
                            <td class="alpe-label">ISC</td>
                            <td class="alpe-num" t-out="this.formatCurrency(amounts.isc)"/>
                        </tr>
                        <tr t-if="amounts.ivap">
                            <td class="alpe-label">IVAP</td>
                            <td class="alpe-num" t-out="this.formatCurrency(amounts.ivap)"/>
                        </tr>
                        <tr t-if="amounts.icbper">
                            <td class="alpe-label">ICBPER</td>
                            <td class="alpe-num" t-out="this.formatCurrency(amounts.icbper)"/>
                        </tr>
                        <tr t-if="amounts.others">
                            <td class="alpe-label">Otros tributos</td>
                            <td class="alpe-num" t-out="this.formatCurrency(amounts.others)"/>
                        </tr>
                        <tr>
                            <td class="alpe-label" t-out="amounts.igvLabel"/>
                            <td class="alpe-num" t-out="this.formatCurrency(amounts.igv)"/>
                        </tr>
                        <tr class="alpe-total-row">
                            <td class="alpe-label">IMPORTE TOTAL</td>
                            <td class="alpe-num" t-out="this.formatCurrency(amounts.total)"/>
                        </tr>
                        <!-- Redondeo de efectivo: el total del comprobante
                             publicado ya lo incluye; solo se muestra en la
                             aproximación desde los totales del TPV. -->
                        <t t-if="!amounts.fromMove and this.order.appliedRounding">
                            <tr>
                                <td class="alpe-label">Redondeo</td>
                                <td class="alpe-num" t-out="this.formatCurrency(this.order.appliedRounding)"/>
                            </tr>
                            <tr>
                                <td class="alpe-label">Total a pagar</td>
                                <td class="alpe-num" t-out="this.formatCurrency(this.order.roundedPriceIncl)"/>
                            </tr>
                        </t>
                    </table>

                    <!-- MONTO EN LETRAS -->
                    <div class="alpe-words" t-if="amounts.words">
                        SON: <t t-out="amounts.words"/>
                    </div>

                    <!-- PAGOS -->
                    <ul class="alpe-info">
                        <li t-foreach="this.paymentLines" t-as="line" t-key="line_index">
                            <strong><t t-out="line.payment_method_id.name"/>:</strong>
                            <t t-out="this.formatCurrency(line.getAmount())"/>
                        </li>
                        <li t-foreach="this.peExtraPayments" t-as="payment" t-key="payment_index">
                            <strong><t t-out="payment.name"/>:</strong>
                            <t t-out="this.formatCurrency(payment.amount)"/>
                        </li>
                        <li t-if="this.order.showChange">
                            <strong>Vuelto:</strong>
                            <t t-out="this.formatCurrency(this.order.change)"/>
                        </li>
                        <li t-if="this.order.getCashierName()">
                            <strong>Usuario:</strong>
                            <t t-out="this.order.getCashierName()"/>
                        </li>
                        <!-- Vendedor de al_pos_vendedor (si está instalado). -->
                        <li t-if="this.order.seller_id?.name">
                            <strong>Vendedor:</strong>
                            <t t-out="this.order.seller_id.name"/>
                        </li>
                    </ul>

                    <div class="alpe-words" t-foreach="this.peNotes" t-as="note" t-key="note_index"
                         t-out="note"/>

                    <!-- QR DE REPRESENTACIÓN IMPRESA -->
                    <div class="alpe-qr" t-if="this.peQrUrl">
                        <img t-att-src="this.peQrUrl" alt="QR SUNAT"/>
                    </div>

                    <div class="alpe-footer">
                        <t t-if="this.peIssued">
                            <div>Representación impresa de la
                                <t t-out="this.order.peDocTypeLabel.toLowerCase()"/>.</div>
                            <div>Consulte en www.sunat.gob.pe</div>
                        </t>
                        <div>Gracias por su preferencia.</div>
                        <div t-if="this.order.config.receipt_footer"
                             style="white-space:pre-line"
                             t-out="this.order.config.receipt_footer"/>
                    </div>
            </div>
        </xpath>
    </t>

</templates>
