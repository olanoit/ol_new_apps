<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <!--
        Añade un botón circular de "información" superpuesto en la esquina de
        cada tarjeta de la cuadrícula. Oculto en las tarjetas renderizadas
        dentro del popup del configurador de combos, donde apilar otro modal
        sería confuso.
    -->
    <t t-name="al_pos_product_view.ProductCardInfoBtn"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension">

        <xpath expr="//article" position="inside">
            <!--
                Posicionado arriba a la derecha. El badge nativo
                `comboExtraPrice` también vive arriba a la derecha, así que
                ocultamos el botón de información en las tarjetas de combo
                que muestran la píldora de precio extra para evitar que se
                superpongan.
            -->
            <button t-if="!props.isComboPopup and !props.comboExtraPrice"
                    type="button"
                    class="pos-card-info-btn btn btn-light rounded-circle position-absolute top-0 end-0 m-1 d-flex align-items-center justify-content-center"
                    t-on-click="onInfoClick"
                    t-att-title="infoLabel"
                    t-att-aria-label="infoLabel">
                <i class="fa fa-info"/>
            </button>
        </xpath>

    </t>

    <!--
        Badge de stock en las tarjetas de la cuadrícula: la misma píldora que
        las filas de la lista, verde con stock en la caja y rojo sin él.
        Arriba a la izquierda (el botón de información va a la derecha y la
        cantidad en carrito abajo). No sale en el configurador de combos.
    -->
    <t t-name="al_pos_product_view.ProductCardStock"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension">
        <xpath expr="//article" position="inside">
            <span t-if="!props.isComboPopup and showStock"
                  t-attf-class="alpv-card-stock badge rounded-pill position-absolute top-0 start-0 m-1 {{ outOfStock ? 'text-bg-danger' : 'text-bg-success' }}"
                  t-att-title="stockTitle"
                  t-esc="stockLabel"/>
        </xpath>
    </t>

</templates>
