<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="al_pos_product_view.ProductScreenSwitchView"
       t-inherit="point_of_sale.ProductScreen"
       t-inherit-mode="extension">

        <!--
            Barra del catálogo, justo después del selector de categorías: a
            la izquierda los filtros (desplegable «Filtros» y facetas); a la
            derecha el control segmentado «Cuadrícula | Lista» y el botón
            «Actualizar stock».
        -->
        <xpath expr="//CategorySelector" position="after">
            <!--
                Sub-barra con su propio margen inferior y un borde sutil para
                separarla de la lista de productos / filas que siguen.
            -->
            <div class="pos-view-switch d-flex justify-content-end align-items-center gap-2 px-2 py-2 mb-2 mb-md-3 border-bottom"
                 t-if="!pos.scanning">
                <AlpvCatalogFilter/>
                <!-- Control segmentado (semántica de radio). -->
                <div class="alpv-view-switch__group btn-group flex-shrink-0" role="radiogroup" aria-label="Vista de productos">
                    <button type="button" role="radio"
                            class="btn btn-sm btn-light pos-view-switch__btn alpv-view-switch__option d-flex align-items-center gap-2"
                            t-att-class="{ 'active': state.viewMode !== 'list' }"
                            t-att-aria-checked="state.viewMode !== 'list' ? 'true' : 'false'"
                            title="Cuadrícula"
                            t-on-click="() => this.setProductView('grid')">
                        <i class="fa fa-fw fa-th-large" aria-hidden="true"/>
                        <span class="d-none d-md-inline">Cuadrícula</span>
                    </button>
                    <button type="button" role="radio"
                            class="btn btn-sm btn-light pos-view-switch__btn alpv-view-switch__option d-flex align-items-center gap-2"
                            t-att-class="{ 'active': state.viewMode === 'list' }"
                            t-att-aria-checked="state.viewMode === 'list' ? 'true' : 'false'"
                            title="Lista"
                            t-on-click="() => this.setProductView('list')">
                        <i class="fa fa-fw fa-list" aria-hidden="true"/>
                        <span class="d-none d-md-inline">Lista</span>
                    </button>
                </div>
                <!--
                    Actualizar stock ya (filas y tarjetas muestran el badge):
                    misma petición que el refresco automático, sin esperar a
                    que cambie el catálogo.
                -->
                <button type="button"
                        class="btn btn-sm btn-light pos-view-switch__btn alpv-view-switch__refresh-stock rounded-circle flex-shrink-0"
                        t-att-disabled="state.refreshingStock"
                        t-on-click="refreshStockNow"
                        t-att-title="refreshStockLabel"
                        t-att-aria-label="refreshStockLabel">
                    <i t-attf-class="fa fa-refresh {{ state.refreshingStock ? 'fa-spin' : '' }}"/>
                </button>
            </div>
        </xpath>

        <!--
            El estado nativo «¿Aún no hay productos?» (con su botón de cargar
            datos de ejemplo) no corresponde cuando son los filtros del
            catálogo los que lo vacían.
        -->
        <xpath expr="//div[hasclass('o_view_nocontent')]" position="before">
            <p t-elif="pos.alpvHasCatalogFilter" class="alpv-no-match">Ningún producto cumple los filtros seleccionados.</p>
        </xpath>

        <!--
            Conmuta la clase de layout de cuadrícula en el contenedor de la
            lista de productos.

            IMPORTANTE: DEBEMOS sobrescribir el atributo `class` estático
            para quitar `d-grid`. Las utilidades de Bootstrap aplican
            `display: grid !important`, así que si `d-grid` sobrevive en la
            clase estática pisa nuestra regla flex y la vista de lista se
            renderiza rota.

            También cambiamos de `t-attf-class` (plantilla de cadena) a
            `t-att-class` (sintaxis de objeto) para que la clase dinámica
            solo esté presente en el modo activo (más limpio y sin
            duplicación).
        -->
        <xpath expr="//div[hasclass('product-list')]" position="attributes">
            <attribute name="class">product-list gap-1 gap-lg-2 px-2 pt-0 pb-2</attribute>
            <attribute name="t-att-class">{ 'd-grid': state.viewMode !== 'list', 'product-list--rows': state.viewMode === 'list' }</attribute>
        </xpath>

        <!--
            Oculta el ProductCard nativo cuando la vista de lista está activa.
            Mantenemos el mismo bucle `t-foreach` porque solo cambiamos el
            renderizado, no los datos.
        -->
        <xpath expr="//ProductCard" position="attributes">
            <attribute name="t-if">state.viewMode !== 'list'</attribute>
        </xpath>

        <!--
            Renderiza un ProductListRow por producto cuando la vista de lista
            está activa. El clic añade el producto al pedido (mismo handler
            que la tarjeta de cuadrícula); el botón de información abre el
            ProductInfoPopup nativo.
        -->
        <xpath expr="//ProductCard" position="after">
            <ProductListRow
                t-if="state.viewMode === 'list'"
                t-foreach="productCateg[1]" t-as="product" t-key="'list-' + product.id"
                product="product"
                name="getProductName(product)"
                priceLabel="getProductListPrice(product)"
                priceDetail="getProductListPriceDetail(product)"
                imageUrl="pos.config.show_product_images and this.getProductImage(product)"
                productCartQty="this.state.quantityByProductTmplId[product.id]"
                onClick="() => this.addProductToOrder(product)"
                onInfoClick="() => this.pos.onProductInfoClick(product)"/>
        </xpath>

    </t>

</templates>
