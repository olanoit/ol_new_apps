<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="al_pos_product_view.ProductListRow">
        <article tabindex="0"
                 role="button"
                 class="pos-product-list-row d-flex align-items-center w-100 px-2 py-2 mb-1 rounded-3 bg-view border cursor-pointer"
                 t-on-click.stop="this.props.onClick"
                 t-on-keypress="(ev) => ev.code === 'Space' ? this.props.onClick(ev) : null"
                 t-att-data-product-id="this.props.product.id"
                 t-att-aria-label="this.addLabel">

            <!-- Miniatura (solo si la config del TPV tiene activadas las imágenes). -->
            <div t-if="this.props.imageUrl"
                 class="pos-product-list-row__img flex-shrink-0 me-2 rounded-2 overflow-hidden">
                <img class="w-100 h-100 object-fit-cover pe-none"
                     t-att-src="this.props.imageUrl"
                     t-att-alt="this.props.name"
                     draggable="false"/>
            </div>

            <!-- Nombre + SKU/código de barras/etiquetas -->
            <div class="pos-product-list-row__info flex-grow-1 overflow-hidden me-2">
                <div class="pos-product-list-row__name fw-bold text-truncate" t-out="this.props.name"/>
                <small t-if="this.sku or this.barcode or this.productTags.length" class="pos-product-list-row__meta text-muted d-flex flex-wrap align-items-center gap-2">
                    <span t-if="this.sku" class="pos-product-list-row__sku text-truncate">
                        <i class="oi me-1" data-icon="label"/>
                        <t t-out="this.sku"/>
                    </span>
                    <span t-if="this.barcode" class="pos-product-list-row__barcode text-truncate">
                        <i class="oi me-1" data-icon="barcode"/>
                        <t t-out="this.barcode"/>
                    </span>
                    <span t-foreach="this.productTags" t-as="tag" t-key="tag.id"
                          class="pos-product-list-row__tag d-inline-flex align-items-center">
                        <span class="pos-product-list-row__tag-dot rounded-circle d-inline-block me-1 flex-shrink-0"
                              t-att-style="this.tagDotStyle(tag)"/>
                        <span class="pos-product-list-row__tag-name text-truncate" t-out="tag.name"/>
                    </span>
                </small>
            </div>

            <!-- Stock disponible (solo productos almacenables). -->
            <span t-if="this.showStock"
                  t-attf-class="pos-product-list-row__stock badge rounded-pill me-2 {{ this.outOfStock ? 'text-bg-danger' : 'text-bg-success' }}"
                  t-out="this.uom ? this.stockQty + ' ' + this.uom : this.stockQty"/>

            <!-- Badge de cantidad en carrito (replica el comportamiento de la tarjeta). -->
            <span t-if="this.props.productCartQty"
                  class="pos-product-list-row__qty badge bg-black text-white fs-6 me-2"
                  t-out="this.props.productCartQty"/>

            <!-- Precio -->
            <div class="pos-product-list-row__price fw-bolder text-end me-2"
                 t-out="this.props.priceLabel"/>

            <!-- Botón de información -->
            <button type="button"
                    class="pos-product-list-row__info-btn btn btn-sm btn-light rounded-circle"
                    t-on-click="this.onInfoClick"
                    t-att-title="this.infoLabel"
                    t-att-aria-label="this.infoLabel">
                <i class="oi" data-icon="info"/>
            </button>
        </article>
    </t>

</templates>
