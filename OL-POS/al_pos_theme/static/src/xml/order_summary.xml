<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Panel de orden vacío: el core deja la columna en blanco. Se usa el
        slot `emptyCart` que OrderDisplay ya expone (sólo se renderiza cuando
        la orden no tiene líneas), así que no se toca su estructura.
    -->
    <t t-name="al_pos_theme.OrderSummary" t-inherit="point_of_sale.OrderSummary" t-inherit-mode="extension">
        <xpath expr="//OrderDisplay" position="inside">
            <t t-set-slot="emptyCart">
                <div class="alpt-empty-cart d-flex flex-column align-items-center justify-content-center flex-grow-1 text-center gap-2 p-4">
                    <span class="alpt-empty-cart__icon d-flex align-items-center justify-content-center rounded-circle">
                        <i class="fa fa-shopping-basket" aria-hidden="true"/>
                    </span>
                    <span class="alpt-empty-cart__title">La orden está vacía</span>
                    <span class="alpt-empty-cart__hint">Toque un producto o escanee un código de barras para comenzar.</span>
                </div>
            </t>
        </xpath>
    </t>

    <!--
        Línea seleccionada del ticket de la venta: quitar (basurero), −/+ y
        tocar la cantidad para escribirla (OrderSummary publica
        `env.alptStepLine`; en Órdenes y en los recibos la línea queda como en
        el core). Las líneas no seleccionadas conservan el diseño del core.
        Los botones frenan los eventos de puntero para no disparar el «tocar
        línea» (selección) ni la pulsación larga del core.
    -->
    <t t-name="al_pos_theme.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//ul[hasclass('info-list')]" position="after">
            <div t-if="alptShowLineActions" class="alpt-line-actions"
                 t-on-pointerdown.stop="() => {}" t-on-pointerup.stop="() => {}">
                <button type="button" class="alpt-line-remove" t-att-aria-label="alptRemoveLabel"
                        t-att-title="alptRemoveLabel" t-on-click.stop="() => this.alptRemove()">
                    <i class="fa fa-trash-o" aria-hidden="true"/>
                </button>
                <div class="alpt-qty-stepper" role="group" t-att-aria-label="alptStepperLabel">
                    <button type="button" class="alpt-qty-stepper__btn" aria-label="Uno menos" title="Uno menos"
                            t-on-click.stop="() => this.alptStep(-1)">
                        <i class="fa fa-minus" aria-hidden="true"/>
                    </button>
                    <!-- Tocar la cantidad: campo en la línea (teclado físico) o
                         teclado del TPV, según pos.config.al_theme_qty_edit_mode. -->
                    <input t-if="alptQtyState.editing" t-ref="alptQtyInput"
                           type="text" inputmode="decimal" autocomplete="off"
                           class="alpt-qty-stepper__qty alpt-qty-stepper__input"
                           aria-label="Escribir la cantidad" t-att-value="alptQtyLabel"
                           t-on-keydown="alptOnQtyKeydown" t-on-blur="alptCommitQty"
                           t-on-click.stop="() => {}"/>
                    <button t-else="" type="button" class="alpt-qty-stepper__qty" aria-label="Escribir la cantidad"
                            title="Escribir la cantidad" t-on-click.stop="() => this.alptEditQty()"
                            t-esc="alptQtyLabel"/>
                    <button type="button" class="alpt-qty-stepper__btn" aria-label="Uno más" title="Uno más"
                            t-on-click.stop="() => this.alptStep(1)">
                        <i class="fa fa-plus" aria-hidden="true"/>
                    </button>
                </div>
            </div>
        </xpath>
    </t>

</templates>
