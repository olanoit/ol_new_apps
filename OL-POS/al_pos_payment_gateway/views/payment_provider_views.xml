<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form.al_pos_payment_gateway</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_al_pos_payment_method" type="object" class="oe_stat_button"
                        icon="shopping_basket" groups="point_of_sale.group_pos_manager"
                        invisible="not active">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Cobrar en el TPV</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

</odoo>
