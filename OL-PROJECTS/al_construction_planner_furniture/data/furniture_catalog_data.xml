<?xml version="1.0" encoding="utf-8"?>
<!-- Catálogo de actividades de contrata de mobiliario, listas de tarifas y
     reglas del método de unión (v1.8, M18-18 y M18-19). Tarifas base de la
     lista de cocinas leídas en las fichas de pago ALL-PR-F-03 de Allcenter;
     la de closet y cajones, más baja. noupdate: cada cliente las ajusta. -->
<odoo noupdate="1">
    <!-- Reglas del método de unión: insumos de armado del despiece. -->
    <record id="join_rule_plinth" model="construction.join.rule">
        <field name="sequence">1</field>
        <field name="name">Zócalo: sin unión</field>
        <field name="method">none</field>
        <field name="special_kind">plinth</field>
    </record>
    <record id="join_rule_screw" model="construction.join.rule">
        <field name="sequence">10</field>
        <field name="name">Solo tornillo: 20 a 25 tornillos 4x50</field>
        <field name="method">screw</field>
        <field name="screws_min">20</field><field name="screws_max">25</field>
        <field name="dowels_min">0</field><field name="dowels_max">0</field>
    </record>
    <record id="join_rule_mixed" model="construction.join.rule">
        <field name="sequence">20</field>
        <field name="name">Mixto: 12 a 15 tornillos 4x50 y 12 tarugos</field>
        <field name="method">mixed</field>
        <field name="screws_min">12</field><field name="screws_max">15</field>
        <field name="dowels_min">12</field><field name="dowels_max">12</field>
    </record>
    <record id="join_rule_dowel" model="construction.join.rule">
        <field name="sequence">30</field>
        <field name="name">Solo tarugo: 20 a 28 tarugos</field>
        <field name="method">dowel</field>
        <field name="screws_min">0</field><field name="screws_max">0</field>
        <field name="dowels_min">20</field><field name="dowels_max">28</field>
    </record>
    <record id="join_rule_none" model="construction.join.rule">
        <field name="sequence">40</field>
        <field name="name">Sin tornillos ni tarugos: sin unión</field>
        <field name="method">none</field>
        <field name="screws_min">0</field><field name="screws_max">0</field>
        <field name="dowels_min">0</field><field name="dowels_max">0</field>
    </record>

