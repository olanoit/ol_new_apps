<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ajustes ▸ Fabricación ▸ «Órdenes del plan de obra»: categoría de los productos de módulo. -->
    <record id="res_config_settings_view_form_module_product" model="ir.ui.view">
        <field name="name">res.config.settings.form.module.product</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="al_construction_planner_mrp.res_config_settings_view_form_whole_sheet"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='construction_production_date_block']" position="inside">
                <setting id="construction_module_categ" company_dependent="1"
                         help="Los productos de los módulos se crean con esta categoría: de ella toman el método de costo (promedio para el costeo de las órdenes) y sus cuentas.">
                    <field name="construction_module_categ_id" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
    <!-- Ajustes ▸ Planificación de obra ▸ Obra: nombres de los estados del
         ambiente que no son etapas (paquete 1.16, M116-02). -->
    <record id="res_config_settings_view_form_space_states" model="ir.ui.view">
        <field name="name">res.config.settings.form.space.states</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="al_construction_planner.res_config_settings_view_form_construction_planner"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='construction_planner_contracts']" position="inside">
                <setting company_dependent="1" id="construction_space_states" string="Estados del ambiente"
                         help="Los que no son etapas en la etapa actual de cada ambiente del Cronograma. No aparecen en las obras cuyo perfil no mide sus ambientes.">
                    <div class="content-group">
                        <div class="row mt-2">
                            <label for="construction_state_pending_label" class="col-lg-5 o_light_label"/>
                            <field name="construction_state_pending_label"/>
                        </div>
                        <div class="row">
                            <label for="construction_state_measured_label" class="col-lg-5 o_light_label"/>
                            <field name="construction_state_measured_label"/>
                        </div>
                        <div class="row">
                            <label for="construction_state_delivered_label" class="col-lg-5 o_light_label"/>
                            <field name="construction_state_delivered_label"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
