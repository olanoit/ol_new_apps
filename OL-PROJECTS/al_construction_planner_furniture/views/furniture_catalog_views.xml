<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Listas de tarifas por familia y obra y reglas del método de unión
         (v1.8, M18-18 y M18-19). -->
    <record id="construction_rate_list_view_list" model="ir.ui.view">
        <field name="name">construction.rate.list.list</field>
        <field name="model">construction.rate.list</field>
        <field name="arch" type="xml">
            <list string="Listas de tarifas">
                <field name="name"/>
                <field name="family"/>
                <field name="project_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="construction_rate_list_view_form" model="ir.ui.view">
        <field name="name">construction.rate.list.form</field>
        <field name="model">construction.rate.list</field>
        <field name="arch" type="xml">
            <form string="Lista de tarifas">
                <header>
                    <button name="action_copy_for_project" type="object" string="Versión para una obra"
                            help="Copia la lista para pactar sus tarifas con una obra."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Tarifas de cocina · Obra MOMEN"/></h1></div>
                    <group>
                        <group>
                            <field name="family"/>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="activity_id" options="{'no_create': True}"/>
                            <field name="uom_id"/>
                            <field name="price"/>
                            <field name="retention_pct" optional="show"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Notas"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_rate_list" model="ir.actions.act_window">
        <field name="name">Listas de tarifas</field>
        <field name="res_model">construction.rate.list</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree una lista de tarifas</p>
            <p>Una lista por familia (cocina y baño; closet y cajones) y, como las tarifas se
               pactan por obra, una versión por obra con su vigencia. Una tarifa de la obra o de
               la contrata escrita en «Tarifas de contrata» manda sobre la lista.</p>
        </field>
    </record>

    <record id="construction_join_rule_view_list" model="ir.ui.view">
        <field name="name">construction.join.rule.list</field>
        <field name="model">construction.join.rule</field>
        <field name="arch" type="xml">
            <list string="Reglas del método de unión" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="method"/>
                <field name="special_kind"/>
                <field name="screws_min"/>
                <field name="screws_max"/>
                <field name="dowels_min"/>
                <field name="dowels_max"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_construction_join_rule" model="ir.actions.act_window">
        <field name="name">Reglas del método de unión</field>
        <field name="res_model">construction.join.rule</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree las reglas del método de unión</p>
            <p>Se cuentan los tornillos y tarugos de armado de la receta del módulo (los de
               Ajustes; no los de instalación) y gana la primera regla que calza.</p>
        </field>
    </record>

    <record id="construction_labor_activity_view_form_furniture" model="ir.ui.view">
        <field name="name">construction.labor.activity.form.furniture</field>
        <field name="model">construction.labor.activity</field>
        <field name="inherit_id" ref="al_construction_planner.construction_labor_activity_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Mobiliario" name="furniture_catalog">
                    <group>
                        <field name="activity_class"/>
                        <field name="join_method" invisible="activity_class not in ('assembly_method', 'onsite_assembly')"/>
                        <field name="special_kind" invisible="activity_class != 'assembly_special'"/>
                    </group>
                    <group>
                        <field name="piece_types"/>
                        <field name="piece_measure" invisible="not piece_types"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="construction_labor_activity_view_list_furniture" model="ir.ui.view">
        <field name="name">construction.labor.activity.list.furniture</field>
        <field name="model">construction.labor.activity</field>
        <field name="inherit_id" ref="al_construction_planner.construction_labor_activity_view_list"/>
        <field name="arch" type="xml">
            <field name="stage" position="after">
                <field name="activity_class" optional="show"/>
                <field name="join_method" optional="hide"/>
                <field name="special_kind" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="res_config_settings_view_form_furniture_join" model="ir.ui.view">
        <field name="name">res.config.settings.form.furniture.join</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="al_construction_planner.res_config_settings_view_form_construction_planner"/>
        <field name="arch" type="xml">
            <block name="construction_planner_contracts" position="inside">
                <setting company_dependent="1" id="construction_join_products" string="Método de unión del módulo"
                         help="Los tornillos y tarugos de armado que cuentan las reglas del método de unión.">
                    <div class="content-group">
                        <div class="row mt-2">
                            <label for="construction_join_screw_product_ids" class="col-lg-5 o_light_label"/>
                            <field name="construction_join_screw_product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </div>
                        <div class="row">
                            <label for="construction_join_dowel_product_ids" class="col-lg-5 o_light_label"/>
                            <field name="construction_join_dowel_product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
