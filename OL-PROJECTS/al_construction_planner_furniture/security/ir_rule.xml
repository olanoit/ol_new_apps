<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
        <record id="rule_construction_rubro_account_company" model="ir.rule">
            <field name="name">Cuenta Rubro: compañías del usuario</field>
            <field name="model_id" ref="model_construction_rubro_account"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_construction_typology_module_company" model="ir.rule">
            <field name="name">Módulo de la tipología: compañías del usuario</field>
            <field name="model_id" ref="model_construction_typology_module"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    <record id="rule_construction_typology_furniture_company" model="ir.rule">
            <field name="name">Mueble de la tipología: compañías del usuario</field>
            <field name="model_id" ref="model_construction_typology_furniture"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Listas de tarifas (v1.8): las generales sin compañía se comparten. -->
        <record id="rule_construction_rate_list_company" model="ir.rule">
            <field name="name">Listas de tarifas: compañías del usuario</field>
            <field name="model_id" ref="model_construction_rate_list"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Auditoría del 16-nov-2026: modelos con compañía que no tenían regla. -->
        <record id="rule_construction_real_recipe_company" model="ir.rule">
            <field name="name">Receta real del mueble: compañías del usuario</field>
            <field name="model_id" ref="model_construction_real_recipe"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_real_recipe_line_company" model="ir.rule">
            <field name="name">Material de la receta real: compañías del usuario</field>
            <field name="model_id" ref="model_construction_real_recipe_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_recipe_versus_company" model="ir.rule">
            <field name="name">Planificado y real del mueble: compañías del usuario</field>
            <field name="model_id" ref="model_construction_recipe_versus"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_typology_piece_company" model="ir.rule">
            <field name="name">Pieza del módulo: compañías del usuario</field>
            <field name="model_id" ref="model_construction_typology_piece"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_typology_module_material_company" model="ir.rule">
            <field name="name">Material del módulo: compañías del usuario</field>
            <field name="model_id" ref="model_construction_typology_module_material"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_rate_list_line_company" model="ir.rule">
            <field name="name">Línea de la lista de tarifas: compañías del usuario</field>
            <field name="model_id" ref="model_construction_rate_list_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
