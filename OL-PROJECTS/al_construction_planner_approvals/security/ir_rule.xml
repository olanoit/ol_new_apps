<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_construction_approval_route_company" model="ir.rule">
            <field name="name">Rutas de aprobación de obra: compañías del usuario</field>
            <field name="model_id" ref="model_construction_approval_route"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_approval_route_approver_company" model="ir.rule">
            <field name="name">Aprobadores de las rutas de obra: compañías del usuario</field>
            <field name="model_id" ref="model_construction_approval_route_approver"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <!-- Con Aprobaciones, el aprobador de la ruta ve el requerimiento que
             le toca (la regla «por revisar» mira las revisiones por niveles). -->
        <record id="rule_construction_request_approval_approver" model="ir.rule">
            <field name="name">Requerimiento de obra: aprobador en Aprobaciones</field>
            <field name="model_id" ref="al_construction_material_request.model_construction_material_request"/>
            <field name="domain_force">[('construction_approval_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[Command.link(ref('al_construction_material_request.group_construction_approver'))]"/>
        </record>
        <record id="rule_construction_request_line_approval_approver" model="ir.rule">
            <field name="name">Línea de requerimiento de obra: aprobador en Aprobaciones</field>
            <field name="model_id" ref="al_construction_material_request.model_construction_material_request_line"/>
            <field name="domain_force">[('request_id.construction_approval_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[Command.link(ref('al_construction_material_request.group_construction_approver'))]"/>
        </record>
    </data>
</odoo>
