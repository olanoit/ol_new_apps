<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_contractor_worker_company" model="ir.rule">
            <field name="name">Personal de contrata: compañías del usuario</field>
            <field name="model_id" ref="model_construction_contractor_worker"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_contractor_attendance_company" model="ir.rule">
            <field name="name">Marcación de contrata: compañías del usuario</field>
            <field name="model_id" ref="model_construction_contractor_attendance"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_labor_cost_allocation_company" model="ir.rule">
            <field name="name">Cierre de costo de personal: compañías del usuario</field>
            <field name="model_id" ref="model_construction_labor_cost_allocation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_labor_cost_allocation_line_company" model="ir.rule">
            <field name="name">Línea del cierre de costo de personal: compañías del usuario</field>
            <field name="model_id" ref="model_construction_labor_cost_allocation_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
