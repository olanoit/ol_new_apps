<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_construction_attendance" model="ir.ui.view">
        <field name="name">res.config.settings.form.construction.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="al_construction_planner.res_config_settings_view_form_construction_planner"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='construction_categ_installation_id']/.." position="after">
                <div class="row">
                    <label for="construction_labor_cost_account_id" class="col-lg-5 o_light_label"/>
                    <field name="construction_labor_cost_account_id" options="{'no_create': True}"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
