<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_tree_site_checks" model="ir.ui.view">
        <field name="name">hr.attendance.list.site.checks</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <field name="check_out" position="after">
                <field name="l10n_pe_construction_site_id" optional="show"/>
                <field name="l10n_pe_site_late" optional="show"/>
                <field name="l10n_pe_site_out_of_range" optional="show"/>
                <field name="l10n_pe_site_distance_m" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="action_own_attendance_sites" model="ir.actions.act_window">
        <field name="name">Asistencia de personal propio</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('l10n_pe_construction_site_id', '!=', False)]</field>
        <field name="context">{'search_default_groupby_name': 0}</field>
    </record>
</odoo>
