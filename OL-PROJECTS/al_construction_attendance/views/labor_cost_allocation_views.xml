<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cierre de costo de personal (P-29) -->
    <record id="view_labor_cost_allocation_list" model="ir.ui.view">
        <field name="name">construction.labor.cost.allocation.list</field>
        <field name="model">construction.labor.cost.allocation</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="date_from"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_labor_cost_allocation_form" model="ir.ui.view">
        <field name="name">construction.labor.cost.allocation.form</field>
        <field name="model">construction.labor.cost.allocation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Calcular horas"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_post" type="object" string="Publicar apuntes"
                            invisible="state != 'draft' or not line_ids"
                            confirm="Se crean los apuntes analíticos del cierre. Si la planilla ya reparte su costo por sede, se duplicarían. ¿Continuar?"/>
                    <button name="action_draft" type="object" string="Volver a borrador"
                            invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="summary_html" readonly="1" nolabel="1" invisible="not summary_html"/>
                    <notebook>
                        <page string="Horas por trabajador y sede" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="site_id" options="{'no_create': True}"/>
                                    <field name="employee_id" options="{'no_create': True}"/>
                                    <field name="hours" sum="Horas"/>
                                    <field name="hourly_cost"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Apuntes analíticos" name="analytic" invisible="state != 'posted'">
                            <field name="analytic_line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="account_id"/>
                                    <field name="unit_amount" sum="Horas"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_labor_cost_allocation" model="ir.actions.act_window">
        <field name="name">Cierre de costo de personal</field>
        <field name="res_model">construction.labor.cost.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cierre el costo de personal del mes</p>
            <p>Horas de marcación del personal propio en cada sede por su costo por hora, contra lo
               planificado de personal propio de la obra. Publicarlo crea los apuntes analíticos
               con la obra, la etapa de la sede y la partida de mano de obra fija (MODF).</p>
        </field>
    </record>
</odoo>
