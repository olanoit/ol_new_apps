<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paquete 1.16, D3: planes que controla el presupuesto. -->
    <record id="res_config_settings_view_form_construction_budget" model="ir.ui.view">
        <field name="name">res.config.settings.form.construction.budget</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="al_construction_planner.res_config_settings_view_form_construction_planner"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='construction_exceed_policy']" position="after">
                <setting company_dependent="1" id="construction_budget_control_plans"
                         string="Planes que controla el presupuesto"
                         help="La compra se compara con la suma de las líneas del presupuesto que coinciden en estos planes. Vacío: todas las cuentas.">
                    <field name="construction_budget_control_plan_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
