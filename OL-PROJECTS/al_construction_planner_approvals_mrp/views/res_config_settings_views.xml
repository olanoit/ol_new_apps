<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_construction_approvals_mrp" model="ir.ui.view">
        <field name="name">res.config.settings.form.construction.approvals.mrp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="al_construction_planner_approvals.res_config_settings_view_form_construction_approvals"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='construction_planner_approvals']" position="inside">
                <setting company_dependent="1" id="construction_production_margin" string="Exceso en la orden de fabricación"
                         help="Lo que el jefe de producción aprueba en la misma orden; por encima, la orden pide la aprobación según la tabla de rutas.">
                    <div class="content-group">
                        <div class="row mt-2">
                            <label for="construction_production_margin" class="col-lg-5 o_light_label"/>
                            <field name="construction_production_margin"/>
                        </div>
                        <div class="row">
                            <label for="construction_production_margin_basis" class="col-lg-5 o_light_label"/>
                            <field name="construction_production_margin_basis"/>
                        </div>
                        <div class="row">
                            <label for="construction_production_margin_material" class="col-lg-5 o_light_label"/>
                            <field name="construction_production_margin_material"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
