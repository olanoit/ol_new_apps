<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Mensajes del chatter con el patrón nativo (p. ej.
         purchase.track_po_line_template): título en negrita y lista. Los
         enlaces a registros usan data-oe-model / data-oe-id, como
         mail.message_origin_link, para abrirse dentro del cliente web. -->

    <template id="message_process_result">
        <div>
            <strong>Requerimiento procesado</strong>
            <ul class="mb-2">
                <li t-foreach="rows" t-as="row">
                    <strong t-out="row['product']"/>:
                    <t t-out="row['ordered']"/> pedidos,
                    <t t-out="row['available']"/> libres en <t t-out="row['source']"/>.
                    <br/>
                    <span t-if="row['dispatch']">Reservado para despacho desde <t t-out="row['source']"/>:
                        <strong t-out="row['dispatch_txt']"/><t t-if="row['picking']"> (<t t-out="row['picking']"/>, por validar)</t></span>
                    <t t-if="row['dispatch'] and row['purchase']"> · </t>
                    <span t-if="row['purchase']">A compra: <strong t-out="row['purchase_txt']"/>
                        (<t t-out="row['mode']"/>)</span>
                </li>
            </ul>
            <div t-foreach="picking" t-as="one_picking">
                Transferencia a <t t-out="one_picking.location_dest_id.display_name"/>:
                <a href="#" data-oe-model="stock.picking" t-att-data-oe-id="one_picking.id" t-out="one_picking.name"/>
            </div>
            <div t-foreach="pending_picking" t-as="one_pending">
                En espera de la compra (<t t-out="one_pending.location_dest_id.display_name"/>):
                <a href="#" data-oe-model="stock.picking" t-att-data-oe-id="one_pending.id" t-out="one_pending.name"/>
            </div>
            <div t-foreach="purchase_request" t-as="one_request">
                Requerimiento de compra<t t-if="len(purchase_request) &gt; 1"> (<t t-out="one_request.picking_type_id.warehouse_id.name"/>)</t>:
                <a href="#" data-oe-model="purchase.request" t-att-data-oe-id="one_request.id" t-out="one_request.name"/>
            </div>
            <div t-if="shortages" class="mt-2 text-warning">
                <i class="fa fa-exclamation-triangle"/>
                Otro documento reservó stock antes que este requerimiento; pasó a compra:
                <t t-out="shortages"/>.
            </div>
        </div>
    </template>

    <!-- Paquete 1.11, M111-20 F: al validar cada despacho, qué salió, de
         dónde y qué queda pendiente en el requerimiento. -->
    <template id="message_dispatch_done">
        <div>
            <strong>Salió de <t t-out="source"/> en
                <a href="#" data-oe-model="stock.picking" t-att-data-oe-id="picking.id" t-out="picking.name"/>,
                validado por <t t-out="user"/>:</strong>
            <ul class="mb-2">
                <li t-foreach="rows" t-as="row"><strong t-out="row['product']"/>: <t t-out="row['qty']"/></li>
            </ul>
            <div t-if="pending">
                Pendiente en este requerimiento: <t t-out="pending"/> materiales
                (<t t-out="to_dispatch"/> por despachar, <t t-out="purchasing"/> en compra).
            </div>
            <div t-else="">No queda nada pendiente en este requerimiento.</div>
            <div t-foreach="backorders" t-as="backorder">
                Orden parcial:
                <a href="#" data-oe-model="stock.picking" t-att-data-oe-id="backorder.id" t-out="backorder.name"/>
            </div>
        </div>
    </template>

    <!-- Sustituye el mensaje OCA de purchase_request al confirmar la OC: en
         Odoo 19 sumaba HTML en texto plano a una traducción Markup y el
         chatter mostraba las etiquetas escapadas. -->
    <template id="message_purchase_request_po_confirmed">
        <div>
            <strong>
                Orden de compra
                <a href="#" data-oe-model="purchase.order" t-att-data-oe-id="order.id" t-out="order.name"/>
            </strong>
            <ul class="mb-0">
                <li t-foreach="lines" t-as="line">
                    <strong t-out="line['name']"/>:
                    <t t-out="line['qty']"/> pedidos<t t-if="line['date']">, llegada prevista el <t t-out="line['date']"/></t>.
                </li>
            </ul>
        </div>
    </template>

    <template id="message_purchase_request_received">
        <div>
            <strong>Recepción asignada a este requerimiento de compra</strong>
            <ul class="mb-0">
                <li><strong t-out="product"/>: <t t-out="qty"/> recibidos.</li>
            </ul>
        </div>
    </template>

</odoo>
