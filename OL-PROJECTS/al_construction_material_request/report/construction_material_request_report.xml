<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_construction_request" model="ir.actions.report">
        <field name="name">Vale de requerimiento de obra</field>
        <field name="model">construction.material.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_construction_material_request.report_construction_request</field>
        <field name="report_file">al_construction_material_request.report_construction_request</field>
        <field name="print_report_name">'Vale %s' % object.name.replace('/', '-')</field>
        <field name="paperformat_id" ref="al_report_base.paperformat_pe_a4"/>
        <field name="binding_model_id" ref="model_construction_material_request"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Patrón estándar: plantilla contenedora + plantilla por registro. El
         formato es el común de la suite (al_report_base, el del comprobante A4). -->
    <template id="report_construction_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="al_construction_material_request.report_construction_request_document"
                   t-lang="o.requested_by.lang or o.env.lang"/>
            </t>
        </t>
    </template>

    <template id="report_construction_request_document">
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="processed" t-value="o.state in ('in_progress', 'done', 'cancel')"/>
        <t t-set="lines" t-value="o.line_ids"/>
        <t t-set="review_states" t-value="{'approved': 'Aprobado', 'pending': 'Pendiente', 'waiting': 'En espera', 'rejected': 'Rechazado', 'cancel': 'Cancelado'}"/>
        <t t-set="approver" t-value="o.review_ids.filtered(lambda r: r.status == 'approved').sorted('sequence')[-1:].done_by"/>
        <t t-set="state_label" t-value="dict(o._fields['state']._description_selection(o.env)).get(o.state)"/>
        <t t-call="al_report_base.report_pe_page">
            <t t-set="doc_title" t-value="'Vale de requerimiento de obra'"/>
            <t t-set="doc_number" t-value="o.name"/>
            <t t-set="doc_extra" t-value="'Estado: %s%s' % (state_label, ' · URGENTE' if o.priority == '1' else '')"/>

            <!-- Datos del requerimiento -->
            <table class="pe-doc-table mb-3">
                <tr>
                    <t t-if="o.request_type == 'internal'">
                        <td class="pe-doc-label" style="width: 17%;">Área</td>
                        <td class="pe-doc-value" style="width: 38%;"><strong t-out="o.area_id.display_name"/></td>
                    </t>
                    <t t-else="">
                        <td class="pe-doc-label" style="width: 17%;">Obra</td>
                        <td class="pe-doc-value" style="width: 38%;"><strong t-out="o.project_id.display_name"/></td>
                    </t>
                    <td class="pe-doc-label" style="width: 17%;">Solicitado por</td>
                    <td class="pe-doc-value" style="width: 28%;" t-out="o.requested_by.name"/>
                </tr>
                <tr>
                    <td class="pe-doc-label">Ubicación de obra</td>
                    <td class="pe-doc-value" t-out="o.location_dest_id.display_name"/>
                    <td class="pe-doc-label">Fecha</td>
                    <td class="pe-doc-value"><span t-field="o.date_request"/></td>
                </tr>
                <tr>
                    <td class="pe-doc-label">Jefe de proyecto</td>
                    <td class="pe-doc-value" t-out="o.project_manager_id.name or '—'"/>
                    <td class="pe-doc-label">Fecha requerida</td>
                    <td class="pe-doc-value"><strong t-if="o.date_required" t-field="o.date_required"/><t t-else="">—</t></td>
                </tr>
                <tr>
                    <td class="pe-doc-label">Tarea</td>
                    <td class="pe-doc-value" t-out="o.task_id.name or '—'"/>
                    <td class="pe-doc-label">Valor estimado</td>
                    <td class="pe-doc-value"><span t-field="o.amount_estimated"
                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                </tr>
            </table>

            <!-- Materiales -->
            <table class="pe-doc-table pe-doc-lines mb-3">
                <thead>
                    <tr class="pe-doc-thead">
                        <td style="width: 4%;">Ítem</td>
                        <td>Material</td>
                        <td class="text-end" style="width: 10%;">Cantidad</td>
                        <td style="width: 9%;">Unidad</td>
                        <t t-if="processed">
                            <td class="text-end" style="width: 11%;">Disponible al procesar</td>
                            <td class="text-end" style="width: 10%;">A despachar</td>
                            <td class="text-end" style="width: 10%;">A comprar</td>
                            <td class="text-end" style="width: 10%;">Recibido en obra</td>
                        </t>
                        <t t-else="">
                            <td class="text-end" style="width: 13%;">Disponible en central</td>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="lines" t-as="line">
                        <td t-out="line_index + 1"/>
                        <td>
                            <div t-out="line.product_id.display_name"/>
                            <div class="pe-doc-fs-11" t-if="line._get_report_analytic_label() or line.task_id">
                                <t t-out="line._get_report_analytic_label()"/>
                                <t t-if="line.task_id"> · Tarea: <t t-out="line.task_id.name"/></t>
                            </div>
                            <div class="pe-doc-fs-11" t-if="processed and line.qty_to_purchase">
                                Compra: <t t-out="dict(line._fields['supply_mode']._description_selection(line.env))[line.supply_mode].lower()"/>
                            </div>
                        </td>
                        <td class="text-end"><span t-field="line.product_qty"/></td>
                        <td t-out="line.product_uom_id.name"/>
                        <t t-if="processed">
                            <td class="text-end"><span t-field="line.qty_available_at_approval"/></td>
                            <td class="text-end"><span t-field="line.qty_to_dispatch"/></td>
                            <td class="text-end"><span t-field="line.qty_to_purchase"/></td>
                            <td class="text-end"><span t-field="line.qty_received_on_site"/></td>
                        </t>
                        <t t-else="">
                            <td class="text-end"><span t-field="line.qty_available_now"/></td>
                        </t>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="pe-doc-total">
                        <td t-att-colspan="7 if processed else 4" class="text-end">Valor estimado</td>
                        <td class="text-end"><span t-field="o.amount_estimated"
                            t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                    </tr>
                </tfoot>
            </table>

            <!-- Aprobaciones -->
            <div class="pe-doc-section">Aprobaciones</div>
            <table class="pe-doc-table pe-doc-lines mb-3" t-if="o.review_ids">
                <thead>
                    <tr class="pe-doc-thead">
                        <td style="width: 34%;">Nivel</td>
                        <td style="width: 24%;">Revisor</td>
                        <td style="width: 12%;">Estado</td>
                        <td style="width: 14%;">Fecha</td>
                        <td>Comentario</td>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.review_ids.sorted('sequence')" t-as="review">
                        <td t-out="review.name"/>
                        <td t-out="review.done_by.name or review.todo_by"/>
                        <td t-out="review_states.get(review.status, review.status)"/>
                        <td><span t-if="review.reviewed_date" t-field="review.reviewed_date"
                                  t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm'}"/></td>
                        <td t-out="review.comment or ''"/>
                    </tr>
                </tbody>
            </table>
            <p t-else="" class="mb-3">
                <t t-if="o.state in ('approved', 'in_progress', 'done')">Aprobado sin reglas de aprobación aplicables.</t>
                <t t-else="">Sin aprobaciones registradas.</t>
            </p>

            <!-- Documentos relacionados y notas -->
            <t t-set="related" t-value="o._get_report_related_documents()"/>
            <table class="pe-doc-table mb-3 pe-doc-keep" t-if="related">
                <tr class="pe-doc-subheader"><td colspan="2">Documentos relacionados</td></tr>
                <tr t-foreach="related" t-as="doc">
                    <td class="pe-doc-label" style="width: 25%;" t-out="doc[0]"/>
                    <td class="pe-doc-value" t-out="doc[1]"/>
                </tr>
            </table>
            <table class="pe-doc-table mb-3 pe-doc-keep" t-if="not is_html_empty(o.note)">
                <tr class="pe-doc-subheader"><td>Notas</td></tr>
                <tr><td><div t-field="o.note"/></td></tr>
            </table>

            <!-- Firmas -->
            <!-- Cuatro firmas: anchos fijos (la hoja común reparte en dos). -->
            <table class="pe-doc-plain pe-doc-signatures pe-doc-keep" style="table-layout: fixed;">
                <tr>
                    <td style="width: 25%; padding: 0 8px;"><div t-out="o.requested_by.name"/></td>
                    <td style="width: 25%; padding: 0 8px;"><div t-out="approver.name or ''"/></td>
                    <td style="width: 25%; padding: 0 8px;"/>
                    <td style="width: 25%; padding: 0 8px;"/>
                </tr>
                <tr>
                    <td style="width: 25%; padding: 0 8px;"><div class="pe-doc-sign-line" style="width: 90%;">Solicitado por</div></td>
                    <td style="width: 25%; padding: 0 8px;"><div class="pe-doc-sign-line" style="width: 90%;">Aprobado por</div></td>
                    <td style="width: 25%; padding: 0 8px;"><div class="pe-doc-sign-line" style="width: 90%;">Despachado por (almacén)</div></td>
                    <td style="width: 25%; padding: 0 8px;"><div class="pe-doc-sign-line" style="width: 90%;">Recibido en obra</div></td>
                </tr>
            </table>
        </t>
    </template>

</odoo>
