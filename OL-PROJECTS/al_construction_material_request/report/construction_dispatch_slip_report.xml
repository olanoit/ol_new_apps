<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vale de despacho para pegar en el bulto (paquete 1.11, M111-07): todo
         el requerimiento con lo despachado antes, lo de este bulto y lo
         pendiente; sin precios ni stock interno. -->
    <record id="action_report_construction_dispatch_slip" model="ir.actions.report">
        <field name="name">Vale de despacho</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_construction_material_request.report_dispatch_slip_picking</field>
        <field name="report_file">al_construction_material_request.report_dispatch_slip_picking</field>
        <field name="print_report_name">'Vale de despacho %s' % object.name.replace('/', '-')</field>
        <field name="paperformat_id" ref="al_report_base.paperformat_pe_a4"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="domain">[('construction_request_id', '!=', False)]</field>
    </record>

    <!-- Desde el requerimiento (botón): sin la columna «En este bulto». -->
    <record id="action_report_construction_request_dispatch_slip" model="ir.actions.report">
        <field name="name">Vale de despacho</field>
        <field name="model">construction.material.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_construction_material_request.report_dispatch_slip_request</field>
        <field name="report_file">al_construction_material_request.report_dispatch_slip_request</field>
        <field name="print_report_name">'Vale de despacho %s' % object.name.replace('/', '-')</field>
        <field name="paperformat_id" ref="al_report_base.paperformat_pe_a4"/>
    </record>

    <!-- Desde «Productos por despachar» (M111-08): un vale por transferencia
         de los movimientos marcados. -->
    <record id="action_report_construction_dispatch_slip_move" model="ir.actions.report">
        <field name="name">Vale de despacho</field>
        <field name="model">stock.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_construction_material_request.report_dispatch_slip_move</field>
        <field name="report_file">al_construction_material_request.report_dispatch_slip_move</field>
        <field name="print_report_name">'Vale de despacho'</field>
        <field name="paperformat_id" ref="al_report_base.paperformat_pe_a4"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_type">report</field>
        <field name="domain">[('construction_request_id', '!=', False)]</field>
    </record>

    <template id="report_dispatch_slip_move">
        <t t-call="al_construction_material_request.report_dispatch_slip_picking">
            <t t-set="docs" t-value="docs.picking_id"/>
        </t>
    </template>

    <template id="report_dispatch_slip_picking">
        <t t-call="web.html_container">
            <t t-foreach="docs.filtered('construction_request_id')" t-as="picking">
                <t t-set="o" t-value="picking.construction_request_id"/>
                <t t-call="al_construction_material_request.report_dispatch_slip_document"
                   t-lang="o.requested_by.lang or o.env.lang"/>
            </t>
        </t>
    </template>

    <template id="report_dispatch_slip_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="picking" t-value="False"/>
                <t t-call="al_construction_material_request.report_dispatch_slip_document"
                   t-lang="o.requested_by.lang or o.env.lang"/>
            </t>
        </t>
    </template>

    <template id="report_dispatch_slip_document">
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="slip" t-value="o._get_dispatch_slip(picking)"/>
        <t t-set="source" t-value="picking.location_id if picking else o.location_src_id"/>
        <t t-call="al_report_base.report_pe_page">
            <t t-set="doc_title" t-value="'Vale de despacho'"/>
            <t t-set="doc_number" t-value="o.name"/>
            <t t-set="doc_extra" t-value="'Bulto %s' % picking.name if picking else 'Situación del requerimiento'"/>

            <!-- Datos del envío -->
            <table class="pe-doc-table mb-3">
                <tr>
                    <t t-if="o.request_type == 'internal'">
                        <td class="pe-doc-label" style="width: 17%;">Área</td>
                        <td class="pe-doc-value" style="width: 38%;"><strong t-out="o.area_id.display_name"/></td>
                    </t>
                    <t t-else="">
                        <td class="pe-doc-label" style="width: 17%;">Obra</td>
                        <td class="pe-doc-value" style="width: 38%;"><strong t-out="o.project_id.display_name"/></td>
                    </t>
                    <td class="pe-doc-label" style="width: 17%;">Solicitado por</td>
                    <td class="pe-doc-value" style="width: 28%;" t-out="o.requested_by.name"/>
                </tr>
                <tr>
                    <td class="pe-doc-label"><t t-if="o.request_type == 'internal'">Destino</t><t t-else="">Ubicación de obra</t></td>
                    <td class="pe-doc-value" t-out="(picking.location_dest_id if picking else o.location_dest_id).display_name"/>
                    <td class="pe-doc-label">Fecha del requerimiento</td>
                    <td class="pe-doc-value"><span t-field="o.date_request"/></td>
                </tr>
                <tr>
                    <td class="pe-doc-label">Almacén de origen</td>
                    <td class="pe-doc-value" t-out="source.warehouse_id.name or source.display_name"/>
                    <td class="pe-doc-label">Fecha requerida</td>
                    <td class="pe-doc-value"><strong t-if="o.date_required" t-field="o.date_required"/><t t-else="">—</t></td>
                </tr>
                <tr>
                    <td class="pe-doc-label"><t t-if="picking">Fecha de despacho</t><t t-else="">Fecha de impresión</t></td>
                    <td class="pe-doc-value"><span t-out="slip['date']"
                        t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm'}"/></td>
                    <td class="pe-doc-label">Tarea</td>
                    <td class="pe-doc-value" t-out="o.task_id.name or '—'"/>
                </tr>
            </table>

            <!-- Materiales: todas las líneas del requerimiento -->
            <table class="pe-doc-table pe-doc-lines mb-2">
                <thead>
                    <tr class="pe-doc-thead">
                        <td style="width: 4%;">Ítem</td>
                        <td>Material</td>
                        <td style="width: 8%;">Unidad</td>
                        <td class="text-end" style="width: 8%;">Pedido</td>
                        <td class="text-end" style="width: 9%;">Despachado antes</td>
                        <td t-if="picking" class="text-end" style="width: 9%;">En este bulto</td>
                        <td class="text-end" style="width: 8%;">Pendiente</td>
                        <td style="width: 22%;">Situación</td>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="slip['rows']" t-as="row"
                        t-att-style="'color: #9a9a9a;' if picking and not row['in_bundle'] else None">
                        <t t-set="line" t-value="row['line']"/>
                        <td t-out="row['index']"/>
                        <td>
                            <div t-out="line.product_id.display_name"/>
                            <div class="pe-doc-fs-11" t-if="line.task_id" t-out="line.task_id.display_name"/>
                        </td>
                        <td t-out="line.product_uom_id.name"/>
                        <td class="text-end" t-out="row['qty']" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                        <td class="text-end" t-out="row['before']" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                        <td t-if="picking" class="text-end"><strong t-out="row['in_bundle']" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/></td>
                        <td class="text-end" t-out="row['pending']" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                        <td t-out="row['situation']"/>
                    </tr>
                </tbody>
            </table>
            <p class="mb-3"><strong t-out="slip['summary']"/></p>

            <!-- Firmas -->
            <table class="pe-doc-plain pe-doc-signatures pe-doc-keep" style="table-layout: fixed;">
                <tr>
                    <td style="width: 50%; padding: 0 8px;"><div t-out="picking._get_dispatch_slip_user().name if picking else ''"/></td>
                    <td style="width: 50%; padding: 0 8px;"><div>Fecha y hora: ____/____/______ ____:____</div></td>
                </tr>
                <tr>
                    <td style="width: 50%; padding: 0 8px;"><div class="pe-doc-sign-line" style="width: 90%;">Despachado por (almacén)</div></td>
                    <td style="width: 50%; padding: 0 8px;"><div class="pe-doc-sign-line" style="width: 90%;">Recibido por (capataz)</div></td>
                </tr>
            </table>
            <p class="pe-doc-fs-11 mt-3">Este vale acompaña el bulto. Los pendientes se enviarán en otro despacho.</p>
        </t>
    </template>
</odoo>
