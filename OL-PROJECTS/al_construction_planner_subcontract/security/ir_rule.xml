<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
        <record id="rule_construction_contract_settlement_company" model="ir.rule">
            <field name="name">Liquidación de contrata: compañías del usuario</field>
            <field name="model_id" ref="model_construction_contract_settlement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    <record id="rule_construction_contract_settlement_line_company" model="ir.rule">
            <field name="name">Línea de liquidación: compañías del usuario</field>
            <field name="model_id" ref="model_construction_contract_settlement_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>


        <record id="rule_construction_condition_company" model="ir.rule">
            <field name="name">Condiciones de contrata: compañías del usuario</field>
            <field name="model_id" ref="model_construction_contract_condition"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_construction_deduction_company" model="ir.rule">
            <field name="name">Deductivo de contrata: compañías del usuario</field>
            <field name="model_id" ref="model_construction_contract_deduction"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_construction_guarantee_fund_company" model="ir.rule">
            <field name="name">Fondo de garantía: compañías del usuario</field>
            <field name="model_id" ref="model_construction_guarantee_fund"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_construction_order_requirement_company" model="ir.rule">
            <field name="name">Requisito de devolución del fondo: compañías del usuario</field>
            <field name="model_id" ref="model_construction_contract_order_requirement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_construction_order_document_company" model="ir.rule">
            <field name="name">Documento requerido de la orden: compañías del usuario</field>
            <field name="model_id" ref="model_construction_contract_order_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_construction_settlement_summary_company" model="ir.rule">
            <field name="name">Resumen del valorizado: compañías del usuario</field>
            <field name="model_id" ref="model_construction_contract_settlement_summary"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_construction_contract_summary_report_company" model="ir.rule">
            <field name="name">Resumen de valorizaciones: compañías del usuario</field>
            <field name="model_id" ref="model_construction_contract_summary_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
