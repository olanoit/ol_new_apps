<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La liquidación del avance (puente de contratas). -->
    <record id="construction_task_progress_view_list_subcontract" model="ir.ui.view">
        <field name="name">construction.task.progress.list.subcontract</field>
        <field name="model">construction.task.progress</field>
        <field name="inherit_id" ref="al_construction_planner.construction_task_progress_view_list"/>
        <field name="arch" type="xml">
            <field name="period_start" position="after">
                <field name="settlement_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="construction_task_progress_view_form_subcontract" model="ir.ui.view">
        <field name="name">construction.task.progress.form.subcontract</field>
        <field name="model">construction.task.progress</field>
        <field name="inherit_id" ref="al_construction_planner.construction_task_progress_view_form"/>
        <field name="arch" type="xml">
            <field name="settled" position="before">
                <field name="settlement_id"/>
            </field>
        </field>
    </record>
</odoo>
