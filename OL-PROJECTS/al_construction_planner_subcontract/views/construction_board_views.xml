<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contratas en el tablero de obra y en el menú Ejecutar (CREVAL v1.0, 4.4 y 4.5) -->
    <record id="project_project_view_form_construction_board_contracts" model="ir.ui.view">
        <field name="name">project.project.form.construction.board.contracts</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="al_construction_planner.project_project_view_form_construction_board"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='board_execute']" position="inside">
                <button name="action_construction_assign_contract" type="object" class="oe_stat_button"
                        icon="fa-handshake-o" string="Asignar contrata"
                        invisible="not construction_board_plan_id"
                        groups="al_construction_planner.group_planner_user"/>
                <button name="action_construction_view_contract_orders" type="object" class="oe_stat_button"
                        icon="fa-file-text-o" groups="al_construction_planner.group_planner_user">
                    <field name="construction_open_order_count" widget="statinfo" string="Órdenes de contrata"/>
                </button>
                <button name="action_construction_view_settlements_to_approve" type="object" class="oe_stat_button"
                        icon="fa-calendar-check-o" groups="al_construction_planner.group_planner_progress">
                    <field name="construction_settlement_to_approve_count" widget="statinfo" string="Valorizaciones de contrata"/>
                </button>
                <button name="action_construction_view_deductions" type="object" class="oe_stat_button"
                        icon="fa-minus-circle" groups="al_construction_planner.group_planner_user">
                    <field name="construction_deduction_pending_count" widget="statinfo" string="Deductivos"/>
                </button>
            </xpath>
            <xpath expr="//div[@name='board_control']" position="inside">
                <button name="action_construction_view_contract_summary" type="object" class="oe_stat_button"
                        icon="fa-table" string="Resumen de valorizaciones"
                        groups="al_construction_planner.group_planner_user"/>
            </xpath>
        </field>
    </record>

    <record id="construction_task_execute_wizard_view_form_contracts" model="ir.ui.view">
        <field name="name">construction.task.execute.wizard.form.contracts</field>
        <field name="model">construction.task.execute.wizard</field>
        <field name="inherit_id" ref="al_construction_planner.construction_task_execute_wizard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='execute_actions']" position="inside">
                <button name="action_assign_contract" type="object" string="Asignar contrata"
                        class="btn btn-secondary" icon="fa-handshake-o"
                        groups="al_construction_planner.group_planner_user"/>
                <button name="action_register_deduction" type="object" string="Registrar deductivo"
                        class="btn btn-secondary" icon="fa-minus-circle"
                        groups="al_construction_planner.group_planner_user"/>
            </xpath>
        </field>
    </record>
</odoo>
