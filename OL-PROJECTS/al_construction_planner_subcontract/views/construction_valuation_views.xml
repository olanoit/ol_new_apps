<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Preparar las valorizaciones de una obra al corte -->
    <record id="construction_settlement_prepare_wizard_view_form" model="ir.ui.view">
        <field name="name">construction.settlement.prepare.wizard.form</field>
        <field name="model">construction.settlement.prepare.wizard</field>
        <field name="arch" type="xml">
            <form string="Preparar valorizaciones">
                <group>
                    <field name="project_id" options="{'no_create': True}" placeholder="Todas las obras"/>
                    <field name="date"/>
                </group>
                <p class="text-muted small">
                    Crea en borrador (o actualiza) las valorizaciones de las órdenes de contrata cuyo
                    corte ya pasó y tienen avances validados o deductivos por valorizar.
                </p>
                <footer>
                    <button name="action_prepare" type="object" string="Preparar" class="btn-primary" data-hotkey="q"/>
                    <button string="Descartar" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_construction_settlement_prepare_wizard" model="ir.actions.act_window">
        <field name="name">Preparar valorizaciones</field>
        <field name="res_model">construction.settlement.prepare.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <!-- Valorización de contrata con condiciones (CREVAL v1.0, 3.5): título,
         tipo, revisión antes de aprobar, resumen del periodo y pestañas. -->
    <record id="construction_contract_settlement_view_form_terms" model="ir.ui.view">
        <field name="name">construction.contract.settlement.form.terms</field>
        <field name="model">construction.contract.settlement</field>
        <field name="inherit_id" ref="construction_contract_settlement_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="replace">
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                    <h3 invisible="not uses_terms"><field name="title" readonly="1"/></h3>
                </div>
                <field name="uses_terms" invisible="1"/>
                <field name="has_review_items" invisible="1"/>
                <field name="terms_advance_method" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert"
                     invisible="not has_review_items or state not in ('draft', 'submitted', 'validated')">
                    <strong>Revisar antes de aprobar:</strong>
                    <span invisible="not review_manual_count"> <field name="review_manual_count" class="oe_inline"/> metrados escritos a mano;</span>
                    <span invisible="not review_rework_count"> <field name="review_rework_count" class="oe_inline"/> re-trabajos;</span>
                    <span invisible="not review_over_count"> <field name="review_over_count" class="oe_inline"/> líneas sobre lo contratado;</span>
                    <span invisible="not review_no_photo_count"> <field name="review_no_photo_count" class="oe_inline"/> avances sin fotos.</span>
                </div>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="%(action_report_contract_valuation)d" type="action" string="Imprimir valorizado"
                        invisible="not uses_terms"/>
                <button name="action_send_valuation" type="object" string="Enviar por correo"
                        invisible="not uses_terms or state not in ('approved', 'paid')"/>
                <field name="can_close_order" invisible="1"/>
                <button name="action_close_order" type="object" string="Cerrar orden" class="btn-primary"
                        invisible="not can_close_order"
                        groups="account.group_account_invoice,al_construction_planner.group_planner_exec_approver"
                        confirm="Cada línea de la orden baja a lo recibido, se libera el saldo del plan y la orden queda bloqueada. ¿Continuar?"/>
            </xpath>
            <xpath expr="//field[@name='purchase_order_id']" position="before">
                <field name="settlement_type" readonly="id" invisible="not uses_terms"/>
                <field name="terms_id" invisible="not uses_terms"/>
            </xpath>
            <xpath expr="//field[@name='purchase_order_id']" position="attributes">
                <attribute name="string">Orden de contrata</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_date']" position="after">
                <field name="date_cutoff" invisible="settlement_type == 'periodic'"
                       readonly="state != 'draft'"/>
                <field name="advance_manual_amount" readonly="state not in ('draft', 'submitted')"
                       invisible="not uses_terms or terms_advance_method != 'manual'"/>
                <field name="submitted_by_id" invisible="not submitted_by_id"/>
            </xpath>
            <xpath expr="//page[@name='lines']/field[@name='line_ids']/list//field[@name='activity_id']" position="before">
                <field name="level_1_id" optional="hide" readonly="1"/>
                <field name="level_2_id" optional="hide" readonly="1"/>
                <field name="task_id" optional="show" readonly="1"/>
            </xpath>
            <xpath expr="//page[@name='lines']/field[@name='line_ids']/list//field[@name='qty_period']" position="before">
                <field name="qty_contracted" optional="show"/>
                <field name="qty_previous" optional="show"/>
            </xpath>
            <xpath expr="//page[@name='lines']/field[@name='line_ids']/list//field[@name='qty_cumulative']" position="before">
                <field name="qty_accumulated" optional="show"/>
                <field name="pct_accumulated" widget="percentage" optional="show"/>
                <field name="qty_balance" optional="hide"/>
                <field name="amount_previous" optional="hide"/>
                <field name="amount_accumulated" optional="hide"/>
                <field name="amount_balance" optional="hide"/>
                <field name="over_contract" column_invisible="True"/>
                <field name="qty_final" optional="show" column_invisible="parent.settlement_type != 'settlement'"/>
                <field name="final_reason" optional="show" column_invisible="parent.settlement_type != 'settlement'"/>
                <field name="qty_released" optional="show" column_invisible="parent.settlement_type != 'settlement'"/>
                <field name="amount_released" optional="hide" column_invisible="parent.settlement_type != 'settlement'"/>
                <field name="is_additional" optional="hide"/>
            </xpath>
            <xpath expr="//page[@name='lines']/field[@name='line_ids']/list" position="attributes">
                <attribute name="decoration-danger">over_contract</attribute>
            </xpath>
            <xpath expr="//page[@name='lines']/group[hasclass('oe_subtotal_footer')]" position="attributes">
                <attribute name="invisible">uses_terms</attribute>
            </xpath>
            <xpath expr="//page[@name='lines']" position="attributes">
                <attribute name="string">Avance</attribute>
            </xpath>
            <xpath expr="//page[@name='lines']" position="before">
                <page string="Resumen del periodo" name="summary" invisible="not uses_terms">
                    <field name="summary_ids" nolabel="1">
                        <list create="0" delete="0" decoration-bf="is_total">
                            <field name="name"/>
                            <field name="percent" optional="show"/>
                            <field name="amount_contract"/>
                            <field name="amount_previous"/>
                            <field name="amount_current"/>
                            <field name="amount_accumulated"/>
                            <field name="amount_balance"/>
                            <field name="is_total" column_invisible="True"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_total"/>
                        <field name="amount_advance"/>
                        <field name="amount_retention"/>
                        <field name="amount_to_pay" class="oe_subtotal_footer_separator"/>
                        <field name="amount_invoice_rounding" invisible="not amount_invoice_rounding"/>
                        <field name="progress_pct" widget="percentage"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='progress']" position="before">
                <page string="Adicionales" name="additionals" invisible="not uses_terms">
                    <field name="additional_line_ids" nolabel="1">
                        <list create="0" delete="0">
                            <field name="task_id"/>
                            <field name="activity_id"/>
                            <field name="qty_contracted"/>
                            <field name="qty_previous"/>
                            <field name="qty_settle"/>
                            <field name="qty_accumulated"/>
                            <field name="price_unit"/>
                            <field name="amount" sum="Total"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </page>
                <page string="Documentos requeridos" name="documents"
                      invisible="settlement_type != 'settlement' or not order_document_ids">
                    <field name="order_closed" invisible="1"/>
                    <field name="order_document_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="document_type_id" readonly="1"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                            <field name="is_attached"/>
                        </list>
                    </field>
                </page>
                <page string="Deductivos" name="deductions" invisible="not uses_terms">
                    <field name="deduction_ids" nolabel="1"
                           context="{'list_view_ref': 'al_construction_planner_subcontract.construction_contract_deduction_view_list'}"/>
                </page>
            </xpath>
            <xpath expr="//page[@name='progress']" position="attributes">
                <attribute name="string">Avances incluidos</attribute>
            </xpath>
            <xpath expr="//page[@name='progress']" position="after">
                <page string="Validaciones" name="validations" invisible="not review_ids">
                    <field name="review_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0">
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="todo_by"/>
                            <field name="done_by"/>
                            <field name="status"/>
                            <field name="reviewed_date"/>
                            <field name="comment" optional="show"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="construction_contract_settlement_view_list_terms" model="ir.ui.view">
        <field name="name">construction.contract.settlement.list.terms</field>
        <field name="model">construction.contract.settlement</field>
        <field name="inherit_id" ref="construction_contract_settlement_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(action_construction_settlement_prepare_wizard)d" type="action"
                            string="Preparar valorizaciones" display="always"
                            groups="al_construction_planner.group_planner_user"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="title" optional="show"/>
                <field name="settlement_type" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='amount_net']" position="before">
                <field name="amount_total" sum="Total" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
