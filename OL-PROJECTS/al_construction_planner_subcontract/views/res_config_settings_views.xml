<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_construction_subcontract" model="ir.ui.view">
        <field name="name">res.config.settings.form.construction.subcontract</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="al_construction_planner.res_config_settings_view_form_construction_planner"/>
        <field name="arch" type="xml">
            <block name="construction_planner_contracts" position="inside">
                        <setting company_dependent="1" id="construction_retention_account" string="Retención en la factura"
                                 help="Con una cuenta, la factura de cada liquidación lleva la retención como línea negativa y su total es el neto a pagar. Sin cuenta, la factura va por el bruto.">
                            <field name="construction_retention_account_id" options="{'no_create': True}"/>
                        </setting>
                        <setting company_dependent="1" id="construction_discount_account" string="Descuento de material extra"
                                 help="Material extra descontado a una contrata: la factura de su siguiente liquidación lleva el descuento como línea negativa a esta cuenta.">
                            <field name="construction_discount_account_id" options="{'no_create': True}"/>
                        </setting>
                        <setting company_dependent="1" id="construction_default_condition" string="Condiciones de contrata"
                                 help="Las que propone «Asignar contrata» si el contratista no tiene las suyas (pestaña Compras del contacto). Vacías: la orden se comporta como siempre.">
                            <field name="construction_default_condition_id" options="{'no_create': True}"/>
                        </setting>
                        <setting company_dependent="1" id="construction_advance_product" string="Anticipo a contratistas"
                                 help="Servicio con la cuenta de anticipos otorgados: la factura de adelanto y la regularización de cada valorizado.">
                            <field name="construction_advance_product_id" options="{'no_create': True}"/>
                        </setting>
                        <setting company_dependent="1" id="construction_deduction_account" string="Deductivos a contratas"
                                 help="Cuenta de la línea del deductivo en la factura (vacía: la del servicio) y diario del asiento cuando se descuenta al pago.">
                            <field name="construction_deduction_account_id" options="{'no_create': True}"/>
                            <field name="construction_deduction_journal_id" options="{'no_create': True}"/>
                        </setting>
                        <setting company_dependent="1" id="construction_rounding_account" string="Ajuste de redondeo de contratas"
                                 help="Cuenta de la línea que iguala la factura de la valorización con la suma de sus líneas redondeadas (hasta 0.05). Vacía: la del servicio.">
                            <field name="construction_rounding_account_id" options="{'no_create': True}"/>
                        </setting>
                        <setting id="construction_purchase_tier" string="Aprobación por niveles de la orden de contrata"
                                 help="Reglas por monto, aprobadores y secuencia para la orden (purchase_tier_validation de OCA). Sin reglas, rige la aprobación nativa de Compras.">
                            <field name="module_purchase_tier_validation"/>
                        </setting>
            </block>
        </field>
    </record>
</odoo>
