<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multicompañía: cada registro, en las compañías activas del usuario. -->
        <record id="rule_construction_labor_activity_company" model="ir.rule">
            <field name="name">Actividad de obra: compañías del usuario</field>
            <field name="model_id" ref="model_construction_labor_activity"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="rule_construction_labor_rate_company" model="ir.rule">
            <field name="name">Tarifa de contrata: compañías del usuario</field>
            <field name="model_id" ref="model_construction_labor_rate"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_typology_company" model="ir.rule">
            <field name="name">Tipología: compañías del usuario</field>
            <field name="model_id" ref="model_construction_typology"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_execution_template_company" model="ir.rule">
            <field name="name">Receta: compañías del usuario</field>
            <field name="model_id" ref="model_construction_execution_template"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_execution_template_line_company" model="ir.rule">
            <field name="name">Recurso de la receta: compañías del usuario</field>
            <field name="model_id" ref="model_construction_execution_template_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_analytic_rule_company" model="ir.rule">
            <field name="name">Regla analítica: compañías del usuario</field>
            <field name="model_id" ref="model_construction_analytic_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_typology_alias_company" model="ir.rule">
            <field name="name">Otro nombre de la tipología: compañías del usuario</field>
            <field name="model_id" ref="model_construction_typology_alias"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_unit_override_company" model="ir.rule">
            <field name="name">Variante de la unidad: compañías del usuario</field>
            <field name="model_id" ref="model_construction_unit_override"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_typology_activity_company" model="ir.rule">
            <field name="name">Actividad de la tipología: compañías del usuario</field>
            <field name="model_id" ref="model_construction_typology_activity"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_resource_plan_company" model="ir.rule">
            <field name="name">Plan de recursos: compañías del usuario</field>
            <field name="model_id" ref="model_construction_resource_plan"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_resource_plan_line_company" model="ir.rule">
            <field name="name">Línea del plan: compañías del usuario</field>
            <field name="model_id" ref="model_construction_resource_plan_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_resource_plan_allocation_company" model="ir.rule">
            <field name="name">Asignación del plan: compañías del usuario</field>
            <field name="model_id" ref="model_construction_resource_plan_allocation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_task_progress_company" model="ir.rule">
            <field name="name">Avance reportado: compañías del usuario</field>
            <field name="model_id" ref="model_construction_task_progress"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_space_stage_company" model="ir.rule">
            <field name="name">Etapa del ambiente: compañías del usuario</field>
            <field name="model_id" ref="model_construction_space_stage"/>
            <!-- La compañía es la de la tarea; una obra sin compañía es compartida. -->
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="rule_construction_dependency_company" model="ir.rule">
            <field name="name">Dependencia de terceros: compañías del usuario</field>
            <field name="model_id" ref="model_construction_dependency"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_measurement_company" model="ir.rule">
            <field name="name">Metrado: compañías del usuario</field>
            <field name="model_id" ref="model_construction_measurement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_measurement_line_company" model="ir.rule">
            <field name="name">Medida del metrado: compañías del usuario</field>
            <field name="model_id" ref="model_construction_measurement_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
