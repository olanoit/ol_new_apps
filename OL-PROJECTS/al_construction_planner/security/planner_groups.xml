<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="res_groups_privilege_construction_planner" model="res.groups.privilege">
            <field name="name">Planificación de obra</field>
            <field name="sequence">45</field>
            <field name="category_id" ref="base.module_category_services"/>
        </record>

        <!-- Montos (v1.8, M18-10): fuera del privilegio, se suma a cualquier
             nivel. Sin él, la planificación muestra cantidades, fechas, avance
             y estados, sin costos, precios, presupuestos ni saldos. Lo tienen
             el administrador, la jefatura y los ingresos. -->
        <record id="group_planner_amounts" model="res.groups">
            <field name="name">Planificación de obra: ve montos</field>
            <field name="comment">Ve costos, precios, presupuestos, comprometido, real, saldos, márgenes y valorizaciones en el árbol, el cronograma, los paneles, la matriz insumo-producto, los análisis, los reportes y las exportaciones.</field>
        </record>

        <record id="group_planner_progress" model="res.groups">
            <field name="name">Reporte de avance</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_construction_planner"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="comment">Capataces de contrata y supervisores: ven el árbol de sus obras y registran avances.</field>
        </record>

        <record id="group_planner_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_construction_planner"/>
            <field name="implied_ids" eval="[Command.link(ref('group_planner_progress')), Command.link(ref('project.group_project_user')), Command.link(ref('al_project_gantt_base.group_gantt_user'))]"/>
            <field name="comment">Proyectos, Logística y Producción: lanzan las acciones sobre planes aprobados.</field>
        </record>

        <record id="group_planner_planner" model="res.groups">
            <field name="name">Planificador</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_construction_planner"/>
            <field name="implied_ids" eval="[Command.link(ref('group_planner_user'))]"/>
            <field name="comment">Oficina Técnica y supervisores de obra: cargan tipologías, generan y editan planes en borrador, aplican costos y validan avances y liquidaciones.</field>
        </record>

        <record id="group_planner_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="res_groups_privilege_construction_planner"/>
            <field name="implied_ids" eval="[Command.link(ref('group_planner_planner')), Command.link(ref('group_planner_amounts'))]"/>
            <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
            <field name="comment">Jefatura de Proyectos: configuración, políticas, aprobación de liquidaciones y cierre de planes.</field>
        </record>

        <!-- Jefatura y asistente de Proyectos (v1.6, M16-09 y M16-10): fuera
             del privilegio, como ingresos. Las reglas de validación del
             planificador las aprueba la jefatura, no el administrador, para
             que funcionen con un reemplazo. -->
        <record id="group_planner_project_head" model="res.groups">
            <field name="name">Planificación de obra: jefatura de proyectos</field>
            <field name="implied_ids" eval="[Command.link(ref('group_planner_planner')), Command.link(ref('group_planner_amounts'))]"/>
            <field name="comment">Aprueba el plan, los excesos sobre el plan, los metrados con diferencia, el material extra y su descuento a la contrata, las liquidaciones, los cambios, las entregas semanales y la anulación de valorizaciones.</field>
        </record>

        <record id="group_planner_assistant" model="res.groups">
            <field name="name">Planificación de obra: asistente de proyectos</field>
            <field name="implied_ids" eval="[Command.link(ref('group_planner_user'))]"/>
            <field name="comment">Crea los requerimientos a obra en borrador y los envía a aprobación; no aprueba ni valida el despacho, que valida el almacén.</field>
        </record>

        <!-- Ingresos (Administración y Finanzas): fuera del privilegio porque no
             es un escalón del planificador; se suma a cualquier nivel. -->
        <record id="group_planner_revenue" model="res.groups">
            <field name="name">Planificación de obra: ingresos</field>
            <field name="implied_ids" eval="[Command.link(ref('group_planner_user')), Command.link(ref('group_planner_amounts'))]"/>
            <field name="comment">Confirma valorizaciones, crea las facturas desde la valorización y ve el cronograma valorizado.</field>
        </record>

    </data>

    <!-- Funciones del núcleo que se apagan en Ajustes (v1.7, M17-06): grupos
         técnicos que tienen todos los usuarios internos mientras la función
         está activa. Al instalar quedan activas; después las maneja Ajustes. -->
    <data noupdate="1">
        <record id="group_planner_feature_control" model="res.groups">
            <field name="name">Planificación de obra: control activo</field>
            <field name="comment">Muestra el análisis de control, la pestaña «Control» del plan y el control de saldo.</field>
        </record>
        <record id="group_planner_feature_progress" model="res.groups">
            <field name="name">Planificación de obra: avance activo</field>
            <field name="comment">Muestra el registro y la validación de avances.</field>
        </record>
        <!-- Metrado (v1.8, M18-01): concepto de la vertical Mobiliario, separado
             del avance. -->
        <record id="group_planner_feature_measurement" model="res.groups">
            <field name="name">Planificación de obra: metrado activo</field>
            <field name="comment">Muestra los metrados, la carga de medidas y «Generar metrados».</field>
        </record>
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_planner_feature_control')), Command.link(ref('group_planner_feature_progress')), Command.link(ref('group_planner_feature_measurement'))]"/>
        </record>
    </data>
</odoo>
