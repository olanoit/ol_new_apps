<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="res_groups_privilege_construction_planner" model="res.groups.privilege">
            <field name="name">Planificación de obra</field>
            <field name="sequence">45</field>
            <field name="category_id" ref="base.module_category_services"/>
        </record>

        <record id="group_planner_progress" model="res.groups">
            <field name="name">Reporte de avance</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_construction_planner"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="comment">Capataces de contrata y supervisores: ven el árbol de sus obras y registran avances.</field>
        </record>

        <record id="group_planner_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_construction_planner"/>
            <field name="implied_ids" eval="[Command.link(ref('group_planner_progress')), Command.link(ref('project.group_project_user')), Command.link(ref('al_project_gantt_base.group_gantt_user'))]"/>
            <field name="comment">Proyectos, Logística y Producción: lanzan las acciones sobre planes aprobados.</field>
        </record>

        <record id="group_planner_planner" model="res.groups">
            <field name="name">Planificador</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_construction_planner"/>
            <field name="implied_ids" eval="[Command.link(ref('group_planner_user')), Command.link(ref('mrp.group_mrp_user'))]"/>
            <field name="comment">Oficina Técnica y supervisores de obra: cargan tipologías, generan y editan planes en borrador, aplican costos y validan avances y liquidaciones.</field>
        </record>

        <record id="group_planner_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="res_groups_privilege_construction_planner"/>
            <field name="implied_ids" eval="[Command.link(ref('group_planner_planner'))]"/>
            <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
            <field name="comment">Jefatura de Proyectos: configuración, políticas, aprobación de liquidaciones y cierre de planes.</field>
        </record>

        <!-- Ingresos (Administración y Finanzas): fuera del privilegio porque no
             es un escalón del planificador; se suma a cualquier nivel. -->
        <record id="group_planner_revenue" model="res.groups">
            <field name="name">Planificación de obra: ingresos</field>
            <field name="implied_ids" eval="[Command.link(ref('group_planner_user'))]"/>
            <field name="comment">Confirma valorizaciones, crea las facturas desde la valorización y ve el cronograma valorizado.</field>
        </record>

    </data>
</odoo>
