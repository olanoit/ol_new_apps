<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- W-15 · Importar maestro y ETO -->
    <record id="construction_master_import_wizard_view_form" model="ir.ui.view">
        <field name="name">construction.master.import.wizard.form</field>
        <field name="model">construction.master.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar maestro y ETO">
                <field name="company_id" invisible="1"/>
                <div class="alert alert-info mb-3" role="status">
                    Un libro Excel con las hojas del maestro de planificación (actividades,
                    tipologías, módulos, actividades por ambiente, BOM y árbol de la obra) o solo
                    con la hoja ETO (código y ancho real de cada módulo). Todas las hojas son
                    opcionales y volver a importar no duplica nada. Descargue la plantilla vacía
                    o el ejemplo para ver el formato.
                </div>
                <group>
                    <group>
                        <field name="project_id" options="{'no_create': True}"/>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="create_missing_products"/>
                    </group>
                </group>
                <div class="alert alert-danger" role="alert" invisible="not error_html">
                    <field name="error_html" readonly="1" nolabel="1"/>
                </div>
                <separator string="Vista previa" invisible="not preview_html"/>
                <field name="preview_html" readonly="1" nolabel="1" invisible="not preview_html"/>
                <separator string="Advertencias" invisible="not warning_html"/>
                <field name="warning_html" readonly="1" nolabel="1" invisible="not warning_html"/>
                <footer>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"
                            invisible="not file or error_html" data-hotkey="q"/>
                    <button name="action_download_template" type="object" string="Descargar plantilla"
                            class="btn-secondary"/>
                    <button name="action_download_example" type="object" string="Descargar ejemplo"
                            class="btn-secondary"/>
                    <button name="action_download_eto_example" type="object"
                            string="Descargar ETO de ejemplo" class="btn-secondary"/>
                    <button string="Descartar" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_construction_master_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar maestro y ETO</field>
        <field name="res_model">construction.master.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="group_ids" eval="[Command.link(ref('group_planner_planner'))]"/>
    </record>

</odoo>
