<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Paquete 7 de CREVAL: tarjetas presupuestado contra ejecutado. -->
    <t t-name="al_construction_planner.IndicatorBlocks">
        <div class="o_cp_ind_blocks d-flex flex-wrap gap-2">
            <t t-foreach="blocks" t-as="block" t-key="block.key">
                <div t-attf-class="o_cp_ind_block o_cp_ind_block_{{block.key}} flex-grow-1">
                    <div class="o_cp_ind_block_title" t-esc="blockLabel(block)"/>
                    <div class="d-flex flex-wrap gap-2">
                        <t t-foreach="block.items" t-as="item" t-key="item.key">
                            <div t-attf-class="o_cp_ind_card o_cp_ind_{{item.key}}" t-att-title="item.help">
                                <div class="o_cp_ind_card_label" t-esc="item.label"/>
                                <div t-attf-class="o_cp_ind_card_value {{cssClass(item)}}"
                                     t-esc="format(item, props.executed[item.key])"/>
                                <div class="o_cp_ind_card_budget">presup. <t t-esc="format(item, props.budget[item.key])"/></div>
                            </div>
                        </t>
                        <t t-if="block.key === 'close' and props.extraClose">
                            <t t-foreach="props.extraClose" t-as="extra" t-key="extra.key">
                                <div t-attf-class="o_cp_ind_card o_cp_ind_{{extra.key}}" t-att-title="extra.help">
                                    <div class="o_cp_ind_card_label" t-esc="extra.label"/>
                                    <div class="o_cp_ind_card_value" t-esc="extra.executed"/>
                                    <div class="o_cp_ind_card_budget">presup. <t t-esc="extra.budget"/></div>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
