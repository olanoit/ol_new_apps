<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="al_construction_planner.Home">
        <div class="o_action o_cp_home h-100 overflow-auto">
            <div class="container-fluid py-3">
                <div class="row g-3">
                    <div class="col-12 col-xl-8">
                        <div class="d-flex align-items-center mb-2">
                            <h4 class="mb-0">Obras</h4>
                            <button class="btn btn-sm btn-link ms-auto" t-on-click="this.load" t-att-disabled="this.state.loading">
                                <i class="oi me-1" data-icon="refresh"/>Actualizar
                            </button>
                        </div>
                        <t t-if="this.state.data and !this.works.length">
                            <div class="o_view_nocontent position-relative">
                                <div class="o_nocontent_help">
                                    <p class="o_view_nocontent_empty_folder">Todavía no hay planes de recursos</p>
                                    <p>Cree el plan de la obra desde «Obras ▸ Planes de recursos» y genérelo desde
                                       sus tipologías.</p>
                                </div>
                            </div>
                        </t>
                        <table t-elif="this.works.length" class="table table-sm table-hover align-middle o_cp_home_works">
                            <thead>
                                <tr>
                                    <th>Obra · plan</th>
                                    <t t-if="this.state.data.show_amounts">
                                        <th class="text-end">Planificado</th>
                                        <th class="text-end">Saldo</th>
                                    </t>
                                    <th class="text-end">Avance</th>
                                    <th>Próximo hito</th>
                                    <th>Estado</th>
                                    <th/>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.works" t-as="work" t-key="work.plan_id">
                                    <tr class="o_cp_home_work" t-on-click="() => this.openWork(work)">
                                        <td>
                                            <div class="fw-bold" t-out="work.project_name"/>
                                            <div class="small text-muted">
                                                <t t-out="work.plan_name"/> · <t t-out="work.period"/>
                                            </div>
                                        </td>
                                        <t t-if="this.state.data.show_amounts">
                                            <td class="text-end" t-out="this.money(work.amount_total)"/>
                                            <td class="text-end" t-out="this.money(work.amount_remaining)"/>
                                        </t>
                                        <td class="text-end" t-out="this.pct(work.progress)"/>
                                        <td t-out="work.milestone or '—'"/>
                                        <td><span t-att-class="'badge ' + this.badge(work.state)" t-out="work.state_label"/></td>
                                        <td class="text-end">
                                            <button t-if="this.state.data.has_schedule_report"
                                                    class="btn btn-sm btn-link o_cp_home_schedule" title="Cronograma valorizado"
                                                    t-on-click.stop="() => this.openSchedule(work)">
                                                <i class="oi" data-icon="show_chart"/>
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-12 col-xl-4">
                        <div class="card o_cp_home_pending">
                            <div class="card-header">
                                <h5 class="mb-0">Pendientes de hoy</h5>
                                <div class="small text-muted text-capitalize" t-out="this.state.data?.today_label"/>
                            </div>
                            <ul class="list-group list-group-flush">
                                <t t-foreach="this.pending" t-as="item" t-key="item.key">
                                    <li class="list-group-item list-group-item-action d-flex align-items-center gap-2 o_cp_home_item"
                                        t-att-data-key="item.key" t-on-click="() => this.openPending(item)">
                                        <span class="flex-grow-1">
                                            <span t-out="item.label"/>
                                            <span class="d-block small text-muted" t-out="item.where"/>
                                        </span>
                                        <span t-att-class="'badge rounded-pill ' + (item.count ? 'text-bg-primary' : 'text-bg-light')"
                                              t-out="item.count"/>
                                    </li>
                                </t>
                                <li t-if="this.state.data and !this.pending.length" class="list-group-item text-muted small">
                                    Sus grupos no atienden pendientes del planificador.
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
