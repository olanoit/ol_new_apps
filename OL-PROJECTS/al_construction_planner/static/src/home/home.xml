<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="al_construction_planner.Home">
        <div class="o_action o_cp_home h-100 overflow-auto">
            <div class="container-fluid py-2">
                <div class="row g-3">
                    <div class="col-12 col-xxl-9">
                        <!-- 1. Barra superior (CR-59) -->
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2 o_cp_home_bar">
                            <h4 class="mb-0 me-2">Obras</h4>
                            <ul class="nav nav-pills nav-sm o_cp_home_tabs">
                                <li class="nav-item" t-foreach="tabs" t-as="tab" t-key="tab.key">
                                    <a href="#" t-attf-class="nav-link py-1 px-2 o_cp_home_tab_{{tab.key}} {{state.tab === tab.key ? 'active' : ''}}"
                                       t-on-click.prevent="() => this.setTab(tab.key)">
                                        <t t-esc="tab.label"/> <span class="badge rounded-pill text-bg-light" t-esc="tabCount(tab.key)"/>
                                    </a>
                                </li>
                            </ul>
                            <div class="btn-group btn-group-sm">
                                <button t-attf-class="btn o_cp_home_f_favorites {{state.favorites ? 'btn-primary' : 'btn-secondary'}}" t-on-click="() => this.toggleFilter('favorites')">★ Favoritas</button>
                                <button t-attf-class="btn o_cp_home_f_mine {{state.mine ? 'btn-primary' : 'btn-secondary'}}" t-on-click="() => this.toggleFilter('mine')">Mis obras</button>
                                <button t-if="hasIndicators" t-attf-class="btn o_cp_home_f_red {{state.red ? 'btn-danger' : 'btn-secondary'}}" t-on-click="() => this.toggleFilter('red')">En rojo</button>
                            </div>
                            <label t-if="hasIndicators" class="d-flex align-items-center gap-1 small mb-0">Mes
                                <input type="month" class="form-control form-control-sm o_cp_home_month" t-att-value="monthInput" t-on-change="onMonthChange"/>
                            </label>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-secondary dropdown-toggle o_cp_home_sort" data-bs-toggle="dropdown">⇅ <t t-esc="sortLabel"/></button>
                                <ul class="dropdown-menu">
                                    <li t-foreach="sorts" t-as="sort" t-key="sort.key">
                                        <a href="#" t-attf-class="dropdown-item o_cp_home_sort_{{sort.key}} {{state.sort === sort.key ? 'active' : ''}}"
                                           t-on-click.prevent="() => this.setSort(sort.key)" t-esc="sort.label"/>
                                    </li>
                                </ul>
                            </div>
                            <button class="btn btn-sm btn-link ms-auto" t-on-click="load" t-att-disabled="state.loading">
                                <i class="fa fa-refresh me-1"/>Actualizar
                            </button>
                        </div>

                        <t t-if="state.data and !works.length and !unplanned.length">
                            <div class="o_view_nocontent position-relative">
                                <div class="o_nocontent_help">
                                    <p class="o_view_nocontent_empty_folder">Todavía no hay planes de recursos</p>
                                    <p>Cree el plan de la obra desde «Obras ▸ Planes de recursos» y genérelo desde
                                       sus tipologías.</p>
                                </div>
                            </div>
                        </t>

                        <!-- 2. Total de la cartera -->
                        <div t-if="hasIndicators" class="mb-2 o_cp_home_totals">
                            <ConstructionIndicatorBlocks budget="totals.budget" executed="totals.executed" monthTitle="monthTitle"/>
                        </div>

                        <!-- 3. Tabla con dos filas por obra -->
                        <div t-if="hasIndicators" class="table-responsive">
                            <table class="table table-sm align-middle o_cp_home_works o_cp_home_portfolio">
                                <thead>
                                    <tr class="o_cp_home_blockrow">
                                        <th colspan="2"/>
                                        <t t-foreach="blocks" t-as="block" t-key="block.key">
                                            <th t-attf-class="text-center o_cp_home_bh o_cp_home_bh_{{block.key}}" t-att-colspan="block.items.length" t-esc="block.label"/>
                                        </t>
                                        <th colspan="2" class="text-center o_cp_home_bh o_cp_home_bh_index">Índices</th>
                                    </tr>
                                    <tr>
                                        <th>Obra</th>
                                        <th/>
                                        <t t-foreach="blocks" t-as="block" t-key="block.key">
                                            <th t-foreach="block.items" t-as="item" t-key="item.key" class="text-end" t-att-title="item.help">
                                                <t t-esc="item.label"/> <i class="fa fa-info-circle text-muted small"/>
                                            </th>
                                        </t>
                                        <th class="text-end" title="Índice de desempeño del costo: valor ganado ÷ costo ejecutado">CPI <i class="fa fa-info-circle text-muted small"/></th>
                                        <th class="text-end" title="Índice de desempeño del plazo: valor ganado ÷ costo programado a hoy">SPI <i class="fa fa-info-circle text-muted small"/></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="sortedWorks" t-as="work" t-key="work.project_id">
                                        <tr class="o_cp_home_row_budget" t-att-data-project="work.project_id">
                                            <td rowspan="2" class="o_cp_home_work_cell">
                                                <div class="d-flex align-items-start gap-2">
                                                    <button class="btn btn-link p-0 o_cp_home_star" t-on-click="() => this.toggleFavorite(work)"
                                                            t-att-title="work.is_favorite ? 'Quitar de favoritas' : 'Marcar como favorita'">
                                                        <i t-att-class="work.is_favorite ? 'fa fa-star text-warning' : 'fa fa-star-o text-muted'"/>
                                                    </button>
                                                    <span t-att-class="lightClass(work.indicators and work.indicators.light)" class="mt-1"/>
                                                    <div>
                                                        <a href="#" class="fw-bold o_cp_home_work" t-on-click.prevent="() => this.openWork(work)" t-esc="work.project_name"/>
                                                        <div class="small text-muted"><t t-esc="work.partner"/><t t-if="work.partner and work.dates"> · </t><t t-esc="work.dates"/></div>
                                                        <div class="small">
                                                            <span t-att-class="'badge ' + badge(work.state)" t-esc="work.state_label"/>
                                                            <span t-if="work.indicators and work.indicators.days_late &gt; 0" class="ms-1 o_cp_light_red"><t t-esc="work.indicators.days_late"/> d de atraso</span>
                                                            <a t-if="state.data.has_schedule_report" href="#" class="ms-1 o_cp_home_schedule" title="Cronograma valorizado"
                                                               t-on-click.prevent="() => this.openSchedule(work)"><i class="fa fa-line-chart"/></a>
                                                            <a href="#" class="ms-1" title="Plan de recursos" t-on-click.prevent="() => this.openPlan(work)"><i class="fa fa-sitemap"/></a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="small text-muted">Presup.</td>
                                            <t t-foreach="blocks" t-as="block" t-key="block.key">
                                                <td t-foreach="block.items" t-as="item" t-key="item.key" t-attf-class="text-end o_cp_home_c_{{block.key}}" t-esc="cell(work, 'budget', item)"/>
                                            </t>
                                            <td class="o_cp_home_c_index"/><td class="o_cp_home_c_index"/>
                                        </tr>
                                        <tr class="o_cp_home_row_executed">
                                            <td class="small fw-bold">Ejec.</td>
                                            <t t-foreach="blocks" t-as="block" t-key="block.key">
                                                <td t-foreach="block.items" t-as="item" t-key="item.key"
                                                    t-attf-class="text-end fw-bold o_cp_home_c_{{block.key}} {{cellClass(work, item)}}" t-esc="cell(work, 'executed', item)"/>
                                            </t>
                                            <td t-attf-class="text-end fw-bold o_cp_home_c_index o_cp_light_{{work.indicators and work.indicators.lights and work.indicators.lights.cpi}}" t-esc="idx(work.indicators and work.indicators.cpi)"/>
                                            <td t-attf-class="text-end fw-bold o_cp_home_c_index o_cp_light_{{work.indicators and work.indicators.lights and work.indicators.lights.spi}}" t-esc="idx(work.indicators and work.indicators.spi)"/>
                                        </tr>
                                    </t>
                                    <tr t-if="!sortedWorks.length and !filteredUnplanned.length">
                                        <td colspan="16" class="text-muted small">Ninguna obra con estos filtros.</td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="small text-muted o_cp_home_footer">
                                Miles de <t t-esc="works[0]?.currency_symbol"/>, sin IGV. Presupuestado: plan y calendario de valorizaciones. Ejecutado: contabilidad analítica de la obra, avance por partida y valorizaciones confirmadas. Por valorizar: obra hecha que aún no se cobra. Color: semáforo del margen y de los índices (Ajustes) o el ejecutado contra lo presupuestado.
                            </div>
                        </div>

                        <!-- Sin el puente de ventas: tabla de planes (P-01). -->
                        <table t-elif="works.length" class="table table-sm table-hover align-middle o_cp_home_works">
                            <thead>
                                <tr>
                                    <th>Obra · plan</th>
                                    <t t-if="showAmounts">
                                        <th class="text-end">Planificado</th>
                                        <th class="text-end">Saldo</th>
                                    </t>
                                    <th class="text-end">Avance</th>
                                    <th>Próximo hito</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="sortedWorks" t-as="work" t-key="work.plan_id">
                                    <tr class="o_cp_home_work" t-on-click="() => this.openWork(work)">
                                        <td>
                                            <i t-if="work.is_favorite" class="fa fa-star text-warning me-1"/>
                                            <span class="fw-bold" t-esc="work.project_name"/>
                                            <div class="small text-muted">
                                                <t t-esc="work.plan_name"/> · <t t-esc="work.period"/>
                                            </div>
                                        </td>
                                        <t t-if="showAmounts">
                                            <td class="text-end" t-esc="money(work.amount_total)"/>
                                            <td class="text-end" t-esc="money(work.amount_remaining)"/>
                                        </t>
                                        <td class="text-end" t-esc="pct(work.progress)"/>
                                        <td t-esc="work.milestone or '—'"/>
                                        <td><span t-att-class="'badge ' + badge(work.state)" t-esc="work.state_label"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-if="filteredUnplanned.length">
                            <h5 class="mt-3 mb-2">Por planificar</h5>
                            <table class="table table-sm table-hover align-middle o_cp_home_unplanned">
                                <thead>
                                    <tr><th>Obra</th><th>Venta</th><th>Hoja de planificación</th><th/></tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="filteredUnplanned" t-as="work" t-key="work.project_id">
                                        <td class="fw-bold">
                                            <i t-if="work.is_favorite" class="fa fa-star text-warning me-1"/>
                                            <t t-esc="work.project_name"/>
                                        </td>
                                        <td t-esc="work.sale or '—'"/>
                                        <td t-esc="work.sheet_state or '—'"/>
                                        <td class="text-end">
                                            <button t-foreach="work.actions" t-as="action" t-key="action.method"
                                                    class="btn btn-sm btn-secondary o_cp_home_unplanned_action"
                                                    t-on-click="() => this.runUnplanned(work, action)"
                                                    t-esc="action.label"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>

                    <!-- 5. Pendientes de hoy por área (CR-65) -->
                    <div class="col-12 col-xxl-3">
                        <div class="card o_cp_home_pending">
                            <div class="card-header">
                                <h5 class="mb-0">Pendientes de hoy <span class="badge rounded-pill text-bg-primary o_cp_home_pending_total" t-esc="pendingTotal"/></h5>
                                <div class="small text-muted text-capitalize" t-esc="state.data?.today_label"/>
                            </div>
                            <div class="list-group list-group-flush">
                                <t t-foreach="pendingAreas" t-as="area" t-key="area.key">
                                    <div t-attf-class="o_cp_home_area o_cp_home_area_{{area.key}}" t-att-data-area="area.key">
                                        <div class="d-flex align-items-center px-3 pt-2 pb-1">
                                            <span class="fw-bold small text-uppercase" t-esc="area.label"/>
                                            <span class="ms-auto badge rounded-pill o_cp_home_area_total" t-att-class="area.total ? 'text-bg-primary' : 'text-bg-light'" t-esc="area.total"/>
                                        </div>
                                        <t t-foreach="area.items" t-as="item" t-key="item.key">
                                            <a href="#" class="list-group-item list-group-item-action d-flex align-items-center gap-2 border-0 o_cp_home_item"
                                               t-att-data-key="item.key" t-on-click.prevent="() => this.openPending(item)">
                                                <span class="flex-grow-1">
                                                    <span t-esc="item.label"/>
                                                    <span class="d-block small text-muted"><t t-esc="item.where"/> · <t t-esc="item.role"/></span>
                                                </span>
                                                <span class="badge rounded-pill text-bg-primary" t-esc="item.count"/>
                                            </a>
                                        </t>
                                        <div t-if="area.zero.length" class="px-3 pb-2 small text-muted o_cp_home_zero">
                                            <a href="#" class="text-muted" t-on-click.prevent="() => this.toggleArea(area.key)">
                                                <t t-esc="area.zero.length"/> sin casos <i t-att-class="state.openAreas[area.key] ? 'fa fa-caret-up' : 'fa fa-caret-down'"/>
                                            </a>
                                            <t t-if="state.openAreas[area.key]">
                                                <div t-foreach="area.zero" t-as="item" t-key="item.key" class="o_cp_home_item_zero" t-att-data-key="item.key">
                                                    <t t-esc="item.label"/> · 0
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                                <div t-if="state.data and !pending.length" class="list-group-item text-muted small">
                                    Sus grupos no atienden pendientes del planificador.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
