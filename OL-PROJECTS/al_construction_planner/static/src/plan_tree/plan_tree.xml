<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="al_construction_planner.PlanTree">
        <div class="o_action o_cp_tree d-flex flex-column h-100">
            <!-- Plan y filtros -->
            <div class="o_cp_toolbar d-flex flex-wrap align-items-center gap-2 px-3 py-2 border-bottom">
                <select class="form-select form-select-sm o_cp_plan_select w-auto"
                        t-on-change="this.onPlanChange" aria-label="Plan de recursos">
                    <t t-foreach="this.state.plans" t-as="plan" t-key="plan.id">
                        <option t-att-value="plan.id" t-att-selected="plan.id === this.state.planId"
                                t-out="plan.display_name + ' · ' + plan.project_id[1]"/>
                    </t>
                </select>
                <div class="dropdown">
                    <button class="btn btn-sm btn-secondary dropdown-toggle" data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <i class="oi oi-filled me-1" data-icon="filter_alt"/>Filtros
                        <t t-set="nf" t-value="this.state.filters.stages.length + this.state.filters.resource_types.length + this.state.filters.unit_states.length + (this.state.filters.partner ? 1 : 0)"/>
                        <span t-if="nf" class="badge text-bg-primary ms-1" t-out="nf"/>
                    </button>
                    <div class="dropdown-menu p-2 o_cp_filters">
                        <div class="fw-bold small text-muted">Etapa</div>
                        <t t-foreach="this.state.options.stage_tree" t-as="node" t-key="node.code">
                            <t t-set="ss" t-value="this.stageState(node)"/>
                            <div class="dropdown-item d-flex align-items-center o_cp_stage_node"
                                 t-att-data-code="node.code"
                                 t-att-style="'padding-left:' + (16 + node.depth * 16) + 'px'"
                                 t-on-click.stop="() => this.toggleStage(node)">
                                <span t-att-class="'o_cp_check o_cp_' + ss" role="checkbox"
                                      t-att-aria-checked="ss === 'on' ? 'true' : (ss === 'part' ? 'mixed' : 'false')"/>
                                <span t-att-class="node.leaf ? '' : 'fw-bold'" t-out="node.label"/>
                            </div>
                        </t>
                        <div class="fw-bold small text-muted mt-2">Tipo de recurso</div>
                        <t t-foreach="this.state.options.resource_types" t-as="opt" t-key="opt[0]">
                            <label class="dropdown-item d-flex gap-2">
                                <input type="checkbox" t-att-checked="this.state.filters.resource_types.includes(opt[0])"
                                       t-on-change="() => this.toggleFilter('resource_types', opt[0])"/>
                                <span t-out="opt[1]"/>
                            </label>
                        </t>
                        <div class="fw-bold small text-muted mt-2">Estado del módulo</div>
                        <t t-foreach="this.state.options.unit_states" t-as="opt" t-key="opt[0]">
                            <label class="dropdown-item d-flex gap-2">
                                <input type="checkbox" t-att-checked="this.state.filters.unit_states.includes(opt[0])"
                                       t-on-change="() => this.toggleFilter('unit_states', opt[0])"/>
                                <span t-out="opt[1]"/>
                            </label>
                        </t>
                    </div>
                </div>
                <select class="form-select form-select-sm w-auto o_cp_partner_select" t-on-change="this.onPartnerChange"
                        aria-label="Contrata">
                    <option value="" t-att-selected="!this.state.filters.partner">Todas las contratas</option>
                    <option value="none" t-att-selected="this.state.filters.partner === 'none'">Sin asignar</option>
                    <t t-foreach="this.state.partners" t-as="partner" t-key="partner[0]">
                        <option t-att-value="partner[0]" t-att-selected="this.state.filters.partner == partner[0]"
                                t-out="partner[1]"/>
                    </t>
                </select>
                <button class="btn btn-sm btn-secondary ms-auto o_cp_open_io" t-on-click="this.openIoMatrix"
                        title="Recursos de la selección como tabla insumo-producto">
                    <i class="oi me-1" data-icon="table_chart"/>Insumo-producto
                </button>
                <div class="btn-group btn-group-sm o_cp_measure" role="group" aria-label="Medida">
                    <button t-if="this.state.terms.show_amounts" class="btn" t-att-class="this.state.measure === 'amount' ? 'btn-primary' : 'btn-secondary'"
                            t-on-click="() => this.setMeasure('amount')">Soles</button>
                    <button class="btn" t-att-class="this.state.measure === 'driver' ? 'btn-primary' : 'btn-secondary'"
                            t-on-click="() => this.setMeasure('driver')">Cantidad</button>
                    <button class="btn" t-att-class="this.state.measure === 'progress' ? 'btn-primary' : 'btn-secondary'"
                            t-on-click="() => this.setMeasure('progress')">Avance</button>
                </div>
            </div>

            <!-- Barra de selección -->
            <div t-if="this.state.summary and !this.state.summary.empty"
                 class="o_cp_selbar d-flex flex-wrap align-items-center gap-3 px-3 py-2 border-bottom">
                <span class="fw-bold o_cp_summary">
                    Selección:
                    <span class="o_cp_summary_modules" t-out="this.state.summary.modules"/>
                    <t t-out="this.state.terms.details.toLowerCase()"/> ·
                    <span t-out="this.state.summary.spaces"/> <t t-out="this.state.terms.spaces.toLowerCase()"/> ·
                    <t t-if="this.state.terms.show_ml"><span t-out="this.fmt(this.state.summary.ml)"/> ML · </t>
                    <t t-if="this.state.terms.show_amounts">S/ <span class="o_cp_summary_total" t-out="this.fmt(this.state.summary.total)"/></t>
                </span>
                <span t-if="this.state.terms.show_amounts" class="text-muted small">
                    Material S/ <t t-out="this.fmt(this.state.summary.material)"/> ·
                    Contrata S/ <t t-out="this.fmt(this.state.summary.contract)"/>
                </span>
                <div class="ms-auto d-flex flex-wrap gap-1">
                    <t t-foreach="this.state.actions" t-as="act" t-key="act.xmlid">
                        <button class="btn btn-sm btn-primary" t-on-click="() => this.runAction(act.xmlid)">
                            <i class="oi me-1" t-att-data-icon="act.icon"/><t t-out="act.name"/>
                        </button>
                    </t>
                    <button class="btn btn-sm btn-secondary o_cp_clear" t-on-click="this.clearSelection">Quitar selección</button>
                </div>
            </div>

            <div t-if="!this.state.plans.length" class="o_view_nocontent p-5 text-center">
                <p class="o_view_nocontent_smiling_face">No hay planes de recursos</p>
                <p>Cree el plan de una obra y genérelo desde sus tipologías.</p>
            </div>

            <div t-else="" class="o_cp_body d-flex flex-grow-1 overflow-hidden">
                <!-- Árbol -->
                <div class="o_cp_table_wrap flex-grow-1 overflow-auto">
                    <table class="table table-sm o_cp_table mb-0">
                        <thead>
                            <tr>
                                <th>Nivel</th>
                                <th t-if="this.state.terms.show_typology">Tipología</th>
                                <th class="text-end o_cp_col_details" t-out="this.state.terms.details"/>
                                <th t-if="this.state.terms.show_ml" class="text-end">ML</th>
                                <t t-if="this.state.measure !== 'progress'">
                                    <t t-foreach="this.columns" t-as="col" t-key="col.field">
                                        <th class="text-end" t-out="col.label"/>
                                    </t>
                                </t>
                                <th class="text-end">Avance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="this.rows" t-as="row" t-key="row.node.key">
                                <t t-set="node" t-value="row.node"/>
                                <t t-set="cs" t-value="this.checkState(node.key)"/>
                                <tr class="o_cp_tree_row" t-att-data-key="node.key" t-att-data-name="node.name"
                                    t-att-data-level="node.level"
                                    t-att-class="{'o_cp_row_sel': cs === 'on', 'fw-bold': node.level !== 'module'}">
                                    <td class="o_cp_name text-nowrap" t-att-style="'padding-left:' + (4 + row.depth * 18) + 'px'">
                                        <span class="o_cp_caret" t-on-click="() => this.toggleExpand(node.key)">
                                            <i t-if="node.has_children" class="oi oi-fw"
                                               t-att-data-icon="this.state.expanded[node.key] ? 'arrow_drop_down' : 'arrow_right'"/>
                                            <i t-else="" class="oi oi-fw"/>
                                        </span>
                                        <span t-att-class="'o_cp_check o_cp_' + cs" role="checkbox"
                                              t-att-aria-checked="cs === 'on' ? 'true' : (cs === 'part' ? 'mixed' : 'false')"
                                              t-on-click="() => this.toggleCheck(node.key)"/>
                                        <a href="#" t-if="node.task_id" t-on-click.prevent="() => this.openTask(node)"
                                           t-out="node.name"/>
                                        <span t-else="" t-out="node.name"/>
                                        <span class="o_cp_lvl" t-out="node.level_name || this.levelLabel(node.level)"/>
                                    </td>
                                    <td t-if="this.state.terms.show_typology" t-out="node.typology"/>
                                    <td class="text-end" t-out="node.modules"/>
                                    <td t-if="this.state.terms.show_ml" class="text-end" t-out="node.ml ? this.fmt(node.ml) : ''"/>
                                    <t t-if="this.state.measure !== 'progress'">
                                        <t t-foreach="this.columns" t-as="col" t-key="col.field">
                                            <td class="text-end" t-out="node[col.field] ? this.fmt(node[col.field]) : ''"/>
                                        </t>
                                    </t>
                                    <td class="text-end" t-out="this.progressLabel(node)"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Panel de recursos de la selección -->
                <aside class="o_cp_panel border-start overflow-auto">
                    <h5 class="px-3 py-2 m-0 border-bottom">Recursos acumulados de la selección</h5>
                    <div t-if="!this.state.summary or this.state.summary.empty" class="p-3 text-muted small">
                        Marque una obra, un piso, un departamento o módulos para ver sus recursos.
                    </div>
                    <t t-else="">
                        <!-- Por tipo de recurso, en el orden del catálogo, con su subtotal
                             (v1.8, M18-03); dentro, por etapa y sub etapa si se pide. -->
                        <div class="d-flex justify-content-end px-2 pt-1">
                            <button class="btn btn-link btn-sm o_cp_panel_by_stage" t-on-click="this.togglePanelByStage">
                                <t t-if="this.state.panelByStage">Sin etapas</t><t t-else="">Por etapa</t>
                            </button>
                        </div>
                        <table class="table table-sm mb-0 o_cp_panel_table">
                            <thead>
                                <tr><th>Recurso</th><th class="text-end">Driver</th><th class="text-end">Acum.</th><th t-if="this.state.terms.show_amounts" class="text-end">S/</th><th>Contrata</th></tr>
                            </thead>
                            <t t-foreach="this.state.summary.groups" t-as="group" t-key="group.type_id or group_index">
                                <tbody class="o_cp_panel_group" t-att-data-type="group.resource_type">
                                    <tr class="table-light fw-bold o_cp_panel_group_row">
                                        <td t-out="group.name"/>
                                        <td class="text-end" t-out="this.fmt(group.qty)"/>
                                        <td/>
                                        <td t-if="this.state.terms.show_amounts" class="text-end o_cp_panel_group_total" t-out="this.fmt(group.amount)"/>
                                        <td/>
                                    </tr>
                                    <t t-if="this.state.panelByStage">
                                        <t t-foreach="group.stages" t-as="stage" t-key="stage.stage or stage_index">
                                            <tr class="fw-bold text-muted o_cp_panel_stage_row">
                                                <td class="ps-3" t-out="stage.label"/>
                                                <td class="text-end" t-out="this.fmt(stage.qty)"/>
                                                <td/>
                                                <td t-if="this.state.terms.show_amounts" class="text-end" t-out="this.fmt(stage.amount)"/>
                                                <td/>
                                            </tr>
                                            <t t-foreach="stage.resources" t-as="res" t-key="res_index">
                                                <tr>
                                                    <td class="ps-4" t-out="res.name"/>
                                                    <td class="text-end text-nowrap"><t t-out="this.fmt(res.qty)"/> <t t-out="res.uom"/></td>
                                                    <td class="text-end" t-out="this.fmt(res.executed)"/>
                                                    <td t-if="this.state.terms.show_amounts" class="text-end" t-out="this.fmt(res.amount)"/>
                                                    <td t-out="res.partners"/>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <t t-foreach="group.resources" t-as="res" t-key="res_index">
                                            <tr>
                                                <td class="ps-3" t-out="res.name"/>
                                                <td class="text-end text-nowrap"><t t-out="this.fmt(res.qty)"/> <t t-out="res.uom"/></td>
                                                <td class="text-end" t-out="this.fmt(res.executed)"/>
                                                <td t-if="this.state.terms.show_amounts" class="text-end" t-out="this.fmt(res.amount)"/>
                                                <td t-out="res.partners"/>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </t>
                            <tfoot>
                                <tr><td colspan="3"><t t-out="this.state.summary.resources.length"/> recursos</td>
                                    <td t-if="this.state.terms.show_amounts" class="text-end fw-bold" t-out="this.fmt(this.state.summary.total)"/><td/></tr>
                            </tfoot>
                        </table>
                        <div class="p-2">
                            <button class="btn btn-link btn-sm" t-on-click="this.filterUnassigned">
                                Ver solo lo que no tiene contrata
                            </button>
                        </div>
                    </t>
                </aside>
            </div>
        </div>
    </t>

</templates>
