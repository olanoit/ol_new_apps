<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Plantillas que el Gantt de proyectos pinta en sus puntos de extensión
         (`toolbarTemplate`, `sidePanelTemplate`, `bottomPanelTemplate`), con
         ConstructionScheduleAction como contexto. -->

    <t t-name="al_construction_planner.ScheduleToolbar">
        <div class="o_cp_schedule_toolbar d-flex flex-wrap align-items-center gap-2">
            <label class="fw-bold mb-0" for="o_cp_schedule_plan">Plan:</label>
            <select id="o_cp_schedule_plan" class="form-select form-select-sm w-auto o_cp_schedule_plan"
                    t-on-change="onPlanChange">
                <option t-if="!schedule.plans.length" value="">Sin planes</option>
                <t t-foreach="schedule.planGroups" t-as="group" t-key="group_index">
                    <optgroup t-att-label="group.project">
                        <t t-foreach="group.plans" t-as="plan" t-key="plan.id">
                            <option t-att-value="plan.id" t-att-selected="plan.id === schedule.planId"
                                    t-esc="plan.label"/>
                        </t>
                    </optgroup>
                </t>
            </select>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary o_cp_rows_stages"
                        t-att-class="schedule.rows === 'stages' ? 'active' : ''"
                        title="Pisos, departamentos y ambientes con sus etapas"
                        t-on-click="() => this.onRowsChange('stages')">Etapas</button>
                <button type="button" class="btn btn-outline-secondary o_cp_rows_tasks"
                        t-att-class="schedule.rows === 'tasks' ? 'active' : ''"
                        title="Las tareas de la obra"
                        t-on-click="() => this.onRowsChange('tasks')">Tareas</button>
            </div>
            <div class="dropdown o_cp_stage_filter">
                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                        title="Solo esas etapas: las filas, la selección y la carga semanal">
                    <i class="fa fa-filter me-1"/><t t-esc="stageFilterLabel"/>
                </button>
                <div class="dropdown-menu p-2 o_cp_stage_tree">
                    <div class="dropdown-item o_cp_stage_all" t-on-click.stop="() => this.clearStages()">
                        <span t-att-class="'o_cp_check o_cp_' + (schedule.stages.length ? 'off' : 'on')"/>
                        Todas las etapas
                    </div>
                    <t t-foreach="schedule.stageTree" t-as="node" t-key="node.code">
                        <t t-set="ss" t-value="stageState(node)"/>
                        <div class="dropdown-item d-flex align-items-center o_cp_stage_node"
                             t-att-data-code="node.code"
                             t-att-style="'padding-left:' + (16 + node.depth * 16) + 'px'"
                             t-on-click.stop="() => this.toggleStage(node)">
                            <span t-att-class="'o_cp_check o_cp_' + ss" role="checkbox"
                                  t-att-aria-checked="ss === 'on' ? 'true' : (ss === 'part' ? 'mixed' : 'false')"/>
                            <span t-att-class="node.leaf ? '' : 'fw-bold'" t-esc="node.label"/>
                        </div>
                    </t>
                </div>
            </div>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-secondary"
                        t-att-class="schedule.showPanel ? 'active' : ''"
                        title="Recursos de la selección"
                        t-on-click="() => this.togglePanel()">
                    <i class="fa fa-columns"/>
                </button>
                <button t-if="showAmounts" type="button" class="btn btn-outline-secondary"
                        t-att-class="schedule.showLoad ? 'active' : ''"
                        title="Carga semanal por contrata y etapa"
                        t-on-click="() => this.toggleLoad()">
                    <i class="fa fa-bar-chart"/>
                </button>
            </div>
        </div>
    </t>

    <t t-name="al_construction_planner.SchedulePanel">
        <!-- Panel ampliable (paquete 1.15, M115-03): borde que se arrastra,
             «Ampliar / Reducir» y «Pantalla completa». -->
        <div class="o_cp_panel_backdrop" t-if="schedule.showPanel and schedule.panelFull"
             t-on-click="() => this.togglePanelFull()"/>
        <aside class="o_cp_schedule_panel border-start p-2" t-if="schedule.showPanel"
               t-att-class="{'o_cp_panel_wide': panelWide, 'o_cp_panel_full': schedule.panelFull}"
               t-att-style="schedule.panelFull ? '' : 'width:' + schedule.panelWidth + 'px;flex-basis:' + schedule.panelWidth + 'px'">
            <div class="o_cp_panel_resizer" t-if="!schedule.panelFull"
                 title="Arrastre para cambiar el ancho; doble clic vuelve al ancho inicial"
                 t-on-mousedown="onPanelResizeStart" t-on-dblclick="() => this.resetPanelWidth()"/>
            <div class="o_cp_panel_body">
            <div class="d-flex align-items-center gap-1 mb-2">
                <h6 class="mb-0 me-auto">Recursos de la selección</h6>
                <button type="button" class="btn btn-sm btn-link p-0 o_cp_panel_expand" t-if="!schedule.panelFull"
                        t-on-click="() => this.togglePanelWide()">
                    <i t-att-class="'fa me-1 ' + (panelExpanded ? 'fa-compress' : 'fa-expand')"/>
                    <t t-if="panelExpanded">Reducir</t><t t-else="">Ampliar</t>
                </button>
                <button type="button" class="btn btn-sm btn-link p-0 ms-2 o_cp_panel_fullscreen"
                        t-att-title="schedule.panelFull ? 'Cerrar' : 'Pantalla completa'"
                        t-on-click="() => this.togglePanelFull()">
                    <i t-att-class="'fa ' + (schedule.panelFull ? 'fa-times' : 'fa-window-maximize')"/>
                    <span class="ms-1" t-if="schedule.panelFull">Cerrar</span>
                </button>
            </div>
            <p class="text-muted small" t-if="!schedule.planId">
                La obra no tiene plan de recursos: genérelo para ver sus etapas.
            </p>
            <p class="text-muted small" t-elif="!schedule.summary">
                Marque pisos, ambientes o etapas en la primera columna.
            </p>
            <t t-else="">
                <div class="o_cp_schedule_summary small mb-2">
                    <div><span class="o_cp_summary_modules" t-esc="schedule.summary.modules"/>
                        <t t-esc="schedule.terms.details.toLowerCase()"/>
                        <t t-if="schedule.terms.show_ml"> · <t t-esc="schedule.summary.ml"/> ML</t></div>
                    <div t-if="showAmounts">Material S/ <t t-esc="fmt(schedule.summary.material)"/> ·
                        contrata S/ <t t-esc="fmt(schedule.summary.contract)"/></div>
                    <div>Avance <t t-esc="pct(schedule.summary.progress)"/></div>
                </div>
                <div class="d-flex justify-content-end">
                    <button class="btn btn-link btn-sm p-0 o_cp_panel_by_stage" t-on-click="() => this.togglePanelByStage()">
                        <t t-if="schedule.panelByStage">Sin etapas</t><t t-else="">Por etapa</t>
                    </button>
                </div>
                <!-- Por tipo de recurso con subtotales (v1.8, M18-03). -->
                <table class="table table-sm o_cp_schedule_resources mb-0">
                    <thead>
                        <tr>
                            <th>Recurso</th>
                            <th t-if="panelWide" class="o_cp_col_partner">Contrata o proveedor</th>
                            <th t-if="panelWide" class="text-end o_cp_col_qty">Plan</th>
                            <th t-if="showAmounts" class="text-end">Plan S/</th>
                            <th t-if="panelWide and showAmounts" class="text-end o_cp_col_executed">Ejecutado S/</th>
                            <th t-if="panelWide and showAmounts" class="text-end o_cp_col_balance">Saldo S/</th>
                            <th class="text-end">Avance</th>
                        </tr>
                    </thead>
                    <t t-foreach="schedule.summary.groups" t-as="group" t-key="group.type_id or group_index">
                        <tbody class="o_cp_panel_group" t-att-data-type="group.resource_type">
                            <tr class="table-light fw-bold o_cp_panel_group_row">
                                <td t-att-colspan="panelWide ? 3 : 1"><t t-esc="group.name"/>
                                    <span class="text-muted small fw-normal"> · <t t-esc="fmt(group.qty)"/></span></td>
                                <td t-if="showAmounts" class="text-end o_cp_panel_group_total" t-esc="fmt(group.amount)"/>
                                <td t-if="panelWide and showAmounts" colspan="2"/>
                                <td/>
                            </tr>
                            <t t-if="schedule.panelByStage">
                                <t t-foreach="group.stages" t-as="stage" t-key="stage.stage or stage_index">
                                    <tr class="fw-bold text-muted">
                                        <td class="ps-2" t-att-colspan="panelWide ? 3 : 1" t-esc="stage.label"/>
                                        <td t-if="showAmounts" class="text-end" t-esc="fmt(stage.amount)"/>
                                        <td t-if="panelWide and showAmounts" colspan="2"/>
                                        <td/>
                                    </tr>
                                    <t t-foreach="stage.resources" t-as="resource" t-key="resource_index">
                                        <t t-set="indent" t-value="'ps-3'"/>
                                        <t t-call="al_construction_planner.SchedulePanelRow"/>
                                    </t>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-foreach="group.resources" t-as="resource" t-key="resource_index">
                                    <t t-set="indent" t-value="'ps-2'"/>
                                    <t t-call="al_construction_planner.SchedulePanelRow"/>
                                </t>
                            </t>
                        </tbody>
                    </t>
                    <tfoot>
                        <tr>
                            <th t-att-colspan="panelWide ? 3 : 1">Total de la selección</th>
                            <th t-if="showAmounts" class="text-end o_cp_schedule_total" t-esc="fmt(schedule.summary.total)"/>
                            <th t-if="panelWide and showAmounts" colspan="2"/>
                            <th/>
                        </tr>
                    </tfoot>
                </table>
            </t>
            </div>
        </aside>
    </t>

    <t t-name="al_construction_planner.SchedulePanelRow">
        <tr>
            <td t-att-class="indent + ' o_cp_wrap_names'">
                <div t-esc="resource.name"/>
                <div class="text-muted small" t-if="resource.partners and !panelWide" t-esc="resource.partners"/>
            </td>
            <td t-if="panelWide" class="small o_cp_col_partner o_cp_wrap_names" t-esc="resource.partners or '—'"/>
            <td t-if="panelWide" class="text-end text-nowrap o_cp_col_qty">
                <t t-esc="fmt(resource.qty)"/> <span class="text-muted small" t-esc="resource.uom"/>
            </td>
            <td t-if="showAmounts" class="text-end" t-esc="fmt(resource.amount)"/>
            <td t-if="panelWide and showAmounts" class="text-end o_cp_col_executed"
                t-esc="resource.amount_executed === false ? '—' : fmt(resource.amount_executed)"/>
            <td t-if="panelWide and showAmounts" class="text-end o_cp_col_balance"
                t-esc="resource.amount_balance === false ? '—' : fmt(resource.amount_balance)"/>
            <td class="text-end" t-esc="resourceProgress(resource)"/>
        </tr>
    </t>

    <t t-name="al_construction_planner.ScheduleLoad">
        <div class="o_cp_schedule_load border-top" t-if="schedule.showLoad and schedule.load">
            <div class="d-flex flex-wrap align-items-baseline gap-2 px-2 pt-1">
                <span class="fw-bold">Carga semanal</span>
                <span class="text-muted small">
                    Contratas y personal propio por semana, repartidos entre los días hábiles de cada etapa.
                </span>
            </div>
            <p class="text-muted small px-2 mb-1" t-if="!schedule.load.rows.length">
                Sin montos de contratas ni personal propio en las etapas del cronograma.
            </p>
            <div class="table-responsive" t-else="">
                <table class="table table-sm mb-0 o_cp_load_table">
                    <thead>
                        <tr>
                            <th>Contrata · etapa</th>
                            <t t-foreach="schedule.load.weeks" t-as="week" t-key="week">
                                <th class="text-end" t-esc="weekLabel(week)"/>
                            </t>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="schedule.load.rows" t-as="row" t-key="row_index">
                            <tr>
                                <td t-att-class="row.unassigned ? 'text-warning' : ''">
                                    <t t-esc="row.label"/> · <t t-esc="row.stage_label"/>
                                </td>
                                <t t-foreach="row.values" t-as="value" t-key="value_index">
                                    <td class="text-end" t-esc="value ? fmt(value) : '—'"/>
                                </t>
                                <td class="text-end fw-bold" t-esc="fmt(row.total)"/>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Total</th>
                            <t t-foreach="schedule.load.totals" t-as="value" t-key="value_index">
                                <th class="text-end" t-esc="fmt(value)"/>
                            </t>
                            <th class="text-end o_cp_load_total" t-esc="fmt(schedule.load.total)"/>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </t>

</templates>
