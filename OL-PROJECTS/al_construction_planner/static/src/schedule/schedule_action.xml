<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Plantillas que el Gantt de proyectos pinta en sus puntos de extensión
         (`toolbarTemplate`, `sidePanelTemplate`, `bottomPanelTemplate`), con
         ConstructionScheduleAction como contexto. -->

    <t t-name="al_construction_planner.ScheduleToolbar">
        <div class="o_cp_schedule_toolbar d-flex flex-wrap align-items-center gap-2">
            <label class="fw-bold mb-0" for="o_cp_schedule_plan">Plan:</label>
            <select id="o_cp_schedule_plan" class="form-select form-select-sm w-auto o_cp_schedule_plan"
                    t-on-change="this.onPlanChange">
                <option t-if="!this.schedule.plans.length" value="">Sin planes</option>
                <t t-foreach="this.schedule.planGroups" t-as="group" t-key="group_index">
                    <optgroup t-att-label="group.project">
                        <t t-foreach="group.plans" t-as="plan" t-key="plan.id">
                            <option t-att-value="plan.id" t-att-selected="plan.id === this.schedule.planId"
                                    t-out="plan.label"/>
                        </t>
                    </optgroup>
                </t>
            </select>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary o_cp_rows_stages"
                        t-att-class="this.schedule.rows === 'stages' ? 'active' : ''"
                        title="Pisos, departamentos y ambientes con sus etapas"
                        t-on-click="() => this.onRowsChange('stages')">Etapas</button>
                <button type="button" class="btn btn-outline-secondary o_cp_rows_tasks"
                        t-att-class="this.schedule.rows === 'tasks' ? 'active' : ''"
                        title="Las tareas de la obra"
                        t-on-click="() => this.onRowsChange('tasks')">Tareas</button>
            </div>
            <div class="dropdown o_cp_stage_filter">
                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                        title="Solo esas etapas: las filas, la selección y la carga semanal">
                    <i class="oi oi-filled me-1" data-icon="filter_alt"/><t t-out="this.stageFilterLabel"/>
                </button>
                <div class="dropdown-menu p-2 o_cp_stage_tree">
                    <div class="dropdown-item o_cp_stage_all" t-on-click.stop="() => this.clearStages()">
                        <span t-att-class="'o_cp_check o_cp_' + (this.schedule.stages.length ? 'off' : 'on')"/>
                        Todas las etapas
                    </div>
                    <t t-foreach="this.schedule.stageTree" t-as="node" t-key="node.code">
                        <t t-set="ss" t-value="this.stageState(node)"/>
                        <div class="dropdown-item d-flex align-items-center o_cp_stage_node"
                             t-att-data-code="node.code"
                             t-att-style="'padding-left:' + (16 + node.depth * 16) + 'px'"
                             t-on-click.stop="() => this.toggleStage(node)">
                            <span t-att-class="'o_cp_check o_cp_' + ss" role="checkbox"
                                  t-att-aria-checked="ss === 'on' ? 'true' : (ss === 'part' ? 'mixed' : 'false')"/>
                            <span t-att-class="node.leaf ? '' : 'fw-bold'" t-out="node.label"/>
                        </div>
                    </t>
                </div>
            </div>
            <!-- Etapa actual de los ambientes (paquete 1.15, M115-04). -->
            <div class="dropdown o_cp_current_filter" t-if="this.schedule.rows === 'stages' and this.schedule.spaceStates.length">
                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle"
                        t-att-class="this.schedule.currentStages.length or this.schedule.onlyLate ? 'active' : ''"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                        title="Ambientes por su etapa actual y su plazo">
                    <i class="oi oi-filled me-1" data-icon="flag"/><t t-out="this.currentFilterLabel"/>
                </button>
                <div class="dropdown-menu p-2">
                    <div class="dropdown-item o_cp_current_all" t-on-click.stop="() => this.clearCurrentFilters()">
                        <span t-att-class="'o_cp_check o_cp_' + (this.schedule.currentStages.length or this.schedule.onlyLate ? 'off' : 'on')"/>
                        Todos los ambientes
                    </div>
                    <div class="dropdown-item o_cp_only_late" t-on-click.stop="() => this.toggleOnlyLate()">
                        <span t-att-class="'o_cp_check o_cp_' + (this.schedule.onlyLate ? 'on' : 'off')"/>
                        Solo atrasados o en riesgo
                    </div>
                    <div class="dropdown-divider"/>
                    <t t-foreach="this.schedule.spaceStates" t-as="state" t-key="state.code">
                        <div class="dropdown-item d-flex align-items-center o_cp_current_node"
                             t-att-data-code="state.code"
                             t-on-click.stop="() => this.toggleCurrentStage(state.code)">
                            <span t-att-class="'o_cp_check o_cp_' + (this.schedule.currentStages.includes(state.code) ? 'on' : 'off')"/>
                            <span class="o_cp_dot" t-att-style="'background-color:' + state.color"/>
                            <t t-out="state.label"/>
                        </div>
                    </t>
                </div>
            </div>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-secondary"
                        t-att-class="this.schedule.showPanel ? 'active' : ''"
                        title="Recursos de la selección"
                        t-on-click="() => this.togglePanel()">
                    <i class="oi" data-icon="view_column"/>
                </button>
                <button t-if="this.showAmounts" type="button" class="btn btn-outline-secondary"
                        t-att-class="this.schedule.showLoad ? 'active' : ''"
                        title="Carga semanal por contrata y etapa"
                        t-on-click="() => this.toggleLoad()">
                    <i class="oi" data-icon="bar_chart"/>
                </button>
            </div>
        </div>
    </t>

    <t t-name="al_construction_planner.SchedulePanel">
        <!-- Panel ampliable (paquete 1.15, M115-03): borde que se arrastra,
             «Ampliar / Reducir» y «Pantalla completa». -->
        <div class="o_cp_panel_backdrop" t-if="this.schedule.showPanel and this.schedule.panelFull"
             t-on-click="() => this.togglePanelFull()"/>
        <aside class="o_cp_schedule_panel border-start p-2" t-if="this.schedule.showPanel"
               t-att-class="{'o_cp_panel_wide': this.panelWide, 'o_cp_panel_full': this.schedule.panelFull}"
               t-att-style="this.schedule.panelFull ? '' : 'width:' + this.schedule.panelWidth + 'px;flex-basis:' + this.schedule.panelWidth + 'px'">
            <div class="o_cp_panel_resizer" t-if="!this.schedule.panelFull"
                 title="Arrastre para cambiar el ancho; doble clic vuelve al ancho inicial"
                 t-on-mousedown="this.onPanelResizeStart" t-on-dblclick="() => this.resetPanelWidth()"/>
            <div class="o_cp_panel_body">
            <div class="d-flex align-items-center gap-1 mb-2">
                <h6 class="mb-0 me-auto">Recursos de la selección</h6>
                <button type="button" class="btn btn-sm btn-link p-0 o_cp_panel_expand" t-if="!this.schedule.panelFull"
                        t-on-click="() => this.togglePanelWide()">
                    <i class="oi me-1" t-att-data-icon="this.panelExpanded ? 'close_fullscreen' : 'expand_content'"/>
                    <t t-if="this.panelExpanded">Reducir</t><t t-else="">Ampliar</t>
                </button>
                <button type="button" class="btn btn-sm btn-link p-0 ms-2 o_cp_panel_fullscreen"
                        t-att-title="this.schedule.panelFull ? 'Cerrar' : 'Pantalla completa'"
                        t-on-click="() => this.togglePanelFull()">
                    <i class="oi" t-att-data-icon="this.schedule.panelFull ? 'close' : 'fullscreen'"/>
                    <span class="ms-1" t-if="this.schedule.panelFull">Cerrar</span>
                </button>
            </div>
            <p class="text-muted small" t-if="!this.schedule.planId">
                La obra no tiene plan de recursos: genérelo para ver sus etapas.
            </p>
            <p class="text-muted small" t-elif="!this.schedule.summary">
                Marque pisos, ambientes o etapas en la primera columna.
            </p>
            <t t-else="">
                <div class="o_cp_schedule_summary small mb-2">
                    <div><span class="o_cp_summary_modules" t-out="this.schedule.summary.modules"/>
                        <t t-out="this.schedule.terms.details.toLowerCase()"/>
                        <t t-if="this.schedule.terms.show_ml"> · <t t-out="this.schedule.summary.ml"/> ML</t></div>
                    <div t-if="this.showAmounts">Material S/ <t t-out="this.fmt(this.schedule.summary.material)"/> ·
                        contrata S/ <t t-out="this.fmt(this.schedule.summary.contract)"/></div>
                    <div>Avance <t t-out="this.pct(this.schedule.summary.progress)"/></div>
                </div>
                <div class="d-flex justify-content-end">
                    <button class="btn btn-link btn-sm p-0 o_cp_panel_by_stage" t-on-click="() => this.togglePanelByStage()">
                        <t t-if="this.schedule.panelByStage">Sin etapas</t><t t-else="">Por etapa</t>
                    </button>
                </div>
                <!-- Por tipo de recurso con subtotales (v1.8, M18-03). -->
                <table class="table table-sm o_cp_schedule_resources mb-0">
                    <thead>
                        <tr>
                            <th>Recurso</th>
                            <th t-if="this.panelWide" class="o_cp_col_partner">Contrata o proveedor</th>
                            <th t-if="this.panelWide" class="text-end o_cp_col_qty">Plan</th>
                            <th t-if="this.showAmounts" class="text-end">Plan S/</th>
                            <th t-if="this.panelWide and this.showAmounts" class="text-end o_cp_col_executed">Ejecutado S/</th>
                            <th t-if="this.panelWide and this.showAmounts" class="text-end o_cp_col_balance">Saldo S/</th>
                            <th class="text-end">Avance</th>
                        </tr>
                    </thead>
                    <t t-foreach="this.schedule.summary.groups" t-as="group" t-key="group.type_id or group_index">
                        <tbody class="o_cp_panel_group" t-att-data-type="group.resource_type">
                            <tr class="table-light fw-bold o_cp_panel_group_row">
                                <td t-att-colspan="this.panelWide ? 3 : 1"><t t-out="group.name"/>
                                    <span class="text-muted small fw-normal"> · <t t-out="this.fmt(group.qty)"/></span></td>
                                <td t-if="this.showAmounts" class="text-end o_cp_panel_group_total" t-out="this.fmt(group.amount)"/>
                                <td t-if="this.panelWide and this.showAmounts" colspan="2"/>
                                <td/>
                            </tr>
                            <t t-if="this.schedule.panelByStage">
                                <t t-foreach="group.stages" t-as="stage" t-key="stage.stage or stage_index">
                                    <tr class="fw-bold text-muted">
                                        <td class="ps-2" t-att-colspan="this.panelWide ? 3 : 1" t-out="stage.label"/>
                                        <td t-if="this.showAmounts" class="text-end" t-out="this.fmt(stage.amount)"/>
                                        <td t-if="this.panelWide and this.showAmounts" colspan="2"/>
                                        <td/>
                                    </tr>
                                    <t t-foreach="stage.resources" t-as="resource" t-key="resource_index">
                                        <t t-set="indent" t-value="'ps-3'"/>
                                        <t t-call="al_construction_planner.SchedulePanelRow"/>
                                    </t>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-foreach="group.resources" t-as="resource" t-key="resource_index">
                                    <t t-set="indent" t-value="'ps-2'"/>
                                    <t t-call="al_construction_planner.SchedulePanelRow"/>
                                </t>
                            </t>
                        </tbody>
                    </t>
                    <tfoot>
                        <tr>
                            <th t-att-colspan="this.panelWide ? 3 : 1">Total de la selección</th>
                            <th t-if="this.showAmounts" class="text-end o_cp_schedule_total" t-out="this.fmt(this.schedule.summary.total)"/>
                            <th t-if="this.panelWide and this.showAmounts" colspan="2"/>
                            <th/>
                        </tr>
                    </tfoot>
                </table>
            </t>
            </div>
        </aside>
    </t>

    <t t-name="al_construction_planner.SchedulePanelRow">
        <tr>
            <td t-att-class="indent + ' o_cp_wrap_names'">
                <div t-out="resource.name"/>
                <div class="text-muted small" t-if="resource.partners and !this.panelWide" t-out="resource.partners"/>
            </td>
            <td t-if="this.panelWide" class="small o_cp_col_partner o_cp_wrap_names" t-out="resource.partners or '—'"/>
            <td t-if="this.panelWide" class="text-end text-nowrap o_cp_col_qty">
                <t t-out="this.fmt(resource.qty)"/> <span class="text-muted small" t-out="resource.uom"/>
            </td>
            <td t-if="this.showAmounts" class="text-end" t-out="this.fmt(resource.amount)"/>
            <td t-if="this.panelWide and this.showAmounts" class="text-end o_cp_col_executed"
                t-out="resource.amount_executed === false ? '—' : this.fmt(resource.amount_executed)"/>
            <td t-if="this.panelWide and this.showAmounts" class="text-end o_cp_col_balance"
                t-out="resource.amount_balance === false ? '—' : this.fmt(resource.amount_balance)"/>
            <td class="text-end" t-out="this.resourceProgress(resource)"/>
        </tr>
    </t>

    <t t-name="al_construction_planner.ScheduleLoad">
        <!-- Carga semanal (paquete 1.15, M115-06, con M116-07): semanas de la
             obra, días hábiles de la compañía y plan frente a ejecutado. -->
        <div class="o_cp_schedule_load border-top" t-if="this.schedule.showLoad and this.schedule.load">
            <t t-set="load" t-value="this.schedule.load"/>
            <div class="d-flex flex-wrap align-items-baseline gap-2 px-2 pt-1">
                <span class="fw-bold o_cp_load_title">¿Cuánto hay que pagar cada semana a contratas y personal propio, y cuánto se ejecutó?</span>
                <div class="btn-group btn-group-sm ms-auto o_cp_load_modes" role="group">
                    <button type="button" class="btn btn-outline-secondary" data-mode="planned"
                            t-att-class="this.schedule.loadMode === 'planned' ? 'active' : ''"
                            t-on-click="() => this.setLoadMode('planned')">Planificado</button>
                    <button type="button" class="btn btn-outline-secondary" data-mode="executed"
                            t-att-class="this.schedule.loadMode === 'executed' ? 'active' : ''"
                            t-on-click="() => this.setLoadMode('executed')">Ejecutado</button>
                    <button type="button" class="btn btn-outline-secondary" data-mode="compare"
                            t-att-class="this.schedule.loadMode === 'compare' ? 'active' : ''"
                            t-on-click="() => this.setLoadMode('compare')">Plan vs ejecutado</button>
                </div>
            </div>
            <div class="text-muted small px-2 mb-1">
                Soles por etapa y por quién la hace. Planificado: el monto de cada etapa repartido
                entre sus días hábiles. Ejecutado: los avances validados por su fecha. En «Plan vs
                ejecutado», hasta la semana actual: ejecutado arriba y «de» lo planificado abajo, en
                <span class="o_cp_load_good">verde</span> desde <t t-out="load.thresholds.green"/> %,
                <span class="o_cp_load_warn">ámbar</span> desde <t t-out="load.thresholds.amber"/> % y
                <span class="o_cp_load_bad">rojo</span> debajo; las semanas futuras, solo lo planificado.
            </div>
            <p class="text-muted small px-2 mb-1" t-if="!load.rows.length">
                Sin montos de contratas ni personal propio en las etapas del cronograma.
            </p>
            <div class="table-responsive" t-else="">
                <table class="table table-sm mb-0 o_cp_load_table">
                    <thead>
                        <tr>
                            <th>Etapa · quién la hace</th>
                            <t t-foreach="load.weeks" t-as="week" t-key="week">
                                <th class="text-end" t-att-class="week_index === load.current_week ? 'o_cp_load_current' : ''"
                                    t-out="this.weekRange(week_index)"/>
                            </t>
                            <th class="text-end">Plan total</th>
                            <th class="text-end">Plan a la fecha</th>
                            <th class="text-end">Ejecutado</th>
                            <th class="text-end">% a la fecha</th>
                        </tr>
                    </thead>
                    <t t-foreach="load.groups" t-as="group" t-key="group.stage">
                        <tbody class="o_cp_load_group" t-att-data-stage="group.stage">
                            <tr class="fw-bold o_cp_load_group_row">
                                <td>
                                    <span class="o_cp_dot" t-att-style="'background-color:' + group.color"/>
                                    <t t-out="group.stage_label"/>
                                </td>
                                <t t-set="item" t-value="group"/>
                                <t t-call="al_construction_planner.ScheduleLoadCells"/>
                            </tr>
                            <t t-foreach="group.rows" t-as="row" t-key="row_index">
                                <tr class="o_cp_load_row">
                                    <td class="ps-3">
                                        <span t-if="row.unassigned" class="badge text-bg-warning o_cp_load_unassigned" t-out="row.label"/>
                                        <t t-else="" t-out="row.label"/>
                                    </td>
                                    <t t-set="item" t-value="row"/>
                                    <t t-call="al_construction_planner.ScheduleLoadCells"/>
                                </tr>
                            </t>
                        </tbody>
                    </t>
                    <tfoot>
                        <tr class="fw-bold">
                            <th>Total</th>
                            <t t-set="item" t-value="this.loadTotals"/>
                            <t t-call="al_construction_planner.ScheduleLoadCells"/>
                        </tr>
                        <tr class="o_cp_load_diff">
                            <th>Diferencia ejecutado − plan</th>
                            <t t-foreach="load.diff" t-as="value" t-key="value_index">
                                <td class="text-end" t-att-class="value === false ? '' : (value &lt; 0 ? 'o_cp_load_bad' : 'o_cp_load_good')"
                                    t-out="value === false ? '' : this.fmt0(value)"/>
                            </t>
                            <td/>
                            <td/>
                            <td class="text-end" t-out="this.fmt0(load.executed_total - load.plan_to_date)"/>
                            <td/>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </t>

    <t t-name="al_construction_planner.ScheduleLoadCells">
        <t t-foreach="load.weeks" t-as="week" t-key="week">
            <t t-set="past" t-value="load.diff[week_index] !== false"/>
            <t t-set="planned" t-value="item.values[week_index]"/>
            <t t-set="done" t-value="item.executed[week_index]"/>
            <td class="text-end" t-att-class="week_index === load.current_week ? 'o_cp_load_current' : ''">
                <t t-if="this.schedule.loadMode === 'planned'"><t t-out="planned ? this.fmt0(planned) : '—'"/></t>
                <t t-elif="this.schedule.loadMode === 'executed'"><t t-out="done ? this.fmt0(done) : '—'"/></t>
                <t t-elif="past">
                    <div t-att-class="this.loadClass(done, planned)" t-out="done ? this.fmt0(done) : (planned ? '0' : '—')"/>
                    <div class="text-muted small" t-if="planned">de <t t-out="this.fmt0(planned)"/> · <t t-out="this.loadPct(done, planned)"/></div>
                </t>
                <t t-else=""><span class="text-muted" t-out="planned ? this.fmt0(planned) : '—'"/></t>
            </td>
        </t>
        <td class="text-end" t-out="this.fmt0(item.total)"/>
        <td class="text-end" t-out="this.fmt0(item.plan_to_date)"/>
        <td class="text-end" t-out="this.fmt0(item.executed_total)"/>
        <td class="text-end" t-att-class="item.pct === false ? '' : this.loadClass(item.executed_total, item.plan_to_date)"
            t-out="item.pct === false ? '—' : Math.round(item.pct) + ' %'"/>
    </t>

</templates>
