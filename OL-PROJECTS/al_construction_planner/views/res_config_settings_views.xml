<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_construction_planner" model="ir.ui.view">
        <field name="name">res.config.settings.form.construction.planner</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="65"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Planificación de obra" string="Planificación de obra"
                     name="al_construction_planner"
                     groups="al_construction_planner.group_planner_manager">
                    <block title="Perfil de vertical" name="construction_planner_profile"
                           help="El rubro de la compañía deja configurado el planificador completo: niveles, etapas, recursos, funciones, puentes y parámetros. Después todo se puede ajustar.">
                        <setting id="construction_profile" help="Aplicarlo deja su plantilla de niveles para las obras nuevas.">
                            <field name="construction_profile_id" options="{'no_create': True}"/>
                            <div class="mt-2">
                                <button name="action_construction_apply_profile" type="object"
                                        string="Aplicar el perfil" icon="east" class="btn-link"
                                        invisible="not construction_profile_id"/>
                            </div>
                        </setting>
                        <setting id="construction_level_template" help="La que reciben las obras nuevas. Vacía: piso › departamento › ambiente › módulo.">
                            <field name="construction_level_template_id" options="{'no_create': True}"/>
                        </setting>
                    </block>
                    <!-- Funciones (v1.7, M17-06): cada puente se instala al activarlo. -->
                    <block title="Entradas a la ejecución" name="construction_planner_execution_entries"
                           help="Las dos entradas llaman a los mismos asistentes; cada empresa deja activa la que le sirva, o las dos. Apagar una no borra datos.">
                        <setting id="construction_exec_planner" help="Menús ordenados por momento (planificar, ejecutar, controlar y cobrar), tablero de obra y tarea de obra con su menú Ejecutar.">
                            <field name="group_construction_exec_planner"/>
                        </setting>
                        <setting id="construction_exec_project" help="Sección Obra en el tablero del proyecto y menú Ejecutar en la tarea de Proyectos.">
                            <field name="group_construction_exec_project"/>
                        </setting>
                    </block>
                    <block title="Funciones" name="construction_planner_features"
                           help="Siempre activos: Proyectos, la planificación (árbol, plan de recursos y línea base) y el cronograma. Lo que no se activa no se instala.">
                        <setting id="construction_feature_control" help="Comprometido, real, saldo y desvío por nivel, etapa y tipo de recurso.">
                            <field name="group_construction_control"/>
                        </setting>
                        <setting id="construction_feature_progress" help="Avance por el driver de cada partida, contrata o actividad, con fotos y validación.">
                            <field name="group_construction_progress"/>
                        </setting>
                        <setting id="construction_feature_measurement" help="Metrado del mueble: medida del espacio, diseño y despiece frente a lo planificado (vertical Mobiliario).">
                            <field name="group_construction_measurement"/>
                        </setting>
                        <setting id="construction_feature_subcontract" help="OC de servicio de la contrata, liquidación semanal y portal (Compras).">
                            <field name="module_al_construction_planner_subcontract"/>
                        </setting>
                        <setting id="construction_feature_purchase" help="Compra masiva, requerimientos de obra, abastecimiento, precios de compra y material extra.">
                            <field name="module_al_construction_planner_purchase"/>
                        </setting>
                        <setting id="construction_feature_crew" help="Turnos de Planificación y horas de la hoja de horas como real.">
                            <field name="module_al_construction_planner_crew"/>
                        </setting>
                        <setting id="construction_feature_budget" help="Presupuesto analítico al aprobar y control de la OC contra él.">
                            <field name="module_al_construction_planner_budget"/>
                        </setting>
                        <setting id="construction_feature_sale" help="Calendario e ingresos, contratos, entrega semanal, valorización y cronograma valorizado (Ventas).">
                            <field name="module_al_construction_planner_sale"/>
                        </setting>
                        <setting id="construction_feature_mrp" help="Órdenes de fabricación desde el plan (Fabricación).">
                            <field name="module_al_construction_planner_mrp"/>
                        </setting>
                        <setting id="construction_feature_furniture" help="Tipologías de mueble, metros lineales, módulos e importación del ETO.">
                            <field name="module_al_construction_planner_furniture"/>
                        </setting>
                    </block>
                    <block title="Obra" name="construction_planner_contracts">
                        <setting company_dependent="1" id="construction_week_days" string="Semana de liquidación"
                                 help="Valores por defecto de las obras nuevas; cada obra puede cambiarlos. Si el día de liquidación o de pago es feriado del calendario de la compañía, se corre al día hábil anterior.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="construction_week_start_day" class="col-lg-5 o_light_label"/>
                                    <field name="construction_week_start_day"/>
                                </div>
                                <div class="row">
                                    <label for="construction_settlement_day" class="col-lg-5 o_light_label"/>
                                    <field name="construction_settlement_day"/>
                                </div>
                                <div class="row">
                                    <label for="construction_payment_day" class="col-lg-5 o_light_label"/>
                                    <field name="construction_payment_day"/>
                                </div>
                            </div>
                        </setting>
                        <setting company_dependent="1" id="construction_plan_cancel_open" string="Cancelar planes en ejecución"
                                 help="Permite cancelar un plan aprobado o en ejecución que no tenga documentos abiertos (compras, requerimientos, OF, OC de servicio) ni despachos o consumos.">
                            <field name="construction_plan_cancel_open"/>
                            <div class="content-group" invisible="not construction_plan_cancel_open">
                                <div class="row mt-2">
                                    <label for="construction_plan_cancel_group_id" class="col-lg-5 o_light_label"/>
                                    <field name="construction_plan_cancel_group_id" options="{'no_create': True}"/>
                                </div>
                            </div>
                        </setting>
                        <setting company_dependent="1" id="construction_exceed_policy" string="Control de consumo"
                                 help="Política por defecto de las obras nuevas (la heredan sus planes) cuando un documento pide más de lo que queda en el plan o repite lo ya pedido de un nivel y sub etapa. Por tipo de recurso, vacía es la general.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="construction_exceed_policy" class="col-lg-5 o_light_label"/>
                                    <field name="construction_exceed_policy"/>
                                </div>
                                <div class="row">
                                    <label for="construction_exceed_tolerance" class="col-lg-5 o_light_label"/>
                                    <field name="construction_exceed_tolerance"/>
                                </div>
                                <div class="row">
                                    <label for="construction_exceed_policy_material" class="col-lg-5 o_light_label"/>
                                    <field name="construction_exceed_policy_material"/>
                                </div>
                                <div class="row">
                                    <label for="construction_exceed_policy_contract" class="col-lg-5 o_light_label"/>
                                    <field name="construction_exceed_policy_contract"/>
                                </div>
                                <div class="row">
                                    <label for="construction_exceed_policy_labor" class="col-lg-5 o_light_label"/>
                                    <field name="construction_exceed_policy_labor"/>
                                </div>
                                <div class="row">
                                    <label for="construction_exceed_policy_production" class="col-lg-5 o_light_label"/>
                                    <field name="construction_exceed_policy_production"/>
                                </div>
                            </div>
                        </setting>
                        <setting company_dependent="1" id="construction_service_categories" string="Categorías de los servicios"
                                 help="Categorías de los productos de servicio de las actividades: su modelo de distribución analítica pone la etapa.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="construction_categ_assembly_id" class="col-lg-5 o_light_label"/>
                                    <field name="construction_categ_assembly_id" options="{'no_create': True}"/>
                                </div>
                                <div class="row">
                                    <label for="construction_categ_installation_id" class="col-lg-5 o_light_label"/>
                                    <field name="construction_categ_installation_id" options="{'no_create': True}"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_construction_planner_settings" model="ir.actions.act_window">
        <field name="name">Ajustes</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'al_construction_planner', 'bin_size': False}</field>
    </record>

</odoo>
