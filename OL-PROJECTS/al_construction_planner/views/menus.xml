<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- La acción por defecto es el inicio (P-01): obras y pendientes de hoy. -->
    <menuitem id="menu_planner_root" name="Planificación de obra" web_icon="al_construction_planner,static/description/icon.png" action="action_construction_planner_home" groups="group_planner_progress" sequence="46"/>

    <!-- Organización como la app Contabilidad: pocos menús principales,
         secciones (encabezados del desplegable) y acciones; sin cuarto
         nivel, que el desplegable de Odoo no muestra.
           10 Obras           obras, plan de recursos, cronograma
           20 Ejecución       avance y contratas
           30 Abastecimiento
           40 Ingresos
           60 Informes        plan, cronograma valorizado, compras
           90 Configuración -->

    <menuitem id="menu_planner_works" name="Obras" parent="menu_planner_root" sequence="10">
        <menuitem id="menu_planner_works_main" name="Obras y tareas" sequence="10">
            <menuitem id="menu_planner_home" name="Inicio" action="action_construction_planner_home" sequence="1"/>
            <menuitem id="menu_planner_sites" name="Obras" action="action_planner_construction_sites" sequence="10" groups="group_planner_plan_viewer,group_planner_progress"/>
            <menuitem id="menu_planner_tree" name="Tareas de la obra" action="action_construction_tree" sequence="20"/>
        </menuitem>
        <menuitem id="menu_planner_plan_section" name="Plan de recursos" sequence="20">
            <menuitem id="menu_planner_plans" name="Planes de recursos" action="action_construction_resource_plan" sequence="10"/>
            <menuitem id="menu_planner_plan_tree" name="Árbol de recursos" action="action_construction_plan_tree" sequence="20"/>
            <menuitem id="menu_planner_lines" name="Recursos planificados" action="action_construction_resource_plan_line" sequence="30" groups="group_planner_plan_viewer"/>
        </menuitem>
        <!-- Cronograma de la obra y el Gantt de todos los proyectos: con el
             planificador instalado, la aplicación «Gantt» se oculta
             (models/ir_ui_menu.py) y se llega a él desde aquí. -->
        <menuitem id="menu_planner_schedule_root" name="Cronograma" sequence="30" groups="group_planner_user,al_project_gantt_base.group_gantt_user">
            <menuitem id="menu_planner_schedule" name="Cronograma de la obra" action="action_construction_schedule" sequence="10" groups="group_planner_user"/>
            <menuitem id="menu_planner_space_stages" name="Etapas del cronograma" action="action_construction_space_stage" sequence="20" groups="group_planner_plan_viewer"/>
            <menuitem id="menu_planner_gantt" name="Gantt de proyectos" action="al_project_gantt_backend.action_gantt_backend" sequence="30" groups="al_project_gantt_base.group_gantt_user"/>
        </menuitem>
    </menuitem>

    <menuitem id="menu_planner_execution" name="Ejecución" parent="menu_planner_root" sequence="20">
        <menuitem id="menu_planner_progress" name="Avance" groups="group_planner_feature_progress" sequence="10">
            <menuitem id="menu_planner_progress_register" name="Registrar avance" action="action_plan_progress_wizard" sequence="10"/>
            <menuitem id="menu_planner_progress_to_validate" name="Avances por validar" action="action_construction_progress_to_validate" sequence="20"/>
            <menuitem id="menu_planner_progress_all" name="Avances" action="action_construction_progress" sequence="30"/>
            <!-- Metrado: solo con la función «Metrado» (vertical Mobiliario, M18-01). -->
            <menuitem id="menu_planner_measurements" name="Metrados anteriores" action="action_construction_measurement" sequence="40" groups="group_planner_feature_measurement"/>
            <menuitem id="menu_planner_measurement_lines" name="Cargar medidas" action="action_construction_measurement_line" sequence="45" groups="group_planner_feature_measurement"/>
            <menuitem id="menu_planner_measurement_generate" name="Generar metrados" action="action_construction_measurement_generate_wizard" sequence="50" groups="-al_construction_planner.group_planner_user,group_planner_feature_measurement"/>
        </menuitem>
        <menuitem id="menu_planner_contracts" name="Contratas" sequence="20">
            </menuitem>
        <menuitem id="menu_planner_changes" name="Cambios" sequence="25">
            <menuitem id="menu_planner_dependencies" name="Dependencias de terceros" action="action_construction_dependency" sequence="20"/>
        </menuitem>
    </menuitem>

    <menuitem id="menu_planner_supply" name="Abastecimiento" parent="menu_planner_root" sequence="30" groups="group_planner_user">
        <menuitem id="menu_planner_allocations" name="Asignaciones del plan" action="action_construction_resource_plan_allocation" sequence="40"/>
    </menuitem>

    <menuitem id="menu_planner_reports" name="Informes" parent="menu_planner_root" sequence="60" groups="group_planner_plan_viewer,group_planner_revenue">
        <menuitem id="menu_planner_reports_plan" name="Plan" sequence="10" groups="group_planner_plan_viewer">
            <menuitem id="menu_planner_analysis" name="Análisis del plan" action="action_construction_resource_plan_line_analysis" sequence="10"/>
            <menuitem id="menu_planner_control" name="Control de saldo" action="action_construction_plan_control" groups="group_planner_feature_control" sequence="20"/>
            <menuitem id="menu_planner_exceed_logs" name="Excesos autorizados" action="action_construction_exceed_log" groups="group_planner_feature_control" sequence="25"/>
        </menuitem>
        </menuitem>

    <menuitem id="menu_planner_config" name="Configuración" parent="menu_planner_root" sequence="90" groups="group_planner_plan_planner">
        <menuitem id="menu_planner_settings" name="Ajustes" action="action_construction_planner_settings" sequence="5" groups="group_planner_manager"/>
        <menuitem id="menu_planner_config_plan" name="Plan de obra" sequence="10">
            <menuitem id="menu_planner_profiles" name="Perfiles de vertical" action="action_construction_vertical_profile" sequence="1" groups="group_planner_manager"/>
            <menuitem id="menu_planner_profile_import" name="Importar perfil" action="action_construction_profile_import_wizard" sequence="2" groups="group_planner_manager"/>
            <menuitem id="menu_planner_level_templates" name="Plantillas de niveles" action="action_construction_level_template" sequence="5" groups="group_planner_manager"/>
            <menuitem id="menu_planner_stages" name="Etapas" action="action_construction_stage" sequence="6" groups="group_planner_manager"/>
            <menuitem id="menu_planner_resource_types" name="Tipos de recurso" action="action_construction_resource_type" sequence="7" groups="group_planner_manager"/>
            <menuitem id="menu_planner_recipes" name="Recetas" action="action_construction_execution_template" sequence="9"/>
            <menuitem id="menu_planner_activities" name="Actividades de obra" action="action_construction_labor_activity" sequence="20"/>
            <menuitem id="menu_planner_rates" name="Tarifas de contrata" action="action_construction_labor_rate" sequence="30" groups="group_planner_manager"/>
            <menuitem id="menu_planner_analytic_rules" name="Reglas analíticas" action="action_construction_analytic_rule" sequence="35" groups="group_planner_manager"/>
            <menuitem id="menu_planner_recipe_import" name="Importar recetas y niveles" action="action_construction_recipe_import_wizard" sequence="45"/>
        </menuitem>
        <menuitem id="menu_planner_config_other" name="Aprobaciones y Gantt" sequence="20">
            <menuitem id="menu_planner_tier_definitions" name="Reglas de aprobación" action="action_construction_plan_tier_definition" sequence="10" groups="group_planner_manager"/>
            <menuitem id="menu_planner_gantt_colors" name="Colores del Gantt" action="al_project_gantt_base.al_gantt_state_color_action" sequence="20" groups="al_project_gantt_base.group_gantt_manager"/>
        </menuitem>
    </menuitem>

</odoo>