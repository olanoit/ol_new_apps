<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plantillas de hitos de cobro -->
    <record id="view_construction_milestone_template_list" model="ir.ui.view">
        <field name="name">construction.milestone.template.list</field>
        <field name="model">construction.milestone.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="summary"/>
            </list>
        </field>
    </record>

    <record id="view_construction_milestone_template_form" model="ir.ui.view">
        <field name="name">construction.milestone.template.form</field>
        <field name="model">construction.milestone.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="p. ej. Estructura 80 / Acabados 15 / Entrega 5"/></h1>
                    </div>
                    <group>
                        <field name="total_pct"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="pct" sum="Total"/>
                            <field name="trigger"/>
                            <field name="stage" invisible="trigger != 'stage_done'"
                                   required="trigger == 'stage_done'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_milestone_template" model="ir.actions.act_window">
        <field name="name">Plantillas de hitos de cobro</field>
        <field name="res_model">construction.milestone.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Contrato de obra (P-30) -->
    <record id="view_construction_contract_list" model="ir.ui.view">
        <field name="name">construction.contract.list</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('closed', 'cancel')">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="scope"/>
                <field name="currency_id" optional="show"/>
                <field name="unit_count"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_billed" sum="Cobrado"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_construction_contract_form" model="ir.ui.view">
        <field name="name">construction.contract.form</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activar" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_open_unit_wizard" type="object" string="Marcar unidades"
                            invisible="state in ('closed', 'cancel')"/>
                    <button name="action_generate_milestones" type="object" string="Generar hitos"
                            invisible="state in ('closed', 'cancel')"/>
                    <button name="action_prepare_valuation" type="object" string="Valorizar hitos"
                            class="btn-primary" invisible="state != 'active'"/>
                    <button name="action_close" type="object" string="Cerrar" invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Anular"
                            invisible="state not in ('draft', 'active')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_milestones" type="object" class="oe_stat_button"
                                icon="fa-flag-checkered">
                            <field name="milestone_count" widget="statinfo" string="Hitos"/>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not term_conflicts">
                        <strong>Diferencias entre documentos:</strong> <field name="term_conflicts" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="p. ej. Instalación de cocinas (soles)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="sale_order_id" options="{'no_create': True}"/>
                            <field name="currency_id" options="{'no_create': True}"/>
                            <field name="scope"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="milestone_template_id" options="{'no_create': True}"/>
                            <field name="discount_factor"/>
                            <field name="unit_count"/>
                            <field name="amount_total"/>
                            <field name="amount_earned"/>
                            <field name="amount_billed"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Precios por tipología" name="prices">
                            <field name="price_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="typology_id" options="{'no_create': True}"/>
                                    <field name="unit_price"/>
                                    <field name="sale_line_id" options="{'no_create': True}"/>
                                    <field name="milestone_template_id" options="{'no_create': True}"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Condiciones" name="conditions">
                            <group>
                                <group string="Adelanto y garantías">
                                    <field name="advance_pct"/>
                                    <field name="advance_bond"/>
                                    <field name="guarantee_pct"/>
                                    <field name="guarantee_base"/>
                                    <field name="performance_bond_pct"/>
                                    <field name="detraction_pct"/>
                                </group>
                                <group string="Valorización y penalidades">
                                    <field name="valuation_frequency"/>
                                    <field name="penalty_daily_pct"/>
                                    <field name="penalty_cap_pct"/>
                                </group>
                            </group>
                            <field name="term_conflicts" placeholder="Lo que dicen distinto la cotización, la orden y el contrato…"/>
                        </page>
                        <page string="Unidades cubiertas" name="units">
                            <field name="typology_ids" widget="many2many_tags" options="{'no_create': True}"
                                   placeholder="Todas las tipologías"/>
                            <field name="task_ids" options="{'no_create': True}">
                                <list>
                                    <field name="construction_floor_task_id"/>
                                    <field name="name"/>
                                    <field name="construction_unit_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documentos" name="documents">
                            <field name="document_ids">
                                <list editable="bottom" decoration-danger="required and not received">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="required"/>
                                    <field name="received"/>
                                    <field name="date_received"/>
                                    <field name="source" optional="show"/>
                                    <field name="attachment_ids" widget="many2many_binary" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_contract_search" model="ir.ui.view">
        <field name="name">construction.contract.search</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <filter string="Vigentes" name="active_contracts" domain="[('state', '=', 'active')]"/>
                <group>
                    <filter string="Obra" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Alcance" name="group_scope" context="{'group_by': 'scope'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_contract" model="ir.actions.act_window">
        <field name="name">Contratos de obra</field>
        <field name="res_model">construction.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre el contrato de la obra</p>
            <p>Cliente, moneda, unidades que cubre, condiciones y hitos de cobro. Una obra puede
               tener varios: suministro e instalación, uno por familia o por parte del edificio.</p>
        </field>
    </record>

    <!-- Hitos por unidad -->
    <record id="view_construction_unit_milestone_list" model="ir.ui.view">
        <field name="name">construction.unit.milestone.list</field>
        <field name="model">construction.unit.milestone</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false">
                <field name="contract_id" optional="hide"/>
                <field name="task_id" readonly="1"/>
                <field name="typology_id" readonly="1"/>
                <field name="template_line_id" readonly="1"/>
                <field name="trigger"/>
                <field name="pct"/>
                <field name="amount" sum="Total" readonly="1"/>
                <field name="manual_pct" readonly="trigger not in ('after_sales', 'manual')"/>
                <field name="progress_pct" widget="progressbar"/>
                <field name="billed_pct" widget="progressbar"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_construction_unit_milestone_pivot" model="ir.ui.view">
        <field name="name">construction.unit.milestone.pivot</field>
        <field name="model">construction.unit.milestone</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="template_line_id" type="col"/>
                <field name="typology_id" type="row"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_construction_unit_milestone_search" model="ir.ui.view">
        <field name="name">construction.unit.milestone.search</field>
        <field name="model">construction.unit.milestone</field>
        <field name="arch" type="xml">
            <search>
                <field name="task_id"/>
                <field name="contract_id"/>
                <field name="template_line_id"/>
                <filter string="Manuales" name="manual" domain="[('trigger', 'in', ('after_sales', 'manual'))]"/>
                <group>
                    <filter string="Hito" name="group_template" context="{'group_by': 'template_line_id'}"/>
                    <filter string="Unidad" name="group_unit" context="{'group_by': 'task_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_unit_milestone" model="ir.actions.act_window">
        <field name="name">Hitos por unidad</field>
        <field name="res_model">construction.unit.milestone</field>
        <field name="view_mode">list,pivot</field>
    </record>

    <!-- Marcar unidades -->
    <record id="view_construction_contract_unit_wizard_form" model="ir.ui.view">
        <field name="name">construction.contract.unit.wizard.form</field>
        <field name="model">construction.contract.unit.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="contract_id" invisible="1"/>
                    <field name="project_id" invisible="1"/>
                    <field name="mode" widget="radio"/>
                    <field name="group_ids" widget="many2many_tags" invisible="mode != 'groups'"
                           options="{'no_create': True}"/>
                    <field name="task_ids" widget="many2many_tags" invisible="mode != 'list'"
                           options="{'no_create': True}"/>
                    <field name="replace"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Marcar" class="btn-primary"/>
                    <button string="Descartar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Valorización: contrato y detalle por hito -->
    <record id="view_construction_valuation_form_contract" model="ir.ui.view">
        <field name="name">construction.valuation.form.contract</field>
        <field name="model">construction.valuation</field>
        <field name="inherit_id" ref="al_construction_planner.construction_valuation_view_form"/>
        <field name="arch" type="xml">
            <field name="sale_order_id" position="before">
                <field name="contract_id" readonly="1" invisible="not contract_id"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Hitos" name="milestones" invisible="not milestone_line_ids">
                    <field name="milestone_line_ids" readonly="1">
                        <list>
                            <field name="task_id"/>
                            <field name="template_line_id"/>
                            <field name="pct_before"/>
                            <field name="pct_now"/>
                            <field name="amount" sum="Total"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
