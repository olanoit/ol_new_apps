<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_level_template_list" model="ir.ui.view">
        <field name="name">construction.level.template.list</field>
        <field name="model">construction.level.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="summary"/>
            </list>
        </field>
    </record>

    <record id="view_construction_level_template_form" model="ir.ui.view">
        <field name="name">construction.level.template.form</field>
        <field name="model">construction.level.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="p. ej. Edificio con torres"/></h1>
                    </div>
                    <group>
                        <field name="summary"/>
                        <field name="purchase_destination"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="role"/>
                            <field name="has_stages" optional="show"/>
                            <field name="has_recipe" optional="show"/>
                            <field name="is_measured" optional="show"/>
                            <field name="measure_uom_id" optional="show"
                                   invisible="not is_measured" options="{'no_create': True}"/>
                            <field name="is_billable" optional="show"/>
                            <field name="receives_progress" optional="show"/>
                            <field name="is_delivery_unit" optional="hide"/>
                            <field name="stage_ids" widget="many2many_tags" optional="show"
                                   invisible="not has_stages" options="{'no_create': True}"/>
                            <field name="level" optional="hide"/>
                        </list>
                    </field>
                    <p class="text-muted">
                        Un solo nivel con etapas (ambiente, partida, spool), que es el que
                        programa el cronograma. La unidad de entrega, el subnivel y el nivel de
                        detalle son opcionales y van en ese orden; los agrupadores (torre, piso,
                        disciplina, área…) van arriba y el último es el que agrupa las unidades.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_level_template" model="ir.actions.act_window">
        <field name="name">Plantillas de niveles</field>
        <field name="res_model">construction.level.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree una plantilla de niveles</p>
            <p>Los niveles del árbol de la obra con su nombre y su comportamiento: Torre › Piso ›
               Departamento › Ambiente › Mueble › Módulo en mobiliario, Disciplina › Subpartida ›
               Partida › Actividad en una constructora.</p>
        </field>
    </record>
</odoo>
