<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Precios de compra: una fila por línea de OC confirmada (vista SQL) -->
    <record id="construction_purchase_price_report_view_list" model="ir.ui.view">
        <field name="name">construction.purchase.price.report.list</field>
        <field name="model">construction.purchase.price.report</field>
        <field name="arch" type="xml">
            <list string="Compras confirmadas" create="0" edit="0" delete="0">
                <field name="date_approve"/>
                <field name="week_start" optional="hide"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_id" optional="show"/>
                <field name="qty" sum="Total"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
                <field name="currency_id" optional="show"/>
                <field name="price_unit_currency" optional="show"/>
                <field name="currency_rate" optional="show"/>
                <field name="price_unit"/>
                <field name="amount" sum="Total"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="construction_purchase_price_report_view_pivot" model="ir.ui.view">
        <field name="name">construction.purchase.price.report.pivot</field>
        <field name="model">construction.purchase.price.report</field>
        <field name="arch" type="xml">
            <pivot string="Precios de compra" sample="1">
                <field name="product_id" type="row"/>
                <field name="month" interval="month" type="col"/>
                <field name="qty" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="construction_purchase_price_report_view_graph" model="ir.ui.view">
        <field name="name">construction.purchase.price.report.graph</field>
        <field name="model">construction.purchase.price.report</field>
        <field name="arch" type="xml">
            <graph string="Precios de compra" type="line" sample="1">
                <field name="week_start" interval="week"/>
                <field name="price_unit" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="construction_purchase_price_report_view_search" model="ir.ui.view">
        <field name="name">construction.purchase.price.report.search</field>
        <field name="model">construction.purchase.price.report</field>
        <field name="arch" type="xml">
            <search string="Precios de compra">
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="categ_id"/>
                <field name="order_id"/>
                <filter string="Últimos 6 meses" name="last_6m"
                        domain="[('date_approve', '>=', (context_today() - relativedelta(months=6)).strftime('%Y-%m-%d'))]"/>
                <filter string="Últimos 3 meses" name="last_3m"
                        domain="[('date_approve', '>=', (context_today() - relativedelta(months=3)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Aprobada el" name="date_approve" date="date_approve"/>
                <group>
                    <filter string="Producto" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Proveedor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Moneda" name="group_currency" context="{'group_by': 'currency_id'}"/>
                    <filter string="Semana" name="group_week" context="{'group_by': 'week_start:week'}"/>
                    <filter string="Mes" name="group_month" context="{'group_by': 'month:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_purchase_price_report" model="ir.actions.act_window">
        <field name="name">Compras por producto</field>
        <field name="res_model">construction.purchase.price.report</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="context">{'search_default_last_6m': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin compras confirmadas</p>
            <p>Cada línea de una OC confirmada, con su precio en soles al tipo de cambio de su
               fecha de aprobación.</p>
        </field>
    </record>

    <!-- P-16 · Precios de compra del producto -->
    <record id="construction_purchase_price_analysis_view_form" model="ir.ui.view">
        <field name="name">construction.purchase.price.analysis.form</field>
        <field name="model">construction.purchase.price.analysis</field>
        <field name="arch" type="xml">
            <form string="Precios de compra del producto" class="o_cp_price_analysis">
                <field name="currency_id" invisible="1"/>
                <field name="line_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="uom_id" groups="uom.group_uom"/>
                        <field name="plan_id" options="{'no_create': True}"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                    </group>
                    <group>
                        <label for="date_from" string="Ventana"/>
                        <div class="o_row">
                            <field name="date_from"/>
                            <span>—</span>
                            <field name="date_to"/>
                        </div>
                        <field name="week_start_day"/>
                        <field name="basis" widget="selection_badge" invisible="not plan_id"/>
                    </group>
                </group>
                <div class="alert alert-info mb-2" role="status" invisible="purchase_count or not product_id">
                    Sin compras confirmadas del producto en la ventana. Amplíe las fechas o fije el costo a mano.
                </div>
                <group invisible="not purchase_count">
                    <group string="Compras en soles">
                        <field name="purchase_count"/>
                        <field name="qty_total"/>
                        <field name="price_last"/>
                        <field name="date_last"/>
                        <field name="outlier_count" decoration-danger="outlier_count"/>
                    </group>
                    <group string="Promedios">
                        <field name="price_weighted" class="fw-bold"/>
                        <field name="price_mean"/>
                        <field name="price_median"/>
                        <field name="price_moving_4w"/>
                        <field name="price_moving_3m"/>
                    </group>
                    <group string="Dispersión">
                        <field name="price_min"/>
                        <field name="price_max"/>
                        <field name="price_stdev"/>
                    </group>
                </group>
                <field name="chart_html" nolabel="1" readonly="1" invisible="not purchase_count"/>
                <notebook invisible="not purchase_count">
                    <page string="Por mes" name="months">
                        <field name="month_html" nolabel="1" readonly="1"/>
                    </page>
                    <page string="Por proveedor" name="partners">
                        <field name="partner_html" nolabel="1" readonly="1"/>
                    </page>
                    <page string="Por semana" name="weeks">
                        <field name="week_html" nolabel="1" readonly="1"/>
                    </page>
                    <page string="Compras" name="purchases">
                        <field name="purchase_ids" nolabel="1" readonly="1"
                               context="{'list_view_ref': 'al_construction_planner.construction_purchase_price_report_view_list'}"/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_apply_cost" type="object" string="Aplicar costo"
                            class="btn-primary" invisible="not plan_id or not product_id"
                            data-hotkey="q"/>
                    <button name="action_refresh" type="object" string="Actualizar"
                            icon="fa-refresh"/>
                    <button string="Cerrar" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_construction_purchase_price_analysis" model="ir.actions.act_window">
        <field name="name">Precios de compra del producto</field>
        <field name="res_model">construction.purchase.price.analysis</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>

    <!-- W-11 · Crear producto desde el plan (P-17) -->
    <record id="construction_product_create_wizard_view_form" model="ir.ui.view">
        <field name="name">construction.product.create.wizard.form</field>
        <field name="model">construction.product.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear producto desde el plan">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="plan_line_id" invisible="1"/>
                <group>
                    <group string="Producto">
                        <field name="plan_id" options="{'no_create': True}" readonly="plan_line_id"/>
                        <field name="categ_id" options="{'no_create': True}"/>
                        <field name="name" placeholder="p. ej. Bisagra cierre lento copa 35 mm"/>
                        <field name="code_proposed"/>
                    </group>
                    <group string="Unidades y proveedor">
                        <field name="uom_id" options="{'no_create': True}"/>
                        <field name="purchase_uom_id" options="{'no_create': True}"/>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="price_reference"/>
                    </group>
                </group>
                <div class="alert alert-warning mb-2" role="alert" invisible="not similar_count">
                    Hay productos de nombre parecido: revise si alguno es el mismo antes de crear otro.
                </div>
                <field name="similar_count" invisible="1"/>
                <field name="similar_ids" nolabel="1" readonly="1" invisible="not similar_count">
                    <list string="Productos parecidos" create="0" delete="0">
                        <field name="product_id"/>
                        <field name="uom_id" groups="uom.group_uom"/>
                        <field name="score" widget="percentage"/>
                        <field name="price_last"/>
                        <field name="currency_id" column_invisible="1"/>
                        <button name="action_use_product" type="object" string="Usar este"
                                icon="fa-check" column_invisible="not parent.plan_line_id"/>
                    </list>
                </field>
                <p class="text-muted small">
                    El código definitivo se asigna al crear. El producto queda activo, marcado con el
                    plan y asignado a la línea; Logística recibe una actividad para completarlo. El
                    costo de la línea se fija después con «Aplicar costo».
                </p>
                <footer>
                    <button name="action_create" type="object" string="Crear producto"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Descartar" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_construction_product_create_wizard" model="ir.actions.act_window">
        <field name="name">Crear producto desde el plan</field>
        <field name="res_model">construction.product.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="group_ids" eval="[Command.link(ref('group_planner_planner'))]"/>
    </record>

    <!-- P-18 · Abastecimiento de la obra -->
    <record id="action_construction_supply_board" model="ir.actions.client">
        <field name="name">Abastecimiento de la obra</field>
        <field name="tag">al_construction_planner.supply_board</field>
        <field name="path">abastecimiento-obra</field>
    </record>

    <!-- Familia (código de 4 dígitos) y marca del plan en el producto -->
    <record id="product_category_form_view_construction" model="ir.ui.view">
        <field name="name">product.category.form.construction.planner</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="construction_family_code" placeholder="3105"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_construction" model="ir.ui.view">
        <field name="name">product.template.form.construction.planner</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="construction_created_from_plan_id"
                       invisible="not construction_created_from_plan_id"
                       groups="al_construction_planner.group_planner_user"/>
            </xpath>
        </field>
    </record>

</odoo>
