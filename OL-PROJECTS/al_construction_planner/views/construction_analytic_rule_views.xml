<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_analytic_rule_list" model="ir.ui.view">
        <field name="name">construction.analytic.rule.list</field>
        <field name="model">construction.analytic.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="resource_type"/>
                <field name="stage"/>
                <field name="product_categ_id" options="{'no_create': True}"/>
                <field name="stage_account_id" options="{'no_create': True}"/>
                <field name="cost_account_id" options="{'no_create': True}"/>
                <field name="area_account_id" options="{'no_create': True}"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_construction_analytic_rule" model="ir.actions.act_window">
        <field name="name">Reglas analíticas</field>
        <field name="res_model">construction.analytic.rule</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Defina la etapa, la partida y el área de las líneas del plan</p>
            <p>Por tipo de recurso, etapa y categoría del producto (vacío: cualquiera). Gana la regla
               más específica. Producción y armado → PRD, instalación y acabado → INS; contrata → MODV,
               personal propio → MODF; tableros, cantos y accesorios por su categoría.</p>
        </field>
    </record>
</odoo>
