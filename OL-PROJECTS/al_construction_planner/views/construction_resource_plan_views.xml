<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Líneas del plan -->
    <record id="construction_resource_plan_line_view_list" model="ir.ui.view">
        <field name="name">construction.resource.plan.line.list</field>
        <field name="model">construction.resource.plan.line</field>
        <field name="arch" type="xml">
            <list string="Líneas del plan" editable="bottom"
                  decoration-warning="not stage" decoration-muted="line_state == 'cancel'">
                <header>
                    <button name="action_open_price_wizard" type="object" string="Aplicar costo"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="action_open_purchase_prices" type="object" string="Precios de compra"
                            groups="al_construction_planner.group_planner_planner"/>
                </header>
                <field name="plan_id" column_invisible="context.get('default_plan_id')"
                       options="{'no_create': True}"/>
                <field name="plan_state" column_invisible="True"/>
                <field name="task_id" options="{'no_create': True}"
                       domain="[('project_id', '=', project_id), ('construction_level', '!=', False)]"/>
                <field name="project_id" column_invisible="True"/>
                <field name="task_level" optional="hide"/>
                <field name="floor_task_id" optional="hide"/>
                <field name="apartment_task_id" optional="show"/>
                <field name="space_task_id" optional="hide"/>
                <field name="module_task_id" optional="hide"/>
                <field name="resource_type"/>
                <field name="stage"/>
                <field name="product_id" options="{'no_create': True}"
                       required="resource_type in ('material', 'service', 'production')"/>
                <field name="activity_id" options="{'no_create': True}"
                       required="resource_type in ('contract', 'labor')"/>
                <field name="partner_id" optional="hide" options="{'no_create': True}"/>
                <field name="role_id" optional="hide" options="{'no_create': True}"/>
                <field name="qty_planned"/>
                <field name="product_uom_id" options="{'no_create': True}"/>
                <field name="price_unit_planned"/>
                <button name="action_open_purchase_prices" type="object" icon="fa-line-chart"
                        title="Precios de compra del producto" invisible="not product_id"
                        groups="al_construction_planner.group_planner_planner"/>
                <button name="action_open_product_create" type="object" icon="fa-plus-square"
                        title="Crear producto desde el plan"
                        invisible="product_id or plan_state != 'draft' or resource_type not in ('material', 'service')"
                        groups="al_construction_planner.group_planner_planner"/>
                <field name="amount_planned" sum="Total"/>
                <field name="qty_requested" optional="hide"/>
                <field name="qty_purchased" optional="hide"/>
                <field name="qty_dispatched" optional="hide"/>
                <field name="qty_consumed" optional="hide"/>
                <field name="qty_remaining" optional="hide"/>
                <field name="qty_executed" optional="hide"/>
                <field name="qty_settled" optional="hide"/>
                <field name="progress_pct" widget="percentage" optional="hide"/>
                <field name="amount_budgeted" sum="Total" optional="hide"/>
                <field name="amount_committed" optional="hide"/>
                <field name="amount_actual" optional="hide"/>
                <field name="amount_remaining" optional="hide"/>
                <field name="executed_pct" widget="percentage" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="price_basis" optional="hide"/>
                <field name="price_basis_date" optional="hide"/>
                <field name="date_needed" optional="show"/>
                <field name="supply_mode" optional="hide"/>
                <field name="analytic_distribution" widget="analytic_distribution" optional="hide"
                       groups="analytic.group_analytic_accounting"/>
                <field name="source" optional="hide"/>
                <field name="line_state" optional="show" widget="badge"
                       decoration-success="line_state == 'done'"
                       decoration-danger="line_state == 'exceeded'"
                       decoration-info="line_state in ('partial', 'purchasing')"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Recursos y avance de un nivel (P-09) -->
    <record id="construction_resource_plan_line_view_list_progress" model="ir.ui.view">
        <field name="name">construction.resource.plan.line.list.progress</field>
        <field name="model">construction.resource.plan.line</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list string="Recursos y avance" default_group_by="stage" create="0" edit="0">
                <field name="stage"/>
                <field name="task_id" optional="hide"/>
                <field name="resource_type" optional="hide"/>
                <field name="resource_name"/>
                <field name="partner_id" optional="show"/>
                <field name="qty_planned" string="Presupuestado"/>
                <field name="product_uom_id" string="Und" groups="uom.group_uom"/>
                <field name="qty_executed" string="Acumulado"/>
                <field name="amount_planned" sum="Total"/>
                <field name="progress_pct" widget="percentage"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="construction_resource_plan_line_view_form" model="ir.ui.view">
        <field name="name">construction.resource.plan.line.form</field>
        <field name="model">construction.resource.plan.line</field>
        <field name="arch" type="xml">
            <form string="Línea del plan">
                <header>
                    <button name="action_open_purchase_prices" type="object" string="Precios de compra"
                            invisible="not product_id"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="action_open_product_create" type="object" string="Crear producto"
                            invisible="product_id or plan_state != 'draft' or resource_type not in ('material', 'service')"
                            groups="al_construction_planner.group_planner_planner"/>
                    <field name="plan_state" invisible="1"/>
                </header>
                <sheet>
                    <group>
                        <group string="Dónde">
                            <field name="plan_id" options="{'no_create': True}"/>
                            <field name="project_id" invisible="1"/>
                            <field name="task_id" options="{'no_create': True}"
                                   domain="[('project_id', '=', project_id), ('construction_level', '!=', False)]"/>
                            <field name="task_level"/>
                            <field name="floor_task_id"/>
                            <field name="apartment_task_id"/>
                            <field name="space_task_id"/>
                            <field name="module_task_id"/>
                            <field name="typology_id"/>
                        </group>
                        <group string="Qué">
                            <field name="resource_type"/>
                            <field name="stage"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="activity_id" options="{'no_create': True}"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="role_id" options="{'no_create': True}"/>
                            <field name="supply_mode"/>
                        </group>
                        <group string="Cuánto">
                            <field name="qty_planned"/>
                            <field name="product_uom_id" options="{'no_create': True}"/>
                            <field name="price_unit_planned"/>
                            <field name="amount_planned"/>
                            <field name="amount_budgeted"/>
                            <field name="amount_committed"/>
                            <field name="amount_actual"/>
                            <field name="amount_remaining"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price_basis"/>
                            <field name="price_basis_date"/>
                        </group>
                        <group string="Ejecución">
                            <field name="qty_requested"/>
                            <field name="qty_purchased"/>
                            <field name="qty_dispatched"/>
                            <field name="qty_consumed"/>
                            <field name="qty_remaining"/>
                            <field name="qty_executed"/>
                            <field name="qty_settled"/>
                            <field name="progress_pct" widget="percentage"/>
                        </group>
                        <group string="Cuándo y estado">
                            <field name="date_needed"/>
                            <field name="line_state"/>
                            <field name="source"/>
                            <field name="source_ref"/>
                            <field name="previous_line_id"/>
                            <field name="analytic_distribution" widget="analytic_distribution"
                                   groups="analytic.group_analytic_accounting"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <field name="allocation_ids" readonly="1" invisible="not allocation_ids"
                           context="{'list_view_ref': 'al_construction_planner.construction_resource_plan_allocation_view_list'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="construction_resource_plan_line_view_pivot" model="ir.ui.view">
        <field name="name">construction.resource.plan.line.pivot</field>
        <field name="model">construction.resource.plan.line</field>
        <field name="arch" type="xml">
            <pivot string="Plan de recursos" sample="1">
                <field name="apartment_task_id" type="row"/>
                <field name="stage" type="col"/>
                <field name="amount_planned" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="construction_resource_plan_line_view_graph" model="ir.ui.view">
        <field name="name">construction.resource.plan.line.graph</field>
        <field name="model">construction.resource.plan.line</field>
        <field name="arch" type="xml">
            <graph string="Plan de recursos" type="bar" stacked="1" sample="1">
                <field name="stage"/>
                <field name="resource_type"/>
                <field name="amount_planned" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="construction_resource_plan_line_view_search" model="ir.ui.view">
        <field name="name">construction.resource.plan.line.search</field>
        <field name="model">construction.resource.plan.line</field>
        <field name="arch" type="xml">
            <search string="Líneas del plan">
                <field name="task_id"/>
                <field name="product_id"/>
                <field name="activity_id"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <filter string="Materiales" name="material" domain="[('resource_type', '=', 'material')]"/>
                <filter string="Contratas" name="contract" domain="[('resource_type', '=', 'contract')]"/>
                <filter string="Personal propio" name="labor" domain="[('resource_type', '=', 'labor')]"/>
                <separator/>
                <filter string="Sin etapa" name="no_stage" domain="[('stage', '=', False)]"/>
                <separator/>
                <filter string="Planificadas" name="state_planned" domain="[('line_state', '=', 'planned')]"/>
                <filter string="Parciales" name="state_partial" domain="[('line_state', '=', 'partial')]"/>
                <filter string="En compra" name="state_purchasing" domain="[('line_state', '=', 'purchasing')]"/>
                <filter string="Completas" name="state_done" domain="[('line_state', '=', 'done')]"/>
                <filter string="Excedidas" name="state_exceeded" domain="[('line_state', '=', 'exceeded')]"/>
                <filter string="Sin costo" name="no_price" domain="[('price_unit_planned', '=', False)]"/>
                <separator/>
                <filter string="Planes vigentes" name="current_plan"
                        domain="[('plan_state', 'in', ('approved', 'in_progress'))]"/>
                <group>
                    <filter string="Etapa" name="group_stage" context="{'group_by': 'stage'}"/>
                    <filter string="Tipo de recurso" name="group_type" context="{'group_by': 'resource_type'}"/>
                    <filter string="Estado" name="group_line_state" context="{'group_by': 'line_state'}"/>
                    <filter string="Contrata o proveedor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Producto" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Actividad" name="group_activity" context="{'group_by': 'activity_id'}"/>
                    <filter string="Piso" name="group_floor" context="{'group_by': 'floor_task_id'}"/>
                    <filter string="Departamento" name="group_apartment" context="{'group_by': 'apartment_task_id'}"/>
                    <filter string="Ambiente" name="group_space" context="{'group_by': 'space_task_id'}"/>
                    <filter string="Plan" name="group_plan" context="{'group_by': 'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- P-13 · Análisis de control: planificado, comprometido, real y saldo -->
    <record id="construction_plan_control_view_pivot" model="ir.ui.view">
        <field name="name">construction.resource.plan.line.pivot.control</field>
        <field name="model">construction.resource.plan.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de control" sample="1">
                <field name="stage" type="row"/>
                <field name="amount_planned" type="measure" string="Planificado"/>
                <field name="amount_committed" type="measure"/>
                <field name="amount_actual" type="measure"/>
                <field name="amount_remaining" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="construction_plan_control_view_graph" model="ir.ui.view">
        <field name="name">construction.resource.plan.line.graph.control</field>
        <field name="model">construction.resource.plan.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <graph string="Análisis de control" type="bar" sample="1">
                <field name="stage"/>
                <field name="amount_planned" type="measure" string="Planificado"/>
                <field name="amount_actual" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_construction_plan_control" model="ir.actions.act_window">
        <field name="name">Análisis de control</field>
        <field name="res_model">construction.resource.plan.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'pivot', 'view_id': ref('construction_plan_control_view_pivot')}),
            Command.create({'view_mode': 'graph', 'view_id': ref('construction_plan_control_view_graph')}),
            Command.create({'view_mode': 'list', 'view_id': ref('construction_resource_plan_line_view_list')})]"/>
        <field name="context">{'search_default_current_plan': 1, 'search_default_group_stage': 1, 'search_default_group_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay líneas en planes vigentes</p>
            <p>Planificado, comprometido, real y saldo por etapa y tipo de recurso, por contrata
               o por producto. El % ejecutado de cada etapa está en la pestaña «Control» del
               plan.</p>
        </field>
    </record>

    <!-- Plan de recursos -->
    <record id="construction_resource_plan_view_list" model="ir.ui.view">
        <field name="name">construction.resource.plan.list</field>
        <field name="model">construction.resource.plan</field>
        <field name="arch" type="xml">
            <list string="Planes de recursos" decoration-muted="state in ('replaced', 'cancel')"
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="version"/>
                <field name="project_id"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="date_start" optional="show"/>
                <field name="date_end" optional="show"/>
                <field name="line_count" optional="hide"/>
                <field name="amount_material" optional="hide" sum="Total"/>
                <field name="amount_contract" optional="hide" sum="Total"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'to_approve')"
                       decoration-success="state in ('approved', 'in_progress')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="construction_resource_plan_view_form" model="ir.ui.view">
        <field name="name">construction.resource.plan.form</field>
        <field name="model">construction.resource.plan</field>
        <field name="arch" type="xml">
            <form string="Plan de recursos">
                <header>
                    <button name="action_open_generate_wizard" type="object" string="Generar plan"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="action_open_price_wizard" type="object" string="Aplicar costo"
                            invisible="state != 'draft'"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="action_request_approval" type="object"
                            string="Solicitar aprobación" class="btn-primary"
                            invisible="state != 'draft' or not line_count"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="action_open_product_create" type="object" string="Crear producto"
                            invisible="state != 'draft'"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="action_open_replan_wizard" type="object" string="Nueva versión"
                            invisible="state not in ('approved', 'in_progress')"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="%(action_plan_purchase_wizard)d" type="action" string="Compra masiva"
                            invisible="state not in ('approved', 'in_progress')"
                            context="{'default_plan_id': id}"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="%(action_plan_request_wizard)d" type="action"
                            string="Requerimiento de obra"
                            invisible="state not in ('approved', 'in_progress')"
                            context="{'default_plan_id': id}"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="%(action_plan_production_wizard)d" type="action"
                            string="Orden de fabricación"
                            invisible="state not in ('approved', 'in_progress')"
                            context="{'default_plan_id': id}"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="%(action_plan_contract_wizard)d" type="action"
                            string="Asignar contrata"
                            invisible="state not in ('approved', 'in_progress')"
                            context="{'default_plan_id': id}"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="%(action_plan_crew_wizard)d" type="action"
                            string="Asignar cuadrilla"
                            invisible="state not in ('approved', 'in_progress')"
                            context="{'default_plan_id': id}"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="%(action_plan_reschedule_wizard)d" type="action"
                            string="Cambiar fechas"
                            invisible="state not in ('approved', 'in_progress')"
                            context="{'default_plan_id': id}"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="%(action_plan_progress_wizard)d" type="action"
                            string="Registrar avance"
                            invisible="state not in ('approved', 'in_progress')"
                            context="{'default_plan_id': id}"
                            groups="al_construction_planner.group_planner_progress"/>
                    <button name="action_sync_space_stages" type="object"
                            string="Crear etapas del cronograma"
                            invisible="not line_count or state in ('closed', 'replaced', 'cancel')"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="action_close" type="object" string="Cerrar"
                            invisible="state not in ('approved', 'in_progress')"
                            groups="al_construction_planner.group_planner_manager"
                            confirm="El plan cerrado queda de solo lectura y su presupuesto pasa a «Hecho». ¿Continuar?"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state not in ('draft', 'to_approve')"
                            groups="al_construction_planner.group_planner_planner"/>
                    <button name="action_draft" type="object" string="Volver a borrador"
                            invisible="state not in ('to_approve', 'cancel')"
                            groups="al_construction_planner.group_planner_planner"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_approve,approved,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_tree" type="object"
                                class="oe_stat_button" icon="fa-sitemap" string="Árbol de recursos"/>
                        <button name="action_open_supply_board" type="object"
                                class="oe_stat_button" icon="fa-truck" string="Abastecimiento"
                                groups="al_construction_planner.group_planner_planner"/>
                        <button name="action_open_schedule" type="object"
                                class="oe_stat_button" icon="fa-tasks" string="Cronograma"
                                groups="al_project_gantt_base.group_gantt_user"/>
                        <button name="action_view_lines" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo" string="Líneas"/>
                        </button>
                        <button name="action_view_allocations" type="object"
                                class="oe_stat_button" icon="fa-link" invisible="not allocation_count">
                            <field name="allocation_count" widget="statinfo" string="Asignaciones"/>
                        </button>
                        <button name="action_open_control_analysis" type="object"
                                class="oe_stat_button" icon="fa-bar-chart"
                                string="Análisis de control"
                                invisible="state in ('draft', 'to_approve', 'cancel')"/>
                        <button name="action_view_budget" type="object"
                                class="oe_stat_button" icon="fa-money" string="Presupuesto"
                                invisible="not budget_analytic_id"/>
                        <button name="action_view_versions" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="version_count &lt; 2">
                            <field name="version_count" widget="statinfo" string="Versiones"/>
                        </button>
                    </div>
                    <div class="alert alert-warning mb-2" role="alert"
                         invisible="not unstaged_line_count and not unpriced_line_count">
                        <span invisible="not unstaged_line_count" class="me-3">
                            Líneas sin etapa: <field name="unstaged_line_count" class="oe_inline"/>
                        </span>
                        <span invisible="not unpriced_line_count">
                            Líneas sin costo: <field name="unpriced_line_count" class="oe_inline"/>
                        </span>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="line_count" options="{'no_create': True}"/>
                            <field name="version"/>
                            <field name="parent_id" invisible="not parent_id"/>
                            <field name="user_id" widget="many2one_avatar_user"
                                   readonly="state in ('closed', 'replaced', 'cancel')"/>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount_material"/>
                            <field name="amount_service"/>
                            <field name="amount_contract"/>
                            <field name="amount_labor"/>
                            <field name="amount_production"/>
                            <field name="amount_total" class="fw-bold"/>
                            <field name="amount_budgeted" invisible="not budget_analytic_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas" name="lines">
                            <field name="line_ids" readonly="state != 'draft'"
                                   context="{'default_plan_id': id, 'list_view_ref': 'al_construction_planner.construction_resource_plan_line_view_list'}"/>
                        </page>
                        <page string="Resumen por etapa" name="stage_summary">
                            <field name="stage_summary_html" nolabel="1"/>
                            <p class="text-muted small">
                                «Contrata» incluye el personal propio. En una versión en
                                preparación, el presupuesto es el de la versión vigente.
                                Comprometido y real se llenan con las asignaciones, contratas y
                                producción; «Sin etapa» impide aprobar el plan.
                            </p>
                        </page>
                        <page string="Control" name="control"
                              invisible="state in ('draft', 'to_approve', 'cancel')">
                            <div class="d-flex justify-content-end mb-2">
                                <button name="action_refresh_control" type="object"
                                        string="Actualizar control" icon="fa-refresh"
                                        class="btn btn-secondary btn-sm"/>
                            </div>
                            <field name="control_html" nolabel="1"/>
                            <p class="text-muted small">
                                Análisis de control (P-13). Comprometido: pedido o comprado sin
                                consumir, OC de servicio sin recibir y turnos sin horas
                                registradas. Real: consumido al costo del plan, recibido en la OC
                                de servicio y horas registradas por el costo hora del empleado.
                                % ejecutado = real ÷ planificado. Se actualiza con cada documento
                                y cada hora.
                            </p>
                        </page>
                        <page string="Políticas" name="policies">
                            <group>
                                <group string="Exceso sobre lo planificado">
                                    <field name="exceed_policy" readonly="state != 'draft'"/>
                                    <field name="exceed_tolerance" readonly="state != 'draft'"/>
                                    <field name="budget_analytic_id" options="{'no_create': True}"/>
                                    <field name="date_approved" invisible="not date_approved"/>
                                    <field name="date_closed" invisible="not date_closed"/>
                                </group>
                                <group string="Anticipación">
                                    <field name="lead_days_material" readonly="state != 'draft'"/>
                                    <field name="lead_days_contract" readonly="state != 'draft'"/>
                                    <field name="lead_days_production" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Versión" name="version" invisible="not parent_id and not replan_reason">
                            <field name="replan_reason" placeholder="Motivo de la nueva versión"
                                   readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="construction_resource_plan_view_search" model="ir.ui.view">
        <field name="name">construction.resource.plan.search</field>
        <field name="model">construction.resource.plan</field>
        <field name="arch" type="xml">
            <search string="Planes de recursos">
                <field name="name"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <filter string="Vigentes y en preparación" name="current"
                        domain="[('state', 'not in', ('replaced', 'cancel', 'closed'))]"/>
                <filter string="Borradores" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="En aprobación" name="to_approve" domain="[('state', '=', 'to_approve')]"/>
                <filter string="Por aprobar por mí" name="needs_my_review"
                        domain="[('reviewer_ids', 'in', uid), ('state', '=', 'to_approve')]"/>
                <group>
                    <filter string="Obra" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- P-01 (básica) · Inicio: obras con su plan -->
    <record id="action_construction_resource_plan" model="ir.actions.act_window">
        <field name="name">Planes de recursos</field>
        <field name="res_model">construction.resource.plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree el plan de recursos de una obra</p>
            <p>Elija la obra y use «Generar plan»: las líneas salen de las tipologías de sus ambientes.</p>
        </field>
    </record>

    <record id="action_construction_resource_plan_line" model="ir.actions.act_window">
        <field name="name">Recursos planificados</field>
        <field name="res_model">construction.resource.plan.line</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('plan_state', 'in', ('draft', 'to_approve', 'approved', 'in_progress'))]</field>
    </record>

    <!-- Análisis de las líneas de los planes (todas las versiones) -->
    <record id="action_construction_resource_plan_line_analysis" model="ir.actions.act_window">
        <field name="name">Análisis del plan</field>
        <field name="res_model">construction.resource.plan.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_current_plan': 1}</field>
    </record>

    <!-- Reglas de aprobación del plan (tier.definition de OCA) -->
    <record id="action_construction_plan_tier_definition" model="ir.actions.act_window">
        <field name="name">Reglas de aprobación</field>
        <field name="res_model">tier.definition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('model', 'in', ('construction.resource.plan', 'construction.contract.settlement'))]</field>
        <field name="context">{'default_model_id': ref('al_construction_planner.model_construction_resource_plan')}</field>
    </record>

</odoo>
