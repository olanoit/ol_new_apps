<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_bom_form_view_construction_planner" model="ir.ui.view">
        <field name="name">mrp.bom.form.construction.planner</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_uom_id']" position="after">
                <field name="construction_consumption_stage" optional="show"
                       groups="al_construction_planner.group_planner_progress"/>
            </xpath>
        </field>
    </record>

</odoo>
