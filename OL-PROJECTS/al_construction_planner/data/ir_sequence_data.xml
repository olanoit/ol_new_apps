<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_construction_resource_plan" model="ir.sequence">
        <field name="name">Plan de recursos de obra</field>
        <field name="code">construction.resource.plan</field>
        <field name="prefix">PLR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_construction_task_progress" model="ir.sequence">
        <field name="name">Avance reportado de obra</field>
        <field name="code">construction.task.progress</field>
        <field name="prefix">AVN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_construction_contract_settlement" model="ir.sequence">
        <field name="name">Liquidación semanal de contrata</field>
        <field name="code">construction.contract.settlement</field>
        <field name="prefix">LIQ/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
