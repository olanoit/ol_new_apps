<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- W-10: revisión adicional del requerimiento de obra que excede el plan
         con la política «pedir aprobación». Editable en Configuración ›
         Reglas de aprobación del requerimiento. -->
    <data noupdate="1">
        <record id="tier_material_request_exceed" model="tier.definition">
            <field name="name">Exceso sobre el plan: jefatura del planificador</field>
            <field name="model_id" ref="al_construction_material_request.model_construction_material_request"/>
            <field name="review_type">group</field>
            <field name="reviewer_group_id" ref="group_planner_project_head"/>
            <field name="definition_domain">[('construction_exceed_state', '=', 'exceeded'), ('construction_plan_id.exceed_policy', '=', 'approval')]</field>
            <field name="sequence">5</field>
            <field name="approve_sequence" eval="True"/>
        </record>
        <!-- Liquidación semanal (P-08): la valida el supervisor y la aprueba
             la jefatura de proyectos; la aprobación recibe en la OC y crea la
             factura. -->
        <record id="tier_contract_settlement_manager" model="tier.definition">
            <field name="name">Liquidación de contrata: jefatura de proyectos</field>
            <field name="model_id" ref="model_construction_contract_settlement"/>
            <field name="review_type">group</field>
            <field name="reviewer_group_id" ref="group_planner_project_head"/>
            <field name="definition_domain">[]</field>
            <field name="sequence">10</field>
            <field name="approve_sequence" eval="True"/>
        </record>
        <!-- Metrado con diferencia (v1.6, M16-04): la jefatura aprueba antes
             de lanzar la orden de fabricación del ambiente. -->
        <record id="tier_measurement_difference" model="tier.definition">
            <field name="name">Metrado con diferencia: jefatura de proyectos</field>
            <field name="model_id" ref="model_construction_measurement"/>
            <field name="review_type">group</field>
            <field name="reviewer_group_id" ref="group_planner_project_head"/>
            <field name="definition_domain">[('has_difference', '=', True)]</field>
            <field name="sequence">10</field>
            <field name="approve_sequence" eval="True"/>
        </record>
        <!-- Todo material extra (v1.6, M16-07): lo aprueba la jefatura de
             proyectos, esté o no dentro del plan; al aprobar decide si se
             descuenta a la contrata (M16-08). -->
        <record id="tier_material_request_extra" model="tier.definition">
            <field name="name">Material extra: jefatura de proyectos</field>
            <field name="model_id" ref="al_construction_material_request.model_construction_material_request"/>
            <field name="review_type">group</field>
            <field name="reviewer_group_id" ref="group_planner_project_head"/>
            <field name="definition_domain">[('is_extra', '=', True)]</field>
            <field name="sequence">4</field>
            <field name="approve_sequence" eval="True"/>
        </record>
    </data>
</odoo>
