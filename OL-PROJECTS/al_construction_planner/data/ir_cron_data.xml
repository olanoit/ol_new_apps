<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cada día, a primera hora: en el día de liquidación de cada obra crea
         en borrador (06:00 en Lima) las liquidaciones de las contratas con avances validados
         por liquidar, y pasa a «Pagada» las de factura pagada. -->
    <record id="ir_cron_prepare_settlements" model="ir.cron">
        <field name="name">Planificación de obra: preparar liquidaciones de contratas</field>
        <field name="model_id" ref="model_construction_contract_settlement"/>
        <field name="state">code</field>
        <field name="code">model._cron_prepare_settlements()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 11:00:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
