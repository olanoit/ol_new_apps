<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paquete 1.17, M117-21, punto 8: la cotización que recibe el cliente. Lee lo
         que la hoja pasó a la cotización: nunca muestra módulos de fabricación. -->
    <record id="action_report_sale_sheet_quotation" model="ir.actions.report">
        <field name="name">Cotización de mobiliario</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_construction_planner_spreadsheet_furniture.report_sale_sheet_quotation</field>
        <field name="report_file">al_construction_planner_spreadsheet_furniture.report_sale_sheet_quotation</field>
        <field name="print_report_name">'Cotizacion_%s_%s' % (object.name, object._construction_sale_version_label())</field>
        <field name="paperformat_id" ref="al_report_base.paperformat_pe_a4"/>
    </record>

    <template id="report_sale_sheet_quotation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="al_construction_planner_spreadsheet_furniture.report_sale_sheet_quotation_document"
                   t-lang="o.partner_id.lang or o.env.lang"/>
            </t>
        </t>
    </template>

    <template id="report_sale_sheet_quotation_document">
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="cur" t-value="o.currency_id"/>
        <t t-set="s" t-value="o._construction_sale_summary_data()"/>
        <t t-set="obra" t-value="s.get('obra', {})"/>
        <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': cur}"/>
        <t t-call="al_report_base.report_pe_page">
            <t t-set="doc_title" t-value="'Cotización'"/>
            <t t-set="doc_number" t-value="'%s · %s' % (o.name, s.get('version') or 'N1')"/>
            <t t-set="doc_extra" t-value="obra.get('Fecha de cotización') or ''"/>
            <table class="pe-doc-table mb-3">
                <tr><td class="pe-doc-label" style="width: 18%;">Cliente</td>
                    <td class="pe-doc-value" t-out="obra.get('Cliente')"/></tr>
                <tr><td class="pe-doc-label">Proyecto</td>
                    <td class="pe-doc-value" t-out="obra.get('Proyecto')"/></tr>
                <tr><td class="pe-doc-label">Ubicación</td>
                    <td class="pe-doc-value" t-out="obra.get('Ubicación')"/></tr>
                <tr><td class="pe-doc-label">Solicitante</td>
                    <td class="pe-doc-value" t-out="obra.get('Solicitante')"/></tr>
            </table>
            <table class="pe-doc-table pe-doc-lines mb-3">
                <thead class="pe-doc-thead">
                    <tr><th>Producto</th><th class="text-end">Ambientes</th><th class="text-end">Subtotal</th></tr>
                </thead>
                <tbody>
                    <tr t-foreach="s.get('partidas', [])" t-as="item">
                        <td t-out="item['name']"/>
                        <td class="text-end" t-out="'%g' % (item.get('spaces') or 0)"/>
                        <td class="text-end"><span t-out="item['subtotal']" t-options="money"/></td>
                    </tr>
                    <tr t-if="s.get('discount')">
                        <td colspan="2">Descuento comercial</td>
                        <td class="text-end"><span t-out="-s['discount']" t-options="money"/></td>
                    </tr>
                    <tr><td colspan="2">Subtotal</td>
                        <td class="text-end"><span t-out="s.get('subtotal')" t-options="money"/></td></tr>
                    <tr><td colspan="2">IGV</td>
                        <td class="text-end"><span t-out="s.get('tax')" t-options="money"/></td></tr>
                    <tr class="pe-doc-total"><td colspan="2">Total</td>
                        <td class="text-end"><span t-out="s.get('total')" t-options="money"/></td></tr>
                </tbody>
            </table>
            <t t-foreach="(('Condiciones generales', 'Condiciones generales'), ('Forma de pago', 'Forma de pago'), ('Garantía', 'Garantía'), ('Validez de la oferta', 'Validez'))" t-as="text">
                <p t-if="obra.get(text[0])"><strong t-out="text[1]"/>: <span t-out="obra.get(text[0])"/></p>
            </t>
            <t t-if="s.get('changes')">
                <p><strong>Cambios de esta versión</strong></p>
                <ul><li t-foreach="s['changes']" t-as="change" t-out="change"/></ul>
            </t>
            <table class="pe-doc-signatures mb-3" style="width: 100%;">
                <tr>
                    <td t-foreach="s.get('signatures') or ['Jefatura de Oficina Técnica', 'Área de Presupuestos']" t-as="signature"
                        class="pe-doc-sign-line text-center" t-out="signature"/>
                </tr>
            </table>
            <t t-foreach="s.get('partidas', [])" t-as="item">
                <div style="page-break-before: always;" t-if="item_first"/>
                <h4 t-out="item['name']"/>
                <table class="pe-doc-table mb-2" t-if="item.get('finishes')">
                    <tr t-foreach="item['finishes']" t-as="finish">
                        <td class="pe-doc-label" style="width: 15%;" t-out="finish['code']"/>
                        <td class="pe-doc-value" t-out="finish['description']"/>
                    </tr>
                </table>
                <t t-foreach="[t for t in s.get('typologies', []) if t.get('partida') == item['name']]" t-as="typology">
                    <table class="pe-doc-table pe-doc-lines mb-3 pe-doc-keep">
                        <thead class="pe-doc-thead">
                            <tr><th>Mueble</th><th class="text-end">Cantidad</th><th class="text-end">Precio</th><th class="text-end">Subtotal</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="typology['lines']" t-as="line">
                                <td t-out="line['description']"/>
                                <td class="text-end" t-out="'%s %s' % (line['qty'], line.get('uom') or '')"/>
                                <td class="text-end"><span t-out="line['price']" t-options="money"/></td>
                                <td class="text-end"><span t-out="line['subtotal']" t-options="money"/></td>
                            </tr>
                            <tr class="pe-doc-total">
                                <td colspan="3" t-out="typology.get('footer')"/>
                                <td class="text-end"><span t-out="typology.get('price') or 0" t-options="money"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </t>
            <t t-if="s.get('considerations')">
                <p><strong>Consideraciones</strong></p>
                <ul><li t-foreach="s['considerations']" t-as="note" t-out="note"/></ul>
            </t>
        </t>
    </template>
</odoo>
