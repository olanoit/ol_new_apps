<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paquete 1.13, M113-04: «Importar Excel a la hoja». -->
    <record id="construction_spreadsheet_import_wizard_view_form" model="ir.ui.view">
        <field name="name">construction.spreadsheet.import.wizard.form</field>
        <field name="model">construction.spreadsheet.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Excel a la hoja">
                <field name="document_id" invisible="1"/>
                <field name="project_id" invisible="1"/>
                <group>
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                        <field name="mode" widget="radio"/>
                    </group>
                    <group>
                        <field name="expand_rows"/>
                        <field name="keep_extra"/>
                        <field name="save_version"/>
                    </group>
                </group>
                <p class="text-muted">
                    Las columnas del maestro se escriben en su columna de la hoja, buscada por su
                    clave o su encabezado; las columnas calculadas no se tocan. El código del
                    producto se convierte en «nombre · unidad · código» en «Producto», y los
                    códigos que no están en el maestro van a PRODUCTOS NUEVOS. El formato está en
                    Planificación de obra › Descargar formato de carga.
                </p>
                <field name="review_html" nolabel="1" invisible="not file"/>
                <footer>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"
                            invisible="not file"/>
                    <button name="action_review" type="object" string="Solo revisar"
                            invisible="not file"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!-- Paquete 1.18, M118-15, punto 2: desde la hoja, el asistente se
         llama «Enviar la hoja al planificador» y no habla de un libro Excel. -->
    <record id="construction_master_import_wizard_view_form_sheet" model="ir.ui.view">
        <field name="name">construction.master.import.wizard.form.sheet</field>
        <field name="model">construction.master.import.wizard</field>
        <field name="inherit_id" ref="al_construction_planner_furniture.construction_master_import_wizard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('alert-info')]" position="attributes">
                <attribute name="invisible">spreadsheet_id</attribute>
            </xpath>
            <xpath expr="//div[hasclass('alert-info')]" position="after">
                <field name="spreadsheet_id" invisible="1"/>
                <div class="alert alert-info mb-3" role="status" invisible="not spreadsheet_id">
                    Revise la vista previa y las advertencias de la hoja. «Importar» lleva la hoja
                    al planificador: tipologías, módulos, piezas, BOM, actividades y árbol de la
                    obra. Volver a enviar no duplica nada.
                </div>
            </xpath>
            <xpath expr="//field[@name='file']" position="attributes">
                <attribute name="invisible">spreadsheet_id</attribute>
            </xpath>
            <xpath expr="//button[@name='action_download_template']" position="attributes">
                <attribute name="invisible">spreadsheet_id</attribute>
            </xpath>
            <xpath expr="//button[@name='action_download_example']" position="attributes">
                <attribute name="invisible">spreadsheet_id</attribute>
            </xpath>
            <xpath expr="//button[@name='action_download_eto_example']" position="attributes">
                <attribute name="invisible">spreadsheet_id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
