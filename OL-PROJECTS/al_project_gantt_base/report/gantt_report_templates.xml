<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================================================
         Diagrama de Gantt en PDF con el formato común de los documentos de
         la suite (al_report_base): encabezado con el recuadro
         R.U.C./tipo, tabla con cabecera gris oscuro y pie con la
         numeración. report_pe_page pone el div.article que
         `_prepare_html()` necesita. Las barras conservan el color del
         estado de cada tarea (la leyenda lo explica).
         ============================================================= -->

    <template id="report_gantt">
        <t t-set="o" t-value="docs[:1]"/>
        <t t-call="web.html_container" o="o" company="o.company_id or docs.env.company">
            <t t-call="al_report_base.report_pe_page"
                doc_title.f="Diagrama de Gantt"
                doc_extra="'Escala %s · %s' % (matrix['scale'], generated_on.strftime('%d/%m/%Y'))">

                <div class="pe-doc-title" t-esc="title"/>
                <p class="pe-doc-fs-11 text-center" style="color: #595959; margin: -12px 0 8px;">
                    <t t-esc="len(rows)"/> fila(s)
                    <t t-if="payload['meta'].get('truncated')">
                        · <strong style="color: #c0392b;">
                            se muestran <t t-esc="payload['meta']['count']"/>
                            de <t t-esc="payload['meta']['total']"/> tareas
                        </strong>
                    </t>
                    <t t-if="payload['meta'].get('critical_path', {}).get('computed')">
                        · <strong style="color: #c0392b;">
                            <t t-esc="payload['meta']['critical_path']['critical_count']"/> en ruta crítica
                        </strong>
                    </t>
                </p>

                <table class="pe-doc-table pe-doc-lines pe-doc-fs-11" style="table-layout: fixed;">
                    <colgroup>
                        <col style="width: 5%"/>
                        <col style="width: 21%"/>
                        <col style="width: 12%"/>
                        <t t-foreach="periods" t-as="period">
                            <!-- Concatenación en vez de formato: un `%` suelto
                                 en una cadena de formato rompe el renderizado. -->
                            <col t-att-style="'width: ' + str(period_width) + '%'"/>
                        </t>
                    </colgroup>
                    <thead>
                        <tr class="pe-doc-thead text-center">
                            <td rowspan="2" class="align-middle">EDT</td>
                            <td rowspan="2" class="align-middle">Tarea</td>
                            <td rowspan="2" class="align-middle">Inicio / Fin</td>
                            <t t-foreach="period_groups" t-as="group">
                                <td t-att-colspan="group['count']" style="padding: 2px; font-size: 9px; white-space: nowrap; overflow: hidden;" t-esc="group['label']"/>
                            </t>
                        </tr>
                        <tr class="pe-doc-thead text-center">
                            <t t-foreach="periods" t-as="period">
                                <td style="padding: 2px; font-size: 9px;" t-esc="period['label']"/>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="rows" t-as="row">
                            <tr t-att-style="'font-weight: bold;' if row['is_project'] else None">
                                <td class="text-center" style="padding: 2px 4px; color: #595959;" t-esc="row['code']"/>
                                <td t-att-style="'padding: 2px 4px 2px %spx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;' % (4 + row['level'] * 9)">
                                    <t t-esc="row['name']"/>
                                    <t t-if="row['critical']">
                                        <strong style="color: #c0392b;"> ▲</strong>
                                    </t>
                                </td>
                                <td class="text-center" style="padding: 2px 4px; white-space: nowrap; color: #595959;">
                                    <!-- Días ya pasados a la zona del usuario en build_matrix. -->
                                    <t t-esc="row['dates_label']"/>
                                </td>
                                <t t-foreach="row['cells']" t-as="cell">
                                    <td style="padding: 3px 1px; vertical-align: middle;">
                                        <t t-if="cell">
                                            <span t-att-style="'display: block; height: 9px; border-radius: 2px; background-color: %s' % (row['color'] or '#595959')"/>
                                        </t>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="pe-doc-fs-11 mt-2" style="color: #595959;">
                    <t t-foreach="legend" t-as="entry">
                        <span style="margin-right: 14px;">
                            <span t-att-style="'display: inline-block; width: 9px; height: 9px; border-radius: 2px; vertical-align: -1px; margin-right: 3px; background-color: %s' % entry['color']"/>
                            <t t-esc="entry['label']"/>
                        </span>
                    </t>
                    <span><strong style="color: #c0392b;">▲</strong> ruta crítica</span>
                </div>
            </t>
        </t>
    </template>

</odoo>
