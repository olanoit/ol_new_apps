<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_gantt" model="ir.actions.report">
        <field name="name">Diagrama de Gantt</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_project_gantt_base.report_gantt</field>
        <field name="paperformat_id" ref="al_report_base.paperformat_pe_a4_landscape"/>
        <field name="print_report_name">'Gantt - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_type">report</field>
        <!-- El informe exige el grupo del Gantt (lo comprueba get_data): sin
             esto, cualquier usuario de Proyecto lo vería en Imprimir y fallaría. -->
        <field name="group_ids" eval="[Command.set([ref('al_project_gantt_base.group_gantt_user')])]"/>
    </record>

</odoo>
