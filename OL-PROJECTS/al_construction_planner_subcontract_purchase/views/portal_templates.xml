<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_construction_extra_button" inherit_id="al_construction_planner_subcontract.portal_my_construction">
        <xpath expr="//a[@href='/my/obra/avances']" position="before">
            <a t-if="rows" href="/my/obra/material" class="btn btn-primary">Pedir material extra</a>
        </xpath>
    </template>

    <template id="portal_construction_extra" name="Material extra">
        <t t-call="portal.portal_layout">
            <h3 class="my-3">Pedir material extra · <t t-out="project.name"/></h3>
            <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
            <div t-if="done" class="alert alert-success" role="alert">
                Pedido <t t-out="done.name"/> registrado: queda en borrador hasta que la jefatura de
                proyectos lo revise. No reserva material del almacén.
            </div>
            <form t-if="len(projects) &gt; 1" method="get" action="/my/obra/material" class="mb-3">
                <label class="form-label" for="project_id">Obra</label>
                <select class="form-select" name="project_id" id="project_id" onchange="this.form.submit()">
                    <option t-foreach="projects" t-as="p" t-att-value="p.id"
                            t-att-selected="p.id == project.id" t-out="p.name"/>
                </select>
            </form>
            <div t-if="not places or not products" class="alert alert-info">
                No hay pisos o materiales del plan vigente de esta obra para pedir.
            </div>
            <form t-else="" id="o_construction_extra_form" method="post" enctype="multipart/form-data"
                  t-attf-action="/my/obra/material?project_id=#{project.id}">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label" for="task_id">Dónde se usa</label>
                        <select class="form-select" name="task_id" id="task_id" required="required">
                            <option value="">Elija dónde se usa</option>
                            <option t-foreach="places" t-as="place" t-att-value="place.id" t-out="place._construction_path_name()"/>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="reason">Motivo</label>
                        <select class="form-select" name="reason" id="reason" required="required">
                            <option value="">Elija el motivo</option>
                            <option t-foreach="reasons" t-as="reason" t-att-value="reason[0]" t-out="reason[1]"/>
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label" for="product_id">Material</label>
                        <select class="form-select" name="product_id" id="product_id" required="required">
                            <option value="">Elija el material</option>
                            <option t-foreach="products" t-as="product" t-att-value="product.id" t-out="product.display_name"/>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="qty">Cantidad</label>
                        <input type="number" step="any" min="0" inputmode="decimal" class="form-control"
                               name="qty" id="qty" required="required"/>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label" for="note">Detalle</label>
                        <textarea class="form-control" name="note" id="note" rows="2"
                                  placeholder="Qué pasó y para qué se necesita"/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="photo">Foto (opcional)</label>
                        <input type="file" class="form-control" name="photo" id="photo"
                               accept="image/*" capture="environment"/>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Enviar pedido</button>
                    <a href="/my/obra" class="btn btn-secondary">Volver</a>
                </div>
            </form>
        </t>
    </template>

</odoo>
