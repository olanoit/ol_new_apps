<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_replacement_company" model="ir.rule">
            <field name="name">Reposición a planta: multicompañía</field>
            <field name="model_id" ref="model_construction_replacement_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <!-- Solicitante: lo suyo y lo de las obras que sigue o dirige, como el requerimiento. -->
        <record id="rule_replacement_requester" model="ir.rule">
            <field name="name">Reposición a planta: propias y de mis obras</field>
            <field name="model_id" ref="model_construction_replacement_request"/>
            <field name="domain_force">['|', '|',
                ('requested_by', '=', user.id),
                ('project_id.user_id', '=', user.id),
                ('project_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[Command.link(ref('al_construction_material_request.group_construction_requester'))]"/>
        </record>
        <record id="rule_replacement_all" model="ir.rule">
            <field name="name">Reposición a planta: todas</field>
            <field name="model_id" ref="model_construction_replacement_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('al_construction_material_request.group_construction_logistics')), Command.link(ref('mrp.group_mrp_user'))]"/>
        </record>
    </data>
</odoo>
