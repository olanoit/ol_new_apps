<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="al_construction_planner_sale.IndicatorSheet">
        <div class="o_action o_cp_indicator_sheet h-100 overflow-auto px-3 py-2">
            <t t-if="data.empty">
                <div class="o_view_nocontent">
                    <div class="o_nocontent_help">
                        <p class="o_view_nocontent_empty_folder">La obra no tiene plan de recursos</p>
                        <p>Los indicadores salen del plan, la venta y la contabilidad de la obra.</p>
                    </div>
                </div>
            </t>
            <t t-elif="state.data">
                <!-- 1. Encabezado -->
                <div class="o_cp_is_header d-flex flex-wrap align-items-center gap-2 mb-2">
                    <button class="btn btn-link p-0 o_cp_is_star" t-on-click="toggleFavorite"
                            t-att-title="data.is_favorite ? 'Quitar de favoritas' : 'Marcar como favorita'">
                        <i t-att-class="data.is_favorite ? 'fa fa-star text-warning' : 'fa fa-star-o text-muted'"/>
                    </button>
                    <span t-attf-class="o_cp_dot o_cp_dot_{{data.light or 'none'}}"/>
                    <h4 class="m-0" t-esc="data.name"/>
                    <span class="text-muted" t-esc="data.partner"/>
                    <span class="badge text-bg-light" t-esc="stageLabel"/>
                    <span class="small text-muted">
                        <t t-esc="data.schedule.start?.label"/> → <t t-esc="data.schedule.end?.label"/>
                    </span>
                    <div class="ms-auto d-flex flex-wrap gap-1">
                        <button class="btn btn-sm btn-secondary o_cp_is_open_schedule" t-on-click="() => this.open('schedule')">Cronograma valorizado</button>
                        <button class="btn btn-sm btn-secondary o_cp_is_open_valuations" t-on-click="() => this.open('valuation')">Valorizaciones</button>
                        <button class="btn btn-sm btn-secondary o_cp_is_open_control" t-on-click="() => this.open('control')">Análisis de control</button>
                        <button class="btn btn-sm btn-secondary o_cp_is_open_changes" t-on-click="() => this.open('change')">Cambios de obra</button>
                        <button class="btn btn-sm btn-light" t-on-click="load" t-att-disabled="state.loading" title="Actualizar">
                            <i class="fa fa-refresh"/>
                        </button>
                    </div>
                </div>

                <!-- 2. Presupuestado contra ejecutado -->
                <h6 class="o_cp_is_section">Presupuestado contra ejecutado <small class="text-muted">· miles de <t t-esc="data.currency_symbol"/>, sin IGV</small></h6>
                <ConstructionIndicatorBlocks budget="data.budget" executed="data.executed"
                                             lights="data.lights" monthTitle="data.month_label"
                                             extraClose="extraClose"/>

                <div class="row g-2 mt-1">
                    <!-- 3. Seguimiento -->
                    <div class="col-lg-6">
                        <h6 class="o_cp_is_section">Seguimiento</h6>
                        <div class="d-flex flex-wrap gap-3 o_cp_is_tracking">
                            <div><div class="small text-muted">Facturado</div><b t-esc="k(data.tracking.invoiced)"/></div>
                            <div><div class="small text-muted">Cobrado</div><b t-esc="k(data.tracking.collected)"/></div>
                            <div><div class="small text-muted">Por cobrar</div><b t-esc="k(data.tracking.receivable)"/></div>
                            <div><div class="small text-muted">Comprometido</div><b t-esc="k(data.tracking.committed)"/></div>
                            <div><div class="small text-muted">Por gastar hasta el cierre</div><b t-esc="k(data.tracking.to_spend)"/></div>
                            <div title="Valor ganado ÷ costo ejecutado">
                                <div class="small text-muted">Índice de costo (CPI)</div>
                                <b t-attf-class="o_cp_is_cpi o_cp_light_{{data.lights.cpi}}" t-esc="idx(data.cpi)"/>
                            </div>
                            <div title="Valor ganado ÷ costo programado a hoy">
                                <div class="small text-muted">Índice de plazo (SPI)</div>
                                <b t-attf-class="o_cp_is_spi o_cp_light_{{data.lights.spi}}" t-esc="idx(data.spi)"/>
                            </div>
                        </div>
                    </div>
                    <!-- 4. Plazo -->
                    <div class="col-lg-6">
                        <h6 class="o_cp_is_section">Plazo
                            <small t-if="data.schedule.days_late &gt; 0" class="o_cp_light_red o_cp_is_late">· <t t-esc="data.schedule.days_late"/> días de atraso</small>
                            <small t-elif="data.schedule.estimated_end" class="o_cp_light_green o_cp_is_late">· a tiempo</small>
                        </h6>
                        <div class="o_cp_is_timeline">
                            <div class="o_cp_is_timeline_bar"/>
                            <t t-foreach="[['start', 'Inicio'], ['today', 'Hoy'], ['end', 'Fin del contrato'], ['estimated_end', 'Fin estimado']]" t-as="mark" t-key="mark[0]">
                                <div t-if="data.schedule[mark[0]]" t-attf-class="o_cp_is_mark o_cp_is_mark_{{mark[0]}}"
                                     t-attf-style="left: {{data.schedule[mark[0]].pos}}%">
                                    <div class="o_cp_is_mark_pin"/>
                                    <div class="o_cp_is_mark_label"><t t-esc="mark[1]"/><br/><t t-esc="data.schedule[mark[0]].label"/></div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- 5. Avance físico contra valorizado -->
                <t t-set="pc" t-value="progressChart"/>
                <t t-set="cc" t-value="costChart"/>
                <div class="row g-2 mt-2">
                    <div class="col-xl-6 o_cp_is_chart o_cp_is_progress_chart" t-if="pc">
                        <h6 class="o_cp_is_section">Avance físico contra valorizado</h6>
                        <svg t-attf-viewBox="0 0 {{chart.width}} {{chart.height}}" preserveAspectRatio="none">
                            <t t-foreach="pc.ticks" t-as="tick" t-key="tick_index">
                                <line class="o_cp_grid" t-att-x1="chart.left" t-att-x2="chart.width - chart.right" t-att-y1="tick.y" t-att-y2="tick.y"/>
                                <text class="o_cp_axis" t-att-x="chart.left - 6" t-att-y="tick.y + 4" text-anchor="end" t-esc="tick.label"/>
                            </t>
                            <t t-foreach="pc.xTicks" t-as="tick" t-key="tick_index">
                                <text class="o_cp_axis" t-att-x="tick.x" t-att-y="chart.height - 8" text-anchor="middle" t-esc="tick.label"/>
                            </t>
                            <polyline class="o_cp_s_planned" t-att-points="pc.planned"/>
                            <polyline class="o_cp_s_valued" t-att-points="pc.valued"/>
                            <polyline class="o_cp_s_physical" t-att-points="pc.physical"/>
                            <line class="o_cp_today" t-att-x1="pc.todayX" t-att-x2="pc.todayX" t-att-y1="chart.top" t-att-y2="chart.height - chart.bottom"/>
                            <line class="o_cp_gap" t-att-x1="pc.todayX" t-att-x2="pc.todayX" t-att-y1="pc.gapTop" t-att-y2="pc.gapBottom"/>
                            <text class="o_cp_gap_label" t-att-x="pc.todayX - 6" t-att-y="(pc.gapTop + pc.gapBottom) / 2" text-anchor="end" t-esc="pc.gapLabel"/>
                        </svg>
                        <div class="o_cp_is_legend small">
                            <span><i class="o_cp_key o_cp_key_physical"/>Avance físico</span>
                            <span><i class="o_cp_key o_cp_key_valued"/>Valorizado</span>
                            <span><i class="o_cp_key o_cp_key_planned"/>Valorización presupuestada</span>
                            <span><i class="o_cp_key o_cp_key_today"/>Hoy</span>
                        </div>
                    </div>
                    <!-- 6. Curva S de costo -->
                    <div class="col-xl-6 o_cp_is_chart o_cp_is_cost_chart" t-if="cc">
                        <h6 class="o_cp_is_section">Curva S de costo <small class="text-muted">· miles</small></h6>
                        <svg t-attf-viewBox="0 0 {{chart.width}} {{chart.height}}" preserveAspectRatio="none">
                            <t t-foreach="cc.ticks" t-as="tick" t-key="tick_index">
                                <line class="o_cp_grid" t-att-x1="chart.left" t-att-x2="chart.width - chart.right" t-att-y1="tick.y" t-att-y2="tick.y"/>
                                <text class="o_cp_axis" t-att-x="chart.left - 6" t-att-y="tick.y + 4" text-anchor="end" t-esc="tick.label"/>
                            </t>
                            <t t-foreach="cc.xTicks" t-as="tick" t-key="tick_index">
                                <text class="o_cp_axis" t-att-x="tick.x" t-att-y="chart.height - 8" text-anchor="middle" t-esc="tick.label"/>
                            </t>
                            <polyline class="o_cp_s_planned_cost" t-att-points="cc.planned"/>
                            <polyline class="o_cp_s_earned" t-att-points="cc.earned"/>
                            <polyline t-if="cc.actual" class="o_cp_s_actual" t-att-points="cc.actual"/>
                            <line class="o_cp_today" t-att-x1="cc.todayX" t-att-x2="cc.todayX" t-att-y1="chart.top" t-att-y2="chart.height - chart.bottom"/>
                        </svg>
                        <div class="o_cp_is_legend small">
                            <span><i class="o_cp_key o_cp_key_planned_cost"/>Costo programado</span>
                            <span><i class="o_cp_key o_cp_key_earned"/>Valor ganado</span>
                            <span><i class="o_cp_key o_cp_key_actual"/>Costo ejecutado</span>
                            <span><i class="o_cp_key o_cp_key_today"/>Hoy</span>
                        </div>
                    </div>
                </div>

                <!-- 7. Tablas -->
                <h6 class="o_cp_is_section mt-3">Valorizaciones del contrato</h6>
                <table class="table table-sm table-hover o_cp_is_table o_cp_is_valuations">
                    <thead><tr><th>Valorización</th><th>Corte</th><th class="text-end">Meta aprobada</th><th class="text-end">Valorizado</th><th class="text-end">Facturado</th><th class="text-end">Cobrado</th><th>Estado</th></tr></thead>
                    <tbody>
                        <tr t-foreach="data.valuations" t-as="row" t-key="row.id" class="cursor-pointer" t-on-click="() => this.open('valuation', row.id)">
                            <td t-esc="row.name"/><td t-esc="row.cutoff"/>
                            <td class="text-end" t-esc="k(row.target)"/><td class="text-end" t-esc="k(row.valued)"/>
                            <td class="text-end" t-esc="k(row.invoiced)"/><td class="text-end" t-esc="k(row.collected)"/>
                            <td t-esc="row.state"/>
                        </tr>
                        <tr t-if="!data.valuations.length"><td colspan="7" class="text-muted">Sin valorizaciones.</td></tr>
                    </tbody>
                </table>
                <h6 class="o_cp_is_section">Por especialidad</h6>
                <table class="table table-sm o_cp_is_table o_cp_is_specialties">
                    <thead><tr><th>Especialidad</th><th class="text-end">Costo meta</th><th class="text-end">Avance presup.</th><th class="text-end">Avance físico</th><th class="text-end">Valorizado</th><th class="text-end" title="Valor ganado ÷ ejecutado valorizado al costo del plan">Índice de costo</th></tr></thead>
                    <tbody>
                        <tr t-foreach="data.specialties" t-as="row" t-key="row_index">
                            <td t-esc="row.name"/><td class="text-end" t-esc="k(row.target)"/>
                            <td class="text-end" t-esc="pct(row.progress_planned)"/><td class="text-end" t-esc="pct(row.progress)"/>
                            <td class="text-end" t-esc="k(row.valued)"/><td class="text-end" t-esc="idx(row.cpi)"/>
                        </tr>
                    </tbody>
                </table>
                <h6 class="o_cp_is_section">Cambios de obra</h6>
                <table class="table table-sm table-hover o_cp_is_table o_cp_is_changes">
                    <thead><tr><th>Cambio</th><th>Fecha</th><th>Tipo</th><th>Cobro</th><th class="text-end">Venta</th><th class="text-end">Costo</th><th class="text-end">Margen</th><th>Estado</th></tr></thead>
                    <tbody>
                        <tr t-foreach="data.changes" t-as="row" t-key="row.id" class="cursor-pointer" t-on-click="() => this.open('change', row.id)">
                            <td t-esc="row.name"/><td t-esc="row.date"/><td t-esc="row.kind"/><td t-esc="row.billing"/>
                            <td class="text-end" t-esc="k(row.sale)"/><td class="text-end" t-esc="k(row.cost)"/>
                            <td class="text-end" t-esc="k(row.margin)"/><td t-esc="row.state"/>
                        </tr>
                        <tr t-if="!data.changes.length"><td colspan="8" class="text-muted">Sin cambios de obra.</td></tr>
                    </tbody>
                </table>
                <div class="small text-muted mb-3">
                    Montos en miles de <t t-esc="data.currency_symbol"/>, sin IGV. Presupuestado: plan y calendario de valorizaciones de la obra. Ejecutado: contabilidad analítica, avance por partida y valorizaciones confirmadas. Índices según la guía PMBOK.
                </div>
            </t>
        </div>
    </t>

</templates>
