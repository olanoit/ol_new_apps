<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Importación del presupuesto con secciones (CREVAL v1.0, 6.4) -->
    <record id="construction_budget_import_wizard_view_form" model="ir.ui.view">
        <field name="name">construction.budget.import.wizard.form</field>
        <field name="model">construction.budget.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar presupuesto">
                <field name="state" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group invisible="state != 'upload'">
                    <field name="sale_order_id"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="product_id" options="{'no_create': True}" placeholder="Partida de presupuesto"/>
                </group>
                <div invisible="state != 'upload'" class="text-muted small">
                    Columnas: Ítem, Descripción, Unidad, Metrado, Precio unitario y Parcial. Las filas
                    sin metrado ni precio son títulos: el nivel 1 entra como sección y el nivel 2 como
                    subsección. Las unidades se leen con Configuración › Equivalencias de unidades.
                </div>
                <group invisible="state == 'upload'">
                    <field name="amount_file"/>
                </group>
                <field name="preview_html" nolabel="1" invisible="state == 'upload'"/>
                <footer>
                    <button name="action_preview" type="object" string="Revisar" class="btn-primary"
                            invisible="state != 'upload'" data-hotkey="q"/>
                    <button name="action_import" type="object" string="Crear líneas en la cotización"
                            class="btn-primary" invisible="state != 'preview'"/>
                    <button string="Cerrar" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_order_view_form_construction_budget" model="ir.ui.view">
        <field name="name">sale.order.form.construction.budget</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_construction_import_budget" type="object" string="Importar presupuesto"
                        invisible="state not in ('draft', 'sent')"
                        groups="al_construction_planner.group_planner_plan_planner"/>
                <field name="project_id" invisible="1"/>
                <button name="action_construction_create_levels" type="object" string="Crear niveles de la obra"
                        invisible="not project_id"
                        groups="al_construction_planner.group_planner_plan_planner"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='name']" position="before">
                <field name="construction_budget_item" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='name']" position="after">
                <field name="construction_line_role" optional="hide"/>
            </xpath>
            <!-- Costo real, holguras y precio (CREVAL v1.0, 6.5): columnas internas. -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="before">
                <field name="construction_qty_real" optional="hide"/>
                <field name="construction_qty_slack_pct" optional="hide"/>
                <field name="construction_qty_slack" optional="hide"/>
                <field name="construction_cost_apu" optional="hide"/>
                <field name="construction_cost_slack_pct" optional="hide"/>
                <field name="construction_cost_slack" optional="hide"/>
                <field name="construction_cost_offered" optional="hide"/>
                <field name="construction_margin_pct" optional="hide"/>
                <field name="construction_margin_amount" optional="hide"/>
                <field name="construction_amount_reserve" optional="hide" sum="Reserva"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="construction_contract_type" invisible="not project_id"/>
                <field name="construction_print_format" invisible="not project_id"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not construction_layers_warning">
                    <field name="construction_layers_warning" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="after">
                <field name="construction_amount_real" invisible="not construction_amount_real"/>
                <field name="construction_amount_reserve" invisible="not construction_amount_real"/>
            </xpath>
        </field>
    </record>

    <record id="construction_resource_plan_view_form_reserve" model="ir.ui.view">
        <field name="name">construction.resource.plan.form.reserve</field>
        <field name="model">construction.resource.plan</field>
        <field name="inherit_id" ref="al_construction_planner.construction_resource_plan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="construction_reserve_amount" invisible="not construction_reserve_amount"/>
            </xpath>
        </field>
    </record>
</odoo>
