<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_construction_sale" model="ir.ui.view">
        <field name="name">res.config.settings.form.construction.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="al_construction_planner.res_config_settings_view_form_construction_planner"/>
        <field name="arch" type="xml">
            <block name="construction_planner_contracts" position="after">
                    <!-- Paquete 7 de CREVAL, CR-61 y CR-62. -->
                    <block title="Indicadores de obra" name="construction_planner_indicators">
                        <setting company_dependent="1" id="construction_default_progress" string="Avance de la partida"
                                 help="Regla de las obras nuevas para el avance físico y la valorización. «Avance valorizado» pondera contrata, personal propio y material.">
                            <field name="construction_default_progress_source"/>
                        </setting>
                        <setting company_dependent="1" id="construction_change_product" string="Adicional de obra"
                                 help="Producto de servicio, sin seguimiento que cree tareas, de la línea que el cambio cobrable agrega a la orden de venta del contrato.">
                            <field name="construction_change_product_id" options="{'no_create': True}"/>
                        </setting>
                        <setting company_dependent="1" id="construction_excluded_accounts" string="Cuentas fuera del costo de obra"
                                 help="Prefijos de cuentas, separados por coma, que no suman al costo ejecutado ni al ingreso de la obra (en Perú, 9 y 79: destinos y cargas imputables).">
                            <field name="construction_excluded_account_prefixes"/>
                        </setting>
                        <setting company_dependent="1" id="construction_indicator_lights" string="Semáforo de la cartera"
                                 help="Índices de costo y de plazo, y margen previsto al cierre: verde desde el primer valor, ámbar desde el segundo, rojo por debajo.">
                            <div class="content-group">
                                <div class="row"><label class="col-lg-5" for="construction_index_green"/><field name="construction_index_green" class="oe_inline"/></div>
                                <div class="row"><label class="col-lg-5" for="construction_index_amber"/><field name="construction_index_amber" class="oe_inline"/></div>
                                <div class="row"><label class="col-lg-5" for="construction_margin_green"/><field name="construction_margin_green" class="oe_inline"/> %</div>
                                <div class="row"><label class="col-lg-5" for="construction_margin_amber"/><field name="construction_margin_amber" class="oe_inline"/> %</div>
                            </div>
                        </setting>
                    </block>
                    <!-- CREVAL, paquete 5, CR-40. -->
                    <block title="Hoja de presupuesto" name="construction_planner_budget_sheet">
                        <setting company_dependent="1" id="construction_budget_footer" string="Pie por defecto"
                                 help="Lo que OBRA de una hoja de presupuesto nueva toma si la cotización no lo trae.">
                            <div class="content-group">
                                <div class="row"><label class="col-lg-5" for="construction_budget_overhead_pct"/><field name="construction_budget_overhead_pct" class="oe_inline"/> %</div>
                                <div class="row"><label class="col-lg-5" for="construction_budget_contingency_pct"/><field name="construction_budget_contingency_pct" class="oe_inline"/> %</div>
                                <div class="row"><label class="col-lg-5" for="construction_budget_profit_pct"/><field name="construction_budget_profit_pct" class="oe_inline"/> %</div>
                                <div class="row"><label class="col-lg-5" for="construction_budget_margin_pct"/><field name="construction_budget_margin_pct" class="oe_inline"/> %</div>
                            </div>
                        </setting>
                        <setting company_dependent="1" id="construction_budget_controls" string="Avisos de la hoja"
                                 help="Precio antiguo en INSUMOS y umbral de CONTROL (vendido frente a planificado).">
                            <div class="content-group">
                                <div class="row"><label class="col-lg-5" for="construction_budget_price_days"/><field name="construction_budget_price_days" class="oe_inline"/></div>
                                <div class="row"><label class="col-lg-5" for="construction_budget_control_pct"/><field name="construction_budget_control_pct" class="oe_inline"/> %</div>
                            </div>
                        </setting>
                    </block>
                    <block title="Ingresos" name="construction_planner_income">
                        <setting company_dependent="1" id="construction_valuation_calendar" string="Calendario de valorización"
                                 help="Valores por defecto de las obras nuevas (pestaña «Calendario e ingresos»). Una fecha que cae en día no hábil pasa al siguiente día hábil.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="construction_valuation_unit" class="col-lg-5 o_light_label"/>
                                    <field name="construction_valuation_unit"/>
                                </div>
                                <div class="row" invisible="construction_valuation_unit != 'week'">
                                    <label for="construction_valuation_every" class="col-lg-5 o_light_label"/>
                                    <field name="construction_valuation_every" class="oe_inline"/>
                                </div>
                                <div class="row">
                                    <label for="construction_valuation_submit_days" class="col-lg-5 o_light_label"/>
                                    <field name="construction_valuation_submit_days" class="oe_inline"/>
                                </div>
                                <div class="row">
                                    <label for="construction_client_confirm_days" class="col-lg-5 o_light_label"/>
                                    <field name="construction_client_confirm_days" class="oe_inline"/>
                                </div>
                                <div class="row">
                                    <label for="construction_invoice_days" class="col-lg-5 o_light_label"/>
                                    <field name="construction_invoice_days" class="oe_inline"/>
                                </div>
                                <div class="row">
                                    <label for="construction_collection_days" class="col-lg-5 o_light_label"/>
                                    <field name="construction_collection_days" class="oe_inline"/>
                                </div>
                                <div class="row">
                                    <label for="construction_income_calendar_id" class="col-lg-5 o_light_label"/>
                                    <field name="construction_income_calendar_id" options="{'no_create': True}"/>
                                </div>
                            </div>
                        </setting>
                        <setting company_dependent="1" id="construction_valuation_retentions" string="Adelanto y fondo de garantía"
                                 help="Con cuenta, la factura de la valorización lleva el fondo de garantía y la amortización del adelanto como líneas negativas y su total es el neto. Sin cuenta, la factura va por lo confirmado y ambos quedan en la valorización.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="construction_advance_pct" class="col-lg-5 o_light_label"/>
                                    <field name="construction_advance_pct" class="oe_inline"/>
                                </div>
                                <div class="row">
                                    <label for="construction_advance_amortization_pct" class="col-lg-5 o_light_label"/>
                                    <field name="construction_advance_amortization_pct" class="oe_inline"/>
                                </div>
                                <div class="row">
                                    <label for="construction_guarantee_pct" class="col-lg-5 o_light_label"/>
                                    <field name="construction_guarantee_pct" class="oe_inline"/>
                                </div>
                                <div class="row">
                                    <label for="construction_guarantee_release" class="col-lg-5 o_light_label"/>
                                    <field name="construction_guarantee_release"/>
                                </div>
                                <div class="row">
                                    <label for="construction_guarantee_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="construction_guarantee_account_id" options="{'no_create': True}"/>
                                </div>
                                <div class="row">
                                    <label for="construction_advance_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="construction_advance_account_id" options="{'no_create': True}"/>
                                </div>
                            </div>
                        </setting>
                        <setting company_dependent="1" id="construction_invoice_form" string="Factura de la valorización"
                                 help="Por partida o una línea por valorización; cada contrato puede tener la suya. El texto admite {numero}, {obra}, {os}, {fondo} y {amortizacion}.">
                            <div class="content-group">
                                <div class="row"><label for="construction_invoice_form" class="col-lg-5 o_light_label"/>
                                    <field name="construction_invoice_form"/></div>
                                <div class="row"><label for="construction_invoice_product_id" class="col-lg-5 o_light_label"/>
                                    <field name="construction_invoice_product_id" options="{'no_create': True}"/></div>
                                <div class="row"><label for="construction_invoice_text" class="col-lg-5 o_light_label"/>
                                    <field name="construction_invoice_text"/></div>
                            </div>
                        </setting>
                        <setting company_dependent="1" id="construction_sheet_change_pct" string="Envío del presupuesto"
                                 help="En la revisión del libro o de la hoja de trabajo, las partidas que bajan a 0 o cambian más que este porcentaje salen en rojo.">
                            <field name="construction_sheet_change_pct" class="oe_inline"/> %
                        </setting>
                    </block>
            </block>
        </field>
    </record>
</odoo>
