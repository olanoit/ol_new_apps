<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="al_project_gantt_backend.GanttAction">
        <!-- El raíz es flex column: sin él, `main.o_content` cuelga de
             `o_action_manager` (display block) y no recibe altura. -->
        <div class="o_algantt_root">
        <Layout display="this.display" className="'o_algantt_action'">
            <div class="algantt-wrapper d-flex flex-column h-100">

                <div class="algantt-toolbar d-flex flex-wrap align-items-center gap-3 p-2 border-bottom">
                    <div class="algantt-projects d-flex flex-wrap align-items-center gap-1" t-if="this.showProjectBar">
                        <span class="fw-bold me-1">Proyectos:</span>
                        <t t-if="!this.projectButtons.length">
                            <span class="text-muted">Ninguno visible</span>
                        </t>
                        <t t-foreach="this.projectButtons" t-as="project" t-key="project.id">
                            <button type="button"
                                    class="btn btn-sm"
                                    t-att-class="this.isSelected(project.id) ? 'btn-primary' : 'btn-outline-secondary'"
                                    t-on-click="() => this.onProjectToggle(project.id)">
                                <t t-out="project.name"/>
                                <span class="badge text-bg-light ms-1" t-out="project.task_count"/>
                            </button>
                        </t>
                        <button type="button" class="btn btn-sm btn-link"
                                t-if="!this.state.pinnedToProject and this.state.availableProjects.length > 1"
                                t-on-click="() => this.onSelectAll()">Todos</button>
                        <!-- Al llegar desde el botón inteligente del proyecto,
                             la vista viene acotada: se ofrece salir de ahí. -->
                        <button type="button" class="btn btn-sm btn-link"
                                t-if="this.state.pinnedToProject"
                                t-on-click="() => this.onShowAllProjects()">Ver todos los proyectos</button>
                    </div>

                    <!-- Punto de extensión: contenido propio de una pantalla heredada. -->
                    <t t-if="this.toolbarTemplate" t-call="{{ this.toolbarTemplate }}"/>

                    <div class="algantt-tools d-flex flex-wrap align-items-center gap-2 ms-auto">
                        <div class="algantt-search input-group input-group-sm" style="width: 210px;">
                            <span class="input-group-text"><i class="oi" data-icon="search"/></span>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Buscar tarea…"
                                   t-att-value="this.state.search"
                                   t-on-input="this.onSearchInput"/>
                            <button type="button" class="btn btn-outline-secondary"
                                    t-if="this.state.search"
                                    t-on-click="() => this.clearSearch()">×</button>
                        </div>
                        <span class="small text-muted" t-if="this.searchLabel" t-out="this.searchLabel"/>

                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-secondary"
                                    t-att-class="this.state.showWbs ? 'active' : ''"
                                    title="Mostrar el código EDT (1, 1.1, 1.2…)"
                                    t-on-click="() => this.onToggleWbs()">EDT</button>
                            <button type="button" class="btn btn-outline-secondary"
                                    t-att-title="this.state.expanded ? 'Contraer todo' : 'Expandir todo'"
                                    t-on-click="() => this.toggleExpand()">
                                <i t-att-data-icon="this.state.expanded ? 'close_fullscreen' : 'expand_content'"/>
                            </button>
                            <button type="button" class="btn btn-outline-secondary"
                                    t-att-class="this.state.hideDone ? 'active' : ''"
                                    title="Ocultar tareas terminadas y canceladas"
                                    t-on-click="() => this.onToggleHideDone()">
                                <i class="oi" data-icon="check_box"/>
                            </button>
                            <button type="button" class="btn btn-outline-secondary"
                                    title="Pantalla completa"
                                    t-on-click="() => this.onToggleFullscreen()">
                                <i class="oi" data-icon="open_with"/>
                            </button>
                        </div>

                        <button type="button" class="btn btn-sm btn-outline-primary"
                                t-if="this.state.meta.can_create"
                                t-on-click="() => this.onAddTask()">
                            <i class="oi me-1" data-icon="add"/>Tarea
                        </button>

                        <button type="button" class="btn btn-sm"
                                t-att-class="this.state.criticalPath ? 'btn-danger' : 'btn-outline-secondary'"
                                t-on-click="() => this.onToggleCriticalPath()"
                                title="Resalta las tareas sin holgura (calculado en el servidor)">
                            <i class="oi me-1" data-icon="flash_on"/>Ruta crítica
                            <span class="badge text-bg-light ms-1"
                                  t-if="this.criticalLabel !== null" t-out="this.criticalLabel"/>
                        </button>

                        <div class="form-check form-switch mb-0" t-if="this.state.meta.can_reschedule_chain and this.state.meta.editable">
                            <input id="algantt_chain" type="checkbox" class="form-check-input"
                                   t-att-checked="this.state.rescheduleChain"
                                   t-on-change="() => this.onToggleRescheduleChain()"/>
                            <label class="form-check-label small" for="algantt_chain"
                                   title="Al mover una tarea, empuja las que dependen de ella">
                                Encadenar
                            </label>
                        </div>

                        <div class="d-flex align-items-center gap-1">
                            <select class="form-select form-select-sm w-auto"
                                    t-on-change="this.onBaselineChange"
                                    title="Comparar contra una línea base">
                                <option value="">Sin línea base</option>
                                <t t-foreach="this.baselineOptions" t-as="baseline" t-key="baseline.id">
                                    <option t-att-value="baseline.id"
                                            t-att-selected="baseline.selected"
                                            t-out="baseline.name"/>
                                </t>
                            </select>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    t-on-click="() => this.onCaptureBaseline()"
                                    title="Guardar una foto del plan actual">
                                <i class="oi" data-icon="photo_camera"/>
                            </button>
                        </div>

                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-secondary"
                                    title="Descargar el diagrama en Excel (dos hojas: tareas y diagrama)"
                                    t-on-click="() => this.onExportXlsx()">
                                <i class="oi" data-icon="table_chart"/>
                            </button>
                            <button type="button" class="btn btn-outline-secondary"
                                    title="Descargar el diagrama en PDF (A3 apaisado)"
                                    t-on-click="() => this.onExportPdf()">
                                <i class="oi" data-icon="picture_as_pdf"/>
                            </button>
                        </div>

                        <span class="small text-muted" t-if="this.state.saving">Guardando…</span>
                        <span class="small text-success" t-elif="this.state.lastSavedAt">
                            <i class="oi me-1" data-icon="check"/><t t-out="this.state.lastSavedAt"/>
                        </span>

                        <button type="button" class="btn btn-sm"
                                t-att-class="this.state.showFilters ? 'btn-secondary' : 'btn-outline-secondary'"
                                t-on-click="() => this.toggleFilters()">
                            <i class="oi oi-filled me-1" data-icon="filter_alt"/>Filtros
                            <span class="badge text-bg-primary ms-1"
                                  t-if="this.activeFilterCount"
                                  t-out="this.activeFilterCount"/>
                        </button>
                        <label class="mb-0" for="algantt_zoom">Escala:</label>
                        <select id="algantt_zoom" class="form-select form-select-sm w-auto"
                                t-on-change="this.onZoomChange">
                            <t t-foreach="this.zoomLevels" t-as="level" t-key="level.key">
                                <option t-att-value="level.key"
                                        t-att-selected="level.key === this.state.zoom"
                                        t-out="level.label"/>
                            </t>
                        </select>
                    </div>
                </div>

                <!-- Barra de selección: casillas marcadas y acciones propias de
                     una pantalla heredada (`extraToolbarButtons`). -->
                <div class="algantt-actionbar d-flex flex-wrap align-items-center gap-2 px-2 py-1 border-bottom"
                     t-if="this.showActionBar">
                    <t t-if="this.selection">
                        <span class="small" t-if="this.state.selectionCount">
                            <i class="oi oi-filled me-1" data-icon="check_box"/>
                            <span class="algantt-selection-count" t-out="this.state.selectionCount"/> fila(s) marcada(s)
                        </span>
                        <span class="small text-muted" t-else="">Marque filas en la primera columna</span>
                        <button type="button" class="btn btn-sm btn-link algantt-selection-clear"
                                t-if="this.state.selectionCount"
                                t-on-click="() => this.clearSelection()">Quitar selección</button>
                    </t>
                    <div class="d-flex flex-wrap gap-1 ms-auto">
                        <t t-foreach="this.extraToolbarButtons" t-as="button" t-key="button.key">
                            <button type="button" class="btn btn-sm btn-outline-primary algantt-extra-button"
                                    t-att-data-key="button.key"
                                    t-att-disabled="button.disabled"
                                    t-att-title="button.title or button.label"
                                    t-on-click="() => button.run()">
                                <i t-if="button.icon" t-att-class="'fa ' + button.icon + ' me-1'"/>
                                <t t-out="button.label"/>
                            </button>
                        </t>
                    </div>
                </div>

                <div class="algantt-filters border-bottom p-2" t-if="this.state.showFilters">
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label small mb-1" for="algantt_users">Personas asignadas</label>
                            <select id="algantt_users" class="form-select form-select-sm"
                                    multiple="multiple" size="4"
                                    t-on-change="(ev) => this.onDraftSelectChange('userIds', ev)">
                                <t t-foreach="this.userOptions" t-as="option" t-key="option.id">
                                    <option t-att-value="option.id" t-att-selected="option.selected">
                                        <t t-out="option.name"/> (<t t-out="option.task_count"/>)
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label small mb-1" for="algantt_states">Estado</label>
                            <select id="algantt_states" class="form-select form-select-sm"
                                    multiple="multiple" size="4"
                                    t-on-change="(ev) => this.onDraftSelectChange('states', ev)">
                                <t t-foreach="this.stateOptions" t-as="option" t-key="option.value">
                                    <option t-att-value="option.value"
                                            t-att-selected="option.selected"
                                            t-out="option.label"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small mb-1" for="algantt_date_from">Desde</label>
                            <input id="algantt_date_from" type="date" class="form-control form-control-sm"
                                   t-att-value="this.state.draft.dateFrom"
                                   t-on-change="(ev) => this.onDraftValueChange('dateFrom', ev)"/>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small mb-1" for="algantt_date_to">Hasta</label>
                            <input id="algantt_date_to" type="date" class="form-control form-control-sm"
                                   t-att-value="this.state.draft.dateTo"
                                   t-on-change="(ev) => this.onDraftValueChange('dateTo', ev)"/>
                        </div>
                        <div class="col-12 col-md-2 d-flex flex-column gap-2">
                            <div class="form-check mb-0">
                                <input id="algantt_undated" type="checkbox" class="form-check-input"
                                       t-att-checked="this.state.draft.includeUndated"
                                       t-on-change="(ev) => this.onDraftValueChange('includeUndated', ev)"/>
                                <label class="form-check-label small" for="algantt_undated">
                                    Incluir sin fecha
                                </label>
                            </div>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-primary"
                                        t-att-disabled="this.invalidRange"
                                        t-on-click="() => this.applyFilters()">Aplicar</button>
                                <button type="button" class="btn btn-sm btn-link"
                                        t-on-click="() => this.clearFilters()">Limpiar</button>
                            </div>
                        </div>
                    </div>
                    <div class="text-danger small mt-1" t-if="this.invalidRange">
                        La fecha «desde» no puede ser posterior a la fecha «hasta».
                    </div>
                </div>

                <div class="algantt-notices px-2 pt-2"
                     t-if="this.state.meta.truncated or this.state.meta.undated_count">
                    <div class="alert alert-warning py-1 px-2 mb-1" t-if="this.state.meta.truncated">
                        Se muestran <t t-out="this.state.meta.count"/> de
                        <t t-out="this.state.meta.total"/> tareas (límite de
                        <t t-out="this.state.meta.limit"/>). Filtre por proyecto o por fechas para ver el resto.
                    </div>
                    <div class="alert alert-info py-1 px-2 mb-1" t-if="this.state.meta.undated_count">
                        <t t-out="this.state.meta.undated_count"/> tarea(s) sin fecha límite
                        <t t-if="this.state.filters.includeUndated">
                            se listan en la rejilla, sin barra en el diagrama.
                        </t>
                        <t t-else="">
                            no se pueden dibujar en el diagrama; actívelas en Filtros ▸ «Incluir sin fecha».
                        </t>
                    </div>
                </div>

                <div class="algantt-main d-flex flex-grow-1">
                <div class="algantt-body flex-grow-1 position-relative">
                    <div t-if="this.state.loading" class="algantt-loading position-absolute top-50 start-50 translate-middle">
                        <i class="oi oi-spin oi-2x text-muted" data-icon="autorenew"/>
                    </div>
                    <div t-if="!this.state.loading and !this.hasTasks"
                         class="algantt-empty position-absolute top-50 start-50 translate-middle text-center text-muted">
                        <i class="oi oi-3x mb-2 d-block" data-icon="checklist"/>
                        <p class="mb-0">No hay tareas con fechas para mostrar.</p>
                        <p class="small mb-0" t-if="!this.activeFilterCount">
                            Asigne fechas a las tareas del proyecto para verlas en el Gantt.
                        </p>
                        <p class="small mb-0" t-else="">
                            Ninguna tarea cumple los filtros aplicados.
                            <button type="button" class="btn btn-sm btn-link p-0 align-baseline"
                                    t-on-click="() => this.clearFilters()">Limpiar filtros</button>
                        </p>
                    </div>
                    <div class="algantt-container h-100 w-100" t-custom-ref="ganttContainer"/>
                </div>
                <!-- Punto de extensión: panel a la derecha del diagrama. -->
                <t t-if="this.sidePanelTemplate" t-call="{{ this.sidePanelTemplate }}"/>
                </div>
                <!-- Punto de extensión: panel debajo del diagrama. -->
                <t t-if="this.bottomPanelTemplate" t-call="{{ this.bottomPanelTemplate }}"/>

            </div>
        </Layout>
        </div>
    </t>

</templates>
