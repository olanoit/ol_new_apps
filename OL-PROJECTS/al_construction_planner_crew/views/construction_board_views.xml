<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cuadrillas en el tablero de obra y en el menú Ejecutar (CREVAL v1.0, 4.4 y 4.5) -->
    <record id="project_project_view_form_construction_board_crew" model="ir.ui.view">
        <field name="name">project.project.form.construction.board.crew</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="al_construction_planner.project_project_view_form_construction_board"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='board_execute']" position="inside">
                <button name="action_construction_assign_crew" type="object" class="oe_stat_button"
                        icon="fa-users" string="Asignar cuadrilla"
                        invisible="not construction_board_plan_id"
                        groups="al_construction_planner.group_planner_user"/>
            </xpath>
        </field>
    </record>

    <record id="construction_task_execute_wizard_view_form_crew" model="ir.ui.view">
        <field name="name">construction.task.execute.wizard.form.crew</field>
        <field name="model">construction.task.execute.wizard</field>
        <field name="inherit_id" ref="al_construction_planner.construction_task_execute_wizard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='execute_actions']" position="inside">
                <button name="action_assign_crew" type="object" string="Asignar cuadrilla"
                        class="btn btn-secondary" icon="fa-users"
                        groups="al_construction_planner.group_planner_user"/>
            </xpath>
        </field>
    </record>
</odoo>
