<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Jornales de las cuadrillas (v1.8, M18-07): planificado contra ejecutado
         por obra, etapa y sub etapa, en jornales y en soles. -->
    <record id="construction_crew_day_view_list" model="ir.ui.view">
        <field name="name">construction.crew.day.list</field>
        <field name="model">construction.crew.day</field>
        <field name="arch" type="xml">
            <list string="Jornales" create="0" edit="0">
                <field name="date"/>
                <field name="kind"/>
                <field name="project_id"/>
                <field name="stage" optional="show"/>
                <field name="task_id" optional="show"/>
                <field name="role_id" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="days" sum="Total"/>
                <field name="hours" optional="hide" sum="Total"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="source" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="construction_crew_day_view_pivot" model="ir.ui.view">
        <field name="name">construction.crew.day.pivot</field>
        <field name="model">construction.crew.day</field>
        <field name="arch" type="xml">
            <pivot string="Jornales de las cuadrillas" sample="1">
                <field name="project_id" type="row"/>
                <field name="stage_parent" type="row"/>
                <field name="stage" type="row"/>
                <field name="kind" type="col"/>
                <field name="days" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="construction_crew_day_view_search" model="ir.ui.view">
        <field name="name">construction.crew.day.search</field>
        <field name="model">construction.crew.day</field>
        <field name="arch" type="xml">
            <search string="Jornales">
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="role_id"/>
                <filter name="planned" string="Planificados" domain="[('kind', '=', 'planned')]"/>
                <filter name="executed" string="Ejecutados" domain="[('kind', '=', 'executed')]"/>
                <filter name="date" string="Fecha" date="date"/>
                <group>
                    <filter name="group_project" string="Obra" context="{'group_by': 'project_id'}"/>
                    <filter name="group_stage_parent" string="Etapa padre" context="{'group_by': 'stage_parent'}"/>
                    <filter name="group_stage" string="Etapa" context="{'group_by': 'stage'}"/>
                    <filter name="group_role" string="Rol" context="{'group_by': 'role_id'}"/>
                    <filter name="group_kind" string="Tipo" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_crew_day" model="ir.actions.act_window">
        <field name="name">Jornales de las cuadrillas</field>
        <field name="res_model">construction.crew.day</field>
        <field name="view_mode">pivot,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin jornales todavía</p>
            <p>Los planificados salen de «Asignar cuadrilla» en jornales; los ejecutados, de los
               días marcados en la sede de la obra (con la marcación instalada).</p>
        </field>
    </record>

    <menuitem id="menu_planner_crew_days" name="Jornales de las cuadrillas"
              parent="al_construction_planner.menu_planner_reports_plan"
              action="action_construction_crew_day" sequence="40"/>

    <record id="planning_role_view_form_construction" model="ir.ui.view">
        <field name="name">planning.role.form.construction</field>
        <field name="model">planning.role</field>
        <field name="inherit_id" ref="planning.planning_role_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Cuadrilla de obra" name="construction_crew">
                    <field name="construction_job_id" options="{'no_create': True}"/>
                    <field name="construction_daily_cost"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="hr_job_view_form_construction" model="ir.ui.view">
        <field name="name">hr.job.form.construction</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Cuadrilla de obra" name="construction_crew">
                    <field name="construction_daily_cost"/>
                    <field name="construction_currency_id" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="project_project_view_form_construction_crew" model="ir.ui.view">
        <field name="name">project.project.form.construction.crew</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="al_construction_planner.project_project_view_form_construction_planner"/>
        <field name="arch" type="xml">
            <field name="construction_payment_day" position="after">
                <field name="construction_crew_time_unit"/>
            </field>
        </field>
    </record>

    <record id="res_config_settings_view_form_construction_crew" model="ir.ui.view">
        <field name="name">res.config.settings.form.construction.crew</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="al_construction_planner.res_config_settings_view_form_construction_planner"/>
        <field name="arch" type="xml">
            <block name="construction_planner_contracts" position="inside">
                <setting company_dependent="1" id="construction_crew_time_unit" string="Jornales de las cuadrillas"
                         help="Unidad en que se planifican y miden las cuadrillas propias, con el redondeo de los tipos de entrada de trabajo de la nómina.">
                    <div class="content-group">
                        <div class="row mt-2">
                            <label for="construction_crew_time_unit" class="col-lg-5 o_light_label"/>
                            <field name="construction_crew_time_unit"/>
                        </div>
                        <div class="row">
                            <label for="construction_crew_round_type" class="col-lg-5 o_light_label"/>
                            <field name="construction_crew_round_type"/>
                        </div>
                        <div class="row">
                            <label for="construction_crew_hours_per_day" class="col-lg-5 o_light_label"/>
                            <field name="construction_crew_hours_per_day"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
