<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Con compras y requerimientos de obra: la jefatura aprueba los
         requerimientos y el asistente los crea (v1.6, M16-09 y M16-10). -->
    <record id="al_construction_planner.group_planner_project_head" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('al_construction_material_request.group_construction_approver'))]"/>
    </record>
    <record id="al_construction_planner.group_planner_exec_approver" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('al_construction_material_request.group_construction_approver'))]"/>
    </record>
    <record id="al_construction_planner.group_planner_assistant" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('al_construction_material_request.group_construction_requester'))]"/>
    </record>
    <!-- Paquete 1.11, M111-20 E: quien ve montos en el planificador ve el
         valor estimado del requerimiento. -->
    <record id="al_construction_planner.group_planner_amounts" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('al_construction_material_request.group_construction_amounts'))]"/>
    </record>
</odoo>
