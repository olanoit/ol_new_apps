<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Material en el tablero de obra y en el menú Ejecutar (CREVAL v1.0, 4.4 y 4.5) -->
    <record id="project_project_view_form_construction_board_purchase" model="ir.ui.view">
        <field name="name">project.project.form.construction.board.purchase</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="al_construction_planner.project_project_view_form_construction_board"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='board_execute']" position="inside">
                <button name="action_construction_request_material" type="object" class="oe_stat_button"
                        icon="fa-cubes" string="Pedir material"
                        invisible="not construction_board_plan_id"
                        groups="al_construction_planner.group_planner_user"/>
                <button name="action_view_construction_requests" type="object" class="oe_stat_button"
                        icon="fa-truck" groups="al_construction_material_request.group_construction_requester">
                    <field name="construction_request_count" widget="statinfo" string="Requerimientos de obra"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="construction_task_execute_wizard_view_form_purchase" model="ir.ui.view">
        <field name="name">construction.task.execute.wizard.form.purchase</field>
        <field name="model">construction.task.execute.wizard</field>
        <field name="inherit_id" ref="al_construction_planner.construction_task_execute_wizard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='execute_actions']" position="inside">
                <button name="action_request_material" type="object" string="Pedir material"
                        class="btn btn-secondary" icon="fa-cubes"
                        groups="al_construction_planner.group_planner_user"/>
            </xpath>
        </field>
    </record>
</odoo>
