<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Alcance del requerimiento de obra (RQ-01 a RQ-07): niveles en
         cascada, etapas, tareas del Gantt y «Traer materiales del plan».
         Hereda la vista del control de plan para ordenar sus columnas. -->
    <record id="construction_material_request_view_form_scope" model="ir.ui.view">
        <field name="name">construction.material.request.form.scope</field>
        <field name="model">construction.material.request</field>
        <field name="inherit_id" ref="construction_material_request_view_form_planner"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="construction_needs_plant" invisible="1"/>
                <field name="construction_production_location_id"
                       invisible="state == 'draft' or (not construction_needs_plant and not construction_production_location_id)"
                       readonly="1" options="{'no_create': True}"/>
            </xpath>
            <!-- M111-20 E: con niveles, la tarea sale del recuadro. -->
            <xpath expr="//group[@name='site']/field[@name='task_id']" position="attributes">
                <attribute name="invisible">not project_id or construction_has_levels</attribute>
            </xpath>
            <xpath expr="//separator[@name='lines']" position="before">
                <div name="construction_scope" class="border border-primary rounded p-3 mb-3"
                     invisible="state != 'draft' or not project_id">
                    <field name="construction_has_levels" invisible="1"/>
                    <field name="construction_allowed_stage_ids" invisible="1"/>
                    <field name="construction_default_stage" invisible="1"/>
                    <field name="construction_default_task_id" invisible="1"/>
                    <field name="construction_plan_id" invisible="1"/>
                    <field name="construction_scope_type_depth" invisible="1"/>
                    <field name="construction_scope_type_options" invisible="1"/>
                    <field name="construction_scope_type_hint" invisible="1"/>
                    <h5 class="mb-3">¿Para qué es el material?</h5>
                    <div class="row mb-2">
                        <div class="col-12 col-md-3 fw-bold"><label for="construction_stage_ids"/></div>
                        <div class="col-12 col-md-9">
                            <field name="construction_stage_ids" widget="many2many_tags" placeholder="Todas"
                                   options="{'no_create': True}"/>
                        </div>
                    </div>
                    <div class="row mb-2" invisible="not construction_needs_plant">
                        <div class="col-12 col-md-3 fw-bold">Planta</div>
                        <div class="col-12 col-md-9">
                            <field name="construction_production_location_id"
                                   required="construction_needs_plant and state == 'draft'"
                                   options="{'no_create': True}"/>
                        </div>
                    </div>
                    <!-- M124-01: el tipo va antes del selector del nivel con etapas. -->
                    <div class="row mb-2" invisible="construction_scope_type_depth != 1">
                        <div class="col-12 col-md-3 fw-bold">
                            <field name="construction_scope_type_label" widget="construction_scope_label"
                                   options="{'hint_field': 'construction_scope_type_hint'}"/>
                        </div>
                        <div class="col-12 col-md-9">
                            <field name="construction_scope_type_keys" widget="construction_scope_types"
                                   placeholder="Todos"
                                   options="{'options_field': 'construction_scope_type_options'}"/>
                        </div>
                    </div>
                    <div class="row mb-2" invisible="not construction_scope_1_label">
                        <div class="col-12 col-md-3 fw-bold">
                            <field name="construction_scope_1_hint" invisible="1"/>
                            <field name="construction_scope_1_label" widget="construction_scope_label"
                                   options="{'hint_field': 'construction_scope_1_hint'}"/>
                            <span class="text-muted fw-normal" invisible="construction_scope_type_depth != 1"> (opcional)</span>
                        </div>
                        <div class="col-12 col-md-9">
                            <field name="construction_scope_1_allowed_ids" invisible="1"/>
                            <field name="construction_scope_1_ids" widget="construction_scope_tags" placeholder="Todos"
                                   domain="[('id', 'in', construction_scope_1_allowed_ids)]"
                                   context="{'construction_scope_path': True}"
                                   options="{'no_create': True}"/>
                        </div>
                    </div>
                    <!-- M124-01: el tipo va antes del selector del nivel con etapas. -->
                    <div class="row mb-2" invisible="construction_scope_type_depth != 2">
                        <div class="col-12 col-md-3 fw-bold">
                            <field name="construction_scope_type_label" widget="construction_scope_label"
                                   options="{'hint_field': 'construction_scope_type_hint'}"/>
                        </div>
                        <div class="col-12 col-md-9">
                            <field name="construction_scope_type_keys" widget="construction_scope_types"
                                   placeholder="Todos"
                                   options="{'options_field': 'construction_scope_type_options'}"/>
                        </div>
                    </div>
                    <div class="row mb-2" invisible="not construction_scope_2_label">
                        <div class="col-12 col-md-3 fw-bold">
                            <field name="construction_scope_2_hint" invisible="1"/>
                            <field name="construction_scope_2_label" widget="construction_scope_label"
                                   options="{'hint_field': 'construction_scope_2_hint'}"/>
                            <span class="text-muted fw-normal" invisible="construction_scope_type_depth != 2"> (opcional)</span>
                        </div>
                        <div class="col-12 col-md-9">
                            <field name="construction_scope_2_allowed_ids" invisible="1"/>
                            <field name="construction_scope_2_ids" widget="construction_scope_tags" placeholder="Todos"
                                   domain="[('id', 'in', construction_scope_2_allowed_ids)]"
                                   context="{'construction_scope_path': True}"
                                   options="{'no_create': True}"/>
                        </div>
                    </div>
                    <!-- M124-01: el tipo va antes del selector del nivel con etapas. -->
                    <div class="row mb-2" invisible="construction_scope_type_depth != 3">
                        <div class="col-12 col-md-3 fw-bold">
                            <field name="construction_scope_type_label" widget="construction_scope_label"
                                   options="{'hint_field': 'construction_scope_type_hint'}"/>
                        </div>
                        <div class="col-12 col-md-9">
                            <field name="construction_scope_type_keys" widget="construction_scope_types"
                                   placeholder="Todos"
                                   options="{'options_field': 'construction_scope_type_options'}"/>
                        </div>
                    </div>
                    <div class="row mb-2" invisible="not construction_scope_3_label">
                        <div class="col-12 col-md-3 fw-bold">
                            <field name="construction_scope_3_hint" invisible="1"/>
                            <field name="construction_scope_3_label" widget="construction_scope_label"
                                   options="{'hint_field': 'construction_scope_3_hint'}"/>
                            <span class="text-muted fw-normal" invisible="construction_scope_type_depth != 3"> (opcional)</span>
                        </div>
                        <div class="col-12 col-md-9">
                            <field name="construction_scope_3_allowed_ids" invisible="1"/>
                            <field name="construction_scope_3_ids" widget="construction_scope_tags" placeholder="Todos"
                                   domain="[('id', 'in', construction_scope_3_allowed_ids)]"
                                   context="{'construction_scope_path': True}"
                                   options="{'no_create': True}"/>
                        </div>
                    </div>
                    <!-- M124-01: el tipo va antes del selector del nivel con etapas. -->
                    <div class="row mb-2" invisible="construction_scope_type_depth != 4">
                        <div class="col-12 col-md-3 fw-bold">
                            <field name="construction_scope_type_label" widget="construction_scope_label"
                                   options="{'hint_field': 'construction_scope_type_hint'}"/>
                        </div>
                        <div class="col-12 col-md-9">
                            <field name="construction_scope_type_keys" widget="construction_scope_types"
                                   placeholder="Todos"
                                   options="{'options_field': 'construction_scope_type_options'}"/>
                        </div>
                    </div>
                    <div class="row mb-2" invisible="not construction_scope_4_label">
                        <div class="col-12 col-md-3 fw-bold">
                            <field name="construction_scope_4_hint" invisible="1"/>
                            <field name="construction_scope_4_label" widget="construction_scope_label"
                                   options="{'hint_field': 'construction_scope_4_hint'}"/>
                            <span class="text-muted fw-normal" invisible="construction_scope_type_depth != 4"> (opcional)</span>
                        </div>
                        <div class="col-12 col-md-9">
                            <field name="construction_scope_4_allowed_ids" invisible="1"/>
                            <field name="construction_scope_4_ids" widget="construction_scope_tags" placeholder="Todos"
                                   domain="[('id', 'in', construction_scope_4_allowed_ids)]"
                                   context="{'construction_scope_path': True}"
                                   options="{'no_create': True}"/>
                        </div>
                    </div>
                    <!-- M124-01: el tipo va antes del selector del nivel con etapas. -->
                    <div class="row mb-2" invisible="construction_scope_type_depth != 5">
                        <div class="col-12 col-md-3 fw-bold">
                            <field name="construction_scope_type_label" widget="construction_scope_label"
                                   options="{'hint_field': 'construction_scope_type_hint'}"/>
                        </div>
                        <div class="col-12 col-md-9">
                            <field name="construction_scope_type_keys" widget="construction_scope_types"
                                   placeholder="Todos"
                                   options="{'options_field': 'construction_scope_type_options'}"/>
                        </div>
                    </div>
                    <div class="row mb-2" invisible="not construction_scope_5_label">
                        <div class="col-12 col-md-3 fw-bold">
                            <field name="construction_scope_5_hint" invisible="1"/>
                            <field name="construction_scope_5_label" widget="construction_scope_label"
                                   options="{'hint_field': 'construction_scope_5_hint'}"/>
                            <span class="text-muted fw-normal" invisible="construction_scope_type_depth != 5"> (opcional)</span>
                        </div>
                        <div class="col-12 col-md-9">
                            <field name="construction_scope_5_allowed_ids" invisible="1"/>
                            <field name="construction_scope_5_ids" widget="construction_scope_tags" placeholder="Todos"
                                   domain="[('id', 'in', construction_scope_5_allowed_ids)]"
                                   context="{'construction_scope_path': True}"
                                   options="{'no_create': True}"/>
                        </div>
                    </div>
                    <!-- M124-01: el tipo va antes del selector del nivel con etapas. -->
                    <div class="row mb-2" invisible="construction_scope_type_depth != 6">
                        <div class="col-12 col-md-3 fw-bold">
                            <field name="construction_scope_type_label" widget="construction_scope_label"
                                   options="{'hint_field': 'construction_scope_type_hint'}"/>
                        </div>
                        <div class="col-12 col-md-9">
                            <field name="construction_scope_type_keys" widget="construction_scope_types"
                                   placeholder="Todos"
                                   options="{'options_field': 'construction_scope_type_options'}"/>
                        </div>
                    </div>
                    <div class="row mb-2" invisible="not construction_scope_6_label">
                        <div class="col-12 col-md-3 fw-bold">
                            <field name="construction_scope_6_hint" invisible="1"/>
                            <field name="construction_scope_6_label" widget="construction_scope_label"
                                   options="{'hint_field': 'construction_scope_6_hint'}"/>
                            <span class="text-muted fw-normal" invisible="construction_scope_type_depth != 6"> (opcional)</span>
                        </div>
                        <div class="col-12 col-md-9">
                            <field name="construction_scope_6_allowed_ids" invisible="1"/>
                            <field name="construction_scope_6_ids" widget="construction_scope_tags" placeholder="Todos"
                                   domain="[('id', 'in', construction_scope_6_allowed_ids)]"
                                   context="{'construction_scope_path': True}"
                                   options="{'no_create': True}"/>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-12 col-md-3 fw-bold"><label for="construction_gantt_task_id"/> <span class="text-muted fw-normal">(opcional)</span></div>
                        <div class="col-12 col-md-9">
                            <field name="construction_gantt_task_id"
                                   placeholder="Para material de una tarea…"
                                   options="{'no_create': True}"/>
                        </div>
                    </div>
                    <!-- M124-01: lo que se va a traer, a la izquierda del botón. -->
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2"
                         invisible="not construction_plan_id">
                        <field name="construction_fetch_summary" class="flex-grow-1 mb-0"
                               nolabel="1" readonly="1"/>
                        <button name="action_construction_fetch_plan" type="object"
                                string="Traer materiales del plan" class="btn-primary ms-auto"
                                icon="fa-download"/>
                    </div>
                    <div class="text-muted small mt-2" invisible="construction_plan_id">
                        La obra no tiene plan de recursos vigente: agregue los materiales a mano.
                    </div>
                </div>
            </xpath>
            <!-- Columnas (RQ-05): Material, Nivel, Etapa, Saldo, Cantidad,
                 Unidad, Disponible. -->
            <xpath expr="//field[@name='line_ids']" position="attributes">
                <attribute name="context">{'default_task_id': construction_default_task_id or task_id, 'default_construction_stage': construction_default_stage}</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_id']" position="after">
                <field name="construction_level_label" optional="show"/>
                <field name="construction_space_type" optional="show" width="120px"
                       column_invisible="not parent.construction_scope_type_depth"/>
                <field name="construction_stage_codes" column_invisible="1"/>
                <field name="construction_stage" optional="show" widget="filterable_selection" options="{'whitelist_fname': 'construction_stage_codes'}"/>
                <field name="location_dest_id" optional="hide" options="{'no_create': True}"
                       groups="stock.group_stock_multi_locations"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_qty']" position="before">
                <xpath expr="//field[@name='line_ids']/list/field[@name='construction_plan_remaining']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_uom_id']" position="after">
                <xpath expr="//field[@name='line_ids']/list/field[@name='qty_available_now']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/form//field[@name='task_id']" position="after">
                <field name="construction_stage_codes" invisible="1"/>
                <field name="construction_stage" widget="filterable_selection" options="{'whitelist_fname': 'construction_stage_codes'}"/>
            </xpath>
        </field>
    </record>

    <!-- Ajuste de la etapa Producción (RQ-07) -->
    <record id="res_config_settings_view_form_construction_request_scope" model="ir.ui.view">
        <field name="name">res.config.settings.form.construction.request.scope</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="res_config_settings_view_form_construction_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='construction_planner_supply']" position="inside">
                <setting company_dependent="1" id="construction_request_production_stage"
                         string="Permitir la etapa Producción en el requerimiento de obra"
                         help="Mientras la orden de fabricación no esté en uso, el jefe de producción pide su material por el requerimiento de obra; se despacha a la preproducción de la planta (ubicaciones marcadas como «Preproducción de planta»).">
                    <field name="construction_request_production_stage"/>
                </setting>
            </xpath>
        </field>
    </record>

    <!-- Ubicación de preproducción de la planta (RQ-07) -->
    <record id="view_location_form_construction_preproduction" model="ir.ui.view">
        <field name="name">stock.location.form.construction.preproduction</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='replenish_location']" position="after">
                <field name="construction_preproduction" invisible="usage != 'internal'"/>
            </xpath>
        </field>
    </record>

</odoo>
