<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_construction_purchase" model="ir.ui.view">
        <field name="name">res.config.settings.form.construction.purchase</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="al_construction_planner.res_config_settings_view_form_construction_planner"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='al_construction_planner']" position="inside">
                    <block title="Abastecimiento" name="construction_planner_supply">
                        <setting company_dependent="1" id="construction_price_alert" string="Alerta de precio"
                                 help="El abastecimiento de la obra y las alertas marcan el producto cuyo último precio de compra supera el costo del plan en este porcentaje o más.">
                            <field name="construction_price_alert_pct" class="oe_inline"/> %
                        </setting>
                        <setting company_dependent="1" id="construction_hand_tools" string="Herramientas manuales"
                                 help="Las compras de esta categoría cargadas a una obra consumen su bolsa de herramientas (líneas del plan en % de la mano de obra).">
                            <field name="construction_hand_tools_categ_id" options="{'no_create': True}"/>
                        </setting>
                    </block>
            </xpath>
        </field>
    </record>
</odoo>
