<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multicompañía del portal de obra -->
    <record id="rule_construction_portal_member_company" model="ir.rule">
        <field name="name">Personal del portal: compañías permitidas</field>
        <field name="model_id" ref="model_construction_portal_member"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_construction_daily_report_company" model="ir.rule">
        <field name="name">Partes diarios: compañías permitidas</field>
        <field name="model_id" ref="model_construction_daily_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_construction_portal_tareo_company" model="ir.rule">
        <field name="name">Tareo: compañías permitidas</field>
        <field name="model_id" ref="model_construction_portal_tareo"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_construction_portal_kit_company" model="ir.rule">
        <field name="name">Kits del portal: compañías permitidas</field>
        <field name="model_id" ref="model_construction_portal_kit"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
