<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_construction_spreadsheet" model="ir.ui.view">
        <field name="name">project.project.form.construction.spreadsheet</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="al_construction_planner.project_project_view_form_construction_planner"/>
        <field name="arch" type="xml">
            <!-- Paquete 1.13, M113-12: versión y estado de la hoja vigente. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="construction_sheet_document_id" invisible="1"/>
                <button name="action_construction_open_spreadsheet" type="object"
                        class="oe_stat_button" icon="fa-table"
                        invisible="not is_construction_site or not construction_sheet_document_id"
                        groups="al_construction_planner.group_planner_plan_planner">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            v<field name="construction_sheet_version" readonly="1"/>
                        </span>
                        <span class="o_stat_text">
                            <field name="construction_sheet_state" readonly="1"/>
                        </span>
                    </div>
                </button>
            </xpath>
            <button name="action_construction_open_schedule" position="after">
                <field name="construction_budget_site" invisible="1"/>
                <button name="action_construction_open_spreadsheet" type="object"
                        string="Hoja de trabajo" icon="fa-table" class="btn-secondary"
                        invisible="construction_budget_site"
                        groups="al_construction_planner.group_planner_plan_planner"/>
                <!-- CREVAL, paquete 5, CR-38 y CR-47: la obra por partidas
                     planifica en su propia hoja. -->
                <button name="action_construction_open_plan_sheet" type="object"
                        string="Hoja de planificación" icon="fa-table" class="btn-secondary"
                        invisible="not construction_budget_site"
                        groups="al_construction_planner.group_planner_plan_planner"/>
            </button>
            <!-- Paquete 1.13, M113-05: las filas de la hoja, a la vista. -->
            <xpath expr="//page[@name='construction_planning']/div[1]" position="after">
                <group name="construction_spreadsheet" string="Hoja de trabajo"
                       groups="al_construction_planner.group_planner_plan_planner">
                    <group>
                        <field name="construction_spreadsheet_rows" placeholder="Automático"/>
                        <field name="construction_sheet_state" readonly="1"
                               invisible="not construction_sheet_document_id"/>
                        <field name="construction_sheet_control_state" readonly="1"
                               decoration-success="construction_sheet_control_state == 'match'"
                               decoration-danger="construction_sheet_control_state == 'mismatch'"
                               widget="badge" invisible="not construction_sheet_control_state"/>
                        <field name="construction_sheet_control_date" readonly="1"
                               invisible="not construction_sheet_control_state"/>
                    </group>
                    <group invisible="not construction_sheet_document_id">
                        <label for="construction_sheet_import_filename" string="Última importación"/>
                        <div class="o_row" invisible="not construction_sheet_import_filename">
                            <field name="construction_sheet_import_filename" readonly="1"/>
                            <field name="construction_sheet_import_date" readonly="1"/>
                            <span>· <field name="construction_sheet_import_errors" readonly="1"
                                           class="oe_inline"/> errores</span>
                        </div>
                        <label for="construction_sheet_send_version" string="Último envío"/>
                        <div class="o_row" invisible="not construction_sheet_send_version">
                            <span>v<field name="construction_sheet_send_version" readonly="1"
                                          class="oe_inline"/></span>
                            <field name="construction_sheet_send_date" readonly="1"/>
                            <field name="construction_sheet_send_message_id" invisible="1"/>
                            <button name="action_construction_open_sheet_message" type="object"
                                    string="Ver en el historial" class="btn-link p-0"
                                    invisible="not construction_sheet_send_message_id"/>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Hoja de trabajo de la cotización (CREVAL v1.0, 6.7) -->
    <record id="sale_order_view_form_construction_spreadsheet" model="ir.ui.view">
        <field name="name">sale.order.form.construction.spreadsheet</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- CREVAL, paquete 5, CR-47: una sola entrada, para quien
                     presupuesta (o planifica). -->
                <button name="action_construction_open_budget_sheet" type="object"
                        string="Hoja de presupuesto" invisible="state == 'cancel'"
                        groups="al_construction_planner_spreadsheet.group_construction_budgeter,al_construction_planner.group_planner_plan_planner"/>
            </xpath>
        </field>
    </record>
    <!-- Paquete 1.17, M117-09: la hoja desde la ficha del planificador. -->
    <record id="project_project_view_form_construction_board_spreadsheet" model="ir.ui.view">
        <field name="name">project.project.form.construction.board.spreadsheet</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="al_construction_planner.project_project_view_form_construction_board"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='board_control']" position="inside">
                <button name="action_construction_open_spreadsheet" type="object"
                        class="oe_stat_button" icon="fa-table"
                        groups="al_construction_planner.group_planner_plan_planner">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Hoja de trabajo</span>
                        <span class="o_stat_text" invisible="not construction_sheet_document_id">
                            v<field name="construction_sheet_version" readonly="1"/> ·
                            <field name="construction_sheet_state" readonly="1"/>
                        </span>
                    </div>
                    <field name="construction_sheet_document_id" invisible="1"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
