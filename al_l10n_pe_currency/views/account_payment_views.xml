<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Elección del tipo de cambio en el cobro o pago -->
    <record id="view_account_payment_form_l10n_pe_currency" model="ir.ui.view">
        <field name="name">account.payment.form.l10n.pe.currency</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="l10n_pe_exchange_rate_type"
                       invisible="currency_id == company_currency_id"
                       readonly="state != 'draft'"/>
            </field>
        </field>
    </record>

    <!-- Y en el asistente de registro de pagos -->
    <record id="view_account_payment_register_form_l10n_pe_currency"
            model="ir.ui.view">
        <field name="name">account.payment.register.form.l10n.pe.currency</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <field name="payment_date" position="after">
                <field name="l10n_pe_exchange_rate_type"
                       invisible="currency_id == company_currency_id"/>
            </field>
        </field>
    </record>

</odoo>
