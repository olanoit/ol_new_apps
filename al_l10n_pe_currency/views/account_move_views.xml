<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_pe_currency" model="ir.ui.view">
        <field name="name">account.move.form.l10n.pe.currency</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Junto a la conversión de moneda nativa ("1 PEN = 0.2949 USD")
                 se añade, en la misma línea, el T.C. peruano aplicado y su
                 fecha (p. ej. "T.C. 3.391 · 16/07/2026"). Un solo campo, sin
                 bloques extra que reacomoden el formulario. -->
            <xpath expr="//div[@name='currency_conversion_div']" position="inside">
                <field name="l10n_pe_exchange_rate_info" nolabel="1"
                       readonly="1" class="oe_inline fst-italic text-nowrap"/>
            </xpath>
            <!-- Elección de compra o venta: solo tiene sentido en moneda
                 extranjera, y solo se puede cambiar antes de publicar. -->
            <field name="invoice_date" position="after">
                <field name="l10n_pe_exchange_rate_type"
                       invisible="currency_id == company_currency_id
                                  or move_type == 'entry'"
                       readonly="state != 'draft'"/>
            </field>
        </field>
    </record>
</odoo>
