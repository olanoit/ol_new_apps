<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_form_exchange_closure" model="ir.ui.view">
        <field name="name">account.account.form.inherit.al.exchange.closure</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group string="Cierre de tipo de cambio (PE)"
                       name="l10n_pe_exchange_closure"
                       invisible="not l10n_pe_exchange_closing_eligible">
                    <field name="l10n_pe_exchange_closing_eligible" invisible="1"/>
                    <field name="l10n_pe_exchange_closing"/>
                    <field name="l10n_pe_exchange_rate_type"
                           invisible="not l10n_pe_exchange_closing"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_account_list_exchange_closure" model="ir.ui.view">
        <field name="name">account.account.list.inherit.al.exchange.closure</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <field name="account_type" position="after">
                <field name="l10n_pe_exchange_closing" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_search_exchange_closure" model="ir.ui.view">
        <field name="name">account.account.search.inherit.al.exchange.closure</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <filter name="filter_l10n_pe_exchange_closing"
                        string="En el cierre de T.C. (PE)"
                        domain="[('l10n_pe_exchange_closing', '!=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_account_exchange_closing" model="ir.actions.act_window">
        <field name="name">Cuentas del cierre de T.C.</field>
        <field name="res_model">account.account</field>
        <field name="view_mode">list,form</field>
        <field name="context">
            {'search_default_filter_l10n_pe_exchange_closing': 1}
        </field>
    </record>

</odoo>
