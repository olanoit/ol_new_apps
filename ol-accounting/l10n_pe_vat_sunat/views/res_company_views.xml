<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form_company_inherited_l10n_pe_vat" model="ir.ui.view">
        <field name="name">res.company.inherit.l10n_pe_vat</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="country_code" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Validación RUC/DNI (PE)"
                      name="l10n_pe_vat_sunat"
                      invisible="country_code and country_code != 'PE'">
                    <group>
                        <group string="Validaciones automáticas">
                            <field name="l10n_pe_ruc_validation"/>
                            <field name="l10n_pe_dni_validation"/>
                        </group>
                        <group string="Estrategia de consulta">
                            <field name="l10n_pe_api_use_fallback"/>
                        </group>
                    </group>
                    <separator string="Conexiones de consulta (por prioridad)"/>
                    <p class="text-muted">
                        Por defecto se usa <b>solo la conexión activa de mayor
                        prioridad</b> (la primera de la lista). Activa "Usar
                        fallback en cascada" para que, si esa falla, se pruebe
                        la siguiente, y así sucesivamente. Cada conexión mapea
                        los atributos de su respuesta a los campos del contacto.
                    </p>
                    <field name="l10n_pe_api_connection_ids" context="{'default_company_id': id}"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
