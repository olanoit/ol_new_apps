<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Reemplaza el recibo nativo. Rama PE: mismo diseño que el ticket
         80mm de al_l10n_pe_invoice (reglas continuas/discontinuas, sin
         rellenos grises — vernáculo de impresora térmica). Rama else:
         reproducción literal del recibo estándar del core, para
         compañías no peruanas o TPV sin diarios CPE configurados. -->
    <t t-name="al_l10n_pe_edi_pos.OrderReceipt"
       t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="replace">
            <div class="pos-receipt p-2">
                <t t-if="peActive">
                    <t t-set="company" t-value="order.company"/>
                    <t t-set="amounts" t-value="peAmounts"/>

                    <!-- ENCABEZADO -->
                    <div class="alpe-center alpe-header">
                        <img t-if="order.config.receiptLogoUrl"
                             t-att-src="order.config.receiptLogoUrl" alt="Logo"/>
                        <div><strong t-esc="company.name"/></div>
                        <div><strong>RUC: <t t-esc="company.vat"/></strong></div>
                        <div t-if="company.street" t-esc="company.street"/>
                        <div t-if="company.phone">Tel: <t t-esc="company.phone"/></div>
                    </div>

                    <!-- TIPO Y NÚMERO DE DOCUMENTO -->
                    <div class="alpe-doc">
                        <t t-esc="order.peDocTypeLabel"/><br/>
                        <t t-esc="peDocNumber"/>
                    </div>

                    <!-- DATOS DEL CLIENTE -->
                    <ul class="alpe-info">
                        <li>
                            <strong>Señor(es):</strong>
                            <t t-esc="order.partner_id?.name || 'CLIENTE VARIOS'"/>
                        </li>
                        <li t-if="order.partner_id?.vat">
                            <strong><t t-esc="order.peVatLabel"/>:</strong>
                            <t t-esc="order.partner_id.vat"/>
                        </li>
                        <li t-if="order.partner_id?.street">
                            <strong>Dirección:</strong>
                            <t t-esc="order.partner_id.street"/>
                        </li>
                        <li>
                            <strong>Emisión:</strong>
                            <t t-esc="order.formatDateOrTime('date_order')"/>
                        </li>
                        <li>
                            <strong>Moneda:</strong>
                            <t t-esc="order.currency?.name === 'USD' ? 'DÓLARES AMERICANOS' : 'SOLES'"/>
                        </li>
                    </ul>

                    <!-- DETALLE DE LÍNEAS -->
                    <table class="alpe-lines">
                        <thead>
                            <tr>
                                <th class="alpe-ctr">Cant.</th>
                                <th>Descripción</th>
                                <th class="alpe-num">P.U.</th>
                                <th class="alpe-num">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="order.lines" t-as="line" t-key="line.uuid">
                                <td class="alpe-ctr" t-esc="line.qty"/>
                                <td>
                                    <t t-esc="line.getFullProductName()"/>
                                    <div t-if="line.getDiscount()" class="alpe-discount">
                                        Desc. <t t-esc="line.getDiscount()"/>%
                                    </div>
                                    <div t-if="line.customerNote" class="alpe-discount"
                                         t-esc="line.customerNote"/>
                                </td>
                                <td class="alpe-num" t-esc="formatCurrency(line.unitPrices.total_included)"/>
                                <td class="alpe-num" t-esc="formatCurrency(line.priceIncl)"/>
                            </tr>
                        </tbody>
                    </table>

                    <!-- TOTALES SUNAT -->
                    <table class="alpe-totals">
                        <tr t-if="amounts.base">
                            <td class="alpe-label">Op. gravadas</td>
                            <td class="alpe-num" t-esc="formatCurrency(amounts.base)"/>
                        </tr>
                        <tr t-if="amounts.exonerated">
                            <td class="alpe-label">Op. exoneradas</td>
                            <td class="alpe-num" t-esc="formatCurrency(amounts.exonerated)"/>
                        </tr>
                        <tr t-if="amounts.unaffected">
                            <td class="alpe-label">Op. inafectas</td>
                            <td class="alpe-num" t-esc="formatCurrency(amounts.unaffected)"/>
                        </tr>
                        <tr t-if="amounts.icbper">
                            <td class="alpe-label">ICBPER</td>
                            <td class="alpe-num" t-esc="formatCurrency(amounts.icbper)"/>
                        </tr>
                        <tr>
                            <td class="alpe-label">IGV (18%)</td>
                            <td class="alpe-num" t-esc="formatCurrency(amounts.igv)"/>
                        </tr>
                        <tr class="alpe-total-row">
                            <td class="alpe-label">IMPORTE TOTAL</td>
                            <td class="alpe-num" t-esc="formatCurrency(amounts.total)"/>
                        </tr>
                    </table>

                    <!-- MONTO EN LETRAS -->
                    <div class="alpe-words" t-if="amounts.words">
                        SON: <t t-esc="amounts.words"/>
                    </div>

                    <!-- PAGOS -->
                    <ul class="alpe-info">
                        <li t-foreach="paymentLines" t-as="line" t-key="line_index">
                            <strong><t t-esc="line.payment_method_id.name"/>:</strong>
                            <t t-esc="formatCurrency(line.getAmount())"/>
                        </li>
                        <li t-if="order.showChange">
                            <strong>Vuelto:</strong>
                            <t t-esc="formatCurrency(order.change)"/>
                        </li>
                        <li t-if="order.getCashierName()">
                            <strong>Usuario:</strong>
                            <t t-esc="order.getCashierName()"/>
                        </li>
                    </ul>

                    <!-- QR DE REPRESENTACIÓN IMPRESA -->
                    <div class="alpe-qr" t-if="peQrUrl">
                        <img t-att-src="peQrUrl" alt="QR SUNAT"/>
                    </div>

                    <div class="alpe-footer">
                        <div>Representación impresa de la
                            <t t-esc="order.peDocTypeLabel.toLowerCase()"/>.</div>
                        <div>Consulte en www.sunat.gob.pe</div>
                        <div>Gracias por su preferencia.</div>
                        <div t-if="order.config.receipt_footer"
                             style="white-space:pre-line"
                             t-esc="order.config.receipt_footer"/>
                    </div>
                </t>
                <t t-else="">
                    <!-- Recibo estándar del core (copiado literal de
                         point_of_sale.OrderReceipt) -->
                    <t t-set="showTaxGroupLabels" t-value="doesAnyOrderlineHaveTaxLabel()"/>
                    <ReceiptHeader order="order"/>
                    <div class="pt-3"/>
                    <OrderDisplay order="order" t-slot-scope="scope" mode="'receipt'">
                        <t t-set="line" t-value="scope.line"/>
                        <Orderline line="line" showTaxGroup="showTaxGroupLabels" mode="'receipt'" basic_receipt="props.basic_receipt">
                            <li t-if="line.customerNote" class="customer-note w-100 p-2 my-1 rounded text-break">
                                <i class="fa fa-sticky-note me-1" role="img" aria-label="Customer Note" title="Customer Note"/>
                                <t t-esc="line.customerNote"/>
                            </li>
                        </Orderline>
                    </OrderDisplay>
                    <t t-if="!props.basic_receipt">
                        <t t-set="taxTotals" t-value="order.prices.taxDetails"/>
                        <div t-if="taxTotals and taxTotals.has_tax_groups" class="pos-receipt-taxes pt-3">
                            <t t-foreach="taxTotals.subtotals" t-as="subtotal" t-key="subtotal.name">
                                <div class="d-flex">
                                    <span class="text-nowrap mw-100">Subtotal</span>
                                    <span t-out="formatCurrency(order.priceExcl)" class="ms-auto font-monospace"/>
                                </div>
                                <div t-foreach="subtotal.tax_groups" t-as="tax_group" t-key="tax_group.id" class="d-flex">
                                    <span>
                                        <span t-esc="tax_group.group_name"/>
                                        <t t-if="showTaxGroupLabels">
                                            (<span t-if="tax_group.group_label" t-out="tax_group.group_label"/>)
                                        </t>
                                    </span>
                                    <span t-out="formatCurrency(tax_group.tax_amount_currency)" class="ms-auto font-monospace"/>
                                </div>
                            </t>
                        </div>
                        <div class="pos-receipt-amount receipt-total fw-bolder">
                            <span class="label-total">Total</span>
                            <span t-out="order.currencyDisplayPriceIncl" class="pos-receipt-right-align font-monospace"/>
                        </div>
                        <div class="paymentlines text-start pt-1" t-foreach="paymentLines" t-as="line" t-key="line_index">
                            <t t-esc="line.payment_method_id.name"/>
                            <span t-out="formatCurrency(line.getAmount())" class="pos-receipt-right-align font-monospace"/>
                        </div>
                        <div t-if="order.showChange" class="pos-receipt-amount receipt-change">
                            <span class="label-change">Change</span>
                            <span t-out="formatCurrency(order.change)" class="pos-receipt-right-align font-monospace"/>
                        </div>
                        <!-- Bloque QR del core, literal: es el ancla del xpath de
                             l10n_pe_edi_pos (EE) — eliminarlo rompe el POS con
                             "cannot be located in element tree". -->
                        <div t-if="order.company.point_of_sale_use_ticket_qr_code and order.finalized" class="gap-2 d-flex flex-row pt-3" style="font-size: 75%;">
                            <div t-if="['qr_code', 'qr_code_and_url'].includes(header.company.point_of_sale_ticket_portal_url_display_mode)" class="pt-1">
                                <img id="posqrcode" t-att-src="this.qrCode" class="m-0"/>
                            </div>
                            <div class="w-100 ms-1">
                                <div class="fw-bolder">
                                    Need an invoice?
                                </div>
                                <div t-if="['url', 'qr_code_and_url'].includes(header.company.point_of_sale_ticket_portal_url_display_mode)" class="portal-url text-break">
                                    <t t-out="getPortalURL()"/>
                                </div>
                                <div class="unique-code">
                                    Code: <t t-out="order.ticket_code"/>
                                </div>
                            </div>
                        </div>
                        <div class="before-footer"/>
                    </t>
                    <div t-if="order.config.receipt_footer" class="pos-receipt-center-align pt-3 text-center" style="white-space:pre-line">
                        <t t-esc="order.config.receipt_footer"/>
                    </div>
                    <div class="after-footer">
                        <t t-foreach="paymentLines" t-as="line" t-key="line_index">
                            <t t-if="line.ticket">
                                <div class="pos-payment-terminal-receipt pt-3">
                                    <pre t-esc="line.ticket"/>
                                </div>
                            </t>
                        </t>
                    </div>
                    <div class="pos-receipt-order-data text-center pt-3">
                        <span>Powered by <b> Odoo </b></span>
                    </div>
                </t>
            </div>
        </xpath>
    </t>

</templates>
