<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_pos_form" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.al.l10n.pe.edi.pos</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="l10n_pe_doc_type" readonly="1"
                       invisible="not l10n_pe_doc_type"/>
                <field name="edi_series_id" readonly="1"
                       invisible="not edi_series_id"/>
                <field name="l10n_pe_edi_send" readonly="1"
                       invisible="l10n_pe_doc_type == 'recibo'"/>
            </xpath>
        </field>
    </record>

</odoo>
