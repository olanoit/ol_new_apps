<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_type_refill" model="mail.activity.type">
        <field name="name">Recompra de tratamiento</field>
        <field name="summary">Recordar la recompra al paciente</field>
        <field name="icon">fa-medkit</field>
        <field name="res_model">pharmacy.treatment</field>
        <field name="delay_count">0</field>
    </record>

    <record id="ir_cron_pharmacy_treatment_refill" model="ir.cron">
        <field name="name">Farmacia: recordatorios de recompra de tratamientos</field>
        <field name="model_id" ref="model_pharmacy_treatment"/>
        <field name="state">code</field>
        <field name="code">model._cron_refill_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <data noupdate="1">
        <record id="mail_template_treatment_refill" model="mail.template">
            <field name="name">Farmacia: recordatorio de recompra</field>
            <field name="model_id" ref="model_pharmacy_treatment"/>
            <field name="subject">{{ object.company_id.name }}: es momento de reponer su {{ object.product_id.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.patient_id.id }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Hola <t t-out="object.patient_id.name or ''"/>:</p>
    <p>
        Su <strong t-out="object.product_id.name or ''"/>
        <t t-if="object.refill_state == 'late'">se terminó el</t>
        <t t-else="">le alcanza hasta el</t>
        <t t-out="object.covered_until" t-options="{'widget': 'date'}"/>.
    </p>
    <p>Si desea, se lo separamos para que lo recoja en el local o se lo enviemos. Responda este correo o llámenos.</p>
    <p>Gracias por confiar en <t t-out="object.company_id.name or ''"/>.</p>
</div>
            </field>
            <field name="lang">{{ object.patient_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
