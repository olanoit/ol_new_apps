<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pharmacy_replenishment_wizard_view_form" model="ir.ui.view">
        <field name="name">pharmacy.replenishment.wizard.form</field>
        <field name="model">pharmacy.replenishment.wizard</field>
        <field name="arch" type="xml">
            <form string="Sugerido de compra">
                <field name="computed" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <group>
                    <group>
                        <field name="warehouse_id"/>
                        <field name="source_warehouse_id"/>
                    </group>
                    <group>
                        <field name="period_days"/>
                        <field name="coverage_days"/>
                    </group>
                </group>
                <div class="text-muted small mb-2">
                    Sugerido = venta diaria × días de cobertura + faltantes − stock − por llegar,
                    redondeado al múltiplo de compra. Puede cambiar el proveedor y la cantidad.
                </div>
                <field name="line_ids" invisible="not computed">
                    <list editable="bottom" create="0">
                        <field name="product_id"/>
                        <field name="vendor_id"/>
                        <field name="sold_qty" optional="hide"/>
                        <field name="avg_daily"/>
                        <field name="shortage_qty"/>
                        <field name="stock_qty"/>
                        <field name="incoming_qty"/>
                        <field name="multiple" optional="show"/>
                        <field name="suggested_qty" sum="Total"/>
                        <field name="uom_id" optional="show"/>
                    </list>
                </field>
                <div invisible="not computed or line_ids" class="alert alert-info">
                    No hay nada que pedir: el stock y lo que está por llegar cubren la venta.
                </div>
                <footer>
                    <button name="action_compute" type="object" string="Calcular" class="btn-primary"
                            invisible="computed"/>
                    <button name="action_compute" type="object" string="Recalcular"
                            invisible="not computed"/>
                    <button name="action_create_purchase" type="object" class="btn-primary"
                            string="Crear solicitudes de presupuesto" invisible="not computed or not line_ids"/>
                    <button name="action_create_transfer" type="object" string="Crear traslado"
                            invisible="not computed or not line_ids or not source_warehouse_id"/>
                    <button string="Cerrar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pharmacy_replenishment_wizard" model="ir.actions.act_window">
        <field name="name">Sugerido de compra</field>
        <field name="res_model">pharmacy.replenishment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
