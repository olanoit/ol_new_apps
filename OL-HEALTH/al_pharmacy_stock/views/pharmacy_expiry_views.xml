<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Escalas de descuento por vencer -->
    <record id="pharmacy_expiry_discount_view_list" model="ir.ui.view">
        <field name="name">pharmacy.expiry.discount.list</field>
        <field name="model">pharmacy.expiry.discount</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="days"/>
                <field name="discount"/>
                <field name="categ_id"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="pharmacy_expiry_discount_action" model="ir.actions.act_window">
        <field name="name">Descuentos por vencer</field>
        <field name="res_model">pharmacy.expiry.discount</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree las escalas de descuento por vencer</p>
            <p>Por ejemplo, -20 % hasta 90 días al vencimiento y -40 % hasta 30 días. La caja aplica
                el descuento al vender un lote que vence dentro de la escala.</p>
        </field>
    </record>

    <!-- Lotes por vencer con su precio sugerido -->
    <record id="pharmacy_lot_expiry_view_list" model="ir.ui.view">
        <field name="name">stock.lot.list.pharmacy.expiry</field>
        <field name="model">stock.lot</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="product_id"/>
                <field name="name"/>
                <field name="expiration_date"/>
                <field name="pharmacy_days_to_expiry"/>
                <field name="product_qty"/>
                <field name="pharmacy_state" widget="badge" decoration-success="pharmacy_state == 'available'"
                       decoration-danger="pharmacy_state in ('blocked', 'expired')"/>
                <field name="pharmacy_expiry_discount"/>
                <field name="pharmacy_suggested_price"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="pharmacy_lot_expiry_action" model="ir.actions.act_window">
        <field name="name">Lotes por vencer</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="pharmacy_lot_expiry_view_list"/>
        <field name="domain">[('product_id.product_tmpl_id.pharmacy_ok', '=', True), ('product_qty', '>', 0)]</field>
        <field name="context">{'search_default_pharmacy_expiry_soon': 1}</field>
    </record>

    <!-- Canje con la droguería -->
    <record id="pharmacy_supplier_return_view_list" model="ir.ui.view">
        <field name="name">pharmacy.supplier.return.list</field>
        <field name="model">pharmacy.supplier.return</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="warehouse_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge" decoration-info="state in ('sent', 'accepted')"
                       decoration-success="state == 'done'" decoration-muted="state == 'cancel'"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="pharmacy_supplier_return_view_form" model="ir.ui.view">
        <field name="name">pharmacy.supplier.return.form</field>
        <field name="model">pharmacy.supplier.return</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_lots" type="object" string="Cargar lotes"
                            invisible="state != 'draft'"/>
                    <button name="action_send" type="object" string="Marcar como enviado"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_accept" type="object" string="Aceptado por el proveedor"
                            class="btn-primary" invisible="state not in ('draft', 'sent')"/>
                    <button name="action_done" type="object" string="Devolver y terminar" class="btn-primary"
                            invisible="state != 'accepted'"/>
                    <button name="action_create_refund" type="object" string="Registrar nota de crédito"
                            invisible="state not in ('accepted', 'done') or refund_id"
                            groups="account.group_account_invoice"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_draft" type="object" string="Volver a borrador"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,accepted,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object" class="oe_stat_button"
                                icon="local_shipping" invisible="not picking_id" string="Devolución"/>
                        <button name="action_view_refund" type="object" class="oe_stat_button"
                                icon="article" invisible="not refund_id" string="Nota de crédito"
                                groups="account.group_account_invoice"/>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state in ('done', 'cancel')"/>
                            <field name="picking_id" invisible="not picking_id"/>
                            <field name="refund_id" invisible="not refund_id"
                                   groups="account.group_account_invoice"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state not in ('draft', 'sent')">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="expiration_date"/>
                            <field name="location_id"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="reason"/>
                            <field name="price_unit"/>
                            <field name="subtotal" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Condiciones del canje, contacto de la droguería…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="pharmacy_supplier_return_view_search" model="ir.ui.view">
        <field name="name">pharmacy.supplier.return.search</field>
        <field name="model">pharmacy.supplier.return</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Pendientes" name="pending" domain="[('state', 'in', ('draft', 'sent', 'accepted'))]"/>
                <group>
                    <filter string="Proveedor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="pharmacy_supplier_return_action" model="ir.actions.act_window">
        <field name="name">Canjes con la droguería</field>
        <field name="res_model">pharmacy.supplier.return</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="pharmacy_supplier_return_load_view_form" model="ir.ui.view">
        <field name="name">pharmacy.supplier.return.load.form</field>
        <field name="model">pharmacy.supplier.return.load</field>
        <field name="arch" type="xml">
            <form string="Cargar lotes">
                <group>
                    <field name="return_id" invisible="1"/>
                    <field name="source" widget="radio"/>
                    <field name="include_near_expiry"/>
                    <field name="days" invisible="not include_near_expiry"/>
                    <field name="include_expired"/>
                </group>
                <footer>
                    <button name="action_load" type="object" string="Cargar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="pharmacy_supplier_return_report" model="ir.actions.report">
        <field name="name">Acta de canje</field>
        <field name="model">pharmacy.supplier.return</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_pharmacy_stock.report_pharmacy_supplier_return</field>
        <field name="print_report_name">'Acta de canje %s' % object.name</field>
        <field name="paperformat_id" ref="al_report_base.paperformat_pe_a4"/>
        <field name="binding_model_id" ref="model_pharmacy_supplier_return"/>
        <field name="binding_type">report</field>
    </record>

    <menuitem id="menu_pharmacy_lot_expiry" name="Lotes por vencer" parent="menu_pharmacy_inventory"
              action="pharmacy_lot_expiry_action" sequence="25"/>
    <menuitem id="menu_pharmacy_supplier_return" name="Canjes con la droguería" parent="menu_pharmacy_inventory"
              action="pharmacy_supplier_return_action" sequence="28"/>
    <menuitem id="menu_pharmacy_expiry_discount" name="Descuentos por vencer"
              parent="al_pharmacy_base.menu_pharmacy_config" action="pharmacy_expiry_discount_action"
              sequence="30" groups="al_pharmacy_base.group_pharmacy_manager"/>
</odoo>
