<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_price_list">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="al_report_base.report_pe_page">
                    <t t-set="company" t-value="o"/>
                    <t t-set="doc_title" t-value="'Precios por principio activo'"/>
                    <p class="pe-doc-text">Precios de venta al público ordenados por denominación común
                        internacional (DCI) y, en cada una, de menor a mayor (Ley 29459, art. 39.3).
                        Pida el genérico en DCI: el químico farmacéutico debe ofrecerle primero las
                        alternativas genéricas (Ley 32033).</p>
                    <table class="pe-doc-table pe-doc-lines mb-3">
                        <thead>
                            <tr class="pe-doc-thead">
                                <th>Principio activo</th><th>Producto</th><th>Tipo</th><th>Laboratorio</th>
                                <th class="text-end">Precio</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="groups[o.id]" t-as="group">
                                <tr t-foreach="group[1]" t-as="product">
                                    <td t-out="group[0] if product_first else ''"/>
                                    <td t-out="product.name"/>
                                    <td><span t-field="product.pharmacy_product_type"/></td>
                                    <td t-out="product.pharmacy_laboratory_id.name or ''"/>
                                    <td class="text-end"><span t-field="product.list_price" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <t t-if="linked[o.id]">
                        <div class="pe-doc-section">Productos de empresas vinculadas a este establecimiento</div>
                        <p class="pe-doc-text">Ley 32033, art. 4: estos productos son de empresas vinculadas
                            al establecimiento: <t t-out="', '.join(linked[o.id].mapped('name'))"/>.</p>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
