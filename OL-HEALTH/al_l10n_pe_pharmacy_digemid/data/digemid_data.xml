<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_pharmacy_adverse_event" model="ir.sequence">
            <field name="name">Sospecha de reacción adversa</field>
            <field name="code">pharmacy.adverse.event</field>
            <field name="prefix">SRA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
    <record id="ir_cron_pharmacy_observatory_reminder" model="ir.cron">
        <field name="name">Farmacia: recordatorio mensual del Observatorio</field>
        <field name="model_id" ref="model_pharmacy_observatory_submission"/>
        <field name="state">code</field>
        <field name="code">model._cron_monthly_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
