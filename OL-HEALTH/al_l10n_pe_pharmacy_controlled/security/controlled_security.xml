<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pharmacy_controlled_book_register_comp_rule" model="ir.rule">
        <field name="name">Libro oficial de controlados: multicompañía</field>
        <field name="model_id" ref="model_pharmacy_controlled_book_register"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="pharmacy_controlled_balance_comp_rule" model="ir.rule">
        <field name="name">Balance de controlados: multicompañía</field>
        <field name="model_id" ref="model_pharmacy_controlled_balance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="pharmacy_controlled_balance_line_comp_rule" model="ir.rule">
        <field name="name">Producto del balance de controlados: multicompañía</field>
        <field name="model_id" ref="model_pharmacy_controlled_balance_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
