<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Receta: archivo de las recetas retenidas -->
    <record id="pharmacy_prescription_view_form_controlled" model="ir.ui.view">
        <field name="name">pharmacy.prescription.form.controlled</field>
        <field name="model">pharmacy.prescription</field>
        <field name="inherit_id" ref="al_pharmacy_prescription.pharmacy_prescription_view_form"/>
        <field name="arch" type="xml">
            <field name="retention_folio" position="after">
                <field name="retention_date" invisible="not retained"/>
                <field name="retention_until" invisible="not retained"/>
            </field>
        </field>
    </record>
    <record id="pharmacy_prescription_view_search_controlled" model="ir.ui.view">
        <field name="name">pharmacy.prescription.search.controlled</field>
        <field name="model">pharmacy.prescription</field>
        <field name="inherit_id" ref="al_pharmacy_prescription.pharmacy_prescription_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="retained_archive" string="Retenidas en archivo"
                        domain="[('retained', '=', True), ('retention_until', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="retained_expired" string="Archivo cumplido (2 años)"
                        domain="[('retained', '=', True), ('retention_until', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
            </xpath>
        </field>
    </record>

    <!-- Libros oficiales -->
    <record id="pharmacy_controlled_book_register_view_list" model="ir.ui.view">
        <field name="name">pharmacy.controlled.book.register.list</field>
        <field name="model">pharmacy.controlled.book.register</field>
        <field name="arch" type="xml">
            <list>
                <field name="warehouse_id"/>
                <field name="book"/>
                <field name="mode"/>
                <field name="folio_from" optional="show"/>
                <field name="folio_to" optional="show"/>
                <field name="visa_number" optional="show"/>
                <field name="electronic_resolution" optional="show"/>
                <field name="date_start"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="pharmacy_controlled_book_register_view_form" model="ir.ui.view">
        <field name="name">pharmacy.controlled.book.register.form</field>
        <field name="model">pharmacy.controlled.book.register</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="warehouse_id"/>
                            <field name="book"/>
                            <field name="mode" widget="radio"/>
                            <field name="date_start"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group invisible="mode != 'physical'">
                            <field name="folio_from"/>
                            <field name="folio_to"/>
                            <field name="visa_number"/>
                            <field name="visa_date"/>
                            <field name="authority"/>
                        </group>
                        <group invisible="mode != 'electronic'">
                            <field name="electronic_resolution"/>
                            <field name="electronic_date"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        El libro de estupefacientes (lista IIA y demás) y el de psicotrópicos van
                        foliados y visados por la DIRIS, DIRESA o GERESA (visación D5), o como
                        registro electrónico calificado por DIGEMID. Al llenar un libro, archive
                        este registro y cree el siguiente.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pharmacy_controlled_book_register_action" model="ir.actions.act_window">
        <field name="name">Libros oficiales</field>
        <field name="res_model">pharmacy.controlled.book.register</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Balance trimestral -->
    <record id="pharmacy_controlled_balance_view_list" model="ir.ui.view">
        <field name="name">pharmacy.controlled.balance.list</field>
        <field name="model">pharmacy.controlled.balance</field>
        <field name="arch" type="xml">
            <list decoration-danger="state != 'submitted' and deadline &lt; current_date"
                  decoration-muted="state == 'submitted'">
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="book"/>
                <field name="date_to"/>
                <field name="deadline"/>
                <field name="submitted_date" optional="show"/>
                <field name="difference_count" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'submitted'"
                       decoration-info="state == 'computed'"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>
    <record id="pharmacy_controlled_balance_view_form" model="ir.ui.view">
        <field name="name">pharmacy.controlled.balance.form</field>
        <field name="model">pharmacy.controlled.balance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Calcular" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_compute" type="object" string="Recalcular"
                            invisible="state != 'computed'"/>
                    <button name="action_submit" type="object" string="Marcar como presentado"
                            class="btn-primary" invisible="state != 'computed'"/>
                    <button name="action_print" type="object" string="Imprimir" invisible="state == 'draft'"/>
                    <button name="action_draft" type="object" string="Volver a borrador"
                            invisible="state != 'submitted'" groups="al_pharmacy_base.group_pharmacy_director"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-warning" role="alert" invisible="not difference_count">
                        <field name="difference_count" class="oe_inline"/> producto(s) no cuadran con el
                        stock al cierre: justifique la diferencia antes de presentar.
                    </div>
                    <group>
                        <group>
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                            <field name="book" readonly="state != 'draft'"/>
                            <field name="year" readonly="state != 'draft'"/>
                            <field name="quarter" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="deadline"/>
                            <field name="form_code"/>
                            <field name="submitted_date"/>
                            <field name="authority_reference"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Productos">
                            <field name="line_ids" readonly="1">
                                <list decoration-danger="difference != 0">
                                    <field name="product_id"/>
                                    <field name="composition" optional="show"/>
                                    <field name="control_list"/>
                                    <field name="uom_id" optional="hide"/>
                                    <field name="initial"/>
                                    <field name="qty_in"/>
                                    <field name="qty_out"/>
                                    <field name="final"/>
                                    <field name="stock_qty"/>
                                    <field name="difference"/>
                                </list>
                            </field>
                        </page>
                        <page name="differences" string="Diferencias">
                            <field name="difference_note" placeholder="Robo, pérdida o merma, con la autorización de la autoridad (art. 41)."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="pharmacy_controlled_balance_view_search" model="ir.ui.view">
        <field name="name">pharmacy.controlled.balance.search</field>
        <field name="model">pharmacy.controlled.balance</field>
        <field name="arch" type="xml">
            <search>
                <field name="warehouse_id"/>
                <filter name="pending" string="Por presentar" domain="[('state', '!=', 'submitted')]"/>
                <filter name="late" string="Vencidos"
                        domain="[('state', '!=', 'submitted'), ('deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_warehouse" string="Local" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_year" string="Año" context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="pharmacy_controlled_balance_action" model="ir.actions.act_window">
        <field name="name">Balances trimestrales</field>
        <field name="res_model">pharmacy.controlled.balance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree el balance del trimestre</p>
            <p>Listas IIA, IIIA, IIIB y IIIC: saldo anterior, ingresos, egresos y saldo final por
                producto, con el cuadre contra el stock. Se presenta dentro de los 15 días calendario
                siguientes al cierre del trimestre. El primer día de cada trimestre Odoo crea el
                borrador del trimestre anterior con una actividad para el director técnico.</p>
        </field>
    </record>

    <record id="action_report_controlled_balance_record" model="ir.actions.report">
        <field name="name">Balance trimestral</field>
        <field name="model">pharmacy.controlled.balance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">al_l10n_pe_pharmacy_controlled.report_controlled_balance_record</field>
        <field name="paperformat_id" ref="al_report_base.paperformat_pe_a4_landscape"/>
        <field name="binding_model_id" ref="model_pharmacy_controlled_balance"/>
        <field name="binding_type">report</field>
    </record>

    <menuitem id="menu_pharmacy_controlled_balance" name="Balances trimestrales" parent="menu_pharmacy_controlled"
              action="pharmacy_controlled_balance_action" sequence="25"/>
    <menuitem id="menu_pharmacy_controlled_book_register" name="Libros oficiales" parent="menu_pharmacy_controlled"
              action="pharmacy_controlled_book_register_action" sequence="30"/>
</odoo>
