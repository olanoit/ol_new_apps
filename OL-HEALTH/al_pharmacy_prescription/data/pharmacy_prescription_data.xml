<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_pharmacy_prescription" model="ir.sequence">
            <field name="name">Receta</field>
            <field name="code">pharmacy.prescription</field>
            <field name="prefix">RX/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="ir_cron_pharmacy_expire_prescriptions" model="ir.cron">
            <field name="name">Farmacia: vencer recetas</field>
            <field name="model_id" ref="model_pharmacy_prescription"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_prescriptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
