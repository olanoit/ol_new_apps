            <field name="prescription_id" ref="prescription_benites"/>
            <field name="prescription_line_id" eval="obj().env.ref('al_pharmacy_prescription.prescription_benites').line_ids.sorted('sequence')[1].id" model="pharmacy.prescription"/>
            <field name="product_id" model="product.template" eval="obj().env.ref('al_pharmacy_base.product_metformin').product_variant_id.id"/>
            <field name="quantity">60</field>
            <field name="date" eval="(DateTime.today() + relativedelta(days=-2)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="pharmacist_id" ref="al_pharmacy_base.employee_director"/>
            <field name="source">Mostrador</field>
        </record>
        <function model="pharmacy.prescription" name="_cron_expire_prescriptions"/>
    </data>
</odoo>
