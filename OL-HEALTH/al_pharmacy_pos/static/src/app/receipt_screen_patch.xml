<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-options')]/div[1]" position="after">
            <button t-if="pharmacyFractionLines.length" type="button"
                    class="button o_pharmacy_fraction_label btn btn-lg btn-secondary w-100 py-3"
                    t-att-disabled="typeof currentOrder.id !== 'number'"
                    t-on-click="() => this.printPharmacyFractionLabel()">
                <i class="fa fa-tag me-1"/>Rótulo de venta fraccionada
            </button>
        </xpath>
    </t>
</templates>
