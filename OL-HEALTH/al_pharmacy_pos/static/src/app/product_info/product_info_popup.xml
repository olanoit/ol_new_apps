<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Ficha del producto: información farmacéutica arriba, antes del stock y
         la descripción (la arma product.template._pharmacy_pos_info). -->
    <t t-name="al_pharmacy_pos.ProductInfoPopup" t-inherit="point_of_sale.ProductInfoPopup"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='header']" position="after">
            <t t-set="ph" t-value="this.props.info.productInfo?.pharmacy"/>
            <div t-if="ph" class="alph-info text-start mt-2 mb-4 pb-3 border-bottom">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <h3 class="section-title mb-0 me-2">Información farmacéutica</h3>
                    <span t-foreach="ph.badges" t-as="badge" t-key="badge_index"
                          t-attf-class="alph-badge alph-badge--{{ badge.kind }}" t-out="badge.label"/>
                </div>
                <div class="alph-info__grid">
                    <t t-foreach="ph.rows" t-as="row" t-key="row_index">
                        <span class="alph-info__label" t-out="row.label"/>
                        <span class="alph-info__value" t-out="row.value"/>
                    </t>
                </div>

                <div t-if="ph.presentations.length" class="mt-3">
                    <h4 class="alph-info__subtitle">Presentaciones</h4>
                    <div class="d-flex flex-wrap gap-2">
                        <span t-foreach="ph.presentations" t-as="presentation" t-key="presentation_index"
                              class="alph-pill">
                            <strong t-out="presentation.name"/> x <t t-out="presentation.factor"/>
                            · <t t-out="this.env.utils.formatCurrency(presentation.price)"/>
                        </span>
                    </div>
                </div>

                <div t-if="ph.lots.length" class="mt-3">
                    <h4 class="alph-info__subtitle">Lotes disponibles <small class="text-muted">(sale primero el que vence antes)</small></h4>
                    <table class="table table-sm alph-lots mb-0">
                        <thead><tr><th>Lote</th><th>Vence</th><th class="text-end">Cantidad</th><th/></tr></thead>
                        <tbody>
                            <tr t-foreach="ph.lots" t-as="lot" t-key="lot_index"
                                t-att-class="lot.expired ? 'alph-lot--expired' : (lot.near ? 'alph-lot--near' : '')">
                                <td t-out="lot.name"/>
                                <td><t t-out="lot.expiration or '—'"/>
                                    <small t-if="lot.days !== null and lot.days >= 0" class="text-muted"> (<t t-out="lot.days"/> días)</small></td>
                                <td class="text-end" t-out="lot.quantity"/>
                                <td class="text-end">
                                    <span t-if="lot.expired" class="alph-badge alph-badge--controlled">Vencido</span>
                                    <span t-elif="lot.state and lot.state !== 'available'" class="alph-badge alph-badge--prescription">No disponible</span>
                                    <span t-elif="lot.near" class="alph-badge alph-badge--warning">Por vencer</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div t-if="ph.equivalents.length" class="mt-3">
                    <h4 class="alph-info__subtitle">Equivalentes y bioequivalentes
                        <small class="text-muted">(toque uno para cambiarlo en el pedido)</small></h4>
                    <div class="alph-equivalents">
                        <button t-foreach="ph.equivalents" t-as="equivalent" t-key="equivalent.id" type="button"
                                class="alph-equivalent" t-on-click="() => this.replaceWithPharmacyEquivalent(equivalent)">
                            <span class="alph-equivalent__name" t-out="equivalent.name"/>
                            <span class="d-flex flex-wrap align-items-center gap-1 small">
                                <span class="text-muted" t-out="equivalent.type"/>
                                <span t-if="equivalent.bioequivalent" class="alph-badge alph-badge--bioequivalent">Bioequivalente</span>
                            </span>
                            <span class="alph-equivalent__price" t-out="this.env.utils.formatCurrency(equivalent.price)"/>
                            <span t-attf-class="small {{ equivalent.qty > 0 ? 'text-success' : 'text-danger' }}">
                                <t t-if="equivalent.qty > 0"><t t-out="equivalent.qty"/> en stock</t>
                                <t t-else="">Sin stock</t>
                            </span>
                        </button>
                    </div>
                </div>

                <div t-foreach="ph.texts" t-as="text" t-key="text_index" class="mt-3">
                    <h4 class="alph-info__subtitle" t-out="text.label"/>
                    <p class="mb-0 alph-info__text" t-out="text.value"/>
                </div>
            </div>
        </xpath>
    </t>

</templates>
