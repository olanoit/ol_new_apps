<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pharmacy_pos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pharmacy.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="pharmacy_ingredient_filter"
                         help="Muestra sobre el catálogo el filtro por principio activo en lugar del de etiquetas.">
                    <field name="pos_pharmacy_ingredient_filter"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
