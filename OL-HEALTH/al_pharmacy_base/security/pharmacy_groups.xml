<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="res_groups_privilege_pharmacy" model="res.groups.privilege">
            <field name="name">Farmacia</field>
            <field name="sequence">50</field>
            <field name="category_id" ref="base.module_category_supply_chain"/>
        </record>

        <record id="group_pharmacy_technician" model="res.groups">
            <field name="name">Técnico en farmacia</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_pharmacy"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="comment">Atiende, recibe mercadería y registra lecturas de temperatura. No dispensa productos con receta (BPOF 7.2.4).</field>
        </record>

        <record id="group_pharmacy_pharmacist" model="res.groups">
            <field name="name">Químico farmacéutico</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_pharmacy"/>
            <field name="implied_ids" eval="[Command.link(ref('group_pharmacy_technician'))]"/>
            <field name="comment">Además, dispensa con receta, valida devoluciones y bajas, y ve los datos de salud de los pacientes.</field>
        </record>

        <record id="group_pharmacy_director" model="res.groups">
            <field name="name">Director técnico</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_pharmacy"/>
            <field name="implied_ids" eval="[Command.link(ref('group_pharmacy_pharmacist'))]"/>
            <field name="comment">Además, firma actas, balances y alertas sanitarias del establecimiento.</field>
        </record>

        <record id="group_pharmacy_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="res_groups_privilege_pharmacy"/>
            <field name="implied_ids" eval="[Command.link(ref('group_pharmacy_director'))]"/>
            <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
            <field name="comment">Además, configura los catálogos y los ajustes de farmacia.</field>
        </record>

    </data>
</odoo>
