<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pharmacy_ingredient_view_list" model="ir.ui.view">
        <field name="name">pharmacy.ingredient.list</field>
        <field name="model">pharmacy.ingredient</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="atc_code"/>
                <field name="synonyms" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="pharmacy_ingredient_view_search" model="ir.ui.view">
        <field name="name">pharmacy.ingredient.search</field>
        <field name="model">pharmacy.ingredient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('synonyms', 'ilike', self), ('atc_code', 'ilike', self)]"/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="pharmacy_ingredient_action" model="ir.actions.act_window">
        <field name="name">Principios activos</field>
        <field name="res_model">pharmacy.ingredient</field>
        <field name="view_mode">list</field>
    </record>

    <record id="pharmacy_dosage_form_view_list" model="ir.ui.view">
        <field name="name">pharmacy.dosage.form.list</field>
        <field name="model">pharmacy.dosage.form</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="pharmacy_dosage_form_action" model="ir.actions.act_window">
        <field name="name">Formas farmacéuticas</field>
        <field name="res_model">pharmacy.dosage.form</field>
        <field name="view_mode">list</field>
    </record>

    <record id="pharmacy_route_view_list" model="ir.ui.view">
        <field name="name">pharmacy.route.list</field>
        <field name="model">pharmacy.route</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="pharmacy_route_action" model="ir.actions.act_window">
        <field name="name">Vías de administración</field>
        <field name="res_model">pharmacy.route</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
