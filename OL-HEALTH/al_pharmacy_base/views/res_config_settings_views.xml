<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pharmacy" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pharmacy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']/block[@name='operations_setting_container']" position="before">
                <block title="Farmacia" name="pharmacy_setting_container">
                    <setting company_dependent="1" string="Venta sin receta"
                             help="Productos con receta médica. Un Q.F. puede autorizar la excepción (queda en el libro de ocurrencias); los controlados nunca la admiten.">
                        <field name="pharmacy_prescription_policy" widget="radio"/>
                    </setting>
                    <setting company_dependent="1" string="Sin Q.F. en turno"
                             help="Al vender con receta si quien atiende no es químico farmacéutico.">
                        <field name="pharmacy_pharmacist_policy" widget="radio"/>
                    </setting>
                    <setting company_dependent="1" string="Aviso de vencimientos"
                             help="Días antes del vencimiento del lote en que se avisa.">
                        <field name="pharmacy_expiry_alert_days"/> días
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
