<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_pharmacy_cmp" model="ir.ui.view">
        <field name="name">res.partner.form.pharmacy.cmp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="al_pharmacy_prescription.res_partner_view_form_pharmacy"/>
        <field name="arch" type="xml">
            <field name="pharmacy_prescriber_license" position="after">
                <div colspan="2" invisible="not pharmacy_is_prescriber or not pharmacy_prescriber_license or pharmacy_profession not in (False, 'physician')">
                    <button name="action_pharmacy_open_cmp" type="object" string="Consultar en el CMP"
                            icon="open_in_new" class="btn-link"/>
                    <button name="action_pharmacy_cmp_enabled" type="object" string="Verificado: hábil"
                            icon="check" class="btn-link"
                            groups="al_pharmacy_base.group_pharmacy_pharmacist"/>
                    <button name="action_pharmacy_cmp_disabled" type="object" string="Verificado: inhábil"
                            icon="block" class="btn-link text-danger"
                            groups="al_pharmacy_base.group_pharmacy_pharmacist"/>
                </div>
                <field name="pharmacy_cmp_council" invisible="not pharmacy_is_prescriber"/>
                <field name="pharmacy_prescriber_checked_by_id" invisible="not pharmacy_prescriber_checked_by_id"/>
            </field>
        </field>
    </record>
</odoo>
