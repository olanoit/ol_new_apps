<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="mcp_generated_module_list_view" model="ir.ui.view">
        <field name="name">mcp.generated.module.list</field>
        <field name="model">mcp.generated.module</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'installed'"
                  decoration-info="state == 'generated'"
                  decoration-muted="state == 'draft'"
                  decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="technical_name"/>
                <field name="version"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'installed'"
                       decoration-info="state == 'generated'"
                       decoration-muted="state == 'draft'"
                       decoration-danger="state == 'failed'"/>
                <field name="created_by"/>
                <field name="create_date" string="Creado el"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="mcp_generated_module_form_view" model="ir.ui.view">
        <field name="name">mcp.generated.module.form</field>
        <field name="model">mcp.generated.module</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate"
                            string="Generar ZIP"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('draft', 'failed')"/>
                    <button name="action_download"
                            string="Descargar ZIP"
                            type="object"
                            invisible="state != 'generated'"/>
                    <button name="action_install"
                            string="Instalar en Esta Instancia"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'generated'"
                            confirm="Esto extraerá el ZIP del módulo a la ruta de addons configurada y lo instalará. El registro de Odoo se reiniciará. ¿Continuar?"/>
                    <button name="action_reset_to_draft"
                            string="Restablecer a Borrador"
                            type="object"
                            invisible="state not in ('generated', 'failed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated,installed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del Módulo"/>
                        </h1>
                        <h3>
                            <field name="technical_name" placeholder="technical_name"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Metadatos del Módulo">
                            <field name="summary"/>
                            <field name="category"/>
                            <field name="author"/>
                            <field name="version"/>
                            <field name="license"/>
                            <field name="depends"/>
                        </group>
                        <group string="Información de Generación">
                            <field name="created_by"/>
                            <field name="create_date" string="Creado el"/>
                            <field name="installed_at"
                                   invisible="state != 'installed'"/>
                            <field name="attachment_id"
                                   invisible="not attachment_id"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Especificación (JSON)" name="spec">
                            <field name="spec"
                                   widget="ace"
                                   options="{'mode': 'js'}"
                                   nolabel="1"/>
                        </page>
                        <page string="Registro de Generación" name="generation_log">
                            <field name="generation_log"
                                   readonly="1"
                                   nolabel="1"
                                   placeholder="La salida del registro aparecerá aquí después de la generación."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="mcp_generated_module_search_view" model="ir.ui.view">
        <field name="name">mcp.generated.module.search</field>
        <field name="model">mcp.generated.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="created_by"/>
                <separator/>
                <filter string="Borrador" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Generado" name="filter_generated"
                        domain="[('state', '=', 'generated')]"/>
                <filter string="Instalado" name="filter_installed"
                        domain="[('state', '=', 'installed')]"/>
                <filter string="Fallido" name="filter_failed"
                        domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter string="Mis Módulos" name="filter_mine"
                        domain="[('created_by', '=', uid)]"/>
            </search>
        </field>
    </record>

    <!-- Window action -->
    <record id="mcp_generated_module_action" model="ir.actions.act_window">
        <field name="name">Módulos Generados</field>
        <field name="res_model">mcp.generated.module</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mcp_generated_module_search_view"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no hay módulos generados.
            </p>
            <p>
                Use la herramienta MCP <b>odoo_generate_module</b> (requiere alcance de administrador)
                para generar un módulo de Odoo instalable a partir de una especificación JSON.
            </p>
        </field>
    </record>

</odoo>
