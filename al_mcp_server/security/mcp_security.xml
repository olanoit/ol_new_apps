<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            mcp.token record rules
            ─────────────────────
            group_user  → sees ONLY own tokens (user_id = uid)
            group_system → sees ALL tokens (ORed with group_user rule = admin wins)
        -->
        <record id="rule_mcp_token_user_own" model="ir.rule">
            <field name="name">Token MCP: los usuarios solo ven sus propios tokens</field>
            <field name="model_id" ref="model_mcp_token"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_mcp_token_admin_all" model="ir.rule">
            <field name="name">Token MCP: el administrador ve todos</field>
            <field name="model_id" ref="model_mcp_token"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            mcp.session record rules
            ────────────────────────
            group_user  → sees ONLY own sessions (read-only)
            group_system → sees ALL sessions (full access)
        -->
        <record id="rule_mcp_session_user_own" model="ir.rule">
            <field name="name">Sesión MCP: los usuarios solo ven sus propias sesiones</field>
            <field name="model_id" ref="model_mcp_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_mcp_session_admin_all" model="ir.rule">
            <field name="name">Sesión MCP: el administrador ve todas</field>
            <field name="model_id" ref="model_mcp_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            mcp.job record rules
            ────────────────────
            group_user  → sees ONLY own jobs (user_id = uid)
            group_system → sees ALL jobs (ORed with group_user rule = admin wins)
        -->
        <record id="rule_mcp_job_user_own" model="ir.rule">
            <field name="name">Trabajo MCP: los usuarios solo ven sus propios trabajos</field>
            <field name="model_id" ref="model_mcp_job"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_mcp_job_admin_all" model="ir.rule">
            <field name="name">Trabajo MCP: el administrador ve todos</field>
            <field name="model_id" ref="model_mcp_job"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            mcp.portal.page record rules
            ────────────────────────────
            group_user  → sees ONLY own pages (created_by = uid)
            group_system → sees ALL pages (ORed with group_user rule = admin wins)
        -->
        <record id="rule_mcp_portal_page_user_own" model="ir.rule">
            <field name="name">Página de Portal MCP: los usuarios solo ven sus propias páginas</field>
            <field name="model_id" ref="model_mcp_portal_page"/>
            <field name="domain_force">[('created_by', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_mcp_portal_page_admin_all" model="ir.rule">
            <field name="name">Página de Portal MCP: el administrador ve todas</field>
            <field name="model_id" ref="model_mcp_portal_page"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
