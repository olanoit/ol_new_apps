<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ple" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.al.ple</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="al_account_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='pe_accounting_block']"
                   position="inside">
                <setting string="Libros PLE simplificados"
                         help="Genera los formatos simplificados 5.2/5.4, 8.3 y 14.2 (excluyentes con 5.1/5.3, 8.1 y 14.1).">
                    <field name="l10n_pe_ple_simplified"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
